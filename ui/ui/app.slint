}

// Glyphs by the names Rust gives them.
global Glyphs {
    pure public function of(k: string) -> string {
        return k == "requests" ? Icons.requests : k == "resources" ? Icons.resources : k == "logs" ? Icons.logs
            : k == "language" ? Icons.language : k == "palette" ? Icons.palette : k == "apps" ? Icons.apps
            : k == "cloud-sync" ? Icons.cloud-sync : k == "wrench" ? Icons.tools : k == "settings" ? Icons.settings
            : k == "gavel" ? Icons.gavel : k == "cpu" ? Icons.memory : k == "info" ? Icons.info
            : k == "code" ? Icons.code : k == "key" ? Icons.key : k == "send" ? Icons.send : "";
    }
}

component Icon inherits Path {
    in property <string> glyph;
    in property <color> tint: Theme.s.on-surface;
    in property <length> size: 24px;
    width: size;
    height: size;
    commands: glyph;
    fill: transparent;
    stroke: tint;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    stroke-line-join: round;
    viewbox-width: 24;
    viewbox-height: 24;
}

component FilledIcon inherits Path {
    in property <string> glyph;
    in property <color> tint: Theme.s.on-surface;
    in property <length> size: 24px;
    width: size;
    height: size;
    commands: glyph;
    fill: tint;
    stroke: tint;
    stroke-width: 1px;
    stroke-line-join: round;
    viewbox-width: 24;
    viewbox-height: 24;
}

// ---------------------------------------------------------------- Building blocks

component Card inherits Rectangle {
    in property <bool> selected;
    background: selected ? Theme.s.primary-container : Theme.s.card;
    border-radius: 12px;
}

// A card with FlClash's header row: a small icon, then the title.
component InfoCard inherits Card {
    in property <string> title;
    in property <string> glyph;
    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            height: 22px;
            Icon { glyph: root.glyph; size: 20px; tint: root.selected ? Theme.s.on-primary-container : Theme.s.primary; y: 1px; }
            Text {
                text: root.title;
                font-size: 15px;
                color: root.selected ? Theme.s.on-primary-container : Theme.s.on-surface;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        @children
    }
}

component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> filled;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked();
    height: 36px;
    min-width: 64px;
    border-radius: 18px;
    background: filled ? (ta.pressed ? Theme.s.primary.darker(0.15) : Theme.s.primary) : (ta.pressed ? Theme.s.inset : transparent);
    opacity: enabled ? 1 : 0.45;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            font-size: 14px;
            color: root.filled ? Theme.s.on-primary : (root.danger ? Theme.s.error : Theme.s.primary);
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <color> tint: Theme.s.on-surface-variant;
    in property <bool> enabled: true;
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: ta.pressed ? Theme.s.inset : transparent;
    opacity: enabled ? 1 : 0.4;
    Icon { glyph: root.glyph; tint: root.tint; }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// FlClash's floating action button: a rounded square in the primary container color,
// bottom right of the page. With a label it widens into the extended form.
component Fab inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> filled-glyph;
    in property <bool> enabled: true;
    callback clicked();
    width: label == "" ? 56px : max(56px, row.preferred-width);
    height: 56px;
    border-radius: 16px;
    background: ta.pressed ? Theme.s.primary-container.darker(0.08) : Theme.s.primary-container;
    opacity: enabled ? 1 : 0.6;
    row := HorizontalLayout {
        padding-left: root.label == "" ? 16px : 18px;
        padding-right: root.label == "" ? 16px : 20px;
        spacing: 10px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            if root.filled-glyph: FilledIcon { glyph: root.glyph; tint: Theme.s.on-primary-container; }
            if !root.filled-glyph: Icon { glyph: root.glyph; tint: Theme.s.on-primary-container; }
        }
        if root.label != "": Text {
            text: root.label;
            font-size: 15px;
            color: Theme.s.on-primary-container;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// The top app bar: the page title on the left, actions on the right.
component AppBar inherits HorizontalLayout {
    in property <string> title;
    in property <bool> can-back;
    callback back();
    height: 56px;
    padding-left: can-back ? 4px : 16px;
    padding-right: 8px;
    spacing: 4px;
    if root.can-back: VerticalLayout {
        alignment: center;
        IconButton { glyph: Icons.back; tint: Theme.s.on-surface; clicked => { root.back(); } }
    }
    Text {
        horizontal-stretch: 1;
        text: root.title;
        font-size: 22px;
        color: Theme.s.on-surface;
        vertical-alignment: center;
        overflow: elide;
    }
    @children
}

component Empty inherits Rectangle {
    in property <string> text;
    Text {
        text: root.text;
        color: Theme.s.on-surface-variant;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
        width: parent.width - 48px;
    }
}

component RadioRow inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    callback clicked();
    height: 34px;
    border-radius: 8px;
    background: ta.pressed ? Theme.s.block : transparent;
    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: 2px;
                border-color: root.checked ? Theme.s.primary : Theme.s.on-surface-variant;
                Rectangle {
                    visible: root.checked;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.s.primary;
                }
            }
        }
        Text {
            text: root.text;
            font-size: 14px;
            color: Theme.s.on-surface;
            vertical-alignment: center;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// ---------------------------------------------------------------- Dashboard

component Switch inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 52px;
    height: 32px;
    border-radius: 16px;
    background: checked ? Theme.s.primary : Theme.s.inset;
    border-width: checked ? 0 : 2px;
    border-color: Theme.s.on-surface-variant;
    Rectangle {
        x: root.checked ? parent.width - self.width - 6px : 8px;
        width: root.checked ? 22px : 16px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.checked ? Theme.s.on-primary : Theme.s.on-surface-variant;
        animate x { duration: 120ms; }
    }
    TouchArea { clicked => { root.checked = !root.checked; root.toggled(root.checked); } }
}

// A small rounded label (`DashboardChip`).
component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.s.on-surface-variant;
    in property <bool> dot;
    height: 22px;
    width: row.preferred-width;
    border-radius: 11px;
    background: tone.with-alpha(0.14);
    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        if root.dot: VerticalLayout {
            alignment: center;
            Rectangle { width: 6px; height: 6px; border-radius: 3px; background: root.tone; }
        }
        Text { text: root.text; font-size: 12px; font-weight: 600; color: root.tone; vertical-alignment: center; }
    }
}

// `DashboardCard` with its header row: icon, title, chips, then actions on the right.
component DashCard inherits Rectangle {
    in property <string> glyph;
    in property <string> title;
    in property <bool> chevron;
    callback tapped();
    background: Theme.s.card;
    border-radius: 20px;
    TouchArea { clicked => { root.tapped(); } }
    @children
}

component DashHeader inherits HorizontalLayout {
    in property <string> glyph;
    in property <string> title;
    in property <bool> chevron;
    height: 28px;
    spacing: 8px;
    VerticalLayout { alignment: center; Icon { glyph: root.glyph; size: 18px; tint: Theme.s.on-surface-variant; } }
    Text { text: root.title; font-size: 15px; font-weight: 600; color: Theme.s.on-surface; vertical-alignment: center; }
    @children
    Rectangle { horizontal-stretch: 1; }
    if root.chevron: VerticalLayout { alignment: center; Icon { glyph: Icons.chevron; size: 18px; tint: Theme.s.on-surface-variant; } }
}

// `CurrentOutboundCard`: where traffic leaves, the kind of address, run time and the
// organization, with the start button.
component StatusCard inherits DashCard {
    in property <DashStatus> status;
    in property <string> run-state;
    in property <string> run-time;
    in property <bool> compact;
    callback toggle();
    callback refresh();
    property <bool> on: run-state == "STARTED";
    property <bool> busy: run-state == "STARTING" || run-state == "STOPPING" || run-state == "OFFLINE";
    glyph: Icons.status;
    title: "状态";
    tapped => { root.refresh(); }
    HorizontalLayout {
        padding: 16px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 12px;
            DashHeader {
                glyph: Icons.status;
                title: "状态";
                Chip {
                    text: root.run-state == "STARTED" ? "运行中" : root.run-state == "STARTING" ? "启动中" : root.run-state == "STOPPING" ? "停止中" : "未运行";
                    tone: root.on ? Theme.success : Theme.s.on-surface-variant;
                    dot: true;
                }
            }
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: Theme.s.block;
                        Text { text: root.status.country == "" ? "—" : root.status.country; font-size: 13px; font-weight: 700; color: Theme.s.on-surface; }
                    }
                }
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: root.status.ip == "" ? (root.status.probing ? "检测中…" : "—") : root.status.ip;
                        font-size: root.compact ? 18px : 22px;
                        font-weight: 700;
                        color: Theme.s.on-surface;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        if root.status.kind != "": Chip { text: root.status.kind; }
                        if root.status.quality > 0: Chip {
                            text: root.status.quality == 1 ? "质量 优" : root.status.quality == 2 ? "质量 普通" : "质量 风险";
                            tone: root.status.quality == 1 ? Theme.success : root.status.quality == 2 ? Theme.s.on-surface-variant : Theme.s.error;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 20px;
                VerticalLayout {
                    spacing: 2px;
                    Text { text: "运行时长"; font-size: 12px; color: Theme.s.on-surface-variant; }
                    Text { text: root.run-time; font-size: 15px; font-weight: 600; color: Theme.s.on-surface; }
                }
                VerticalLayout {
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text { text: "组织"; font-size: 12px; color: Theme.s.on-surface-variant; }
                    Text { text: root.status.org == "" ? "—" : root.status.org; font-size: 15px; font-weight: 600; color: Theme.s.on-surface; overflow: elide; }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: root.compact ? 64px : 76px;
                height: self.width;
                border-radius: self.width / 2;
                background: root.on ? Theme.s.primary : Theme.s.primary-container;
                opacity: root.busy ? 0.6 : 1;
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        FilledIcon { glyph: root.on ? Icons.pause : Icons.play; tint: root.on ? Theme.s.on-primary : Theme.s.on-primary-container; }
                    }
                }
                TouchArea { enabled: !root.busy; clicked => { root.toggle(); } }
            }
        }
    }
}

// `SpeedCard`: one direction's speed, its total and its chart.
component SpeedTile inherits Rectangle {
    in property <bool> upload;
    in property <DashTraffic> traffic;
    in property <bool> peak;
    in property <bool> header;
    background: header ? Theme.s.card : Theme.s.block;
    border-radius: header ? 20px : 14px;
    clip: true;
    property <color> tint: root.upload ? Theme.s.primary : Theme.success;
    Path {
        y: parent.height - self.height;
        width: parent.width;
        height: parent.width * 0.2;
        viewbox-width: 100;
        viewbox-height: 20;
        commands: root.upload ? root.traffic.up-fill : root.traffic.down-fill;
        fill: root.tint.with-alpha(0.14);
        stroke-width: 0;
    }
    Path {
        y: parent.height - self.height;
        width: parent.width;
        height: parent.width * 0.2;
        viewbox-width: 100;
        viewbox-height: 20;
        commands: root.upload ? root.traffic.up-line : root.traffic.down-line;
        fill: transparent;
        stroke: root.tint;
        stroke-width: 2px;
    }
    VerticalLayout {
        padding: root.header ? 16px : 12px;
        spacing: 4px;
        alignment: start;
        HorizontalLayout {
            spacing: 6px;
            VerticalLayout { alignment: center; Icon { glyph: root.upload ? Icons.up : Icons.down; size: 16px; tint: root.tint; } }
            Text { text: root.upload ? "上传" : "下载"; font-size: root.header ? 15px : 13px; font-weight: 600; color: Theme.s.on-surface; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            if root.peak: Text { text: root.upload ? root.traffic.up-peak : root.traffic.down-peak; font-size: 11px; color: Theme.s.on-surface-variant; vertical-alignment: center; }
        }
        HorizontalLayout {
            spacing: 4px;
            // Device fonts can draw bold digits wider than they measure, so
            // the value gets slack and the unit takes the rest of the row.
            Text { text: root.upload ? root.traffic.up-value : root.traffic.down-value; font-size: 28px; font-weight: 700; color: Theme.s.on-surface; min-width: self.preferred-width + 12px; }
            VerticalLayout {
                alignment: end;
                padding-bottom: 5px;
                horizontal-stretch: 1;
                Text { text: root.upload ? root.traffic.up-unit : root.traffic.down-unit; font-size: 12px; font-weight: 600; color: Theme.s.on-surface-variant; min-width: self.preferred-width + 6px; }
            }
        }
        Text { text: root.upload ? root.traffic.up-total : root.traffic.down-total; font-size: 12px; color: Theme.s.on-surface-variant; }
    }
}

// `NetworkSpeedCard` on a phone: both directions side by side.
component SpeedCard inherits DashCard {
    in property <DashTraffic> traffic;
    height: 216px;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        DashHeader { glyph: Icons.speed; title: "网络速度"; }
        HorizontalLayout {
            spacing: 10px;
            SpeedTile { upload: true; traffic: root.traffic; }
            SpeedTile { upload: false; traffic: root.traffic; }
        }
    }
}

// One choice of the outbound mode.
component ModeTile inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> active;
    in property <bool> inline;
    callback clicked();
    border-radius: inline ? 18px : 14px;
    background: active ? Theme.s.primary : Theme.s.block;
    if !root.inline: VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout { alignment: center; Icon { glyph: root.glyph; size: 18px; tint: root.active ? Theme.s.on-primary : Theme.s.on-surface-variant; } }
        Text { text: root.label; font-size: 14px; font-weight: 600; horizontal-alignment: center; color: root.active ? Theme.s.on-primary : Theme.s.on-surface; }
    }
    if root.inline: HorizontalLayout {
        alignment: center;
        spacing: 6px;
        VerticalLayout { alignment: center; Icon { glyph: root.glyph; size: 16px; tint: root.active ? Theme.s.on-primary : Theme.s.on-surface-variant; } }
        Text { text: root.label; font-size: 14px; font-weight: 600; vertical-alignment: center; color: root.active ? Theme.s.on-primary : Theme.s.on-surface; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

// `OutboundModeCard` on a phone: three tiles under the header.
component ModeCard inherits DashCard {
    in property <int> mode;
    callback set-mode(int);
    height: 136px;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        DashHeader { glyph: Icons.route; title: "出站模式"; }
        HorizontalLayout {
            spacing: 8px;
            ModeTile { glyph: Icons.rule; label: "规则"; active: root.mode == 0; clicked => { root.set-mode(0); } }
            ModeTile { glyph: Icons.proxies; label: "全局"; active: root.mode == 1; clicked => { root.set-mode(1); } }
            ModeTile { glyph: Icons.target; label: "直连"; active: root.mode == 2; clicked => { root.set-mode(2); } }
        }
    }
}

// `OutboundModeBar` on a wide dashboard: the label, then the choices in a row.
component ModeBar inherits DashCard {
    in property <int> mode;
    callback set-mode(int);
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout { alignment: center; Icon { glyph: Icons.route; size: 18px; tint: Theme.s.on-surface-variant; } }
            Text { text: "出站模式"; font-size: 14px; font-weight: 600; color: Theme.s.on-surface; vertical-alignment: center; }
        }
        Rectangle { horizontal-stretch: 0.2; }
        ModeTile { inline: true; glyph: Icons.rule; label: "规则"; active: root.mode == 0; clicked => { root.set-mode(0); } }
        ModeTile { inline: true; glyph: Icons.proxies; label: "全局"; active: root.mode == 1; clicked => { root.set-mode(1); } }
        ModeTile { inline: true; glyph: Icons.target; label: "直连"; active: root.mode == 2; clicked => { root.set-mode(2); } }
    }
}

// `VpnCard` / `VpnTile`: the switch that starts and stops the VPN.
component VpnCard inherits DashCard {
    in property <string> run-state;
    in property <bool> slim;
    callback toggle();
    property <bool> on: run-state == "STARTED" || run-state == "STARTING";
    height: slim ? 60px : 84px;
    tapped => { if (root.run-state != "OFFLINE") { root.toggle(); } }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        if !root.slim: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: root.on ? Theme.s.primary : Theme.s.block;
                Icon { glyph: Icons.shield; size: 22px; tint: root.on ? Theme.s.on-primary : Theme.s.on-surface-variant; }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: "VPN"; font-size: root.slim ? 14px : 16px; font-weight: 600; color: Theme.s.on-surface; }
            if !root.slim: Text { text: root.on ? "已启用" : "已停用"; font-size: 12px; color: Theme.s.on-surface-variant; }
        }
        VerticalLayout {
            alignment: center;
            Switch { checked: root.on; toggled => { root.toggle(); } }
        }
    }
}

// `ProfilesCard`: the current profile, when it runs out and how much it has used.
component ProfileDashCard inherits DashCard {
    in property <DashProfile> profile;
    in property <bool> wide;
    callback sync();
    glyph: Icons.profiles;
    title: "配置";
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        alignment: start;
        DashHeader {
            glyph: Icons.profiles;
            title: "配置";
            chevron: true;
            Rectangle { horizontal-stretch: 100; }
            if root.profile.syncable: VerticalLayout {
                alignment: center;
                IconButton {
                    width: 30px;
                    height: 30px;
                    glyph: root.profile.busy ? Icons.clock : Icons.sync;
                    enabled: !root.profile.busy;
                    clicked => { root.sync(); }
                }
            }
        }
        Text {
            text: root.profile.name == "" ? "添加配置" : root.profile.name;
            font-size: 17px;
            font-weight: 600;
            color: Theme.s.on-surface;
            overflow: elide;
        }
        if root.profile.name != "": HorizontalLayout {
            spacing: 12px;
            Text { text: root.profile.updated; font-size: 12px; color: Theme.s.on-surface-variant; horizontal-stretch: 1; overflow: elide; }
            Text { text: root.profile.end; font-size: 12px; color: root.profile.warn ? Theme.warning : Theme.s.on-surface-variant; }
        }
        if root.profile.usage: VerticalLayout {
            spacing: 6px;
            padding-top: 4px;
            HorizontalLayout {
                spacing: 4px;
                Text { text: root.profile.percent; font-size: 20px; font-weight: 700; color: Theme.s.on-surface; }
                VerticalLayout { alignment: end; padding-bottom: 3px; Text { text: "已用"; font-size: 12px; color: Theme.s.on-surface-variant; } }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: end; padding-bottom: 3px; Text { text: root.profile.used; font-size: 12px; color: Theme.s.on-surface-variant; } }
            }
            Rectangle {
                height: 6px;
                border-radius: 3px;
                background: Theme.s.block;
                Rectangle {
                    x: 0;
                    width: parent.width * root.profile.ratio;
                    border-radius: 3px;
                    background: root.profile.ratio >= 0.9 ? Theme.warning : Theme.s.primary;
                }
            }
        }
    }
}

// `ProxyGroupsCard`: the groups with the proxy each one picks; a tap opens it.
component GroupsDashCard inherits DashCard {
    in property <[ProxyGroup]> groups;
    in property <bool> running;
    in property <int> limit: 6;
    callback open(string);
    property <int> cols: self.width > 360px ? 2 : 1;
    property <length> tile-h: 52px;
    property <int> shown: min(groups.length, limit);
    property <length> cell-w: (self.width - 32px - (cols - 1) * 8px) / cols;
    height: 16px + 28px + 12px + (shown == 0 ? 40px : ceil(shown / cols) * (tile-h + 8px) - 8px) + 16px;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        alignment: start;
        DashHeader {
            glyph: Icons.group;
            title: "策略组";
            chevron: root.groups.length > 0;
            if root.groups.length > 0: Chip { text: root.groups.length; }
        }
        if root.groups.length == 0: Text {
            height: 40px;
            text: root.running ? "暂无策略组" : "启动后在这里显示策略组";
            font-size: 13px;
            color: Theme.s.on-surface-variant;
            vertical-alignment: center;
        }
        if root.groups.length > 0: Rectangle {
            height: ceil(root.shown / root.cols) * (root.tile-h + 8px) - 8px;
            for g[i] in root.groups: Rectangle {
                visible: i < root.limit;
                x: mod(i, root.cols) * (root.cell-w + 8px);
                y: floor(i / root.cols) * (root.tile-h + 8px);
                width: root.cell-w;
                height: root.tile-h;
                border-radius: 14px;
                background: ta.pressed ? Theme.s.inset : Theme.s.block;
                ta := TouchArea { clicked => { root.open(g.name); } }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 10px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 10px;
                            background: Theme.s.card;
                            Text { text: g.monogram; font-size: 14px; font-weight: 700; color: Theme.s.on-surface-variant; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text { text: g.name; font-size: 14px; font-weight: 600; color: Theme.s.on-surface; overflow: elide; }
                        Text { text: g.now; font-size: 12px; color: Theme.s.on-surface-variant; overflow: elide; }
                    }
                }
            }
        }
    }
}

// `IntranetIpCard`: this device's address on its network.
component IpDashCard inherits DashCard {
    in property <string> ip;
    callback copy();
    height: 120px;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        alignment: start;
        DashHeader {
            glyph: Icons.devices;
            title: "局域网 IP";
            VerticalLayout { alignment: center; IconButton { width: 30px; height: 30px; glyph: Icons.copy; clicked => { root.copy(); } } }
        }
        Text { text: root.ip; font-size: 22px; font-weight: 700; color: Theme.s.on-surface; overflow: elide; }
    }
}

// `MemoryInfo`: what the app and its Core hold in memory.
component MemoryDashCard inherits DashCard {
    in property <string> memory;
    height: 120px;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        alignment: start;
        DashHeader { glyph: Icons.memory; title: "内存信息"; }
        Text { text: root.memory == "" ? "—" : root.memory; font-size: 22px; font-weight: 700; color: Theme.s.on-surface; }
        Text { text: "常驻内存（含内核）"; font-size: 12px; color: Theme.s.on-surface-variant; }
    }
}

// The editor's frame around a card: move it, or take it off the dashboard.
component EditFrame inherits Rectangle {
    in property <bool> first;
    in property <bool> last;
    callback up();
    callback down();
    callback remove();
    height: 40px;
    HorizontalLayout {
        spacing: 4px;
        alignment: end;
        IconButton { glyph: Icons.up; enabled: !root.first; clicked => { root.up(); } }
        IconButton { glyph: Icons.down; enabled: !root.last; clicked => { root.down(); } }
        IconButton { glyph: Icons.delete; tint: Theme.s.error; clicked => { root.remove(); } }
    }
}

component Dashboard inherits Rectangle {
    in property <string> run-state;
    in property <string> run-time;
    in property <DashStatus> status;
    in property <DashTraffic> traffic;
    in property <DashProfile> profile;
    in property <[ProxyGroup]> groups;
    in property <[string]> widgets;
    in property <[string]> hidden;
    in property <string> local-ip;
    in property <string> memory;
    in property <int> mode;
    in-out property <bool> editing;
    callback toggle-vpn();
    callback set-mode(int);
    callback open-profiles();
    callback sync-profile(string);
    callback open-group(string);
    callback refresh-ip();
    callback copy-ip();
    callback edit(string, string);
    // `DashboardDensity`: a phone column under 640, else the fixed grid of 2 or 4 columns.
    property <bool> wide: self.width >= 640px;
    property <int> columns: self.width < 860px ? 2 : 4;
    property <length> gap: self.width < 600px ? 8px : self.width < 840px ? 12px : 16px;
    property <length> side: max(16px, (self.width - 560px) / 2);
    in property <bool> has-start: true;
    property <length> cw: min((self.width - 40px - gap * (columns - 1)) / columns, 440px);
    property <length> inset: (self.width - 40px - gap * (columns - 1) - cw * columns) / 2;

    function span(n: int) -> length { return root.cw * n + root.gap * (n - 1); }

    VerticalLayout {
        AppBar {
            title: root.editing ? "编辑仪表盘" : "仪表盘";
            if !root.wide: VerticalLayout {
                alignment: center;
                IconButton {
                    glyph: root.editing ? Icons.check : Icons.edit;
                    tint: Theme.s.on-surface;
                    clicked => { root.editing = !root.editing; }
                }
            }
        }
        if !root.wide: Flickable {
            content-height: mobile.preferred-height;
            mobile := VerticalLayout {
                padding-left: root.side;
                padding-right: root.side;
                padding-top: 4px;
                padding-bottom: 24px;
                spacing: root.gap;
                for w[i] in root.widgets: VerticalLayout {
                    if root.editing: EditFrame {
                        first: i == 0;
                        last: i == root.widgets.length - 1;
                        up => { root.edit("up", w); }
                        down => { root.edit("down", w); }
                        remove => { root.edit("remove", w); }
                    }
                    if w == "status": StatusCard {
                        height: 200px;
                        status: root.status;
                        run-state: root.run-state;
                        run-time: root.run-time;
                        toggle => { root.toggle-vpn(); }
                        refresh => { root.refresh-ip(); }
                    }
                    if w == "speed": SpeedCard { traffic: root.traffic; }
                    if w == "mode": ModeCard { mode: root.mode; set-mode(m) => { root.set-mode(m); } }
                    if w == "vpn": VpnCard { run-state: root.run-state; toggle => { root.toggle-vpn(); } }
                    if w == "profile": ProfileDashCard {
                        height: self.preferred-height;
                        profile: root.profile;
                        tapped => { root.open-profiles(); }
                        sync => { root.sync-profile(root.profile.id); }
                    }
                    if w == "groups": GroupsDashCard {
                        groups: root.groups;
                        running: root.run-state == "STARTED";
                        tapped => { root.open-group(""); }
                        open(g) => { root.open-group(g); }
                    }
                    if w == "ip": IpDashCard { ip: root.local-ip; copy => { root.copy-ip(); } }
                    if w == "memory": MemoryDashCard { memory: root.memory; }
                }
                if root.editing && root.hidden.length > 0: VerticalLayout {
                    spacing: 8px;
                    padding-top: 8px;
                    Text { text: "添加卡片"; font-size: 13px; color: Theme.s.on-surface-variant; }
                    for h in root.hidden: Rectangle {
                        height: 48px;
                        border-radius: 14px;
                        background: Theme.s.card;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 4px;
                            Text {
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                font-size: 15px;
                                color: Theme.s.on-surface;
                                text: h == "status" ? "状态" : h == "speed" ? "网络速度" : h == "mode" ? "出站模式" : h == "vpn" ? "VPN" : h == "profile" ? "配置" : h == "groups" ? "策略组" : h == "ip" ? "局域网 IP" : "内存信息";
                            }
                            IconButton { glyph: Icons.plus; tint: Theme.s.primary; clicked => { root.edit("add", h); } }
                        }
                    }
                }
                if root.editing: HorizontalLayout {
                    alignment: center;
                    TextButton { text: "恢复默认"; clicked => { root.edit("reset", ""); } }
                }
            }
        }
        // The wide dashboard (`_DesktopDashboard`): rows of fixed height across 2 or 4
        // columns.
        if root.wide: Flickable {
            content-height: grid.preferred-height;
            grid := VerticalLayout {
                padding-left: 16px + root.inset;
                padding-right: 24px + root.inset;
                padding-top: 4px;
                padding-bottom: 24px;
                spacing: root.gap;
                if root.columns == 2: StatusCard {
                    height: 200px;
                    status: root.status;
                    run-state: root.run-state;
                    run-time: root.run-time;
                    toggle => { root.toggle-vpn(); }
                    refresh => { root.refresh-ip(); }
                }
                HorizontalLayout {
                    height: 200px;
                    spacing: root.gap;
                    if root.columns == 4: StatusCard {
                        width: root.span(2);
                        status: root.status;
                        run-state: root.run-state;
                        run-time: root.run-time;
                        compact: true;
                        toggle => { root.toggle-vpn(); }
                        refresh => { root.refresh-ip(); }
                    }
                    SpeedTile { width: root.cw; header: true; peak: true; upload: true; traffic: root.traffic; }
                    SpeedTile { width: root.cw; header: true; peak: true; upload: false; traffic: root.traffic; }
                }
                if root.columns == 2: ModeBar { height: 60px; mode: root.mode; set-mode(m) => { root.set-mode(m); } }
                if root.columns == 2: VpnCard { slim: true; run-state: root.run-state; toggle => { root.toggle-vpn(); } }
                if root.columns == 4: HorizontalLayout {
                    height: 60px;
                    spacing: root.gap;
                    ModeBar { width: root.span(2); mode: root.mode; set-mode(m) => { root.set-mode(m); } }
                    VpnCard { width: root.span(2); slim: true; run-state: root.run-state; toggle => { root.toggle-vpn(); } }
                }
                HorizontalLayout {
                    height: 170px;
                    spacing: root.gap;
                    IpDashCard { width: root.cw; height: 170px; ip: root.local-ip; copy => { root.copy-ip(); } }
                    ProfileDashCard {
                        width: root.columns == 4 ? root.span(2) : root.cw;
                        wide: true;
                        profile: root.profile;
                        tapped => { root.open-profiles(); }
                        sync => { root.sync-profile(root.profile.id); }
                    }
                    if root.columns == 4: MemoryDashCard { width: root.cw; height: 170px; memory: root.memory; }
                }
                if root.columns == 2: HorizontalLayout {
                    height: 120px;
                    spacing: root.gap;
                    MemoryDashCard { width: root.cw; memory: root.memory; }
                    Rectangle { width: root.cw; }
                }
                GroupsDashCard {
                    groups: root.groups;
                    limit: root.columns == 4 ? 8 : 6;
                    running: root.run-state == "STARTED";
                    tapped => { root.open-group(""); }
                    open(g) => { root.open-group(g); }
                }
            }
        }
    }

    // Neither the status card nor the VPN switch on a phone dashboard: the start button
    // stays reachable.
    if !root.wide && !root.has-start: Fab {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        glyph: root.run-state == "STARTED" ? Icons.pause : Icons.play;
        filled-glyph: true;
        enabled: root.run-state == "STARTED" || root.run-state == "STOPPED";
        clicked => { root.toggle-vpn(); }
    }
}

// ---------------------------------------------------------------- Proxies

// The delay on a card (`_DelayText`): a bolt to test while untested, a clock while queued,
// dots while running, then the value; a tap tests the card again.
component DelayBadge inherits Rectangle {
    in property <int> delay;
    in property <color> idle: Theme.s.on-surface-variant;
    callback test();
    property <bool> busy: delay == -3 || delay == -4;
    width: delay > 0 || delay == -1 || delay == -2 ? label.preferred-width + 4px : 18px;
    height: 18px;
    if root.delay == 0: Icon { glyph: Icons.bolt; size: 15px; tint: root.idle; }
    if root.delay == -4: Icon { glyph: Icons.clock; size: 15px; tint: root.idle.with-alpha(0.5); }
    if root.delay == -3: Text { text: "···"; font-size: 13px; font-weight: 700; color: Theme.s.primary; horizontal-alignment: center; vertical-alignment: center; }
    label := Text {
        visible: root.delay > 0 || root.delay == -1 || root.delay == -2;
        text: root.delay == -1 ? "超时" : root.delay == -2 ? "失败" : root.delay + " ms";
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: right;
        vertical-alignment: center;
        color: root.delay > 0 && root.delay < 800 ? Theme.success : root.delay > 0 && root.delay < 1500 ? Theme.warning : Theme.s.error;
    }
    TouchArea {
        enabled: !root.busy;
        clicked => { root.test(); }
    }
}

// FlClash's ProxyCard: the name (two lines, or one when compact), the type and the delay
// below, and a badge for the proxy in use or the pin.
component NodeCard inherits Card {
    in property <NodeItem> item;
    // 0 compact, 1 standard, 2 loose.
    in property <int> size: 1;
    callback clicked();
    callback test();
    selected: item.selected;
    background: item.selected ? Theme.s.primary-container : (ta.pressed ? Theme.s.block : Theme.s.card);
    property <color> fg: item.selected ? Theme.s.on-primary-container : Theme.s.on-surface;
    property <color> fg2: item.selected ? Theme.s.on-primary-container : Theme.s.on-surface-variant;
    ta := TouchArea { clicked => { root.clicked(); } }
    VerticalLayout {
        padding-left: 12px;
        padding-right: 10px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: root.size == 2 ? 4px : 6px;
        HorizontalLayout {
            spacing: 4px;
            vertical-stretch: 1;
            Text {
                text: root.item.name;
                font-size: 14px;
                color: root.fg;
                wrap: root.size == 0 ? no-wrap : word-wrap;
                overflow: elide;
                vertical-alignment: top;
                horizontal-stretch: 1;
            }
            if root.item.pinned || root.item.selected: Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: root.item.selected ? Theme.s.primary : Theme.s.primary.with-alpha(0.15);
                Icon {
                    glyph: root.item.pinned ? Icons.pin : Icons.check;
                    size: 13px;
                    tint: root.item.selected ? Theme.s.on-primary : Theme.s.primary;
                }
            }
        }
        if root.size == 2: Text { text: root.item.kind; font-size: 12px; color: root.fg2; overflow: elide; }
        if root.size == 2: HorizontalLayout {
            DelayBadge { delay: root.item.delay; idle: root.fg2; test => { root.test(); } }
            Rectangle { }
        }
        if root.size != 2: HorizontalLayout {
            spacing: 6px;
            height: 18px;
            Text {
                horizontal-stretch: 1;
                text: root.item.kind;
                font-size: 12px;
                color: root.fg2;
                overflow: elide;
                vertical-alignment: center;
            }
            DelayBadge { delay: root.item.delay; idle: root.fg2; test => { root.test(); } }
        }
    }
}

// A group's cards in rows of `columns`.
component NodeGrid inherits Rectangle {
    in property <[NodeItem]> nodes;
    in property <int> columns: 2;
    in property <length> card-height;
    in property <int> size;
    callback select(string);
    callback test(string);
    property <length> gap: 8px;
    property <length> cell-w: (self.width - (columns - 1) * gap) / columns;
    height: max(0px, ceil(nodes.length / columns) * (card-height + gap) - gap);
    for n[i] in root.nodes: NodeCard {
        x: mod(i, root.columns) * (root.cell-w + root.gap);
        y: floor(i / root.columns) * (root.card-height + root.gap);
        width: root.cell-w;
        height: root.card-height;
        item: n;
        size: root.size;
        clicked => { root.select(n.name); }
        test => { root.test(n.name); }
    }
}

// The list style's group header (`ListHeader`): icon, name and its pick, then the
// locate and test buttons while unfolded or the type while folded, and the fold toggle.
component GroupHeader inherits Card {
    in property <ProxyGroup> group;
    // 0 filled, 1 plain, 2 hidden.
    in property <int> icon;
    callback toggle();
    callback test();
    callback locate();
    height: 64px;
    border-radius: 16px;
    ta := TouchArea { clicked => { root.toggle(); } }
    HorizontalLayout {
        padding-left: root.icon == 2 ? 14px : 10px;
        padding-right: 6px;
        spacing: 10px;
        if root.icon == 0: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 42px;
                height: 42px;
                border-radius: 10px;
                background: Theme.s.block;
                Text { text: root.group.monogram; font-size: 18px; font-weight: 600; color: Theme.s.on-surface-variant; }
            }
        }
        if root.icon == 1: VerticalLayout {
            alignment: center;
            Text { text: root.group.monogram; width: 28px; font-size: 22px; font-weight: 700; color: Theme.s.primary; horizontal-alignment: center; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.group.name; font-size: 16px; font-weight: 600; color: Theme.s.on-surface; overflow: elide; }
            if root.group.now != "": Text { text: root.group.now; font-size: 12px; color: Theme.s.on-surface-variant; overflow: elide; }
        }
        if root.group.expanded: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 84px;
                height: 36px;
                border-radius: 18px;
                background: Theme.s.block;
                HorizontalLayout {
                    IconButton { width: 42px; height: 36px; glyph: Icons.locate; clicked => { root.locate(); } }
                    IconButton {
                        width: 42px;
                        height: 36px;
                        glyph: root.group.testing ? Icons.clock : Icons.bolt;
                        enabled: !root.group.testing;
                        clicked => { root.test(); }
                    }
                }
            }
        }
        if !root.group.expanded: Text { text: root.group.kind; font-size: 12px; color: Theme.s.on-surface-variant; vertical-alignment: center; }
        VerticalLayout {
            alignment: center;
            IconButton { glyph: root.group.expanded ? Icons.fold : Icons.unfold; clicked => { root.toggle(); } }
        }
    }
}

component Proxies inherits Rectangle {
    in property <[ProxyGroup]> groups;
    in property <ProxyStyle> style;
    in-out property <string> current-group;
    in property <bool> testing;
    in property <string> hint;
    in-out property <bool> searching;
    in-out property <string> query;
    // `getProxiesColumns` and the card heights of `getItemHeight`.
    out property <int> columns: max(ceil((self.width - 32px) / 250px), 2) + (style.layout == 0 ? 1 : style.layout == 2 ? -1 : 0);
    out property <length> card-height: style.card == 0 ? 58px : style.card == 2 ? 94px : 76px;
    callback open-group(string);
    callback select-node(string, string);
    callback test-group(string);
    callback test-node(string, string);
    callback toggle-group(string);
    callback search(string);
    callback open-options();
    callback locate(string) -> length;

    changed query => { root.search(root.query); }

    function go-to(group: string) {
        flick.content-y = -min(max(0px, root.locate(group) - 8px), max(0px, flick.content-height - flick.height));
    }

    VerticalLayout {
        if !root.searching: AppBar {
            title: "代理";
            VerticalLayout { alignment: center; IconButton { glyph: Icons.search; tint: Theme.s.on-surface; clicked => { root.searching = true; } } }
            if root.style.kind == 0 && root.groups.length > 0: VerticalLayout {
                alignment: center;
                IconButton { glyph: Icons.locate; tint: Theme.s.on-surface; clicked => { root.go-to(root.current-group); } }
            }
            VerticalLayout { alignment: center; IconButton { glyph: Icons.more; tint: Theme.s.on-surface; clicked => { root.open-options(); } } }
        }
        if root.searching: HorizontalLayout {
            height: 56px;
            padding-left: 4px;
            padding-right: 12px;
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                IconButton { glyph: Icons.back; tint: Theme.s.on-surface; clicked => { root.query = ""; root.searching = false; } }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Rectangle {
                    height: 44px;
                    border-radius: 22px;
                    background: Theme.s.block;
                    Text {
                        x: 16px;
                        visible: search-input.text == "";
                        text: "搜索";
                        color: Theme.s.on-surface-variant;
                        font-size: 15px;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    search-input := TextInput {
                        x: 16px;
                        width: parent.width - 32px;
                        height: parent.height;
                        vertical-alignment: center;
                        single-line: true;
                        font-size: 15px;
                        color: Theme.s.on-surface;
                        text <=> root.query;
                        init => { self.focus(); }
                    }
                }
            }
            if root.style.kind == 0 && root.groups.length > 0: VerticalLayout {
                alignment: center;
                IconButton { glyph: root.testing ? Icons.clock : Icons.bolt; enabled: !root.testing; tint: Theme.s.on-surface; clicked => { root.test-group(root.current-group); } }
            }
        }

        // Group tabs, FlClash's scrollable tab bar.
        if root.style.kind == 0 && root.groups.length > 0: Rectangle {
            height: 44px;
            Flickable {
                content-width: max(tabs.preferred-width, self.width);
                tabs := HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    for g in root.groups: Rectangle {
                        property <bool> active: g.name == root.current-group;
                        width: label.preferred-width + 24px;
                        label := Text {
                            text: g.name;
                            font-size: 14px;
                            font-weight: parent.active ? 600 : 400;
                            color: parent.active ? Theme.s.primary : Theme.s.on-surface-variant;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            y: parent.height - 3px;
                            width: label.preferred-width;
                            height: 3px;
                            border-radius: 1.5px;
                            background: parent.active ? Theme.s.primary : transparent;
                        }
                        TouchArea {
                            clicked => {
                                root.current-group = g.name;
                                flick.content-y = 0;
                                root.open-group(g.name);
                            }
                        }
                    }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.s.outline-variant; }
        }

        Rectangle {
            flick := Flickable {
                content-height: max(content.preferred-height, self.height);
                content := VerticalLayout {
                    alignment: start;
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 8px;
                    padding-bottom: root.style.kind == 0 ? 96px : 24px;
                    spacing: 10px;
                    if root.style.kind == 1: VerticalLayout {
                        spacing: 10px;
                        for g in root.groups: VerticalLayout {
                            spacing: 8px;
                            GroupHeader {
                                group: g;
                                icon: root.style.icon;
                                toggle => { root.toggle-group(g.name); }
                                test => { root.test-group(g.name); }
                                locate => { root.go-to(g.name); }
                            }
                            if g.expanded: NodeGrid {
                                nodes: g.nodes;
                                columns: root.columns;
                                card-height: root.card-height;
                                size: root.style.card;
                                select(n) => { root.select-node(g.name, n); }
                                test(n) => { root.test-node(g.name, n); }
                            }
                        }
                    }
                    if root.style.kind == 0: VerticalLayout {
                        for g in root.groups: VerticalLayout {
                            if g.name == root.current-group: NodeGrid {
                                nodes: g.nodes;
                                columns: root.columns;
                                card-height: root.card-height;
                                size: root.style.card;
                                select(n) => { root.select-node(g.name, n); }
                                test(n) => { root.test-node(g.name, n); }
                            }
                        }
                    }
                }
            }
            if root.groups.length == 0: Empty { text: root.searching && root.query != "" ? "没有匹配的代理" : root.hint; }
        }
    }

    if root.style.kind == 0 && root.groups.length > 0 && !root.searching: Fab {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        glyph: Icons.bolt;
        enabled: !root.testing;
        label: root.testing ? "测试中…" : "";
        clicked => { root.test-group(root.current-group); }
    }
}

// One option of the proxies menu: its name, then its choices as chips.
component OptionRow inherits VerticalLayout {
    in property <string> label;
    in property <[string]> options;
    in property <int> value;
    callback picked(int);
    padding-left: 20px;
    padding-right: 20px;
    spacing: 8px;
    Text { text: root.label; font-size: 13px; color: Theme.s.on-surface-variant; }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        for o[i] in root.options: Rectangle {
            height: 34px;
            width: chip.preferred-width + 28px;
            border-radius: 17px;
            background: i == root.value ? Theme.s.primary-container : Theme.s.block;
            chip := Text {
                text: o;
                font-size: 14px;
                color: i == root.value ? Theme.s.on-primary-container : Theme.s.on-surface;
            }
            TouchArea { clicked => { root.picked(i); } }
        }
    }
}

// ---------------------------------------------------------------- Profiles

// FlClash's ProfileItem: title with the expiry chip, the usage or the type below, the last
// update and the selection badge on the right; the more
// button opens its menu.
component ProfileCard inherits Card {
    in property <ProfileItem> item;
    callback select();
    callback menu();
    selected: item.active;
    height: 72px;
    property <color> fg: item.active ? Theme.s.on-primary-container : Theme.s.on-surface;
    property <color> fg2: item.active ? Theme.s.on-primary-container : Theme.s.on-surface-variant;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 4px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.item.name;
                    font-size: 17px;
                    color: root.fg;
                    overflow: elide;
                    horizontal-stretch: 1;
                    max-width: self.preferred-width;
                }
                if root.item.expire != "": Rectangle {
                    width: chip.preferred-width + 16px;
                    height: 20px;
                    border-radius: 10px;
                    background: (root.item.expired ? Theme.s.error : Theme.s.primary).with-alpha(0.15);
                    chip := Text {
                        text: root.item.expire;
                        font-size: 11px;
                        font-weight: 600;
                        color: root.item.expired ? Theme.s.error : Theme.s.primary;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
                Rectangle { horizontal-stretch: 0.001; }
            }
            Text { text: root.item.subtitle; font-size: 13px; color: root.fg2; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.item.busy ? "更新中…" : root.item.trailing;
                font-size: 12px;
                color: root.fg2;
            }
        }
        if root.item.active: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: Theme.s.primary;
                Icon { glyph: Icons.check; size: 16px; tint: Theme.s.on-primary; }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                glyph: Icons.more;
                enabled: !root.item.busy;
                tint: root.fg2;
                clicked => { root.menu(); }
            }
        }
    }
    TouchArea {
        width: parent.width - 48px;
        x: 0;
        clicked => { root.select(); }
    }
}

component Profiles inherits Rectangle {
    in property <[ProfileItem]> profiles;
    in property <bool> adding;
    callback add();
    callback update-all();
    callback open-sort();
    callback select-profile(string);
    callback menu(ProfileItem);

    VerticalLayout {
        AppBar {
            title: "配置";
            if root.profiles.length > 0: VerticalLayout {
                alignment: center;
                IconButton { glyph: Icons.sync; tint: Theme.s.on-surface; clicked => { root.update-all(); } }
            }
            if root.profiles.length > 0: VerticalLayout {
                alignment: center;
                IconButton { glyph: Icons.sort; tint: Theme.s.on-surface; clicked => { root.open-sort(); } }
            }
        }
        if root.profiles.length == 0: Rectangle {
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text { text: "暂无配置"; font-size: 18px; color: Theme.s.on-surface; horizontal-alignment: center; }
                Text { text: "添加一个配置文件后即可开始使用"; font-size: 14px; color: Theme.s.on-surface-variant; horizontal-alignment: center; }
                HorizontalLayout {
                    alignment: center;
                    padding-top: 8px;
                    TextButton { text: "添加配置"; filled: true; clicked => { root.add(); } }
                }
            }
        }
        if root.profiles.length > 0: Flickable {
            content-height: list.preferred-height;
            list := VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 88px;
                spacing: 10px;
                for p in root.profiles: ProfileCard {
                    item: p;
                    select => { root.select-profile(p.id); }
                    menu => { root.menu(p); }
                }
            }
        }
    }

    if root.profiles.length > 0: Fab {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        glyph: Icons.plus;
        enabled: !root.adding;
        label: root.adding ? "加载中…" : "";
        clicked => { root.add(); }
    }
}

// An outlined text field with its label above, as FlClash's forms.
component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> multi;
    in property <bool> enabled: true;
    in property <InputType> input-type: InputType.text;
    in-out property <string> text <=> input.text;
    callback accepted();
    public function focus-input() { input.focus(); }
    spacing: 6px;
    if root.label != "": Text { text: root.label; font-size: 13px; color: Theme.s.on-surface-variant; }
    Rectangle {
        height: root.multi ? 160px : 50px;
        border-radius: 8px;
        border-width: input.has-focus ? 2px : 1px;
        border-color: input.has-focus ? Theme.s.primary : Theme.s.outline-variant;
        clip: true;
        Text {
            x: 14px;
            y: root.multi ? 12px : (parent.height - self.height) / 2;
            visible: input.text == "";
            text: root.placeholder;
            color: Theme.s.on-surface-variant;
            font-size: 15px;
        }
        input := TextInput {
            x: 14px;
            y: root.multi ? 12px : 0px;
            width: parent.width - 28px;
            height: root.multi ? parent.height - 24px : parent.height;
            vertical-alignment: root.multi ? top : center;
            single-line: !root.multi;
            wrap: root.multi ? word-wrap : no-wrap;
            input-type: root.input-type;
            font-size: 15px;
            color: Theme.s.on-surface;
            selection-background-color: Theme.s.primary-container;
            enabled: root.enabled;
            accepted => { root.accepted(); }
        }
    }
}


// EditProfileView: name, url, age key, auto update and its interval, and the profile file
// (edit or upload).
component EditProfilePage inherits Rectangle {
    in property <bool> is-url;
    in-out property <string> name;
    in-out property <string> url;
    in-out property <string> age;
    in-out property <bool> auto;
    in-out property <string> interval;
    in property <string> file-info;
    in property <bool> busy;
    callback save();
    callback back();
    callback edit-file();
    callback upload-file();
    background: Theme.s.page;
    VerticalLayout {
        AppBar {
            title: "编辑";
            can-back: true;
            back => { root.back(); }
            VerticalLayout {
                alignment: center;
                TextButton { text: root.busy ? "保存中…" : "保存"; enabled: !root.busy; clicked => { root.save(); } }
            }
        }
        Flickable {
            content-height: form.preferred-height;
            form := VerticalLayout {
                padding: 16px;
                spacing: 14px;
                Field { label: "名称"; placeholder: "必填"; text <=> root.name; }
                if root.is-url: Field { label: "URL"; placeholder: "必填"; text <=> root.url; }
                Field { label: "age 私钥"; placeholder: "可选"; text <=> root.age; }
                if root.is-url: HorizontalLayout {
                    height: 48px;
                    Text { text: "自动更新"; font-size: 16px; color: Theme.s.on-surface; vertical-alignment: center; horizontal-stretch: 1; }
                    VerticalLayout { alignment: center; Switch { checked <=> root.auto; } }
                }
                if root.is-url && root.auto: HorizontalLayout {
                    spacing: 8px;
                    Field { label: "自动更新间隔"; placeholder: "必填"; input-type: InputType.number; text <=> root.interval; }
                    VerticalLayout {
                        alignment: end;
                        Text { text: "分钟"; height: 50px; vertical-alignment: center; color: Theme.s.on-surface-variant; }
                    }
                }
                Card {
                    height: 64px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 4px;
                        spacing: 4px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text { text: "配置"; font-size: 16px; color: Theme.s.on-surface; }
                            Text { text: root.file-info; font-size: 13px; color: Theme.s.on-surface-variant; }
                        }
                        VerticalLayout { alignment: center; IconButton { glyph: Icons.edit; clicked => { root.edit-file(); } } }
                        VerticalLayout { alignment: center; IconButton { glyph: Icons.upload; clicked => { root.upload-file(); } } }
                    }
                }
            }
        }
    }
}

// EditorPage: the profile file to edit, or the runtime config to read.
component EditorPage inherits Rectangle {
    in property <string> title;
    in-out property <string> text;
    in property <bool> readonly;
    callback save(string);
    callback back();
    background: Theme.s.page;
    VerticalLayout {
        AppBar {
            title: root.title;
            can-back: true;
            back => { root.back(); }
            if !root.readonly: VerticalLayout {
                alignment: center;
                TextButton { text: "保存"; clicked => { root.save(editor.text); } }
            }
        }
        Rectangle {
            background: Theme.s.card;
            flick := Flickable {
                content-height: max(editor.preferred-height + 24px, self.height);
                content-width: self.width;
                editor := TextInput {
                    x: 12px;
                    y: 12px;
                    width: parent.width - 24px;
                    text <=> root.text;
                    read-only: root.readonly;
                    single-line: false;
                    wrap: word-wrap;
                    font-family: "monospace";
                    font-size: 13px;
                    color: Theme.s.on-surface;
                    selection-background-color: Theme.s.primary-container;
                }
            }
        }
    }
}

// ReorderableProfilesSheet: move each profile up or down, then save.
component SortPage inherits Rectangle {
    in property <[ProfileItem]> items;
    callback move(int, int);
    callback save();
    callback back();
    background: Theme.s.page;
    VerticalLayout {
        AppBar {
            title: "配置排序";
            can-back: true;
            back => { root.back(); }
            VerticalLayout {
                alignment: center;
                TextButton { text: "保存"; clicked => { root.save(); } }
            }
        }
        Flickable {
            content-height: col.preferred-height;
            col := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                for p[i] in root.items: Card {
                    height: 64px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 4px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text { text: p.name; font-size: 16px; color: Theme.s.on-surface; overflow: elide; }
                            Text { text: p.subtitle; font-size: 13px; color: Theme.s.on-surface-variant; overflow: elide; }
                        }
                        VerticalLayout { alignment: center; IconButton { glyph: Icons.up; enabled: i > 0; clicked => { root.move(i, -1); } } }
                        VerticalLayout { alignment: center; IconButton { glyph: Icons.down; enabled: i < root.items.length - 1; clicked => { root.move(i, 1); } } }
                    }
                }
            }
        }
    }
}

// A row of a popup menu (FlClash's PopupMenuItem).
component MenuRow inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> danger;
    in property <bool> sub;
    callback clicked();
    height: 48px;
    background: ta.pressed ? Theme.s.inset : transparent;
    HorizontalLayout {
        padding-left: root.sub ? 40px : 16px;
        padding-right: 16px;
        spacing: 14px;
        VerticalLayout { alignment: center; Icon { glyph: root.glyph; size: 20px; tint: root.danger ? Theme.s.error : Theme.s.on-surface-variant; } }
        Text { text: root.label; font-size: 15px; color: root.danger ? Theme.s.error : Theme.s.on-surface; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// A centered dialog card over a scrim.
component Dialog inherits Rectangle {
    in property <string> title;
    in property <length> keyboard;
    in property <length> top;
    in property <bool> dismissable: true;
    callback dismiss();
    background: #00000066;
    TouchArea { clicked => { if (root.dismissable) { root.dismiss(); } } }
    Rectangle {
        x: 24px;
        width: parent.width - 48px;
        height: body.preferred-height;
        y: max(root.top + 24px, (parent.height - root.keyboard - self.height) / 2);
        background: Theme.s.card;
        border-radius: 24px;
        TouchArea { }
        body := VerticalLayout {
            padding: 24px;
            padding-bottom: 16px;
            spacing: 16px;
            if root.title != "": Text { text: root.title; font-size: 22px; color: Theme.s.on-surface; wrap: word-wrap; }
            @children
        }
    }
}

// ---------------------------------------------------------------- Tools

component SetRowView inherits Rectangle {
    in property <SetRow> item;
    in property <bool> divider;
    callback clicked(string);
    callback toggled(string, bool);
    property <bool> leading: root.item.glyph != "" && root.item.kind != "value";
    height: root.item.subtitle != "" ? 64px : 52px;
    background: ta.pressed && root.item.kind != "person" ? Theme.s.inset : transparent;
    opacity: root.item.enabled ? 1 : 0.45;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        if root.leading && root.item.kind == "person": VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: Theme.s.primary-container;
                Text { text: root.item.glyph; font-size: 16px; font-weight: 600; color: Theme.s.on-primary-container; }
            }
        }
        if root.leading && root.item.kind == "link": VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                background: Theme.s.block;
                Icon { glyph: Glyphs.of(root.item.glyph); size: 20px; tint: Theme.s.on-surface-variant; }
            }
        }
        if root.leading && root.item.kind != "person" && root.item.kind != "link": VerticalLayout {
            alignment: center;
            Icon { glyph: Glyphs.of(root.item.glyph); tint: Theme.s.on-surface-variant; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.item.title; font-size: 16px; color: Theme.s.on-surface; overflow: elide; }
            if root.item.subtitle != "": Text { text: root.item.subtitle; font-size: 13px; color: Theme.s.on-surface-variant; overflow: elide; }
        }
        if root.item.kind == "toggle": VerticalLayout {
            alignment: center;
            Switch { checked: root.item.on; toggled(on) => { root.toggled(root.item.id, on); } }
        }
        if root.item.kind == "open" || root.item.kind == "value-icon": VerticalLayout {
            alignment: center;
            Icon { glyph: Icons.chevron; size: 20px; tint: Theme.s.on-surface-variant; }
        }
        if root.item.kind == "link": VerticalLayout {
            alignment: center;
            Icon { glyph: Icons.external; size: 20px; tint: Theme.s.on-surface-variant; }
        }
    }
    if root.divider: Rectangle {
        x: root.leading ? 54px : 16px;
        y: parent.height - 1px;
        width: parent.width - self.x;
        height: 1px;
        background: Theme.s.outline-variant.with-alpha(0.6);
    }
    ta := TouchArea {
        enabled: root.item.enabled && root.item.kind != "person";
        clicked => {
            if (root.item.kind == "toggle") {
                root.toggled(root.item.id, !root.item.on);
            } else {
                root.clicked(root.item.id);
            }
        }
    }
}

// `generateSection`s one under the other.
component Sections inherits VerticalLayout {
    in property <[SetSection]> sections;
    callback clicked(string);
    callback toggled(string, bool);
    padding-left: 16px;
    padding-right: 16px;
    spacing: 4px;
    for sec in root.sections: VerticalLayout {
        if sec.rows.length > 0 && sec.title != "": HorizontalLayout {
            padding-left: 14px;
            Text { text: sec.title; height: 36px; font-size: 13px; color: Theme.s.on-surface-variant; vertical-alignment: center; }
        }
        if sec.rows.length > 0 && sec.title == "": Rectangle { height: 8px; }
        if sec.rows.length > 0: Rectangle {
            background: Theme.s.card;
            border-radius: 16px;
            clip: true;
            VerticalLayout {
                for r[i] in sec.rows: SetRowView {
                    item: r;
                    divider: i < sec.rows.length - 1;
                    clicked(id) => { root.clicked(id); }
                    toggled(id, on) => { root.toggled(id, on); }
                }
            }
        }
        if sec.rows.length > 0 && sec.footer != "": HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 6px;
            Text { text: sec.footer; font-size: 12px; color: Theme.s.on-surface-variant; wrap: word-wrap; }
        }
    }
}

// A settings page: the bar, anything given as children, then the sections.
component SettingsPage inherits Rectangle {
    in property <string> title;
    in property <bool> can-back: true;
    in property <[SetSection]> sections;
    in property <length> bottom-gap: 24px;
    callback back();
    callback clicked(string);
    callback toggled(string, bool);
    VerticalLayout {
        AppBar { title: root.title; can-back: root.can-back; back => { root.back(); } }
        Flickable {
            content-height: page-col.preferred-height;
            page-col := VerticalLayout {
                alignment: start;
                padding-bottom: root.bottom-gap;
                @children
                Sections {
                    sections: root.sections;
                    clicked(id) => { root.clicked(id); }
                    toggled(id, on) => { root.toggled(id, on); }
                }
            }
        }
    }
}

// lib/views/about.dart: the logo (five taps turn on developer mode), name, version, the
// description and the update check, then the sections.
component AboutPage inherits Rectangle {
    in property <image> icon;
    in property <string> version;
    in property <bool> checking;
    in property <[SetSection]> sections;
    callback back();
    callback clicked(string);
    callback toggled(string, bool);
    callback check-update();
    callback logo-tapped();
    SettingsPage {
        title: "关于";
        sections: root.sections;
        back => { root.back(); }
        clicked(id) => { root.clicked(id); }
        toggled(id, on) => { root.toggled(id, on); }
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 24px;
            padding-bottom: 8px;
            spacing: 0px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 96px;
                    height: 96px;
                    border-radius: 24px;
                    background: Theme.s.primary-container;
                    Image { source: root.icon; width: 96px; height: 96px; }
                    TouchArea { clicked => { root.logo-tapped(); } }
                }
            }
            Rectangle { height: 20px; }
            Text { text: "SeasonCat"; font-size: 22px; font-weight: 700; color: Theme.s.on-surface; horizontal-alignment: center; }
            Rectangle { height: 10px; }
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Rectangle {
                    height: 24px;
                    width: vpill.preferred-width * 1.1 + 24px;
                    border-radius: 12px;
                    background: Theme.s.primary;
                    vpill := Text { text: root.version; font-size: 12px; font-weight: 600; color: Theme.s.on-primary; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    height: 24px;
                    width: lpill.preferred-width * 1.1 + 24px;
                    border-radius: 12px;
                    background: Theme.s.block;
                    lpill := Text { text: "GPL-3.0"; font-size: 12px; font-weight: 600; color: Theme.s.on-surface-variant; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            Rectangle { height: 16px; }
            Text {
                text: "基于 Concord 内核的多平台代理客户端，简单易用，开源无广告。";
                font-size: 15px;
                color: Theme.s.on-surface-variant;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Rectangle { height: 20px; }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    height: 44px;
                    width: ubtn.preferred-width + 40px;
                    border-radius: 22px;
                    background: uta.pressed ? Theme.s.primary-container.darker(0.08) : Theme.s.primary-container;
                    opacity: root.checking ? 0.5 : 1;
                    ubtn := HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        VerticalLayout { alignment: center; Icon { glyph: Icons.sync; size: 20px; tint: Theme.s.on-primary-container; } }
                        Text { text: "检查更新"; font-size: 15px; color: Theme.s.on-primary-container; vertical-alignment: center; }
                    }
                    uta := TouchArea { enabled: !root.checking; clicked => { root.check-update(); } }
                }
            }
        }
    }
}

// lib/views/disclaimer.dart, read from the tools page (no consent bar).
component DisclaimerPage inherits Rectangle {
    callback back();
    property <[{title: string, content: string}]> terms: [
        { title: "软件性质", content: "本软件是基于 Concord 内核的开源网络代理客户端，仅提供配置管理、规则分流与流量转发等本地工具功能。\n\n本软件自身不提供任何代理服务器、节点、订阅、机场或网络接入服务，也不与任何此类服务的提供者存在合作、代理或担保关系。" },
        { title: "使用说明", content: "任何人基于本软件开展的商业活动，包括付费分发、捆绑销售或作为商业服务的组成部分，均与本软件的开发者无关，开发者不为其提供背书、支持或担保。\n\n你须自行遵守所在国家或地区的法律法规，因违法使用本软件产生的后果由你自行承担。" },
        { title: "用户责任", content: "你应自行确认使用本软件在你所在国家或地区是合法的，并对使用本软件的全部行为及其后果独立承担法律责任。\n\n你导入的订阅、节点与配置由你自行选择和判断，其来源是否合法、内容是否安全、服务是否稳定，均由你与相关提供者自行负责。" },
        { title: "第三方内容", content: "订阅链接、配置文件、规则集、脚本、外部资源及外部链接均由第三方提供，开发者无法也不会对其合法性、准确性、安全性和可用性进行审查或担保。\n\n因使用第三方内容导致的数据泄露、财产损失、账号封禁或其他任何损失，由你与第三方自行解决，开发者不承担任何责任。" },
        { title: "无担保声明", content: "本软件按“现状”和“可用”的原则提供，不附带任何明示或默示的担保，包括但不限于适销性、特定用途适用性、不侵权以及持续可用、无错误、无安全漏洞的担保。\n\n开发者不保证本软件能满足你的需求，也不保证本软件的运行不会中断或不会出现错误。" },
        { title: "责任限制", content: "在适用法律允许的最大范围内，开发者及所有贡献者均不对因使用或无法使用本软件而产生的任何直接、间接、偶然、特殊、惩罚性或后果性损害承担责任，包括但不限于数据丢失、设备损坏、网络异常、业务中断、利润损失或因此引起的任何法律纠纷，即使已被告知发生此类损害的可能性。" },
        { title: "数据收集与隐私", content: "本软件不会收集或上传你的订阅地址、节点信息、配置内容、访问的网站、连接记录、流量内容和日志，这些数据仅保存在你的设备本地，开发者无法获取。\n\n本软件只会在你使用相应功能时访问外部网络，例如更新订阅时访问你提供的订阅地址、检查更新时访问 GitHub。\n\n本软件在所有平台上均未集成任何数据统计或崩溃上报服务。" },
        { title: "开源协议", content: "本软件以 GPL-3.0 协议开源，你可以依该协议运行、研究、修改和分发本软件；分发本软件或其修改版本时，须同样以 GPL-3.0 协议提供源代码并保留原有的版权声明。\n\n本软件包含的第三方组件（包括 Concord 内核）分别遵循其各自的开源协议。基于本软件修改或分发的版本所产生的任何问题，与原作者无关。" },
        { title: "声明变更", content: "本声明可能随版本更新而修订，以每个版本附带的内容为准。" },
        { title: "与开源协议的关系", content: "本声明是对软件性质、风险与责任的说明，不是 GPL-3.0 之外的附加条款，也不限制该协议授予你的运行、复制、修改和分发等任何权利；两者不一致时，以 GPL-3.0 为准。" },
    ];
    VerticalLayout {
        AppBar { title: "免责声明"; can-back: true; back => { root.back(); } }
        Flickable {
            content-height: dcol.preferred-height;
            dcol := VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: 32px;
                Rectangle {
                    background: Theme.s.card;
                    border-radius: 20px;
                    height: intro.preferred-height;
                    intro := HorizontalLayout {
                        padding: 20px;
                        spacing: 16px;
                        VerticalLayout { alignment: start; Icon { glyph: Icons.gavel; size: 28px; tint: Theme.s.primary; } }
                        Text {
                            horizontal-stretch: 1;
                            text: "在使用 FlClash（以下简称“本软件”）前，请仔细阅读并充分理解本声明。点击“同意”表示你已阅读并理解以下内容；如不想继续，可点击“退出”。";
                            font-size: 15px;
                            color: Theme.s.on-surface-variant;
                            wrap: word-wrap;
                        }
                    }
                }
                for t[i] in root.terms: VerticalLayout {
                    padding-top: 28px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: Theme.s.primary-container;
                            Text { text: i + 1; font-size: 13px; font-weight: 600; color: Theme.s.on-primary-container; }
                        }
                        Text { text: t.title; font-size: 17px; font-weight: 600; color: Theme.s.on-surface; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                    }
                    Text { text: t.content; font-size: 15px; color: Theme.s.on-surface-variant; wrap: word-wrap; }
                }
            }
        }
    }
}

component Tools inherits Rectangle {
    in property <[SetSection]> sections;
    callback open(string);
    SettingsPage {
        title: "工具";
        can-back: false;
        sections: root.sections;
        clicked(id) => { root.open(id); }
    }
}

component Logs inherits Rectangle {
    in property <[LogItem]> logs;
    callback clear-logs();
    callback back();
    VerticalLayout {
        AppBar {
            title: "日志";
            can-back: true;
            back => { root.back(); }
            VerticalLayout {
                alignment: center;
                TextButton { text: "清空"; clicked => { root.clear-logs(); } }
            }
        }
        if root.logs.length == 0: Empty { text: "暂无数据"; }
        if root.logs.length > 0: Flickable {
            content-height: list.preferred-height;
            list := VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 16px;
                spacing: 8px;
                for l in root.logs: Card {
                    height: col.preferred-height;
                    col := VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: l.level;
                                font-size: 11px;
                                color: l.level == "error" ? Theme.s.error : l.level == "warning" ? Theme.warning : l.level == "info" ? Theme.s.primary : Theme.s.on-surface-variant;
                            }
                            Text { text: l.time; font-size: 11px; color: Theme.s.on-surface-variant; }
                            Rectangle { }
                        }
                        Text { text: l.text; font-size: 13px; color: Theme.s.on-surface; wrap: word-wrap; }
                    }
                }
            }
        }
    }
}

component ThemePage inherits Rectangle {
    in property <[color]> accents;
    in property <int> accent;
    in property <int> theme-mode;
    in property <bool> pure-black;
    callback set-accent(int);
    callback set-theme-mode(int);
    callback set-pure-black(bool);
    callback back();
    VerticalLayout {
        AppBar { title: "主题"; can-back: true; back => { root.back(); } }
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 12px;
            alignment: start;
            InfoCard {
                title: "主题模式";
                glyph: Icons.palette;
                VerticalLayout {
                    spacing: 2px;
                    RadioRow { text: "跟随系统"; checked: root.theme-mode == 0; clicked => { root.set-theme-mode(0); } }
                    RadioRow { text: "浅色"; checked: root.theme-mode == 1; clicked => { root.set-theme-mode(1); } }
                    RadioRow { text: "深色"; checked: root.theme-mode == 2; clicked => { root.set-theme-mode(2); } }
                }
            }
            InfoCard {
                title: "纯黑模式";
                glyph: Icons.palette;
                VerticalLayout {
                    spacing: 2px;
                    RadioRow { text: "标准"; checked: !root.pure-black; clicked => { root.set-pure-black(false); } }
                    RadioRow { text: "纯黑"; checked: root.pure-black; clicked => { root.set-pure-black(true); } }
                }
            }
            InfoCard {
                title: "主题色彩";
                glyph: Icons.palette;
                HorizontalLayout {
                    height: 40px;
                    alignment: space-between;
                    for c[i] in root.accents: Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: c;
                        Rectangle {
                            visible: i == root.accent;
                            width: 14px;
                            height: 14px;
                            border-radius: 7px;
                            background: white;
                        }
                        TouchArea { clicked => { root.set-accent(i); } }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------- Requests

// `ConnectedButtonBar`: one button per choice, joined.
component SegmentBar inherits HorizontalLayout {
    in property <[string]> items;
    in property <int> value;
    in property <length> bar-height: 40px;
    callback picked(int);
    spacing: 2px;
    for label[i] in root.items: Rectangle {
        height: root.bar-height;
        horizontal-stretch: 1;
        min-width: seg-text.preferred-width * 1.15 + 24px;
        border-top-left-radius: i == 0 ? self.height / 2 : 6px;
        border-bottom-left-radius: i == 0 ? self.height / 2 : 6px;
        border-top-right-radius: i == root.items.length - 1 ? self.height / 2 : 6px;
        border-bottom-right-radius: i == root.items.length - 1 ? self.height / 2 : 6px;
        background: i == root.value ? Theme.s.primary : (seg-ta.pressed ? Theme.s.inset : Theme.s.block);
        seg-text := Text {
            text: label;
            font-size: 14px;
            font-weight: i == root.value ? 600 : 400;
            color: i == root.value ? Theme.s.on-primary : Theme.s.on-surface;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        seg-ta := TouchArea { clicked => { root.picked(i); } }
    }
}

// `SegmentedControl` (compact): a tray with the chosen segment raised.
component StatusBar inherits Rectangle {
    in property <[string]> items;
    in property <int> value;
    callback picked(int);
    height: 32px;
    Flickable {
        content-width: max(tray.preferred-width, 0px);
        interactive: tray.preferred-width > self.width;
        tray := Rectangle {
            width: row.preferred-width;
            height: 32px;
            border-radius: 16px;
            background: Theme.s.block;
            row := HorizontalLayout {
                padding: 2px;
                for label[i] in root.items: Rectangle {
                    width: status-text.preferred-width * 1.12 + 24px;
                    border-radius: 14px;
                    background: i == root.value ? Theme.s.card : transparent;
                    status-text := Text {
                        text: label;
                        font-size: 13px;
                        font-weight: i == root.value ? 600 : 400;
                        color: i == root.value ? Theme.s.on-surface : Theme.s.on-surface-variant;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.picked(i); } }
                }
            }
        }
    }
}

// The conditions set (`ConditionBlock`): a field's line of chips, then clear all.
component ConditionBlock inherits Rectangle {
    in property <[ConditionLine]> lines;
    callback edit(int);
    callback remove(int);
    callback clear();
    background: Theme.s.block;
    border-radius: 14px;
    height: col.preferred-height;
    col := VerticalLayout {
        padding-left: 16px;
        padding-right: 8px;
        padding-top: 4px;
        for line[li] in root.lines: VerticalLayout {
            HorizontalLayout {
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 8px;
                Text {
                    text: line.label;
                    width: 64px;
                    font-size: 13px;
                    color: Theme.s.on-surface-variant;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Flickable {
                    height: 32px;
                    content-width: chips.preferred-width;
                    interactive: chips.preferred-width > self.width;
                    chips := HorizontalLayout {
                        spacing: 6px;
                        for item[ii] in line.items: HorizontalLayout {
                            spacing: 6px;
                            if ii > 0: Text { text: "或"; font-size: 12px; color: Theme.s.on-surface-variant; vertical-alignment: center; }
                            Rectangle {
                                height: 32px;
                                width: chip-row.preferred-width;
                                border-radius: 16px;
                                background: Theme.s.card;
                                chip-row := HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 4px;
                                    spacing: 2px;
                                    Text { text: item.text; font-size: 13px; color: Theme.s.on-surface; vertical-alignment: center; }
                                    Rectangle {
                                        width: 24px;
                                        Icon { glyph: Icons.close; size: 14px; tint: Theme.s.on-surface-variant; }
                                        TouchArea { clicked => { root.remove(item.index); } }
                                    }
                                }
                                TouchArea {
                                    width: parent.width - 28px;
                                    x: 0;
                                    clicked => { root.edit(item.index); }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.s.outline-variant.with-alpha(0.6); }
        }
        HorizontalLayout {
            height: 40px;
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: "同一行满足其一，各行都要满足";
                font-size: 12px;
                color: Theme.s.on-surface-variant;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle {
                width: clear-text.preferred-width * 1.1 + 16px;
                clear-text := Text { text: "清除全部"; font-size: 13px; color: Theme.s.primary; vertical-alignment: center; }
                TouchArea { clicked => { root.clear(); } }
            }
        }
    }
}

// `TrackerAppWell` without the app's icon (its name's first letter), or `LabelWell`.
component Well inherits Rectangle {
    in property <string> text;
    in property <bool> label;
    in property <length> size: 40px;
    width: size;
    height: size;
    border-radius: size * 0.28;
    background: label ? Theme.s.block : Theme.s.primary-container;
    Text {
        text: root.text;
        font-size: root.label ? (root.text.character-count > 3 ? root.size * 0.26 : root.size * 0.32) : root.size * 0.42;
        font-weight: 600;
        color: root.label ? Theme.s.on-surface-variant : Theme.s.on-primary-container;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A row of a requests list; a long press or a right click opens its menu.
component RecordRowView inherits Rectangle {
    in property <RecordRow> rec;
    in property <bool> marks;
    callback select(int);
    callback menu(int);
    property <bool> fired;
    property <color> muted: Theme.s.on-surface-variant;
    height: root.rec.header ? 40px : 64px;
    if root.rec.header: HorizontalLayout {
        padding-left: 28px;
        padding-right: 16px;
        padding-top: 14px;
        spacing: 8px;
        Text { text: root.rec.label; font-size: 13px; font-weight: 600; color: root.muted; vertical-alignment: center; }
        Text { text: root.rec.count; font-size: 13px; color: root.muted; vertical-alignment: center; horizontal-stretch: 1; }
    }
    if !root.rec.header: Rectangle {
        x: 16px;
        width: parent.width - 32px;
        background: (root.rec.selected && root.marks) || ta.pressed ? Theme.s.block : Theme.s.card;
        border-top-left-radius: root.rec.first ? 16px : 0;
        border-top-right-radius: root.rec.first ? 16px : 0;
        border-bottom-left-radius: root.rec.last ? 16px : 0;
        border-bottom-right-radius: root.rec.last ? 16px : 0;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 14px;
            spacing: 12px;
            VerticalLayout { alignment: center; Well { text: root.rec.well; label: root.rec.well-label; } }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                horizontal-stretch: 1;
                Text { text: root.rec.title; font-size: 15px; color: Theme.s.on-surface; overflow: elide; }
                HorizontalLayout {
                    spacing: 4px;
                    about := Text {
                        text: root.rec.about;
                        font-size: 12px;
                        color: root.rec.about-error ? Theme.s.error : root.muted;
                        overflow: elide;
                        horizontal-stretch: 1;
                        max-width: self.preferred-width;
                        vertical-alignment: center;
                    }
                    if root.rec.chip != "": Chip { text: root.rec.chip; height: 18px; }
                    if root.rec.mitm: Chip { text: "MITM"; height: 18px; }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                top := Text {
                    text: root.rec.top;
                    min-width: self.preferred-width * 1.12;
                    font-size: 13px;
                    font-weight: root.rec.top-strong ? 600 : 400;
                    horizontal-alignment: right;
                    color: root.rec.top-tone == 1 ? Theme.s.error : root.rec.top-tone == 2 ? Theme.success : root.rec.top-tone == 3 ? Theme.warning : root.rec.top-tone == 4 ? root.muted : Theme.s.on-surface;
                }
                if root.rec.bottom != "": Text {
                    text: root.rec.bottom;
                    min-width: self.preferred-width * 1.12;
                    font-size: 11px;
                    color: root.muted;
                    horizontal-alignment: right;
                }
            }
        }
        if !root.rec.last: Rectangle {
            x: 64px;
            y: parent.height - 1px;
            width: parent.width - 64px;
            height: 1px;
            background: Theme.s.outline-variant.with-alpha(0.6);
        }
        if root.rec.selected && root.marks: Rectangle {
            x: 0;
            width: 3px;
            height: 16px;
            border-radius: 1.5px;
            background: Theme.s.primary;
        }
        ta := TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    if (e.button == PointerEventButton.right) {
                        root.fired = true;
                        root.menu(root.rec.id);
                    } else {
                        root.fired = false;
                        hold.running = true;
                    }
                } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                    hold.running = false;
                }
            }
            moved => {
                if (abs(self.mouse-x - self.pressed-x) > 8px || abs(self.mouse-y - self.pressed-y) > 8px) {
                    hold.running = false;
                }
            }
            clicked => {
                if (!root.fired) { root.select(root.rec.id); }
            }
        }
        hold := Timer {
            interval: 450ms;
            running: false;
            triggered => {
                self.running = false;
                root.fired = true;
                root.menu(root.rec.id);
            }
        }
    }
}

// `NullStatus`: what an empty list or pane says.
component NullStatus inherits Rectangle {
    in property <string> label;
    in property <string> description;
    VerticalLayout {
        alignment: center;
        spacing: 6px;
        padding-left: 32px;
        padding-right: 32px;
        Text { text: root.label; font-size: 16px; font-weight: 600; color: Theme.s.on-surface; horizontal-alignment: center; wrap: word-wrap; }
        if root.description != "": Text { text: root.description; font-size: 13px; color: Theme.s.on-surface-variant; horizontal-alignment: center; wrap: word-wrap; }
    }
}

component DetailRowView inherits Rectangle {
    in property <DetailRow> item;
    in property <bool> divider;
    callback tapped(string);
    property <color> muted: Theme.s.on-surface-variant;
    property <color> toned: root.item.tone == 1 ? Theme.s.error : root.item.tone == 2 ? Theme.success : root.item.tone == 3 ? Theme.warning : muted;
    property <bool> opens: root.item.kind == "link" || (root.item.arg != "" && root.item.kind != "traffic");
    height: body.preferred-height;
    background: ta.pressed && opens ? Theme.s.inset : transparent;
    ta := TouchArea {
        enabled: root.opens;
        clicked => { root.tapped(root.item.arg); }
    }
    body := VerticalLayout {
        if root.item.kind == "text": HorizontalLayout {
            height: 48px;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 12px;
            Text { text: root.item.title; font-size: 15px; color: Theme.s.on-surface; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; min-width: min(self.preferred-width, 72px); }
            if root.item.value != "": Text {
                text: root.item.value;
                font-size: 15px;
                color: root.item.tone == 0 ? root.muted : root.toned;
                vertical-alignment: center;
                horizontal-alignment: right;
                overflow: elide;
                max-width: self.preferred-width * 1.08;
                horizontal-stretch: 2;
            }
        }
        if root.item.kind == "stacked": HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 12px;
            if root.item.tone == 1: VerticalLayout { alignment: start; Icon { glyph: Icons.error; size: 20px; tint: Theme.s.error; } }
            VerticalLayout {
                spacing: 2px;
                Text { text: root.item.title; font-size: 15px; color: Theme.s.on-surface; wrap: word-wrap; }
                Text { text: root.item.value; font-size: 13px; color: root.muted; wrap: word-wrap; overflow: elide; max-height: 54px; }
            }
        }
        if root.item.kind == "rail" || root.item.kind == "link": HorizontalLayout {
            height: root.item.note == "" ? 48px : 58px;
            padding-left: root.item.kind == "rail" ? 0 : 16px;
            padding-right: 16px;
            spacing: 4px;
            if root.item.kind == "rail": Rectangle {
                width: 44px;
                property <length> cy: root.item.note == "" ? self.height / 2 : self.height / 2 - 9px;
                if !root.item.first: Rectangle { x: (parent.width - 1.5px) / 2; y: 0; width: 1.5px; height: max(0px, parent.cy - 8px); background: Theme.s.outline-variant; }
                if !root.item.last: Rectangle { x: (parent.width - 1.5px) / 2; y: parent.cy + 8px; width: 1.5px; height: max(0px, parent.height - parent.cy - 8px); background: Theme.s.outline-variant; }
                Rectangle {
                    x: (parent.width - 10px) / 2;
                    y: parent.cy - 5px;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    border-width: root.item.mark == 0 ? 1.7px : 0;
                    border-color: Theme.s.on-surface-variant;
                    background: root.item.mark == 1 ? Theme.s.primary : root.item.mark == 2 ? Theme.s.error : transparent;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text { text: root.item.title; font-size: 15px; font-weight: root.item.mark == 1 && root.item.kind == "rail" ? 600 : 400; color: Theme.s.on-surface; overflow: elide; }
                if root.item.note != "": Text { text: root.item.note; font-size: 12px; color: root.item.kind == "link" && root.item.tone == 1 ? Theme.s.error : root.muted; overflow: elide; }
            }
            if root.item.trailing != "": Text {
                text: root.item.trailing;
                min-width: self.preferred-width * 1.1;
                font-size: 13px;
                color: root.item.kind == "link" ? root.toned : root.muted;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            if root.item.kind == "link": VerticalLayout { alignment: center; Icon { glyph: Icons.chevron; size: 18px; tint: root.muted; } }
        }
        if root.item.kind == "code": HorizontalLayout {
            padding: 12px;
            Text { text: root.item.value; font-size: 12px; color: Theme.s.on-surface; wrap: word-wrap; }
        }
        if root.item.kind == "traffic": HorizontalLayout {
            spacing: 8px;
            for cell[ci] in [{ glyph: Icons.down, label: "下载", figure: root.item.title, speed: root.item.note }, { glyph: Icons.up, label: "上传", figure: root.item.value, speed: root.item.trailing }]: Rectangle {
                horizontal-stretch: 1;
                border-radius: 14px;
                background: Theme.s.block;
                height: cell-col.preferred-height;
                cell-col := VerticalLayout {
                    padding: 12px;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 4px;
                        Icon { glyph: cell.glyph; size: 16px; tint: Theme.s.primary; }
                        Text { text: cell.label; font-size: 13px; color: root.muted; vertical-alignment: center; }
                    }
                    Text { text: cell.figure; font-size: 20px; font-weight: 700; color: Theme.s.on-surface; min-width: self.preferred-width * 1.1; }
                    if cell.speed != "": Text { text: cell.speed + "/s"; font-size: 12px; color: root.muted; }
                }
            }
        }
        if root.divider: Rectangle { height: 1px; background: Theme.s.outline-variant.with-alpha(0.6); }
    }
}

// A record's detail: its head, its tabs (`DetailTabs`) and the sections of the tab shown.
component DetailView inherits Rectangle {
    in property <ReqDetail> detail;
    in property <bool> stretch-tabs;
    in property <bool> head-menu;
    in property <length> top-gap: 20px;
    in property <length> bottom-gap;
    callback tab(int);
    callback close();
    callback menu();
    callback open-row(string);
    if !root.detail.has: NullStatus { label: root.detail.empty; description: root.detail.hint; }
    if root.detail.has: VerticalLayout {
        padding-top: root.top-gap;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 8px;
            padding-bottom: root.detail.tabs.length > 1 ? 12px : 8px;
            spacing: 12px;
            if root.detail.well != "": VerticalLayout { alignment: center; Well { text: root.detail.well; label: root.detail.well-label; size: 48px; } }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text { text: root.detail.title; font-size: 17px; font-weight: 600; color: Theme.s.on-surface; overflow: elide; }
                if root.detail.subtitle != "": Text { text: root.detail.subtitle; font-size: 13px; color: root.detail.subtitle-error ? Theme.s.error : Theme.s.on-surface-variant; overflow: elide; }
            }
            if root.detail.closable: VerticalLayout { alignment: center; IconButton { glyph: Icons.block; tint: Theme.s.error; clicked => { root.close(); } } }
            if root.head-menu && root.detail.menu: VerticalLayout { alignment: center; IconButton { glyph: Icons.more; clicked => { root.menu(); } } }
        }
        if root.detail.tabs.length > 1: HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            alignment: root.stretch-tabs ? stretch : start;
            SegmentBar {
                items: root.detail.tabs;
                value: root.detail.tab;
                bar-height: 36px;
                picked(i) => { root.tab(i); }
            }
        }
        if root.detail.loading || root.detail.sections.length == 0: NullStatus {
            vertical-stretch: 1;
            label: root.detail.loading ? "" : root.detail.empty;
        }
        if !root.detail.loading && root.detail.sections.length > 0: Flickable {
            vertical-stretch: 1;
            content-height: max(secs.preferred-height, self.height);
            secs := VerticalLayout {
                alignment: start;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 4px;
                padding-bottom: 16px + root.bottom-gap;
                for sec in root.detail.sections: VerticalLayout {
                    if sec.title != "": HorizontalLayout {
                        padding-left: 14px;
                        Text { text: sec.title; height: 40px; font-size: 13px; color: Theme.s.on-surface-variant; vertical-alignment: bottom; }
                    }
                    if sec.title != "": Rectangle { height: 6px; }
                    if sec.title == "": Rectangle { height: 12px; }
                    if sec.plain: VerticalLayout {
                        for r in sec.rows: DetailRowView { item: r; tapped(a) => { root.open-row(a); } }
                    }
                    if !sec.plain && sec.rows.length > 0: Rectangle {
                        background: Theme.s.block;
                        border-radius: 14px;
                        clip: true;
                        VerticalLayout {
                            for r[ri] in sec.rows: DetailRowView {
                                item: r;
                                divider: ri < sec.rows.length - 1 && r.kind != "rail";
                                tapped(a) => { root.open-row(a); }
                            }
                        }
                    }
                }
            }
        }
    }
}

// The page's head: the segments, then the filter row and the conditions.
component ReqHeader inherits VerticalLayout {
    in property <int> segment;
    in property <bool> shows-http;
    in property <[string]> statuses;
    in property <int> status;
    in property <[ConditionLine]> conditions;
    callback set-segment(int);
    callback set-status(int);
    callback add-condition();
    callback edit-condition(int);
    callback remove-condition(int);
    callback clear-conditions();
    padding-top: 4px;
    padding-bottom: 4px;
    spacing: 12px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        SegmentBar {
            items: root.shows-http ? ["连接", "HTTP", "DNS"] : ["连接", "DNS"];
            value: root.segment == 2 ? (root.shows-http ? 2 : 1) : root.segment;
            picked(i) => { root.set-segment(!root.shows-http && i == 1 ? 2 : i); }
        }
    }
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            StatusBar {
                horizontal-stretch: 1;
                items: root.statuses;
                value: root.status;
                picked(i) => { root.set-status(i); }
            }
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: add-ta.pressed ? Theme.s.inset : Theme.s.block;
                Icon { glyph: Icons.plus; size: 18px; tint: Theme.s.on-surface; }
                add-ta := TouchArea { clicked => { root.add-condition(); } }
            }
        }
        if root.conditions.length > 0: ConditionBlock {
            lines: root.conditions;
            edit(i) => { root.edit-condition(i); }
            remove(i) => { root.remove-condition(i); }
            clear => { root.clear-conditions(); }
        }
    }
}

component ReqList inherits Rectangle {
    in property <[RecordRow]> rows;
    in property <bool> marks;
    in property <string> empty;
    in property <string> empty-desc;
    in property <length> bottom-gap;
    callback select(int);
    callback menu(int);
    if root.rows.length == 0: NullStatus { label: root.empty; description: root.empty-desc; }
    if root.rows.length > 0: ListView {
        for r in root.rows: RecordRowView {
            rec: r;
            marks: root.marks;
            select(id) => { root.select(id); }
            menu(id) => { root.menu(id); }
        }
    }
}

// lib/views/access.dart: the installed apps with a checkbox each, a floating bar saying what
// the selection does, select all and save in the bar, the rest in the menu.
component AccessPage inherits Rectangle {
    in property <[AccessRow]> rows;
    in property <bool> enabled;
    in property <bool> changed;
    in property <bool> all-selected;
    in property <bool> can-select-all;
    in property <bool> loading;
    in property <bool> needs-permission;
    in property <bool> authorize;
    in property <string> status;
    in property <string> count;
    in property <length> bottom-gap;
    in-out property <bool> searching;
    in-out property <string> query;
    callback back();
    callback toggle(string);
    callback select-all();
    callback save();
    callback menu();
    callback enable();
    callback grant();
    callback search(string);
    changed query => { root.search(root.query); }
    VerticalLayout {
        if !root.searching: AppBar {
            title: "应用访问控制";
            can-back: true;
            back => { root.back(); }
            VerticalLayout { alignment: center; IconButton { glyph: Icons.search; tint: Theme.s.on-surface; clicked => { root.searching = true; } } }
            if root.enabled && !root.needs-permission: VerticalLayout {
                alignment: center;
                IconButton { glyph: root.all-selected ? Icons.deselect : Icons.select-all; enabled: root.can-select-all; tint: Theme.s.on-surface; clicked => { root.select-all(); } }
            }
            if root.changed: VerticalLayout { alignment: center; IconButton { glyph: Icons.check; tint: Theme.s.primary; clicked => { root.save(); } } }
            VerticalLayout { alignment: center; IconButton { glyph: Icons.more; tint: Theme.s.on-surface; clicked => { root.menu(); } } }
        }
        if root.searching: HorizontalLayout {
            height: 56px;
            padding-left: 4px;
            padding-right: 8px;
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                IconButton { glyph: Icons.back; tint: Theme.s.on-surface; clicked => { root.query = ""; root.searching = false; } }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Rectangle {
                    height: 44px;
                    border-radius: 22px;
                    background: Theme.s.block;
                    Text {
                        x: 16px;
                        visible: acc-input.text == "";
                        text: "搜索";
                        color: Theme.s.on-surface-variant;
                        font-size: 15px;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    acc-input := TextInput {
                        x: 16px;
                        width: parent.width - 32px;
                        height: parent.height;
                        vertical-alignment: center;
                        single-line: true;
                        font-size: 15px;
                        color: Theme.s.on-surface;
                        text <=> root.query;
                        init => { self.focus(); }
                    }
                }
            }
            if root.enabled && !root.needs-permission: VerticalLayout {
                alignment: center;
                IconButton { glyph: root.all-selected ? Icons.deselect : Icons.select-all; enabled: root.can-select-all; tint: Theme.s.on-surface; clicked => { root.select-all(); } }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            if root.needs-permission: VerticalLayout {
                alignment: center;
                spacing: 6px;
                padding-left: 32px;
                padding-right: 32px;
                Text { text: "需要读取应用列表权限"; font-size: 16px; font-weight: 600; color: Theme.s.on-surface; horizontal-alignment: center; wrap: word-wrap; }
                Text { text: "当前系统在授权前不会提供已安装的应用列表，授权后即可配置分应用代理。"; font-size: 13px; color: Theme.s.on-surface-variant; horizontal-alignment: center; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: center;
                    padding-top: 12px;
                    TextButton { text: "授权"; filled: true; clicked => { root.grant(); } }
                }
            }
            if !root.needs-permission && root.loading: Spinner { width: 32px; height: 32px; indeterminate: true; }
            if !root.needs-permission && !root.loading && root.rows.length == 0: NullStatus { label: "暂无数据"; }
            if !root.needs-permission && !root.loading && root.rows.length > 0: Rectangle {
                opacity: root.enabled ? 1 : 0.45;
                ListView {
                    y: 0;
                    height: parent.height - 80px - root.bottom-gap;
                    for r in root.rows: Rectangle {
                        height: 72px;
                        background: row-ta.pressed ? Theme.s.inset : transparent;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 16px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    border-radius: 12px;
                                    background: Theme.s.primary-container;
                                    Text { text: r.monogram; font-size: 18px; font-weight: 600; color: Theme.s.on-primary-container; }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text { text: r.label; font-size: 16px; color: Theme.s.on-surface; overflow: elide; }
                                Text { text: r.name; font-size: 13px; color: Theme.s.on-surface-variant; overflow: elide; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    border-radius: 4px;
                                    border-width: r.checked ? 0px : 2px;
                                    border-color: Theme.s.on-surface-variant;
                                    background: r.checked ? Theme.s.primary : transparent;
                                    if r.checked: Icon { glyph: Icons.check; size: 16px; tint: Theme.s.on-primary; }
                                }
                            }
                        }
                        row-ta := TouchArea {
                            enabled: root.enabled;
                            clicked => { root.toggle(r.name); }
                        }
                    }
                }
            }
            if !root.needs-permission: Rectangle {
                x: 16px;
                y: parent.height - self.height - 12px - root.bottom-gap;
                width: parent.width - 32px;
                height: max(56px, foot.preferred-height);
                border-radius: 16px;
                background: Theme.s.card;
                border-width: 1px;
                border-color: Theme.s.outline-variant.with-alpha(0.6);
                foot := HorizontalLayout {
                    padding-left: 16px;
                    padding-right: root.enabled && !root.authorize ? 16px : 8px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 12px;
                    VerticalLayout { alignment: center; Icon { glyph: root.enabled && !root.authorize ? Icons.apps : Icons.info; size: 20px; tint: Theme.s.on-surface-variant; } }
                    Text { horizontal-stretch: 1; text: root.status; font-size: 13px; color: Theme.s.on-surface; vertical-alignment: center; wrap: word-wrap; overflow: elide; }
                    if root.authorize: VerticalLayout { alignment: center; TextButton { text: "授权"; clicked => { root.grant(); } } }
                    if root.enabled && !root.authorize: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 28px;
                            min-width: chip.preferred-width * 1.1 + 20px;
                            border-radius: 14px;
                            background: Theme.s.primary.with-alpha(0.15);
                            chip := Text { text: root.count; font-size: 13px; color: Theme.s.primary; }
                        }
                    }
                    if !root.enabled: VerticalLayout { alignment: center; TextButton { text: "开启"; clicked => { root.enable(); } } }
                }
            }
        }
    }
}

// lib/views/connection/requests.dart: the connections, HTTP requests and DNS queries of
// this run; beside the list on a wide page the selection's detail, else a sheet.
component RequestsPage inherits Rectangle {
    in property <bool> mobile;
    in property <bool> can-back;
    in property <int> segment;
    in property <bool> shows-http;
    in property <[RecordRow]> rows;
    in property <[string]> statuses;
    in property <int> status;
    in property <[ConditionLine]> conditions;
    in property <string> empty;
    in property <string> empty-desc;
    in property <ReqDetail> detail;
    in property <bool> has-menu;
    in-out property <bool> searching;
    in-out property <string> query;
    out property <bool> split: !root.mobile && root.width >= 392px + 496px;
    callback back();
    callback search(string);
    callback open-menu();
    callback set-segment(int);
    callback set-status(int);
    callback add-condition();
    callback edit-condition(int);
    callback remove-condition(int);
    callback clear-conditions();
    callback select(int, bool);
    callback row-menu(int);
    callback detail-tab(int);
    callback detail-close();
    callback detail-menu();
    callback detail-row(string);

    changed query => { root.search(root.query); }

    VerticalLayout {
        if !root.searching: AppBar {
            title: "请求";
            can-back: root.can-back;
            back => { root.back(); }
            VerticalLayout { alignment: center; IconButton { glyph: Icons.search; tint: Theme.s.on-surface; clicked => { root.searching = true; } } }
            if root.has-menu: VerticalLayout { alignment: center; IconButton { glyph: Icons.more; tint: Theme.s.on-surface; clicked => { root.open-menu(); } } }
        }
        if root.searching: HorizontalLayout {
            height: 56px;
            padding-left: 4px;
            padding-right: 12px;
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                IconButton { glyph: Icons.back; tint: Theme.s.on-surface; clicked => { root.query = ""; root.searching = false; } }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Rectangle {
                    height: 44px;
                    border-radius: 22px;
                    background: Theme.s.block;
                    Text {
                        x: 16px;
                        visible: req-input.text == "";
                        text: "搜索";
                        color: Theme.s.on-surface-variant;
                        font-size: 15px;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    req-input := TextInput {
                        x: 16px;
                        width: parent.width - 32px;
                        height: parent.height;
                        vertical-alignment: center;
                        single-line: true;
                        font-size: 15px;
                        color: Theme.s.on-surface;
                        text <=> root.query;
                        init => { self.focus(); }
                    }
                }
            }
            if root.has-menu: VerticalLayout { alignment: center; IconButton { glyph: Icons.more; tint: Theme.s.on-surface; clicked => { root.open-menu(); } } }
        }
        if !root.split: ReqHeader {
            segment: root.segment;
            shows-http: root.shows-http;
            statuses: root.statuses;
            status: root.status;
            conditions: root.conditions;
            set-segment(s) => { root.set-segment(s); }
            set-status(s) => { root.set-status(s); }
            add-condition => { root.add-condition(); }
            edit-condition(i) => { root.edit-condition(i); }
            remove-condition(i) => { root.remove-condition(i); }
            clear-conditions => { root.clear-conditions(); }
        }
        if !root.split: ReqList {
            vertical-stretch: 1;
            rows: root.rows;
            marks: !root.mobile;
            empty: root.empty;
            empty-desc: root.empty-desc;
            select(id) => { root.select(id, false); }
            menu(id) => { root.row-menu(id); }
        }
        if root.split: HorizontalLayout {
            vertical-stretch: 1;
            VerticalLayout {
                width: 392px;
                ReqHeader {
                    segment: root.segment;
                    shows-http: root.shows-http;
                    statuses: root.statuses;
                    status: root.status;
                    conditions: root.conditions;
                    set-segment(s) => { root.set-segment(s); }
                    set-status(s) => { root.set-status(s); }
                    add-condition => { root.add-condition(); }
                    edit-condition(i) => { root.edit-condition(i); }
                    remove-condition(i) => { root.remove-condition(i); }
                    clear-conditions => { root.clear-conditions(); }
                }
                ReqList {
                    vertical-stretch: 1;
                    rows: root.rows;
                    marks: true;
                    empty: root.empty;
                    empty-desc: root.empty-desc;
                    select(id) => { root.select(id, true); }
                    menu(id) => { root.row-menu(id); }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                padding-top: 4px;
                padding-left: 4px;
                padding-right: 12px;
                padding-bottom: 12px;
                Rectangle {
                    background: Theme.s.card;
                    border-radius: 28px;
                    clip: true;
                    DetailView {
                        detail: root.detail;
                        head-menu: true;
                        tab(i) => { root.detail-tab(i); }
                        close => { root.detail-close(); }
                        menu => { root.detail-menu(); }
                        open-row(a) => { root.detail-row(a); }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------- Resources

component ResourceRow inherits Rectangle {
    in property <ResourceItem> item;
    in property <bool> divider;
    callback tapped(string);
    callback menu(string);
    property <bool> fired;
    height: 64px;
    background: rta.pressed ? Theme.s.inset : transparent;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.item.title; font-size: 16px; color: Theme.s.on-surface; overflow: elide; }
            Text { text: root.item.subtitle; font-size: 13px; color: Theme.s.on-surface-variant; overflow: elide; }
        }
        if root.item.busy: VerticalLayout { alignment: center; Spinner { width: 22px; height: 22px; indeterminate: true; } }
        if !root.item.busy && root.item.chip != "": VerticalLayout {
            alignment: center;
            Rectangle {
                height: 24px;
                width: chip-text.preferred-width * 1.1 + 20px;
                border-radius: 12px;
                background: Theme.s.block;
                chip-text := Text { text: root.item.chip; font-size: 12px; font-weight: 600; color: Theme.s.on-surface-variant; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
    if root.divider: Rectangle { x: 16px; y: parent.height - 1px; width: parent.width - 16px; height: 1px; background: Theme.s.outline-variant.with-alpha(0.6); }
    rta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                if (e.button == PointerEventButton.right) {
                    root.fired = true;
                    root.menu(root.item.key);
                } else {
                    root.fired = false;
                    rhold.running = true;
                }
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                rhold.running = false;
            }
        }
        moved => {
            if (abs(self.mouse-x - self.pressed-x) > 8px || abs(self.mouse-y - self.pressed-y) > 8px) {
                rhold.running = false;
            }
        }
        clicked => { if (!root.fired) { root.tapped(root.item.key); } }
    }
    rhold := Timer {
        interval: 450ms;
        running: false;
        triggered => {
            self.running = false;
            root.fired = true;
            root.menu(root.item.key);
        }
    }
}

// lib/views/resources.dart: the geo files' auto update and each file.
component ResourcesPage inherits Rectangle {
    in property <[ResourceItem]> items;
    in property <bool> auto;
    in property <string> interval;
    in property <bool> updating;
    callback back();
    callback update-all();
    callback set-auto(bool);
    callback open-interval();
    callback tapped(string);
    callback menu(string);
    VerticalLayout {
        AppBar {
            title: "资源";
            can-back: true;
            back => { root.back(); }
            VerticalLayout {
                alignment: center;
                if root.updating: Rectangle { width: 40px; height: 40px; Spinner { width: 22px; height: 22px; indeterminate: true; } }
                if !root.updating: IconButton { glyph: Icons.sync; tint: Theme.s.on-surface; clicked => { root.update-all(); } }
            }
        }
        Flickable {
            content-height: max(res-col.preferred-height, self.height);
            res-col := VerticalLayout {
                alignment: start;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: 24px;
                spacing: 6px;
                Rectangle {
                    background: Theme.s.card;
                    border-radius: 16px;
                    clip: true;
                    VerticalLayout {
                        HorizontalLayout {
                            height: 56px;
                            padding-left: 16px;
                            padding-right: 16px;
                            Text { text: "自动更新"; font-size: 16px; color: Theme.s.on-surface; vertical-alignment: center; horizontal-stretch: 1; }
                            VerticalLayout { alignment: center; Switch { checked: root.auto; toggled(on) => { root.set-auto(on); } } }
                        }
                        if root.auto: HorizontalLayout { padding-left: 16px; Rectangle { height: 1px; background: Theme.s.outline-variant.with-alpha(0.6); } }
                        if root.auto: Rectangle {
                            height: 64px;
                            background: ita.pressed ? Theme.s.inset : transparent;
                            VerticalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: center;
                                spacing: 2px;
                                Text { text: "自动更新间隔"; font-size: 16px; color: Theme.s.on-surface; }
                                Text { text: root.interval; font-size: 13px; color: Theme.s.on-surface-variant; }
                            }
                            ita := TouchArea { clicked => { root.open-interval(); } }
                        }
                    }
                }
                HorizontalLayout { padding-left: 14px; Text { text: "Geo"; height: 40px; font-size: 13px; color: Theme.s.on-surface-variant; vertical-alignment: bottom; } }
                Rectangle {
                    background: Theme.s.card;
                    border-radius: 16px;
                    clip: true;
                    VerticalLayout {
                        for it[i] in root.items: ResourceRow {
                            item: it;
                            divider: i < root.items.length - 1;
                            tapped(k) => { root.tapped(k); }
                            menu(k) => { root.menu(k); }
                        }
                    }
                }
            }
        }
    }
}

// A menu as a sheet from the bottom (`PopupMenuItem`s: a heading starts a titled section,
// section a plain one; sub rows sit under the row that opened them).
component ActionSheet inherits Rectangle {
    in property <string> title;
    in property <[ActionItem]> items;
    in property <length> bottom-inset;
    callback picked(string);
    callback dismiss();
    background: #00000066;
    TouchArea { clicked => { root.dismiss(); } }
    Rectangle {
        y: parent.height - self.height;
        height: min(sheet-col.preferred-height + root.bottom-inset, parent.height - 48px);
        background: Theme.s.card;
        border-top-left-radius: 24px;
        border-top-right-radius: 24px;
        TouchArea { }
        Flickable {
            height: parent.height - root.bottom-inset;
            content-height: sheet-col.preferred-height;
            sheet-col := VerticalLayout {
                padding-top: 12px;
                padding-bottom: 8px;
                if root.title != "": HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    Text { text: root.title; font-size: 16px; color: Theme.s.on-surface-variant; height: 40px; vertical-alignment: center; overflow: elide; }
                }
                for a[ai] in root.items: VerticalLayout {
                    if ai > 0 && (a.section || a.heading != ""): Rectangle { height: 8px; Rectangle { y: 3px; height: 1px; background: Theme.s.outline-variant.with-alpha(0.6); } }
                    if a.heading != "": HorizontalLayout {
                        padding-left: 16px;
                        Text { text: a.heading; font-size: 13px; color: Theme.s.primary; height: 32px; vertical-alignment: center; }
                    }
                    Rectangle {
                        height: a.subtitle != "" ? 60px : 48px;
                        opacity: a.enabled ? 1 : 0.4;
                        background: ata.pressed ? Theme.s.inset : transparent;
                        HorizontalLayout {
                            padding-left: a.sub ? 40px : 16px;
                            padding-right: 16px;
                            spacing: 14px;
                            if a.glyph != "": VerticalLayout {
                                alignment: center;
                                Icon {
                                    size: 20px;
                                    tint: a.danger ? Theme.s.error : Theme.s.on-surface-variant;
                                    glyph: a.glyph == "copy" ? Icons.copy : a.glyph == "filter" ? Icons.filter : a.glyph == "eye-off" ? Icons.eye-off : a.glyph == "block" ? Icons.block : a.glyph == "sync" ? Icons.sync : a.glyph == "edit" ? Icons.edit : a.glyph == "fold" ? Icons.fold : a.glyph == "unfold" ? Icons.unfold : "";
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text { text: a.label; font-size: 15px; color: a.danger ? Theme.s.error : Theme.s.on-surface; overflow: elide; }
                                if a.subtitle != "": Text { text: a.subtitle; font-size: 12px; color: Theme.s.on-surface-variant; overflow: elide; }
                            }
                            if a.check: VerticalLayout {
                                alignment: center;
                                width: 20px;
                                if a.checked: Icon { glyph: Icons.check; size: 20px; tint: Theme.s.primary; }
                            }
                        }
                        ata := TouchArea {
                            enabled: a.enabled;
                            clicked => { root.picked(a.id); }
                        }
                    }
                }
            }
        }
    }
}

// A dialog's choices in two or three columns (`_ChoiceGrid`).
component ChoiceGrid inherits VerticalLayout {
    in property <[string]> choices;
    in property <int> value;
    callback picked(int);
    property <int> cols: root.choices.length > 4 ? 3 : 2;
    spacing: 6px;
    for r in ceil(root.choices.length / root.cols): HorizontalLayout {
        spacing: 6px;
        for c in root.cols: Rectangle {
            property <int> i: r * root.cols + c;
            height: 40px;
            preferred-width: 0px;
            min-width: 0px;
            horizontal-stretch: 1;
            border-radius: 20px;
            background: self.i >= root.choices.length ? transparent : self.i == root.value ? Theme.s.primary : Theme.s.block;
            Text {
                text: parent.i < root.choices.length ? root.choices[parent.i] : "";
                font-size: 14px;
                color: parent.i == root.value ? Theme.s.on-primary : Theme.s.on-surface;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                enabled: parent.i < root.choices.length;
                clicked => { root.picked(parent.i); }
            }
        }
    }
}

// ---------------------------------------------------------------- Shell

// Material 3 navigation bar destination: a pill behind the active icon, label below.
component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <string> glyph;
    callback clicked();
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 60px;
                height: 32px;
                border-radius: 16px;
                background: root.active ? Theme.s.primary-container : transparent;
                Icon {
                    glyph: root.glyph;
                    tint: root.active ? Theme.s.on-primary-container : Theme.s.on-surface-variant;
                }
            }
        }
        Text {
            text: root.label;
            font-size: 12px;
            horizontal-alignment: center;
            color: root.active ? Theme.s.on-surface : Theme.s.on-surface-variant;
        }
    }
    TouchArea { clicked => { root.clicked(); } }
}

// A destination on the side: a rail item (icon over label) or a side bar row.
component SideItem inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> active;
    in property <bool> rail;
    callback clicked();
    height: rail ? 60px : 44px;
    border-radius: rail ? 0 : 12px;
    background: !rail && active ? Theme.s.primary-container : transparent;
    if root.rail: VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 56px;
                height: 32px;
                border-radius: 16px;
                background: root.active ? Theme.s.primary-container : transparent;
                Icon { glyph: root.glyph; tint: root.active ? Theme.s.on-primary-container : Theme.s.on-surface-variant; }
            }
        }
        Text { text: root.label; font-size: 12px; horizontal-alignment: center; color: root.active ? Theme.s.on-surface : Theme.s.on-surface-variant; }
    }
    if !root.rail: HorizontalLayout {
        padding-left: 12px;
        spacing: 12px;
        VerticalLayout { alignment: center; Icon { glyph: root.glyph; size: 22px; tint: root.active ? Theme.s.on-primary-container : Theme.s.on-surface-variant; } }
        Text { text: root.label; font-size: 15px; vertical-alignment: center; color: root.active ? Theme.s.on-primary-container : Theme.s.on-surface; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

export component AppWindow inherits Window {
    title: "SeasonCat";
    background: Theme.s.page;
    default-font-size: 14px;

    // 0 dashboard, 1 proxies, 2 profiles, 3 tools (FlClash's mobile bar)
    in-out property <int> tab: 0;
    // Page opened from tools: "", "logs" or "theme".
    in-out property <string> tools-page;
    // Dashboard
    in property <string> run-state: "OFFLINE";
    in property <string> profile-name;
    in property <string> up-speed: "0 B/s";
    in property <string> down-speed: "0 B/s";
    in property <string> up-total;
    in property <string> down-total;
    in property <int> mode: 0;
    in property <DashStatus> dash-status;
    in property <DashTraffic> dash-traffic;
    in property <DashProfile> dash-profile;
    in property <[ProxyGroup]> dash-groups;
    in property <[string]> dash-widgets;
    in property <[string]> dash-hidden;
    in property <bool> dash-has-start: true;
    in property <string> dash-local-ip;
    in property <string> dash-memory;
    in property <string> dash-run-time: "00:00:00";
    in property <int> profile-count;
    in-out property <bool> dash-editing;
    callback edit-dashboard(string, string);
    callback refresh-ip();
    callback copy-text(string);
    callback toggle-vpn();
    callback set-mode(int);
    // Profiles
    in property <[ProfileItem]> profiles;
    in property <bool> adding;
    // Page over the profiles list: "", "edit", "editor", "preview" or "sort".
    in-out property <string> profiles-page;
    in-out property <bool> add-menu-open;
    in-out property <bool> link-open;
    in-out property <bool> link-batch;
    in-out property <ProfileItem> menu-item;
    in-out property <bool> menu-open;
    in-out property <bool> menu-more;
    callback import-links(string, string, string, bool);
    callback add-file();
    callback update-profile(string);
    callback update-all();
    callback select-profile(string);
    callback delete-profile(string);
    callback edit-profile(string);
    callback preview-profile(string);
    callback copy-link(string);
    callback show-qr(string);
    callback export-profile(string);
    callback open-sort();
    // Edit page
    in-out property <string> edit-id;
    in-out property <bool> edit-is-url;
    in-out property <string> edit-name;
    in-out property <string> edit-url;
    in-out property <string> edit-age;
    in-out property <bool> edit-auto;
    in-out property <string> edit-interval;
    in-out property <string> edit-file-info;
    in-out property <bool> edit-file-changed;
    callback edit-save();
    callback edit-file();
    callback upload-file();
    // Editor / runtime config
    in-out property <string> editor-title;
    in-out property <string> editor-text;
    in-out property <bool> editor-readonly;
    callback editor-save(string);
    // Sort
    in property <[ProfileItem]> sort-items;
    callback sort-move(int, int);
    callback sort-save();
    // age key prompt (dialogs.showAgeSecretKeyInput)
    in-out property <bool> age-open;
    callback age-submit(string);
    // QR code of a profile's link
    in-out property <bool> qr-open;
    in-out property <string> qr-title;
    in-out property <image> qr-image;
    // Alert and confirm dialogs
    in-out property <bool> alert-open;
    in-out property <string> alert-title;
    in-out property <string> alert-text;
    in-out property <bool> confirm-open;
    in-out property <string> confirm-title;
    in-out property <string> confirm-text;
    in-out property <string> confirm-action;
    in-out property <string> confirm-arg;
    callback confirm-answer(string, string, bool);
    // Proxies
    in property <[ProxyGroup]> proxy-groups;
    in property <ProxyStyle> proxy-style: { kind: 1, sort: 0, layout: 1, card: 1, icon: 0, hide-timeout: false };
    out property <int> proxy-columns: proxies-page.columns;
    out property <length> proxy-card-height: proxies-page.card-height;
    in-out property <bool> proxy-options-open;
    in-out property <bool> proxy-searching;
    callback test-node(string, string);
    callback toggle-group(string);
    callback proxy-style-changed(string, int);
    callback search-proxies(string);
    callback locate(string) -> length;
    in-out property <string> current-group;
    in property <bool> testing;
    in property <string> proxies-hint: "暂无数据";
    callback open-group(string);
    callback select-node(string, string);
    callback test-group(string);
    callback tab-changed(int);
    // Logs
    in property <[LogItem]> logs;
    callback clear-logs();
    // Settings
    in property <[color]> accents;
    in property <int> accent;
    in property <int> theme-mode;
    callback set-accent(int);
    callback set-theme-mode(int);
    // Requests (tab 4 beside the bar, tools page "requests" under it)
    in-out property <int> req-segment;
    in property <bool> req-shows-http;
    in property <[RecordRow]> req-rows;
    in property <[string]> req-statuses;
    in property <int> req-status;
    in property <[ConditionLine]> req-conditions;
    in property <string> req-empty;
    in property <string> req-empty-desc;
    in property <ReqDetail> req-detail;
    in property <bool> req-has-menu: true;
    in-out property <bool> req-searching;
    in-out property <string> req-query;
    in-out property <bool> req-sheet-open;
    in-out property <bool> req-actions-open;
    in property <string> req-actions-title;
    in property <[ActionItem]> req-actions;
    out property <bool> req-visible: root.tab == 4 || (root.tab == 3 && root.tools-page == "requests");
    callback req-search(string);
    callback req-open-menu();
    callback req-set-segment(int);
    callback req-set-status(int);
    callback req-add-condition();
    callback req-edit-condition(int);
    callback req-remove-condition(int);
    callback req-clear-conditions();
    callback req-select(int, bool);
    callback req-row-menu(int);
    callback req-detail-tab(int);
    callback req-detail-close();
    callback req-detail-menu();
    callback req-detail-row(string);
    callback req-sheet-closed();
    callback req-action(string);
    // Condition dialog (`showConditionDialog`)
    in-out property <bool> cond-open;
    in property <bool> cond-editing;
    in property <[string]> cond-fields;
    in-out property <int> cond-field;
    in-out property <int> cond-op;
    in-out property <string> cond-value;
    in property <[Suggestion]> cond-suggestions;
    in property <string> cond-values-in;
    in property <string> cond-shows;
    in property <string> cond-tip;
    in property <bool> cond-ready;
    callback cond-changed();
    callback cond-submit();
    // Resources
    in property <[ResourceItem]> res-items;
    in property <bool> res-auto;
    in property <string> res-interval;
    in property <bool> res-updating;
    // The open input dialog: "", "interval" or "url".
    in-out property <string> res-dialog;
    in-out property <string> res-dialog-title;
    in-out property <string> res-dialog-value;
    in-out property <string> res-dialog-default;
    in-out property <string> res-dialog-key;
    in-out property <bool> res-touched;
    property <string> res-error: root.res-touched && root.res-dialog != "" ? root.res-check(root.res-dialog, root.res-dialog-value) : "";
    callback res-update-all();
    callback res-set-auto(bool);
    callback res-open-interval();
    callback res-tapped(string);
    callback res-menu(string);
    callback res-dialog-submit(string, string, string);
    pure callback res-check(string, string) -> string;
    pure callback res-digits(string) -> string;
    // Settings under tools (lib/views/tools.dart): the tools list, the open settings page's
    // sections, a picker sheet and a one or two field input dialog.
    in property <[SetSection]> tools-sections;
    in property <[SetSection]> page-sections;
    in property <string> list-title;
    // The port form (`PortForm`)
    in-out property <bool> ports-open;
    in-out property <string> port-mixed;
    in-out property <string> port-http;
    in-out property <string> port-socks;
    pure callback ports-check(string, string, string) -> string;
    callback ports-submit(string, string, string);
    property <string> ports-error: root.ports-open ? root.ports-check(root.port-mixed, root.port-http, root.port-socks) : "";
    in property <string> list-parent;
    in property <bool> pure-black;
    in property <string> app-version;
    in property <image> app-icon;
    in property <bool> update-checking;
    callback tools-clicked(string);
    callback set-clicked(string, string);
    callback set-toggled(string, string, bool);
    callback set-pure-black(bool);
    callback check-update();
    callback about-logo-tapped();
    in-out property <bool> choice-open;
    in property <string> choice-title;
    in property <[ActionItem]> choice-items;
    callback choice-picked(string);
    in-out property <bool> input-open;
    in property <string> input-title;
    in property <string> input-key;
    in property <string> input-label;
    in property <string> input-label2;
    in-out property <string> input-value;
    in-out property <string> input-value2;
    in property <bool> input-removable;
    in property <bool> input-number;
    pure callback input-check(string, string, string) -> string;
    callback input-submit(string, string, string);
    property <string> input-error: root.input-open ? root.input-check(root.input-key, root.input-value, root.input-value2) : "";
    callback input-remove(string);
    // Access control (lib/views/access.dart)
    in property <[AccessRow]> acc-rows;
    in property <bool> acc-enabled;
    in property <bool> acc-changed;
    in property <bool> acc-all-selected;
    in property <bool> acc-can-select-all;
    in property <bool> acc-loading;
    in property <bool> acc-needs-permission;
    in property <bool> acc-authorize;
    in property <string> acc-status;
    in property <string> acc-count;
    in-out property <bool> acc-searching;
    in-out property <string> acc-query;
    callback acc-back();
    callback acc-toggle(string);
    callback acc-select-all();
    callback acc-save();
    callback acc-menu();
    callback acc-enable();
    callback acc-grant();
    callback acc-search(string);
    // WebDAV form (`WebDAVForm`)
    in-out property <bool> dav-open;
    in property <bool> dav-bound;
    in-out property <string> dav-uri;
    in-out property <string> dav-user;
    in-out property <string> dav-pass;
    pure callback dav-check(string, string, string) -> string;
    callback dav-submit(string, string, string);
    callback dav-delete();
    property <string> dav-error: root.dav-open ? root.dav-check(root.dav-uri, root.dav-user, root.dav-pass) : "";
    // Feedback
    in property <string> toast;

    callback page-shown();
    changed req-visible => { if (root.req-visible) { root.page-shown(); } }
    callback tools-page-changed();
    changed tools-page => {
        if (root.tools-page == "resources") { root.page-shown(); }
        root.tools-page-changed();
    }
    changed cond-value => { root.cond-changed(); }
    changed res-dialog-value => {
        if (root.res-dialog == "interval") {
            if (root.res-digits(root.res-dialog-value) != root.res-dialog-value) {
                root.res-dialog-value = root.res-digits(root.res-dialog-value);
            }
        }
        root.res-touched = true;
    }

    public function links-done() {
        root.link-open = false;
        link-name.text = "";
        link-url.text = "";
        link-age.text = "";
        root.link-batch = false;
    }

    function go(t: int) {
        root.tab = t;
        root.tools-page = "";
        root.profiles-page = "";
        root.tab-changed(t);
    }

    property <bool> wide: root.width > 600px;
    property <bool> desktop: root.width > 840px;
    // WindowEdges.kt: Slint's safe area can carry the whole screen's bars in a freeform window.
    in property <bool> insets-known;
    in property <length> inset-top;
    in property <length> inset-bottom;
    in property <length> inset-left;
    in property <length> inset-right;
    callback window-resized();
    changed width => { root.window-resized(); }
    changed height => { root.window-resized(); }
    property <length> top-inset: root.insets-known ? root.inset-top : max(root.safe-area-insets.top, 0px);
    property <length> bottom-inset: root.insets-known ? root.inset-bottom : max(root.safe-area-insets.bottom, 0px);
    property <length> keyboard: root.virtual-keyboard-size.height > 0 ? root.virtual-keyboard-size.height : 0px;

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Back) {
                if (root.alert-open) { root.alert-open = false; return accept; }
                if (root.input-open) { root.input-open = false; return accept; }
                if (root.choice-open) { root.choice-open = false; return accept; }
                if (root.cond-open) { root.cond-open = false; return accept; }
                if (root.res-dialog != "") { root.res-dialog = ""; return accept; }
                if (root.req-actions-open) { root.req-actions-open = false; return accept; }
                if (root.req-sheet-open) { root.req-sheet-open = false; root.req-sheet-closed(); return accept; }
                if (root.req-visible && root.req-searching) { root.req-searching = false; root.req-query = ""; return accept; }
                if (root.proxy-options-open) { root.proxy-options-open = false; return accept; }
                if (root.tab == 1 && root.proxy-searching) { root.proxy-searching = false; root.search-proxies(""); return accept; }
                if (root.confirm-open && root.confirm-action == "access-save") { root.confirm-open = false; return accept; }
                if (root.confirm-open) {
                    root.confirm-open = false;
                    root.confirm-answer(root.confirm-action, root.confirm-arg, false);
                    return accept;
                }
                if (root.qr-open) { root.qr-open = false; return accept; }
                if (root.age-open) { root.age-open = false; root.age-submit(""); return accept; }
                if (root.menu-open) { root.menu-open = false; return accept; }
                if (root.add-menu-open) { root.add-menu-open = false; return accept; }
                if (root.link-open) { root.link-open = false; return accept; }
                if (root.tab == 2 && root.profiles-page == "editor") { root.profiles-page = "edit"; return accept; }
                if (root.tab == 2 && root.profiles-page != "") { root.profiles-page = ""; return accept; }
                if (root.dav-open) { root.dav-open = false; return accept; }
                if (root.ports-open) { root.ports-open = false; return accept; }
                if (root.tab == 3 && root.tools-page == "access" && root.acc-searching) { root.acc-query = ""; root.acc-searching = false; return accept; }
                if (root.tab == 3 && root.tools-page == "access") { root.acc-back(); return accept; }
                if (root.tab == 3 && root.tools-page == "hosts") { root.tools-page = "general"; return accept; }
                if (root.tab == 3 && root.tools-page == "list") { root.tools-page = root.list-parent; return accept; }
                if (root.tab == 3 && root.tools-page == "network") { root.tools-page = "advanced"; return accept; }
                if (root.tab == 3 && root.tools-page != "") {
                    root.tools-page = "";
                    return accept;
                }
                if (root.tab == 0 && root.dash-editing) { root.dash-editing = false; return accept; }
                if (root.tab != 0) {
                    root.go(0);
                    return accept;
                }
            }
            reject
        }

        HorizontalLayout {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            padding-top: root.top-inset;
            padding-left: root.insets-known ? root.inset-left : 0px;
            padding-right: root.insets-known ? root.inset-right : 0px;
            // `ViewMode`: past 600 the bar moves to the side, a rail up to 840 and a
            // labelled side bar beyond.
            if root.wide: Rectangle {
                width: root.desktop ? 200px : 88px;
                background: Theme.s.card;
                VerticalLayout {
                    padding-top: 16px;
                    padding-left: root.desktop ? 12px : 4px;
                    padding-right: root.desktop ? 12px : 4px;
                    spacing: root.desktop ? 4px : 12px;
                    alignment: start;
                    SideItem { label: "仪表盘"; glyph: Icons.dashboard; rail: !root.desktop; active: root.tab == 0; clicked => { root.go(0); } }
                    SideItem { label: "代理"; glyph: Icons.proxies; rail: !root.desktop; active: root.tab == 1; clicked => { root.go(1); } }
                    SideItem { label: "请求"; glyph: Icons.requests; rail: !root.desktop; active: root.tab == 4; clicked => { root.go(4); } }
                    SideItem { label: "配置"; glyph: Icons.profiles; rail: !root.desktop; active: root.tab == 2; clicked => { root.go(2); } }
                    SideItem { label: "工具"; glyph: Icons.tools; rail: !root.desktop; active: root.tab == 3; clicked => { root.go(3); } }
                }
            }
        VerticalLayout {
            Rectangle {
                vertical-stretch: 1;
                if root.tab == 0: Dashboard {
                    width: parent.width;
                    height: parent.height;
                    run-state: root.run-state;
                    run-time: root.dash-run-time;
                    status: root.dash-status;
                    traffic: root.dash-traffic;
                    profile: root.dash-profile;
                    groups: root.dash-groups;
                    widgets: root.dash-widgets;
                    hidden: root.dash-hidden;
                    has-start: root.dash-has-start;
                    local-ip: root.dash-local-ip;
                    memory: root.dash-memory;
                    mode: root.mode;
                    editing <=> root.dash-editing;
                    toggle-vpn => { root.toggle-vpn(); }
                    set-mode(m) => { root.set-mode(m); }
                    open-profiles => { root.go(2); }
                    sync-profile(id) => { root.update-profile(id); }
                    open-group(g) => {
                        if (g != "") { root.current-group = g; }
                        root.go(1);
                        root.open-group(root.current-group);
                    }
                    refresh-ip => { root.refresh-ip(); }
                    copy-ip => { root.copy-text(root.dash-local-ip); }
                    edit(a, w) => { root.edit-dashboard(a, w); }
                }
                // Kept in the tree so its measures stay readable and its scroll stays put.
                proxies-page := Proxies {
                    visible: root.tab == 1;
                    width: parent.width;
                    height: parent.height;
                    groups: root.proxy-groups;
                    style: root.proxy-style;
                    current-group <=> root.current-group;
                    searching <=> root.proxy-searching;
                    testing: root.testing;
                    hint: root.proxies-hint;
                    open-group(g) => { root.open-group(g); }
                    select-node(g, n) => { root.select-node(g, n); }
                    test-group(g) => { root.test-group(g); }
                    test-node(g, n) => { root.test-node(g, n); }
                    toggle-group(g) => { root.toggle-group(g); }
                    search(q) => { root.search-proxies(q); }
                    open-options => { root.proxy-options-open = true; }
                    locate(g) => { return root.locate(g); }
                }
                if root.tab == 2 && root.profiles-page == "": Profiles {
                    width: parent.width;
                    height: parent.height;
                    profiles: root.profiles;
                    adding: root.adding;
                    add => { root.add-menu-open = true; }
                    update-all => { root.update-all(); }
                    open-sort => { root.open-sort(); }
                    select-profile(id) => { root.select-profile(id); }
                    menu(p) => { root.menu-item = p; root.menu-more = false; root.menu-open = true; }
                }
                if root.tab == 2 && root.profiles-page == "edit": EditProfilePage {
                    width: parent.width;
                    height: parent.height;
                    is-url: root.edit-is-url;
                    name <=> root.edit-name;
                    url <=> root.edit-url;
                    age <=> root.edit-age;
                    auto <=> root.edit-auto;
                    interval <=> root.edit-interval;
                    file-info: root.edit-file-info;
                    busy: root.adding;
                    save => { root.edit-save(); }
                    back => { root.profiles-page = ""; }
                    edit-file => { root.edit-file(); }
                    upload-file => { root.upload-file(); }
                }
                if root.tab == 2 && (root.profiles-page == "editor" || root.profiles-page == "preview"): EditorPage {
                    width: parent.width;
                    height: parent.height;
                    title: root.editor-title;
                    text <=> root.editor-text;
                    readonly: root.editor-readonly;
                    save(t) => { root.editor-save(t); }
                    back => { root.profiles-page = root.profiles-page == "editor" ? "edit" : ""; }
                }
                if root.tab == 2 && root.profiles-page == "sort": SortPage {
                    width: parent.width;
                    height: parent.height;
                    items: root.sort-items;
                    move(i, d) => { root.sort-move(i, d); }
                    save => { root.sort-save(); }
                    back => { root.profiles-page = ""; }
                }
                if root.tab == 3 && root.tools-page == "": Tools {
                    width: parent.width;
                    height: parent.height;
                    sections: root.tools-sections;
                    open(p) => { root.tools-clicked(p); }
                }
                if root.tab == 3 && (root.tools-page == "general" || root.tools-page == "developer" || root.tools-page == "hosts" || root.tools-page == "backup" || root.tools-page == "advanced" || root.tools-page == "network" || root.tools-page == "list"): SettingsPage {
                    width: parent.width;
                    height: parent.height;
                    title: root.tools-page == "general" ? "常规" : root.tools-page == "developer" ? "开发者模式" : root.tools-page == "backup" ? "备份与恢复" : root.tools-page == "advanced" ? "进阶配置" : root.tools-page == "network" ? "网络" : root.tools-page == "list" ? root.list-title : "Hosts";
                    sections: root.page-sections;
                    bottom-gap: root.tools-page == "hosts" || root.tools-page == "list" ? 96px : 24px;
                    back => { root.tools-page = root.tools-page == "hosts" ? "general" : root.tools-page == "list" ? root.list-parent : root.tools-page == "network" ? "advanced" : ""; }
                    clicked(id) => { root.set-clicked(root.tools-page, id); }
                    toggled(id, on) => { root.set-toggled(root.tools-page, id, on); }
                }
                if root.tab == 3 && root.tools-page == "list": Fab {
                    x: parent.width - self.width - 16px;
                    y: parent.height - self.height - 16px;
                    glyph: Icons.plus;
                    clicked => { root.set-clicked("list", "add"); }
                }
                if root.tab == 3 && root.tools-page == "hosts": Fab {
                    x: parent.width - self.width - 16px;
                    y: parent.height - self.height - 16px;
                    glyph: Icons.plus;
                    clicked => { root.set-clicked("hosts", "add"); }
                }
                if root.tab == 3 && root.tools-page == "access": AccessPage {
                    width: parent.width;
                    height: parent.height;
                    rows: root.acc-rows;
                    enabled: root.acc-enabled;
                    changed: root.acc-changed;
                    all-selected: root.acc-all-selected;
                    can-select-all: root.acc-can-select-all;
                    loading: root.acc-loading;
                    needs-permission: root.acc-needs-permission;
                    authorize: root.acc-authorize;
                    status: root.acc-status;
                    count: root.acc-count;
                    searching <=> root.acc-searching;
                    query <=> root.acc-query;
                    back => { root.acc-back(); }
                    toggle(n) => { root.acc-toggle(n); }
                    select-all => { root.acc-select-all(); }
                    save => { root.acc-save(); }
                    menu => { root.acc-menu(); }
                    enable => { root.acc-enable(); }
                    grant => { root.acc-grant(); }
                    search(q) => { root.acc-search(q); }
                }
                if root.tab == 3 && root.tools-page == "about": AboutPage {
                    width: parent.width;
                    height: parent.height;
                    icon: root.app-icon;
                    version: root.app-version;
                    checking: root.update-checking;
                    sections: root.page-sections;
                    back => { root.tools-page = ""; }
                    clicked(id) => { root.set-clicked("about", id); }
                    toggled(id, on) => { root.set-toggled("about", id, on); }
                    check-update => { root.check-update(); }
                    logo-tapped => { root.about-logo-tapped(); }
                }
                if root.tab == 3 && root.tools-page == "disclaimer": DisclaimerPage {
                    width: parent.width;
                    height: parent.height;
                    back => { root.tools-page = ""; }
                }
                if root.req-visible: RequestsPage {
                    width: parent.width;
                    height: parent.height;
                    mobile: !root.wide;
                    can-back: root.tab == 3;
                    segment: root.req-segment;
                    shows-http: root.req-shows-http;
                    rows: root.req-rows;
                    statuses: root.req-statuses;
                    status: root.req-status;
                    conditions: root.req-conditions;
                    empty: root.req-empty;
                    empty-desc: root.req-empty-desc;
                    detail: root.req-detail;
                    has-menu: root.req-has-menu;
                    searching <=> root.req-searching;
                    query <=> root.req-query;
                    back => { root.tools-page = ""; }
                    search(q) => { root.req-search(q); }
                    open-menu => { root.req-open-menu(); }
                    set-segment(s) => { root.req-set-segment(s); }
                    set-status(s) => { root.req-set-status(s); }
                    add-condition => { root.req-add-condition(); }
                    edit-condition(i) => { root.req-edit-condition(i); }
                    remove-condition(i) => { root.req-remove-condition(i); }
                    clear-conditions => { root.req-clear-conditions(); }
                    select(id, split) => {
                        if (!split) { root.req-sheet-open = true; }
                        root.req-select(id, split);
                    }
                    row-menu(id) => { root.req-row-menu(id); }
                    detail-tab(i) => { root.req-detail-tab(i); }
                    detail-close => { root.req-detail-close(); }
                    detail-menu => { root.req-detail-menu(); }
                    detail-row(a) => { root.req-detail-row(a); }
                }
                if root.tab == 3 && root.tools-page == "resources": ResourcesPage {
                    width: parent.width;
                    height: parent.height;
                    items: root.res-items;
                    auto: root.res-auto;
                    interval: root.res-interval;
                    updating: root.res-updating;
                    back => { root.tools-page = ""; }
                    update-all => { root.res-update-all(); }
                    set-auto(on) => { root.res-set-auto(on); }
                    open-interval => { root.res-open-interval(); }
                    tapped(k) => { root.res-tapped(k); }
                    menu(k) => { root.res-menu(k); }
                }
                if root.tab == 3 && root.tools-page == "logs": Logs {
                    width: parent.width;
                    height: parent.height;
                    logs: root.logs;
                    clear-logs => { root.clear-logs(); }
                    back => { root.tools-page = ""; }
                }
                if root.tab == 3 && root.tools-page == "theme": ThemePage {
                    width: parent.width;
                    height: parent.height;
                    accents: root.accents;
                    accent: root.accent;
                    theme-mode: root.theme-mode;
                    pure-black: root.pure-black;
                    set-accent(i) => { root.set-accent(i); }
                    set-theme-mode(m) => { root.set-theme-mode(m); }
                    set-pure-black(on) => { root.set-pure-black(on); }
                    back => { root.tools-page = ""; }
                }

                if root.toast != "": Rectangle {
                    y: parent.height - self.height - 88px - root.keyboard;
                    x: (parent.width - self.width) / 2;
                    width: min(parent.width - 40px, toast-text.preferred-width + 32px);
                    height: toast-text.preferred-height + 20px;
                    border-radius: 8px;
                    background: Theme.s.on-surface;
                    toast-text := Text {
                        x: 16px;
                        width: parent.width - 32px;
                        text: root.toast;
                        color: Theme.s.page;
                        font-size: 14px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            if !root.wide && root.keyboard == 0: Rectangle {
                height: 72px + root.bottom-inset;
                background: Theme.s.card;
                HorizontalLayout {
                    y: 0;
                    height: 72px;
                    NavItem { label: "仪表盘"; glyph: Icons.dashboard; active: root.tab == 0; clicked => { root.go(0); } }
                    NavItem { label: "代理"; glyph: Icons.proxies; active: root.tab == 1; clicked => { root.go(1); } }
                    NavItem { label: "配置"; glyph: Icons.profiles; active: root.tab == 2; clicked => { root.go(2); } }
                    NavItem { label: "工具"; glyph: Icons.tools; active: root.tab == 3; clicked => { root.go(3); } }
                }
            }
        }
        }

        // The proxies page's menu (`_buildMenuItems`), as a sheet from the bottom.
        if root.proxy-options-open: Rectangle {
            background: #00000066;
            TouchArea { clicked => { root.proxy-options-open = false; } }
            Rectangle {
                y: parent.height - self.height;
                height: opts.preferred-height + root.bottom-inset;
                background: Theme.s.card;
                border-top-left-radius: 24px;
                border-top-right-radius: 24px;
                TouchArea { }
                opts := VerticalLayout {
                    padding-top: 20px;
                    padding-bottom: 12px;
                    spacing: 16px;
                    OptionRow { label: "风格"; options: ["标签页", "列表"]; value: root.proxy-style.kind; picked(i) => { root.proxy-style-changed("kind", i); } }
                    OptionRow { label: "排序"; options: ["默认", "延迟", "名称"]; value: root.proxy-style.sort; picked(i) => { root.proxy-style-changed("sort", i); } }
                    OptionRow { label: "布局"; options: ["紧凑", "标准", "宽松"]; value: root.proxy-style.layout; picked(i) => { root.proxy-style-changed("layout", i); } }
                    OptionRow { label: "尺寸"; options: ["紧凑", "标准", "宽松"]; value: root.proxy-style.card; picked(i) => { root.proxy-style-changed("card", i); } }
                    if root.proxy-style.kind == 1: OptionRow { label: "图标样式"; options: ["色块", "纯图标", "隐藏"]; value: root.proxy-style.icon; picked(i) => { root.proxy-style-changed("icon", i); } }
                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        height: 48px;
                        Text { text: "隐藏超时代理"; font-size: 16px; color: Theme.s.on-surface; vertical-alignment: center; horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            Switch { checked: root.proxy-style.hide-timeout; toggled(on) => { root.proxy-style-changed("hide", on ? 1 : 0); } }
                        }
                    }
                }
            }
        }

        // AddProfileMenu: 文件 and 链接 (the scan and custom entries follow with the custom
        // profile editor).
        if root.add-menu-open: Rectangle {
            background: #00000033;
            TouchArea { clicked => { root.add-menu-open = false; } }
            Rectangle {
                x: parent.width - self.width - 16px;
                y: parent.height - self.height - (root.wide ? 0px : 72px) - root.bottom-inset - 88px;
                width: 200px;
                height: add-menu.preferred-height;
                background: Theme.s.card;
                border-radius: 12px;
                add-menu := VerticalLayout {
                    padding-top: 8px;
                    padding-bottom: 8px;
                    MenuRow { glyph: Icons.import-file; label: "文件"; clicked => { root.add-menu-open = false; root.add-file(); } }
                    MenuRow { glyph: Icons.cloud; label: "链接"; clicked => { root.add-menu-open = false; root.link-open = true; link-url.focus-input(); } }
                }
            }
        }

        // The profile's menu (ProfileItem._menuItems), as a sheet from the bottom.
        if root.menu-open: Rectangle {
            background: #00000066;
            TouchArea { clicked => { root.menu-open = false; } }
            Rectangle {
                y: parent.height - self.height;
                height: sheet.preferred-height + root.bottom-inset;
                background: Theme.s.card;
                border-top-left-radius: 24px;
                border-top-right-radius: 24px;
                TouchArea { }
                sheet := VerticalLayout {
                    padding-top: 12px;
                    padding-bottom: 8px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Text { text: root.menu-item.name; font-size: 16px; color: Theme.s.on-surface-variant; height: 40px; vertical-alignment: center; overflow: elide; }
                    }
                    MenuRow { glyph: Icons.edit; label: "编辑"; clicked => { root.menu-open = false; root.edit-profile(root.menu-item.id); } }
                    if root.menu-item.is-url: MenuRow { glyph: Icons.sync; label: "同步"; clicked => { root.menu-open = false; root.update-profile(root.menu-item.id); } }
                    MenuRow { glyph: Icons.more-circle; label: "更多"; clicked => { root.menu-more = !root.menu-more; } }
                    if root.menu-more: MenuRow { sub: true; glyph: Icons.eye; label: "运行时配置"; clicked => { root.menu-open = false; root.preview-profile(root.menu-item.id); } }
                    if root.menu-more && root.menu-item.is-url: MenuRow { sub: true; glyph: Icons.copy; label: "复制链接"; clicked => { root.menu-open = false; root.copy-link(root.menu-item.id); } }
                    if root.menu-more && root.menu-item.is-url: MenuRow { sub: true; glyph: Icons.qr; label: "二维码"; clicked => { root.menu-open = false; root.show-qr(root.menu-item.id); } }
                    if root.menu-more: MenuRow { sub: true; glyph: Icons.export; label: "导出文件"; clicked => { root.menu-open = false; root.export-profile(root.menu-item.id); } }
                    MenuRow { glyph: Icons.delete; label: "删除"; danger: true; clicked => { root.menu-open = false; root.delete-profile(root.menu-item.id); } }
                }
            }
        }

        // 从链接导入 (showNamedUrlsForm): a name, the link and an age key, or a batch of links.
        // Kept in the tree so the inputs keep their text and focus.
        Dialog {
            visible: root.link-open;
            title: "从链接导入";
            keyboard: root.keyboard;
            top: root.top-inset;
            dismiss => { root.link-open = false; }
            link-name := Field { label: "名称"; placeholder: "可选"; visible: !root.link-batch; height: root.link-batch ? 0 : self.preferred-height; }
            link-url := Field {
                label: "链接";
                placeholder: root.link-batch ? "每行一个链接" : "订阅链接或代理分享链接";
                multi: root.link-batch;
               
            }
            link-age := Field { label: "age 私钥"; placeholder: "可选"; visible: !root.link-batch; height: root.link-batch ? 0 : self.preferred-height; }
            HorizontalLayout {
                spacing: 8px;
                TextButton { text: root.link-batch ? "单个导入" : "批量导入"; clicked => { root.link-batch = !root.link-batch; } }
                Rectangle { horizontal-stretch: 1; }
                TextButton { text: "取消"; clicked => { root.link-open = false; } }
                TextButton {
                    text: "导入";
                    enabled: !root.adding && link-url.text != "";
                    clicked => { root.import-links(link-name.text, link-url.text, link-age.text, root.link-batch); }
                }
            }
        }

        if root.age-open: Dialog {
            title: "age 私钥";
            keyboard: root.keyboard;
            top: root.top-inset;
            dismissable: false;
            Text { text: "该配置已用 age 加密，需要 age 私钥才能解密"; wrap: word-wrap; color: Theme.s.on-surface-variant; }
            age-key := Field { placeholder: "AGE-SECRET-KEY-…"; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                TextButton { text: "取消"; clicked => { root.age-open = false; root.age-submit(""); } }
                TextButton { text: "确定"; enabled: age-key.text != ""; clicked => { root.age-open = false; root.age-submit(age-key.text); } }
            }
        }

        if root.qr-open: Dialog {
            title: root.qr-title;
            top: root.top-inset;
            dismiss => { root.qr-open = false; }
            HorizontalLayout {
                alignment: center;
                Image { source: root.qr-image; width: 240px; height: 240px; image-rendering: pixelated; }
            }
            Text { text: "在另一台设备上用 FlClash 扫码即可导入此配置。"; wrap: word-wrap; color: Theme.s.on-surface-variant; horizontal-alignment: center; }
            HorizontalLayout {
                alignment: end;
                TextButton { text: "确定"; clicked => { root.qr-open = false; } }
            }
        }

        // The detail of the selection in a sheet, where no pane fits beside the list.
        if root.req-sheet-open && root.req-visible: Rectangle {
            background: #00000066;
            TouchArea { clicked => { root.req-sheet-open = false; root.req-sheet-closed(); } }
            Rectangle {
                y: root.top-inset + 24px;
                height: parent.height - self.y;
                background: Theme.s.card;
                border-top-left-radius: 24px;
                border-top-right-radius: 24px;
                clip: true;
                TouchArea { }
                VerticalLayout {
                    Rectangle {
                        height: 16px;
                        Rectangle { y: 8px; width: 36px; height: 4px; border-radius: 2px; background: Theme.s.outline-variant; }
                    }
                    HorizontalLayout {
                        height: 44px;
                        padding-left: 20px;
                        padding-right: 8px;
                        Text { text: root.req-detail.sheet-title; font-size: 17px; font-weight: 600; color: Theme.s.on-surface; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        if root.req-detail.menu: VerticalLayout { alignment: center; IconButton { glyph: Icons.more; clicked => { root.req-detail-menu(); } } }
                        VerticalLayout { alignment: center; IconButton { glyph: Icons.close; clicked => { root.req-sheet-open = false; root.req-sheet-closed(); } } }
                    }
                    DetailView {
                        vertical-stretch: 1;
                        detail: root.req-detail;
                        stretch-tabs: !root.wide;
                        top-gap: 8px;
                        bottom-gap: root.bottom-inset;
                        tab(i) => { root.req-detail-tab(i); }
                        close => { root.req-detail-close(); }
                        menu => { root.req-detail-menu(); }
                        open-row(a) => { root.req-detail-row(a); }
                    }
                }
            }
        }

        if root.req-actions-open: ActionSheet {
            title: root.req-actions-title;
            items: root.req-actions;
            bottom-inset: root.bottom-inset;
            picked(id) => {
                if (id != "capture-limit") { root.req-actions-open = false; }
                root.req-action(id);
            }
            dismiss => { root.req-actions-open = false; }
        }

        if root.cond-open: Dialog {
            title: root.cond-editing ? "编辑条件" : "添加条件";
            keyboard: root.keyboard;
            top: root.top-inset;
            dismiss => { root.cond-open = false; }
            VerticalLayout {
                spacing: 6px;
                HorizontalLayout { padding-left: 14px; Text { text: "字段"; font-size: 13px; color: Theme.s.on-surface-variant; } }
                ChoiceGrid {
                    choices: root.cond-fields;
                    value: root.cond-field;
                    picked(i) => { root.cond-field = i; root.cond-changed(); }
                }
            }
            VerticalLayout {
                spacing: 6px;
                HorizontalLayout { padding-left: 14px; Text { text: "条件"; font-size: 13px; color: Theme.s.on-surface-variant; } }
                ChoiceGrid {
                    choices: ["包含", "不包含", "等于", "不等于"];
                    value: root.cond-op;
                    picked(i) => { root.cond-op = i; root.cond-changed(); }
                }
            }
            Field {
                label: "值";
                text <=> root.cond-value;
                accepted => { if (root.cond-ready) { root.cond-submit(); } }
                init => { self.focus-input(); }
            }
            if root.cond-suggestions.length > 0: VerticalLayout {
                spacing: 6px;
                HorizontalLayout { padding-left: 14px; Text { text: root.cond-values-in; font-size: 13px; color: Theme.s.on-surface-variant; } }
                Flickable {
                    height: 32px;
                    content-width: sugg.preferred-width;
                    interactive: sugg.preferred-width > self.width;
                    sugg := HorizontalLayout {
                        spacing: 6px;
                        for g in root.cond-suggestions: Rectangle {
                            height: 32px;
                            width: sugg-row.preferred-width;
                            border-radius: 16px;
                            background: sta.pressed ? Theme.s.inset : Theme.s.block;
                            sugg-row := HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;
                                Text { text: g.value; font-size: 13px; color: Theme.s.on-surface; vertical-alignment: center; }
                                Text { text: g.count; font-size: 12px; color: Theme.s.on-surface-variant; vertical-alignment: center; }
                            }
                            sta := TouchArea { clicked => { root.cond-value = g.value; } }
                        }
                    }
                }
            }
            VerticalLayout {
                padding-left: 14px;
                spacing: 4px;
                Text { text: root.cond-shows; font-size: 13px; font-weight: 600; color: Theme.s.on-surface; }
                Text { text: root.cond-tip; font-size: 13px; color: Theme.s.on-surface-variant; wrap: word-wrap; }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                TextButton { text: "取消"; clicked => { root.cond-open = false; } }
                TextButton { text: root.cond-editing ? "保存" : "添加"; enabled: root.cond-ready; clicked => { root.cond-submit(); } }
            }
        }

        if root.res-dialog != "": Dialog {
            title: root.res-dialog-title;
            keyboard: root.keyboard;
            top: root.top-inset;
            dismiss => { root.res-dialog = ""; }
            HorizontalLayout {
                spacing: 12px;
                Field {
                    horizontal-stretch: 1;
                    text <=> root.res-dialog-value;
                    input-type: root.res-dialog == "interval" ? InputType.number : InputType.text;
                    init => { self.focus-input(); }
                }
                if root.res-dialog == "interval": Text { text: "小时"; font-size: 15px; color: Theme.s.on-surface-variant; vertical-alignment: center; }
            }
            if root.res-error != "": HorizontalLayout { padding-left: 14px; Text { text: root.res-error; font-size: 13px; color: Theme.s.error; } }
            HorizontalLayout {
                spacing: 8px;
                if root.res-dialog-default != "": TextButton { text: "重置"; clicked => { root.res-dialog-value = root.res-dialog-default; } }
                Rectangle { horizontal-stretch: 1; }
                TextButton { text: "取消"; clicked => { root.res-dialog = ""; } }
                TextButton {
                    text: "确定";
                    enabled: root.res-check(root.res-dialog, root.res-dialog-value) == "";
                    clicked => {
                        root.res-dialog-submit(root.res-dialog, root.res-dialog-key, root.res-dialog-value);
                        root.res-dialog = "";
                    }
                }
            }
        }

        if root.confirm-open: Dialog {
            title: root.confirm-title;
            top: root.top-inset;
            dismissable: false;
            Text { text: root.confirm-text; wrap: word-wrap; color: Theme.s.on-surface-variant; font-size: 15px; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                TextButton { text: root.confirm-action == "access-save" ? "不保存" : "取消"; clicked => { root.confirm-open = false; root.confirm-answer(root.confirm-action, root.confirm-arg, false); } }
                TextButton {
                    text: root.confirm-action == "access-save" ? "保存" : root.confirm-action == "app-settings" ? "设置" : root.confirm-action == "delete" ? "删除" : root.confirm-action == "close-active" ? "关闭" : "确定";
                    danger: root.confirm-action == "delete" || root.confirm-action == "close-active";
                    clicked => { root.confirm-open = false; root.confirm-answer(root.confirm-action, root.confirm-arg, true); }
                }
            }
        }

        if root.choice-open: ActionSheet {
            title: root.choice-title;
            items: root.choice-items;
            bottom-inset: root.bottom-inset;
            picked(id) => { root.choice-open = false; root.choice-picked(id); }
            dismiss => { root.choice-open = false; }
        }

        if root.input-open: Dialog {
            title: root.input-title;
            keyboard: root.keyboard;
            top: root.top-inset;
            dismiss => { root.input-open = false; }
            Field {
                label: root.input-label;
                text <=> root.input-value;
                input-type: root.input-number ? InputType.number : InputType.text;
                init => { self.focus-input(); }
            }
            if root.input-label2 != "": Field { label: root.input-label2; text <=> root.input-value2; }
            if root.input-error != "": HorizontalLayout { padding-left: 14px; Text { text: root.input-error; font-size: 13px; color: Theme.s.error; wrap: word-wrap; } }
            HorizontalLayout {
                spacing: 8px;
                if root.input-removable: TextButton { text: "删除"; danger: true; clicked => { root.input-open = false; root.input-remove(root.input-key); } }
                Rectangle { horizontal-stretch: 1; }
                TextButton { text: "取消"; clicked => { root.input-open = false; } }
                TextButton {
                    text: "确定";
                    enabled: root.input-error == "";
                    clicked => {
                        root.input-open = false;
                        root.input-submit(root.input-key, root.input-value, root.input-value2);
                    }
                }
            }
        }

        if root.ports-open: Dialog {
            title: "端口";
            keyboard: root.keyboard;
            top: root.top-inset;
            dismiss => { root.ports-open = false; }
            Field { label: "混合端口"; text <=> root.port-mixed; input-type: InputType.number; init => { self.focus-input(); } }
            Field { label: "端口"; text <=> root.port-http; input-type: InputType.number; }
            Field { label: "Socks端口"; text <=> root.port-socks; input-type: InputType.number; }
            if root.ports-error != "": HorizontalLayout { padding-left: 14px; Text { text: root.ports-error; font-size: 13px; color: Theme.s.error; wrap: word-wrap; } }
            HorizontalLayout {
                spacing: 8px;
                TextButton { text: "重置"; clicked => { root.port-mixed = "7890"; root.port-http = "0"; root.port-socks = "0"; } }
                Rectangle { horizontal-stretch: 1; }
                TextButton { text: "取消"; clicked => { root.ports-open = false; } }
                TextButton {
                    text: "确定";
                    enabled: root.ports-error == "";
                    clicked => {
                        root.ports-open = false;
                        root.ports-submit(root.port-mixed, root.port-http, root.port-socks);
                    }
                }
            }
        }

        if root.dav-open: Dialog {
            title: "WebDAV配置";
            keyboard: root.keyboard;
            top: root.top-inset;
            dismiss => { root.dav-open = false; }
            Field { label: "地址"; text <=> root.dav-uri; init => { self.focus-input(); } }
            Field { label: "账号"; text <=> root.dav-user; }
            Field { label: "密码"; text <=> root.dav-pass; input-type: InputType.password; }
            if root.dav-error != "": HorizontalLayout { padding-left: 14px; Text { text: root.dav-error; font-size: 13px; color: Theme.s.error; wrap: word-wrap; } }
            HorizontalLayout {
                spacing: 8px;
                if root.dav-bound: TextButton { text: "删除"; danger: true; clicked => { root.dav-open = false; root.dav-delete(); } }
                Rectangle { horizontal-stretch: 1; }
                TextButton { text: "取消"; clicked => { root.dav-open = false; } }
                TextButton {
                    text: "保存";
                    enabled: root.dav-error == "";
                    clicked => {
                        root.dav-open = false;
                        root.dav-submit(root.dav-uri, root.dav-user, root.dav-pass);
                    }
                }
            }
        }

        if root.alert-open: Dialog {
            title: root.alert-title;
            top: root.top-inset;
            dismiss => { root.alert-open = false; }
            Text { text: root.alert-text; wrap: word-wrap; color: Theme.s.on-surface-variant; font-size: 15px; }
            HorizontalLayout {
                alignment: end;
                TextButton { text: "确定"; clicked => { root.alert-open = false; } }
            }
        }
    }
}
