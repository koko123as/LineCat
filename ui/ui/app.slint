// SeasonCat UI. FlClash's mobile layout (bottom bar: dashboard, proxies, profiles, tools;
// dashboard cards with a start button at the bottom right; proxies as group tabs over a
// two-column grid of nodes; logs and theme under tools), drawn flat: plain filled
// surfaces, no blur, no glass, no shadows. Colors follow prism_ui's seeded scheme
// (see src/theme.rs, generated by examples/gen_theme.rs).
import { Palette, ListView, Spinner } from "std-widgets.slint";

export struct Scheme {
    primary: color,
    on-primary: color,
    primary-container: color,
    on-primary-container: color,
    tertiary: color,
    page: color,
    card: color,
    block: color,
    inset: color,
    on-surface: color,
    on-surface-variant: color,
    outline-variant: color,
    error: color,
}

// `ThemeProps.fontFamily` and the text scale every font size is multiplied by.
export global Type {
    in property <float> scale: 1;
    in property <string> family;
}

export global Theme {
    in property <Scheme> light;
    in property <Scheme> dark;
    // 0 follow system, 1 light, 2 dark
    in property <int> mode: 0;
    out property <bool> is-dark: mode == 2 || (mode == 0 && Palette.color-scheme == ColorScheme.dark);
    out property <Scheme> s: is-dark ? dark : light;
    // Status colors of prism_ui's ColorSchemeExtension (success / warning tones 40 and 80).
    out property <color> success: is-dark ? #7ddc7a : #1b6d24;
    out property <color> warning: is-dark ? #ffb870 : #8b5000;
}

export struct ProfileItem {
    id: string,
    name: string,
    // FlClash's subtitle: "used / total" from the subscription, else 远程 / 本地.
    subtitle: string,
    // Last update, compact ("3 小时前").
    trailing: string,
    // Expiry date chip, empty for none.
    expire: string,
    expired: bool,
    active: bool,
    busy: bool,
    is-url: bool,
    is-custom: bool,
    // `_GroupsCountChip`: the custom profile's group count, compact.
    groups: string,
}

// A row of the custom profile's overview (`_sectionRow`): `tone` 0 plain, 1 in effect, 2
// invalid.
export struct CustomRow {
    id: string,
    glyph: string,
    title: string,
    state: string,
    tone: int,
}

// `_ProxyGroupItem`: the group's name, type name, icon url or monogram, issue mark and
// whether it is selected.
export struct GroupRow {
    id: string,
    name: string,
    kind: string,
    icon: string,
    mark: string,
    invalid: bool,
    selected: bool,
}

export struct NodeItem {
    name: string,
    // The type, or for a group the type and the proxy it stands for.
    kind: string,
    // >0 ms, 0 untested, -1 timeout, -2 failed, -3 running, -4 queued
    delay: int,
    // In use by its group.
    selected: bool,
    // Pinned in a group that picks by itself.
    pinned: bool,
    // `_isAddableToLocal`: the menu offers 添加到本地代理.
    addable: bool,
}

export struct ProxyGroup {
    name: string,
    kind: string,
    now: string,
    count: int,
    monogram: string,
    expanded: bool,
    testing: bool,
    nodes: [NodeItem],
}

// ProxiesStyleProps: kind 0 tab 1 list; sort 0 default 1 delay 2 name; layout 0 tight
// 1 standard 2 loose; card 0 compact 1 standard 2 loose; icon 0 filled 1 plain 2 hidden.
export struct DashTraffic {
    up-value: string,
    up-unit: string,
    up-total: string,
    up-peak: string,
    up-line: string,
    up-fill: string,
    down-value: string,
    down-unit: string,
    down-total: string,
    down-peak: string,
    down-line: string,
    down-fill: string,
}

export struct DashStatus {
    ip: string,
    country: string,
    // 住宅 / 移动网络 / 机房 / 类型未知
    kind: string,
    // 0 unknown, 1 good, 2 normal, 3 risky
    quality: int,
    org: string,
    probing: bool,
    // `probe.outboundIp` failed: "检测失败", and a tap on the badge retries.
    failed: bool,
}

// A service of the service status card (`_ServiceView`): tone 0 muted 1 ok 2 warning 3 error.
export struct DashService {
    id: string,
    label: string,
    status: string,
    tone: int,
    dot: int,
    // The sheet's line under the name (`_OutboundIpLine`) and its checking state.
    place: string,
    loading: bool,
    // Where the check left from; a tap on the address opens its IP quality sheet.
    ip: string,
    region: string,
}

// A row of `ServiceManageView`: shown on the dashboard, and the last enabled one locked on.
export struct ServiceManageRow {
    id: string,
    label: string,
    enabled: bool,
    shown: bool,
    locked: bool,
}

// `ConnectionStatsCard`'s counts.
export struct DashStats {
    connections: string,
    requests: string,
    dns: string,
}

// `ConnectionsTableCard` (`dash_table.rs`): a column's place, a cell and a row.
export struct DashCol {
    id: string,
    label: string,
    x: length,
    w: length,
    end: bool,
    // 0 unsorted, 1 ascending, 2 descending
    sort: int,
}

export struct DashCell {
    text: string,
    tone: int,
    badge: string,
}

export struct DashRow {
    cells: [DashCell],
}

// `LiveStatusButton` and its deck (`live_status.rs`). Tones: 0 neutral, 1 error,
// 2 warning, 3 success, 4 primary.
export struct LivePill {
    kind: string,
    tone: int,
    text: string,
    progress: float,
}

export struct LiveWarning {
    path: string,
    message: string,
}

export struct LiveCard {
    kind: string,
    tint: int,
    title: string,
    body: string,
    action: string,
    action-tone: int,
    ask-title: string,
    ask-body: string,
    ask-label: string,
    big: string,
    tag: string,
    ticks-on: string,
    ticks-off: string,
    chips: [string],
    warnings: [LiveWarning],
}

// A card the editor can add (`_AddRow`).
export struct DashAdd {
    id: string,
    label: string,
    desc: string,
}

// `MemoryDetailSheet`'s figures, formatted.
export struct DashMemory {
    total: string,
    app: string,
    shared: bool,
}

// `ProfileDetailSheet`: the counts are empty until the profile is read, "-" when it fails.
export struct DashProfileDetail {
    groups: string,
    proxies: string,
    rules: string,
    providers: string,
    updated: string,
    script: string,
    remote: bool,
}

// `_ExternalProviderItem`: the count, or with a subscription its traffic meter and the
// count as a chip; the expiry chip; a spinner or when it was last updated.
export struct ProviderRow {
    name: string,
    subtitle: string,
    chip: string,
    expire: string,
    expired: bool,
    meter: bool,
    traffic: string,
    ratio: float,
    updated: string,
    busy: bool,
    previewable: bool,
}

export struct DashProfile {
    id: string,
    name: string,
    // 剩余 N 天, or 远程 / 本地
    end: string,
    warn: bool,
    updated: string,
    usage: bool,
    percent: string,
    used: string,
    ratio: float,
    syncable: bool,
    busy: bool,
}

export struct ProxyStyle {
    kind: int,
    sort: int,
    layout: int,
    card: int,
    icon: int,
    hide-timeout: bool,
}

// A log record as `LogItem` draws it: the payload read by `LogPayload.parse`.
export struct LogItem {
    id: int,
    level: string,
    time: string,
    text: string,
    tag: string,
    message: string,
    has-route: bool,
    dest: string,
    error: string,
    rule: string,
    proxy: string,
    source: string,
}

// `RecordLabel`: a tonal chip after a record's line; tone 0 neutral, 1 error, 2 success,
// 3 warning.
export struct RecordLabel {
    text: string,
    tone: int,
}

// Where `RecordLabelLine` puts its parts in `room`.
export struct LineLayout {
    text-shown: bool,
    text-w: length,
    last-shown: bool,
    last-w: length,
    // Where the last label starts after the text.
    before-last: length,
}

// A row of the requests lists: a minute's header, or a record under it.
export struct RecordRow {
    header: bool,
    label: string,
    count: string,
    id: int,
    well: string,
    // The package whose icon takes the well's place once the shell gives it.
    app: string,
    well-label: bool,
    title: string,
    // `RecordLabelLine` under the title.
    line: string,
    labels: [RecordLabel],
    top: string,
    top-strong: bool,
    // 0 plain, 1 error, 2 success, 3 warning, 4 muted
    top-tone: int,
    bottom: string,
    first: bool,
    last: bool,
    selected: bool,
    // `showFull`, local: what the scrollbar's hint shows at this row.
    time: string,
}

export struct ConditionItem {
    index: int,
    text: string,
    // Joined to the one before by 或.
    or: bool,
}

// A run of a line's chips that fits the block's width.
export struct ConditionRow {
    items: [ConditionItem],
}

export struct ConditionLine {
    label: string,
    rows: [ConditionRow],
}

export struct Suggestion {
    value: string,
    count: string,
}

// kind: text, stacked, rail (mark 0 step, 1 end, 2 error), link, code, traffic. A tap
// sends arg: copy:<text>, conn:<id> or http:<id>.
export struct DetailRow {
    kind: string,
    title: string,
    value: string,
    note: string,
    trailing: string,
    tone: int,
    mark: int,
    first: bool,
    last: bool,
    arg: string,
    labels: [RecordLabel],
    image: image,
    // A long press opens the row's menu, as `ContextMenuRegion` does.
    menu: bool,
}

export struct DetailSection {
    title: string,
    // `ListHeader.caption`: a body's size and type after its title.
    caption: string,
    plain: bool,
    rows: [DetailRow],
    footer: string,
}

export struct ReqDetail {
    has: bool,
    loading: bool,
    sheet-title: string,
    well: string,
    app: string,
    well-label: bool,
    title: string,
    subtitle: string,
    labels: [RecordLabel],
    closable: bool,
    menu: bool,
    tabs: [string],
    tab: int,
    sections: [DetailSection],
    empty: string,
    hint: string,
}

export struct ActionItem {
    id: string,
    glyph: string,
    heading: string,
    label: string,
    subtitle: string,
    check: bool,
    checked: bool,
    danger: bool,
    enabled: bool,
    sub: bool,
    section: bool,
}

// A colour of the theme page's swatches; `system` is the one that follows the system.
export struct Swatch {
    fill: color,
    // The system's colour differs between light and dark.
    fill-dark: color,
    system: bool,
    selected: bool,
    light-ink: bool,
    light-ink-dark: bool,
}

export struct ResourceItem {
    key: string,
    title: string,
    subtitle: string,
    chip: string,
    url: string,
    busy: bool,
}

// A row of a settings list (`ListItem`): kind "open" (chevron), "value" (subtitle, tap to
// edit), "value-icon" (the same with its leading icon), "toggle", "action", "link"
// (external) or "person" (a monogram in place of the icon).
export struct SetRow {
    id: string,
    kind: string,
    glyph: string,
    title: string,
    subtitle: string,
    on: bool,
    enabled: bool,
    // "remove": led by the button that takes the row off (`EntryButton.remove`); "add": the
    // row that adds one, led by `EntryButton.add`.
    lead: string,
    // `ChipTitle`'s chip after the title, and a caption at the row's end.
    chip: string,
    trailing: string,
    // A picture behind an http url leads the row in place of the glyph (`CommonTargetIcon`).
    image: string,
    // `DecorationListItem.invalid`: an error mark before the row's end.
    invalid: bool,
}

// What the page shell needs of a settings page Rust builds: its title, where back goes,
// the bar's action, whether it has an add button, and what it shows while empty.
export struct PageMeta {
    known: bool,
    title: string,
    parent: string,
    action: string,
    // A second bar action, left of the first.
    action2: string,
    fab: bool,
    empty: string,
    empty-desc: string,
    empty-action: string,
    long-press: bool,
    // `AppBarSearchState`: a search in the bar, sent as `search:<query>`.
    search: bool,
    // The bar action stays while the page is empty (an add menu with more than 添加).
    action-empty: bool,
    // Rows are being selected: the bar holds 删除 and 全选 (`selectionActions`), back clears.
    selecting: bool,
}

// An installed app on the access control page (`PackageListItem`).
export struct AccessRow {
    name: string,
    label: string,
    monogram: string,
    checked: bool,
}

// `generateSection`: a titled group of rows with an optional footer.
export struct SetSection {
    title: string,
    footer: string,
    rows: [SetRow],
}

// ---------------------------------------------------------------- Icons
// 24x24 outline glyphs, stroked.

// The phone's floating dock: how much of a page's bottom it covers, so pages pad their
// scroll ends and lift their buttons above it.
global Dock {
    in-out property <length> pad: 88px;
}

