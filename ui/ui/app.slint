    callback req-hex-columns(int);
    in-out property <bool> req-actions-open;
    in property <string> req-actions-title;
    in property <[ActionItem]> req-actions;
    // A tools page pushed over the page (a module's editor from a request's menu) hides it.
    property <bool> tools-covering: root.tools-over && root.tools-page != "";
    property <bool> req-tab-visible: (root.tab == 4 && !root.tools-covering) || (root.tools-shown && root.tools-page == "requests");
    out property <bool> req-visible: root.req-tab-visible || (root.tab == 0 && root.feed-open && !root.tools-covering);
    // `openDashboardFeed`: the requests page in a sheet over the dashboard, with its own
