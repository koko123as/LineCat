    // The condition chips' row width, which Rust wraps them to.
    callback req-cond-width(length);
    // Whether the requests page shows its detail beside the list.
    in-out property <bool> req-split;
    callback req-search(string);
    callback req-open-menu();
    callback req-set-segment(int);
    callback req-set-status(int);
    callback req-status-menu();
    callback req-add-condition();
    callback req-edit-condition(int);
    callback req-remove-condition(int);
    callback req-clear-conditions();
    callback req-select(int, bool);
    callback req-row-menu(int);
    callback req-detail-tab(int);
    callback req-detail-close();
    callback req-detail-menu();
    callback req-detail-row(string);
    callback req-sheet-closed();
    callback req-action(string);
    // Condition dialog (`showConditionDialog`)
    in-out property <bool> cond-open;
    in property <bool> cond-editing;
    in property <[string]> cond-fields;
    in-out property <int> cond-field;
    in-out property <int> cond-op;
    in-out property <string> cond-value;
    in property <[Suggestion]> cond-suggestions;
    in property <string> cond-values-in;
    in property <string> cond-shows;
    in property <string> cond-tip;
    in property <bool> cond-ready;
    callback cond-changed();
    callback cond-submit();
    // Resources
    in property <[ResourceItem]> res-items;
    in property <[ResourceItem]> res-icon-sets;
    in property <[ResourceItem]> res-rule-sets;
    in property <[ResourceItem]> res-scripts;
    in property <[ResourceItem]> res-modules;
    in property <bool> res-auto;
    in property <string> res-interval;
    in property <bool> res-updating;
    // The open input dialog: "", "interval" or "url".
    in-out property <string> res-dialog;
    in-out property <string> res-dialog-title;
    in-out property <string> res-dialog-value;
    in-out property <string> res-dialog-default;
    in-out property <string> res-dialog-key;
    in-out property <bool> res-touched;
    property <string> res-error: root.res-touched && root.res-dialog != "" ? root.res-check(root.res-dialog, root.res-dialog-value) : "";
    callback res-update-all();
    callback res-set-auto(bool);
    callback res-open-interval();
    callback res-tapped(string);
    callback res-menu(string);
    callback res-dialog-submit(string, string, string);
    pure callback res-check(string, string) -> string;
    pure callback res-digits(string) -> string;
    // Settings under tools: the tools list, the open settings page's
    // sections, a picker sheet and a one or two field input dialog.
    in property <[SetSection]> tools-sections;
    in property <[SetSection]> page-sections;
    // The tools tab's text editor (a script's content), and the page it returns to.
    in-out property <string> tools-editor-title;
    in property <bool> tools-editor-title-editable;
    in-out property <string> tools-editor-text;
    in property <string> tools-editor-parent;
    in property <bool> tools-editor-readonly;
    in-out property <bool> tools-editor-loading;
    in-out property <string> tools-editor-error;
    // Back asks Rust first, which offers to save a changed MITM module.
    in property <bool> tools-editor-guard;
    callback tools-editor-back(string);
    // 图标集's preview (`icon_sets_app.rs`).
    in property <string> iconset-title;
    in property <[IconTile]> iconset-tiles;
    in property <string> iconset-empty;
    in-out property <bool> iconset-searching;
    in-out property <string> iconset-query;
    callback iconset-search(string);
    callback tools-editor-save(string);
    // The settings pages Rust builds (`page-meta` names them).
    pure callback page-meta(string, int) -> PageMeta;
    // Bumped when the open page's bar changes without the page changing.
    in property <int> meta-rev;
    property <PageMeta> meta: root.page-meta(root.tools-page, root.meta-rev);
    // The port form (`PortForm`)
    in-out property <bool> ports-open;
    in-out property <string> port-mixed;
    in-out property <string> port-http;
    in-out property <string> port-socks;
    pure callback ports-check(string, string, string) -> string;
    callback ports-submit(string, string, string);
    property <string> ports-error: root.ports-open ? root.ports-check(root.port-mixed, root.port-http, root.port-socks) : "";
    in property <bool> pure-black;
    in property <string> app-version;
    in property <image> app-icon;
    in property <bool> update-checking;
    callback tools-clicked(string);
    callback set-clicked(string, string);
    callback set-toggled(string, string, bool);
    callback set-pure-black(bool);
    callback check-update();
    callback about-logo-tapped();
    // `HomeBackScopeContainer`: back with nothing left to close on the root page.
    callback close-app();
    in-out property <bool> choice-open;
    in property <string> choice-title;
    in-out property <bool> choice-loading;
    in property <[ActionItem]> choice-items;
    callback choice-picked(string);
    in-out property <bool> input-open;
    in property <string> input-title;
    in property <string> input-key;
    in property <string> input-label;
    in property <string> input-label2;
    in-out property <string> input-value;
    in-out property <string> input-value2;
    in property <bool> input-removable;
    in property <bool> input-number;
    // A hint inside the empty field, and a field of at least this many lines.
    in property <string> input-hint;
    in property <int> input-lines;
    // `_ShareLinkDialog`: 确定 alone, kept open while Rust reads the value (`input-busy`
    // disables it); Rust closes it, or sets `input-fail` under the field.
    in property <bool> input-holds;
    in-out property <bool> input-busy;
    in-out property <string> input-fail;
    pure callback input-check(string, string, string) -> string;
    callback input-submit(string, string, string);
    property <string> input-error: !root.input-open ? "" : root.input-fail != "" ? root.input-fail : root.input-check(root.input-key, root.input-value, root.input-value2);
    callback input-remove(string);
    // Access control
    in property <[AccessRow]> acc-rows;
    in property <bool> acc-enabled;
    in property <bool> acc-changed;
    in property <bool> acc-all-selected;
    in property <bool> acc-can-select-all;
    in property <bool> acc-loading;
    in property <bool> acc-needs-permission;
    in property <bool> acc-authorize;
    in property <string> acc-status;
    in property <string> acc-count;
    in-out property <bool> acc-searching;
    in-out property <string> acc-query;
    callback acc-back();
    callback acc-toggle(string);
    callback acc-select-all();
    callback acc-save();
    callback acc-menu();
    callback acc-enable();
    callback acc-grant();
    callback acc-search(string);
    // WebDAV form (`WebDAVForm`)
    in-out property <bool> dav-open;
    in property <bool> dav-bound;
    in-out property <string> dav-uri;
    in-out property <string> dav-user;
    in-out property <string> dav-pass;
    pure callback dav-check(string, string, string) -> string;
    callback dav-submit(string, string, string);
    callback dav-delete();
    property <string> dav-error: root.dav-open ? root.dav-check(root.dav-uri, root.dav-user, root.dav-pass) : "";
    // Feedback
    in property <string> toast;

    callback page-shown();
    changed req-visible => { if (root.req-visible) { root.page-shown(); } }
    callback tools-page-changed();
    changed tools-page => {
        if (root.tools-over && root.tools-page == "") { root.tools-over = false; }
        root.set-sorting = false;
        if (root.tools-page == "resources") { root.page-shown(); }
        if (root.tools-page != "editor") {
            root.tools-editor-loading = false;
            root.tools-editor-error = "";
        }
        root.tools-page-changed();
    }
    changed choice-open => {
        if (!root.choice-open) { root.choice-loading = false; }
    }
    changed cond-value => { root.cond-changed(); }
    changed res-dialog-value => {
        if (root.res-dialog == "interval") {
            if (root.res-digits(root.res-dialog-value) != root.res-dialog-value) {
                root.res-dialog-value = root.res-digits(root.res-dialog-value);
            }
        }
        root.res-touched = true;
    }

    public function links-done() {
        root.link-open = false;
        link-name.text = "";
        link-url.text = "";
        link-age.text = "";
        root.link-batch = false;
    }

    // `_toPage` (FlClash: lib/views/home.dart) on a phone: the page slides in from the side it lies on, or
    // cross-fades in place, with the page it leaves drawn until the switch ends.
    property <int> tab-prev: -1;
    property <duration> tab-started;
    property <duration> tab-span: root.tab-fade ? 220ms : 300ms;
    property <float> tab-t: root.tab-prev >= 0 ? clamp((animation-tick() - root.tab-started) / root.tab-span, 0, 1) : 1;
    property <float> tab-eased: root.tab-fade ? root.tab-t * root.tab-t * (3 - 2 * root.tab-t) : 1 - (1 - root.tab-t) * (1 - root.tab-t);
    property <float> tab-dir: root.tab-prev > root.tab ? -1 : 1;
    // The page left stays drawn only until the switch ends: faded out it would still sit
    // over the new page and take its touches.
    property <int> tab-leaving: root.tab-t < 1 ? root.tab-prev : -1;
    pure function tab-x(t: int) -> length {
        if (root.tab-prev < 0 || root.tab-fade) { return 0px; }
        if (t == root.tab) { return root.tab-dir * root.width * (1 - root.tab-eased); }
        if (t == root.tab-prev) { return -root.tab-dir * root.width * root.tab-eased; }
        return 0px;
    }
    pure function tab-opacity(t: int) -> float {
        if (root.tab-prev < 0 || !root.tab-fade) { return 1; }
        if (t == root.tab) { return root.tab-eased; }
        if (t == root.tab-prev) { return 1 - root.tab-eased; }
        return 1;
    }
    tab-done := Timer {
        interval: root.tab-span;
        running: root.tab-prev >= 0;
        triggered => { root.tab-prev = -1; }
    }
    function nav(t: int) {
        if (!root.wide && t != root.tab && root.tab <= 3) {
            root.tab-prev = root.tab;
            root.tab-started = animation-tick();
            tab-done.restart();
        }
        root.go(t);
    }

    // `DashboardFeed`: 0 live connections (on the active ones), 1 recent requests, 2 DNS.
    public function open-feed(feed: int) {
        root.feed-tall = false;
        root.feed-searching = false;
        root.feed-query = "";
        root.req-sheet-open = false;
        root.feed-open = true;
        root.req-feed(true, feed);
    }
    public function close-feed() {
        root.req-sheet-open = false;
        root.feed-open = false;
        root.req-feed(false, 0);
    }
    // The sheet searches on its own; the proxies page's query comes back once it closes.
    public function open-group-sheet() {
        root.group-sheet-tall = false;
        root.group-sheet-searching = false;
        root.search-proxies("");
        root.group-sheet-open = true;
    }
    public function close-group-sheet() {
        root.group-sheet-open = false;
        root.group-sheet-searching = false;
        root.search-proxies(proxies-page.query);
    }

    // A tools page pushed over the current page, as 前往配置脚本 pushes ScriptsView over the
    // extend page: the bar keeps its tab and back leaving the tools page returns there.
    in-out property <bool> tools-over;
    in-out property <string> tools-over-root;
    property <bool> tools-shown: root.tab == 3 || root.tools-over;
    // A custom profile opened over the dashboard (`showCustomProfileSheet`, `_toAddCustom`).
    in-out property <bool> profiles-over;
    property <bool> profiles-shown: root.tab == 2 || root.profiles-over;
    changed profiles-page => {
        if (self.profiles-page == "") { root.profiles-over = false; }
        if (self.profiles-page != "editor" && self.profiles-page != "preview") {
            root.editor-loading = false;
            root.editor-error = "";
        }
    }
    changed profiles-over => {
        root.po-tall = false;
        root.po-drag = 0px;
    }
    // The custom profile's sheet over the dashboard: its pages sit in the sheet's frame.
    property <bool> po-tall;
    property <length> po-drag;
    property <float> po-fling;
    property <length> po-last-y;
    property <duration> po-last-t;
    pure function po-sheet-h(ph: length) -> length {
        return clamp((root.po-tall ? min(root.height * 0.9, ph) : root.height * 9 / 16) - root.po-drag, 0px, ph);
    }
    pure function po-w(pw: length) -> length {
        return !root.profiles-over ? pw : root.wide ? min(pw, SideSheet.width(root.width)) : min(pw, 640px);
    }
    pure function po-x(pw: length) -> length {
        return !root.profiles-over ? 0px : root.wide ? pw - root.po-w(pw) : (pw - root.po-w(pw)) / 2;
    }
    pure function po-top(ph: length) -> length {
        return !root.profiles-over || root.wide ? 0px : ph - root.po-sheet-h(ph);
    }
    pure function po-y(ph: length) -> length {
        return root.po-top(ph) + (root.profiles-over && !root.wide ? 24px : 0px);
    }
    function po-settle() {
        let short = root.height * 9 / 16;
        let d = root.po-drag;
        let v = animation-tick() - root.po-last-t > 100ms ? 0 : root.po-fling;
        root.po-drag = 0px;
        if (d > (root.po-tall ? root.height * 0.9 - short / 2 : short / 2) || (!root.po-tall && SheetDrag.closes(d, short, v))) {
            root.custom-back();
        } else if (root.po-tall && d > 48px) {
            root.po-tall = false;
        } else if (!root.po-tall && d < -48px) {
            root.po-tall = true;
        }
    }
    public function open-tools(page: string) {
        root.tools-over = root.tab != 3;
        root.tools-over-root = page;
        root.tools-page = page;
    }
    // Up from a tools page: to its parent, or off the pushed one back to the page under it.
    function tools-up(parent: string) {
        root.tools-page = root.tools-over && root.tools-page == root.tools-over-root ? "" : parent;
    }

    function go(t: int) {
        if (root.custom-open) { root.custom-back(); }
        if (root.feed-open) { root.close-feed(); }
        if (root.group-sheet-open) { root.close-group-sheet(); }
        root.tab = t;
        root.tools-over = false;
        root.tools-page = "";
        root.profiles-page = "";
        root.profiles-over = false;
        root.tab-changed(t);
    }

    property <bool> wide: root.width > 600px;
    // The custom profile's bottom sheet over the dashboard is modal: it covers the bar.
    property <bool> po-modal: root.profiles-over && root.profiles-page != "" && !root.wide;
    property <length> dock-pad: !root.wide && root.keyboard == 0 && root.floating-bar && !root.po-modal ? 88px + root.bottom-inset : 0px;
    changed dock-pad => { Dock.pad = self.dock-pad; }
    init => { Dock.pad = self.dock-pad; }
    // `navigationItemsState`: 代理 shows once the Core has groups, or before the first
    // load while there are profiles.
    in property <bool> groups-loaded;
    property <bool> has-proxies: root.groups-loaded ? root.proxy-groups.length > 0 : root.profiles.length > 0;
    changed has-proxies => { if (!root.has-proxies && root.tab == 1) { root.go(0); } }
    // `capturesHttp`: while HTTP is captured 请求 is a phone destination too.
    in property <bool> captures-http;
    changed captures-http => { if (!root.captures-http && !root.wide && root.tab == 4) { root.go(0); } }
    // `shownPageLabelOf`: without capture 请求 has no phone item, so a window narrowed on it
    // shows the first item, and widening again returns to 请求.
    property <bool> narrowed-from-requests;
    changed wide => {
        if (!root.wide && root.tab == 4 && !root.captures-http) {
            root.go(0);
            root.narrowed-from-requests = true;
        } else if (root.wide && root.narrowed-from-requests && root.tab == 0) {
            root.go(4);
            root.narrowed-from-requests = false;
        } else {
            root.narrowed-from-requests = false;
        }
    }
    property <bool> desktop: root.width > 840px;
    // `AppSettingProps.sidebarExpanded` (default on), and the pane opened over a laptop
    // width page. `chromeSurface`: surfaceContainerHighest, dark surfaceContainerLow.
    in property <bool> sidebar-expanded: true;
    callback set-sidebar-expanded(bool);
    property <color> chrome: Theme.is-dark ? Theme.s.card : Theme.s.inset;
    property <bool> side-overlay;
    property <float> side-progress: root.desktop && root.sidebar-expanded ? 1 : 0;
    animate side-progress { duration: 250ms; easing: cubic-bezier(0.2, 0, 0, 1); }
    property <float> side-overlay-p: root.side-overlay ? 1 : 0;
    animate side-overlay-p { duration: root.desktop ? 0ms : 250ms; easing: cubic-bezier(0.2, 0, 0, 1); }
    changed desktop => { if (self.desktop) { root.side-overlay = false; } }
    property <[SideDest]> side-items: root.has-proxies
        ? [{ tab: 0, label: "仪表盘", glyph: Icons.dashboard }, { tab: 1, label: "代理", glyph: Icons.proxies }, { tab: 4, label: "请求", glyph: Icons.requests }, { tab: 2, label: "配置", glyph: Icons.profiles }, { tab: 3, label: "工具", glyph: Icons.tools }]
        : [{ tab: 0, label: "仪表盘", glyph: Icons.dashboard }, { tab: 4, label: "请求", glyph: Icons.requests }, { tab: 2, label: "配置", glyph: Icons.profiles }, { tab: 3, label: "工具", glyph: Icons.tools }];
    property <int> side-shift: root.has-proxies ? 1 : 0;
    property <int> side-index: root.tab == 0 ? 0 : root.tab == 1 ? 1 : root.tab == 4 ? 1 + root.side-shift : root.tab == 2 ? 2 + root.side-shift : root.tab == 3 ? 3 + root.side-shift : -1;
    function side-toggle() {
        if (root.desktop) {
            root.set-sidebar-expanded(!root.sidebar-expanded);
        } else {
            root.side-overlay = !root.side-overlay;
        }
    }
    // WindowEdges.kt: Slint's safe area can carry the whole screen's bars in a freeform window.
    in property <bool> insets-known;
    in property <length> inset-top;
    in property <length> inset-bottom;
    in property <length> inset-left;
    in property <length> inset-right;
    callback window-resized();
    changed width => { root.window-resized(); }
    changed height => { root.window-resized(); }
    property <length> top-inset: root.insets-known ? root.inset-top : max(root.safe-area-insets.top, 0px);
    property <length> bottom-inset: root.insets-known ? root.inset-bottom : max(root.safe-area-insets.bottom, 0px);
    property <length> keyboard: root.virtual-keyboard-size.height > 0 ? root.virtual-keyboard-size.height : 0px;

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Back) {
                // A search field that closes takes the focus with it; back keeps it here.
                keys.focus();
                if (root.alert-open) { root.alert-open = false; return accept; }
                if (root.live-open) { root.live-close(); return accept; }
                if (root.input-open) { root.input-open = false; return accept; }
                if (root.choice-open) { root.choice-open = false; return accept; }
                if (root.cond-open) { root.cond-open = false; return accept; }
                if (root.res-dialog != "") { root.res-dialog = ""; return accept; }
                if (root.req-actions-open) { root.req-actions-open = false; return accept; }
                if (root.req-body-page == "text" && root.editor-menu-open) { root.editor-menu-open = false; return accept; }
                if (root.req-body-page == "text" && root.editor-finding) { root.editor-finding = false; return accept; }
                if (root.req-body-page != "") { root.req-body-page = ""; return accept; }
                if (root.log-detail-open) { root.log-detail-open = false; return accept; }
                if (root.ip-sheet-open) { root.ip-sheet-open = false; return accept; }
                if (root.mem-sheet-open) { root.mem-sheet-open = false; return accept; }
                if (root.svc-sheet-open && root.svc-sheet-page != "") { root.svc-sheet-page = ""; return accept; }
                if (root.svc-sheet-open) { root.svc-sheet-open = false; return accept; }
                if (root.picker-open) { root.picker-open = false; return accept; }
                if (root.profile-sheet-open) { root.profile-sheet-open = false; return accept; }
                if (root.tools-shown && root.tools-page == "logs" && root.log-searching) { root.log-searching = false; root.log-query = ""; return accept; }
                if (root.req-sheet-open) { root.req-sheet-open = false; root.req-sheet-closed(); return accept; }
                if (root.feed-open && root.feed-searching) { root.feed-searching = false; root.feed-query = ""; return accept; }
                if (root.feed-open) { root.close-feed(); return accept; }
                if (root.req-visible && root.req-searching) { root.req-searching = false; root.req-query = ""; return accept; }
                if (root.ctx-kind != "") { root.ctx-kind = ""; return accept; }
                if (root.tools-shown && root.set-sorting) { root.set-sorting = false; return accept; }
                if (root.tools-shown && root.meta.known && root.meta.selecting) { root.set-clicked(root.tools-page, "sel-clear"); return accept; }
                if (root.proxy-sub != "") { root.proxy-sub = ""; return accept; }
                if (root.proxy-options-open) { root.proxy-options-open = false; return accept; }
                if (root.group-sheet-open && root.group-sheet-searching) { root.group-sheet-searching = false; root.search-proxies(""); return accept; }
                if (root.group-sheet-open) { root.close-group-sheet(); return accept; }
                if (root.tab == 1 && root.proxy-searching) { root.proxy-searching = false; root.search-proxies(""); return accept; }
                if (root.confirm-open && (root.confirm-action == "access-save" || root.confirm-action == "pg-save" || root.confirm-action == "pr-save" || root.confirm-action == "script-save" || root.confirm-action == "rs-save")) { root.confirm-open = false; return accept; }
                if (root.confirm-open) {
                    root.confirm-open = false;
                    root.confirm-answer(root.confirm-action, root.confirm-arg, false);
                    return accept;
                }
                if (root.qr-open) { root.qr-open = false; root.qr-closed(); return accept; }
                if (root.age-open) { root.age-open = false; root.age-submit(""); return accept; }
                if (root.menu-open) { root.menu-open = false; return accept; }
                if (root.custom-menu-open) { root.custom-menu-open = false; return accept; }
                if (root.custom-import-open) { root.custom-import-open = false; return accept; }
                if (root.add-menu-open) { root.add-menu-open = false; return accept; }
                if (root.link-open) { root.link-open = false; return accept; }
                if (root.dav-open) { root.dav-open = false; return accept; }
                if (root.ports-open) { root.ports-open = false; return accept; }
                if (root.tools-shown && root.tools-page == "access" && root.acc-searching) { root.acc-query = ""; root.acc-searching = false; return accept; }
                if (root.tools-shown && root.tools-page == "access") { root.acc-back(); return accept; }
                if (root.tools-shown && root.tools-page == "theme-color") { root.tools-page = "theme"; return accept; }
                if (root.tools-shown && root.tools-page == "font" && root.font-searching) { root.font-query = ""; root.font-searching = false; return accept; }
                if (root.tools-shown && root.tools-page == "font") { root.tools-page = "theme"; return accept; }
                if (root.tools-shown && root.tools-page == "icon-set" && root.iconset-searching) { root.iconset-query = ""; root.iconset-searching = false; return accept; }
                if (root.tools-shown && root.tools-page == "icon-set") { root.tools-page = "icon-sets"; return accept; }
                if (root.tools-shown && root.meta.known && root.set-searching) { root.set-query = ""; root.set-searching = false; return accept; }
                if (root.tools-shown && root.meta.known) { root.tools-up(root.meta.parent); return accept; }
                if (root.editor-menu-open && ((root.tools-shown && root.tools-page == "editor") || (root.profiles-shown && root.profiles-page == "editor") || ((root.tab == 2 || root.tab == 0) && root.profiles-page == "preview"))) { root.editor-menu-open = false; return accept; }
                if (root.editor-finding && ((root.tools-shown && root.tools-page == "editor") || (root.profiles-shown && root.profiles-page == "editor") || ((root.tab == 2 || root.tab == 0) && root.profiles-page == "preview"))) { root.editor-finding = false; return accept; }
                if (root.tools-shown && root.tools-page == "editor" && root.tools-editor-guard) { root.tools-editor-back(root.tools-editor-text); return accept; }
                if (root.tools-shown && root.tools-page == "editor") { root.tools-page = root.tools-editor-parent; return accept; }
                if (root.tools-shown && root.tools-page != "") {
                    root.tools-page = "";
                    return accept;
                }
                if (root.profiles-shown && root.profiles-page == "editor" && root.editor-parent == "group") { root.group-yaml-closed(); root.editor-parent = ""; root.profiles-page = "group"; return accept; }
                if (root.profiles-shown && root.profiles-page == "editor" && root.editor-parent == "rules") { root.editor-parent = ""; root.pr-act("yaml-closed"); return accept; }
                if (root.profiles-shown && root.profiles-page == "editor" && root.editor-parent == "pmore") { root.editor-parent = ""; root.pm-clicked("yaml-closed"); root.profiles-page = "pmore"; return accept; }
                if (root.profiles-shown && root.profiles-page == "rules" && root.pr-searching && !root.pr-selecting && !root.pr-sorting) { root.pr-query = ""; root.pr-searching = false; return accept; }
                if (root.profiles-shown && root.profiles-page == "rules") { root.pr-act("back"); return accept; }
                if (root.profiles-shown && (root.profiles-page == "rule" || root.profiles-page == "rule-presets")) { root.pr-form("back"); return accept; }
                if (root.profiles-shown && root.profiles-page == "editor") { root.profile-editor-back(root.editor-text); return accept; }
                if (root.profiles-shown && root.profiles-page == "group") { root.pg-back(); return accept; }
                if (root.profiles-shown && root.profiles-page == "pmore") { root.pm-back(); return accept; }
                if (root.profiles-shown && root.profiles-page == "ext" && root.ext-searching) { root.ext-query = ""; root.ext-searching = false; return accept; }
                if (root.profiles-shown && (root.profiles-page == "ext" || root.profiles-page == "extend")) { root.ext-back(); return accept; }
                if (root.profiles-shown && root.profiles-page == "group-members" && root.pg-pick-searching) { root.pg-pick-query = ""; root.pg-pick-searching = false; return accept; }
                if (root.profiles-shown && root.profiles-page == "group-members") { root.pg-pick("back"); return accept; }
                if (root.profiles-shown && root.profiles-page == "group-icon" && root.gi-searching) { root.gi-query = ""; root.gi-searching = false; return accept; }
                if (root.profiles-shown && root.profiles-page == "group-icon") { root.icon-pick("back"); return accept; }
                if (root.profiles-shown && root.profiles-page == "custom" && (root.custom-group-selecting || root.custom-group-sorting)) { root.custom-group("clear"); return accept; }
                if (root.tab == 0 && !root.custom-open && root.profiles-page == "preview") { root.profiles-page = ""; root.profile-sheet-open = true; return accept; }
                if (root.profiles-shown && root.custom-open && root.profiles-page == "preview") { root.profiles-page = "custom"; return accept; }
                if (root.profiles-shown && root.profiles-page == "custom") { root.custom-back(); return accept; }
                if (root.profiles-shown && root.profiles-page == "edit") { root.edit-back(); return accept; }
                if (root.profiles-shown && root.profiles-page != "") { root.profiles-page = ""; return accept; }
                if (root.tab == 0 && root.dash-editing) { root.dash-editing = false; return accept; }
                if (root.is-tv && root.tab != 0) {
                    root.go(0);
                    return accept;
                }
                root.close-app();
                return accept;
            }
            reject
        }

        HorizontalLayout {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            padding-top: root.top-inset;
            padding-left: root.insets-known ? root.inset-left : 0px;
            padding-right: root.insets-known ? root.inset-right : 0px;
            // `AppSidebarContainer`: past 600 the bar moves to the side; it widens in place
            // past 840 (`canExpandSidebar`), else its toggle opens it over the page.
            if root.wide: Rectangle {
                width: side-pane.width + 1px;
                background: root.chrome;
                side-pane := NavSidebar {
                    x: 0;
                    height: parent.height;
                    items: root.side-items;
                    selected: root.side-index;
                    progress: root.side-progress;
                    select(t) => { root.go(t); }
                    toggle => { root.side-toggle(); }
                }
                Rectangle { x: parent.width - 1px; width: 1px; background: Theme.s.on-surface.with-alpha(0.14); }
            }
        VerticalLayout {
            Rectangle {
                vertical-stretch: 1;
                clip: root.tab-prev >= 0;
                if root.tab == 0 || root.tab-leaving == 0: Dashboard {
                    x: root.tab-x(0);
                    opacity: root.tab-opacity(0);
                    width: parent.width;
                    height: parent.height;
                    run-state: root.run-state;
                    run-time: root.dash-run-time;
                    status: root.dash-status;
                    traffic: root.dash-traffic;
                    profile: root.dash-profile;
                    groups: root.dash-groups;
                    groups-timed-out: root.dash-groups-timed-out;
                    widgets: root.dash-widgets;
                    addable: root.dash-addable;
                    widgets-has-service: root.dash-has-service;
                    local-ip: root.dash-local-ip;
                    services: root.dash-services;
                    service-verdict: root.dash-service-verdict;
                    service-warn: root.dash-service-warn;
                    stats: root.dash-stats;
                    allow-lan: root.dash-allow-lan;
                    port: root.dash-port;
                    hide-ip: root.dash-hide-ip;
                    memory: root.dash-memory;
                    mode: root.mode;
                    editing <=> root.dash-editing;
                    toggle-vpn => { root.toggle-vpn(); }
                    set-mode(m) => { root.set-mode(m); }
                    open-profiles => { root.picker-open = true; }
                    sync-profile(id) => { root.update-profile(id); }
                    open-group(g) => {
                        if (g != "") { root.current-group = g; }
                        root.open-group(root.current-group);
                        root.open-group-sheet();
                    }
                    refresh-ip => { root.refresh-ip(); }
                    copy-ip(a) => { root.copy-text(a); }
                    open-ip => { root.ipq-ip = ""; root.ip-sheet-open = true; }
                    fault-count: root.dash-fault-count;
                    live-pill: root.live-pill;
                    open-live => { root.live-show(); }
                    switchable: root.profiles.length > 1;
                    open-faults => {
                        root.alert-title = "未能启动的服务";
                        root.alert-text = root.dash-faults-text;
                        root.alert-open = true;
                    }
                    open-memory => { root.mem-sheet-open = true; root.open-memory(); }
                    open-profile => { root.open-profile-detail(); }
                    switch-profile => { root.picker-open = true; }
                    set-lan(on) => { root.dash-set-lan(on); }
                    retry-services => { root.dash-probe-services(); }
                    services-checking: root.dash-services-checking;
                    open-services => { root.svc-sheet-page = ""; root.svc-sheet-open = true; }
                    open-stats(i) => { root.open-feed(i); }
                    edit(a, w) => { root.edit-dashboard(a, w); }
                    move(f, t) => { root.dash-move(f, t); }
                    card-height(i, h) => { root.dash-card-height(i, h); }
                    drag-target(f, d, g, n) => { return root.dash-drag-target(f, d, g, n); }
                    drag-offset(f, t, i, g) => { return root.dash-drag-offset(f, t, i, g); }
                    layout(w, c, sv) => { root.dash-layout(w, c, sv); }
                    table-feed: root.dash-table-feed;
                    table-counts: root.dash-table-counts;
                    table-tcp: root.dash-table-tcp;
                    table-udp: root.dash-table-udp;
                    table-cols: root.dash-table-cols;
                    table-rows: root.dash-table-rows;
                    table-select(f) => { root.dash-table-select(f); }
                    table-sort(c) => { root.dash-table-sort(c); }
                    table-width(w) => { root.dash-table-width(w); }
                    table-shown(v) => { root.dash-table-shown(v); }
                    table-resize-start(b) => { root.dash-table-resize-start(b); }
                    table-resize(d) => { root.dash-table-resize(d); }
                    table-resize-end => { root.dash-table-resize-end(); }
                    table-reset => { root.dash-table-reset(); }
                }
                // Kept in the tree so its measures stay readable and its scroll stays put.
                proxies-page := Proxies {
                    visible: root.tab == 1 || root.tab-leaving == 1;
                    x: root.tab-x(1);
                    opacity: root.tab-opacity(1);
                    width: parent.width;
                    height: parent.height;
                    groups: root.proxy-groups;
                    style: root.proxy-style;
                    current-group <=> root.current-group;
                    searching <=> root.proxy-searching;
                    testing: root.testing;
                    hint: root.proxies-hint;
                    open-group(g) => { root.open-group(g); }
                    select-node(g, n) => { root.select-node(g, n); }
                    test-group(g) => { root.test-group(g); }
                    test-node(g, n) => { root.test-node(g, n); }
                    toggle-group(g) => { root.toggle-group(g); }
                    search(q) => { root.search-proxies(q); }
                    open-options => { root.proxy-options-open = true; }
                    locate(g) => { return root.locate(g); }
                    view-width: root.width;
                    // `_menuItems`: 选中 for a selector, 首选 for a group that picks by itself.
                    node-menu(g, k, n, x, y, w, h) => {
                        root.ctx-kind = "node";
                        root.ctx-a = g;
                        root.ctx-b = n.name;
                        root.ctx-names = [];
                        root.ctx-items = k == "Selector"
                            ? (n.addable
                                ? [{ id: "select", glyph: "check-circle", label: "选中", check: true, checked: n.selected, enabled: true }, { id: "add-local", glyph: "list-add", label: "添加到本地代理", check: false, checked: false, enabled: true }]
                                : [{ id: "select", glyph: "check-circle", label: "选中", check: true, checked: n.selected, enabled: true }])
                            : k == "URLTest" || k == "Fallback" || k == "Smart"
                            ? (n.addable
                                ? [{ id: "select", glyph: "pin", label: "首选", check: true, checked: n.pinned, enabled: true }, { id: "add-local", glyph: "list-add", label: "添加到本地代理", check: false, checked: false, enabled: true }]
                                : [{ id: "select", glyph: "pin", label: "首选", check: true, checked: n.pinned, enabled: true }])
                            : n.addable ? [{ id: "add-local", glyph: "list-add", label: "添加到本地代理", check: false, checked: false, enabled: true }] : [];
                        root.ctx-x = x;
                        root.ctx-y = y;
                        root.ctx-w = w;
                        root.ctx-h = h;
                    }
                    group-menu(x, y, w, h) => {
                        root.ctx-kind = "group";
                        root.ctx-items = [];
                        root.ctx-names = root.proxy-group-names;
                        root.ctx-x = x;
                        root.ctx-y = y;
                        root.ctx-w = w;
                        root.ctx-h = h;
                    }
                }
                if (root.tab == 2 && (root.profiles-page == "" || root.profiles-page == "sort")) || root.tab-leaving == 2: Profiles {
                    x: root.tab-x(2);
                    opacity: root.tab-opacity(2);
                    width: parent.width;
                    height: parent.height;
                    profiles: root.profiles;
                    adding: root.adding;
                    view-width: root.width;
                    add(x, y, w, h) => {
                        root.ctx-x = x;
                        root.ctx-y = y;
                        root.ctx-w = w;
                        root.ctx-h = h;
                        root.add-menu-open = true;
                    }
                    update-all => { root.update-all(); }
                    open-sort => { root.open-sort(); }
                    select-profile(id) => { root.select-profile(id); }
                    menu(p, x, y, w, h) => {
                        root.menu-item = p;
                        root.menu-more = false;
                        root.ctx-x = x;
                        root.ctx-y = y;
                        root.ctx-w = w;
                        root.ctx-h = h;
                        root.menu-open = true;
                    }
                }
                // `showNestedSheet`: a side sheet past the mobile width, else a bottom sheet
                // whose grabber drags it between 9/16 and 0.9 of the window or closes it.
                if root.profiles-over && root.profiles-page != "": Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: #00000066;
                    TouchArea { clicked => { root.custom-back(); } }
                    Rectangle {
                        x: root.po-x(parent.width);
                        y: root.po-top(parent.height);
                        width: root.po-w(parent.width);
                        height: parent.height - self.y;
                        background: Theme.s.page;
                        border-top-left-radius: root.wide ? 0 : 24px;
                        border-top-right-radius: root.wide ? 0 : 24px;
                        TouchArea { }
                        if !root.wide: Rectangle {
                            y: 0;
                            height: 24px;
                            Rectangle { y: 10px; width: 36px; height: 4px; border-radius: 2px; background: Theme.s.outline-variant; }
                            TouchArea {
                                moved => {
                                    root.po-drag += self.mouse-y - self.pressed-y;
                                    root.po-fling = SheetDrag.speed(self.absolute-position.y + self.mouse-y, animation-tick(), root.po-last-y, root.po-last-t, root.po-fling);
                                    root.po-last-y = self.absolute-position.y + self.mouse-y;
                                    root.po-last-t = animation-tick();
                                }
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down) {
                                        root.po-fling = 0;
                                        root.po-last-y = self.absolute-position.y + self.mouse-y;
                                        root.po-last-t = animation-tick();
                                    }
                                    if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { root.po-settle(); }
                                }
                            }
                        }
                    }
                }
                if root.profiles-shown && root.profiles-page == "edit": EditProfilePage {
                    x: root.po-x(parent.width);
                    y: root.po-y(parent.height);
                    width: root.po-w(parent.width);
                    height: parent.height - root.po-y(parent.height);
                    is-url: root.edit-is-url;
                    name <=> root.edit-name;
                    url <=> root.edit-url;
                    age <=> root.edit-age;
                    auto <=> root.edit-auto;
                    interval <=> root.edit-interval;
                    file-info: root.edit-file-info;
                    busy: root.adding;
                    save => { root.edit-save(); }
                    back => { root.edit-back(); }
                    edit-file => { root.edit-file(); }
                    upload-file => { root.upload-file(); }
                }
                if (root.profiles-shown && root.profiles-page == "editor") || ((root.tab == 2 || root.tab == 0) && root.profiles-page == "preview"): EditorPage {
                    x: root.po-x(parent.width);
                    y: root.po-y(parent.height);
                    width: root.po-w(parent.width);
                    height: parent.height - root.po-y(parent.height);
                    title: root.editor-title;
                    text <=> root.editor-text;
                    key: "profiles";
                    schema: root.editor-schema;
                    keyboard: root.keyboard;
                    finding <=> root.editor-finding;
                    menu-open <=> root.editor-menu-open;
                    readonly: root.editor-readonly;
                    loading: root.editor-loading;
                    error: root.editor-error;
                    save(t) => { root.editor-save(t); }
                    back => {
                        if (root.tab == 0 && !root.custom-open) { root.profile-sheet-open = true; }
                        if (root.profiles-page == "editor" && root.editor-parent == "group") {
                            root.group-yaml-closed();
                            root.editor-parent = "";
                            root.profiles-page = "group";
                            return;
                        }
                        if (root.profiles-page == "editor" && root.editor-parent == "rules") {
                            root.editor-parent = "";
                            root.pr-act("yaml-closed");
                            return;
                        }
                        if (root.profiles-page == "editor" && root.editor-parent == "pmore") {
                            root.editor-parent = "";
                            root.pm-clicked("yaml-closed");
                            root.profiles-page = "pmore";
                            return;
                        }
                        if (root.profiles-page == "editor") {
                            root.profile-editor-back(root.editor-text);
                            return;
                        }
                        root.profiles-page = root.custom-open ? "custom" : "";
                    }
                }
                if root.profiles-shown && root.profiles-page == "custom": CustomProfilePage {
                    x: root.po-x(parent.width);
                    y: root.po-y(parent.height);
                    width: root.po-w(parent.width);
                    height: parent.height - root.po-y(parent.height);
                    title: root.custom-title;
                    rows: root.custom-rows;
                    issues: root.custom-issues;
                    group-count: root.custom-group-count;
                    groups: root.custom-groups;
                    group-titles: root.custom-group-titles;
                    group-kinds: root.custom-group-kinds;
                    selecting: root.custom-group-selecting;
                    sorting: root.custom-group-sorting;
                    importing: root.custom-importing;
                    group(a) => { root.custom-group(a); }
                    import-menu(x, y, w, h) => {
                        root.ctx-x = x;
                        root.ctx-y = y;
                        root.ctx-w = w;
                        root.ctx-h = h;
                        root.custom-import-open = true;
                    }
                    back => { root.custom-back(); }
                    title-menu(x, y, w, h) => {
                        root.ctx-x = x;
                        root.ctx-y = y;
                        root.ctx-w = w;
                        root.ctx-h = h;
                        root.custom-menu-open = true;
                    }
                    open-row(r) => {
                        if (r.id == "rules") {
                            root.pr-act("open");
                            return;
                        }
                        root.custom-row(r.id);
                    }
                }
                if root.profiles-shown && root.profiles-page == "rules": ProfileRulesPage {
                    x: root.po-x(parent.width);
                    y: root.po-y(parent.height);
                    width: root.po-w(parent.width);
                    height: parent.height - root.po-y(parent.height);
                    rows: root.pr-rows;
                    total: root.pr-total;
                    sort-titles: root.pr-sort-titles;
                    sort-subtitles: root.pr-sort-subtitles;
                    selecting: root.pr-selecting;
                    sorting: root.pr-sorting;
                    searching <=> root.pr-searching;
                    query <=> root.pr-query;
                    act(a) => { root.pr-act(a); }
                }
                if root.profiles-shown && (root.profiles-page == "rule" || root.profiles-page == "rule-presets"): ProfileFormPage {
                    x: root.po-x(parent.width);
                    y: root.po-y(parent.height);
                    width: root.po-w(parent.width);
                    height: parent.height - root.po-y(parent.height);
                    title: root.pr-form-title;
                    issue: root.pr-form-issue;
                    sections: root.pr-form-sections;
                    action-glyph: root.pr-form-action;
                    back => { root.pr-form("back"); }
                    clicked(id) => { root.pr-form(id); }
                    toggled(id, on) => { root.pr-form-toggled(id, on); }
                }
                if root.profiles-shown && root.profiles-page == "group": EditProxyGroupPage {
                    x: root.po-x(parent.width);
                    y: root.po-y(parent.height);
                    width: root.po-w(parent.width);
                    height: parent.height - root.po-y(parent.height);
                    title: root.pg-title;
                    issue: root.pg-issue;
                    head: root.pg-head;
                    members: root.pg-members;
                    tail: root.pg-tail;
                    provider: root.pg-provider;
                    back => { root.pg-back(); }
                    clicked(id) => { root.pg-clicked(id); }
                    toggled(id, on) => { root.pg-toggled(id, on); }
                    member(a) => { root.pg-member(a); }
                }
                if root.profiles-shown && root.profiles-page == "pmore": SettingsPage {
                    x: root.po-x(parent.width);
                    y: root.po-y(parent.height);
                    width: root.po-w(parent.width);
                    height: parent.height - root.po-y(parent.height);
                    title: root.pm-meta.title;
                    action-glyph: Glyphs.of(root.pm-meta.action);
                    action2-glyph: Glyphs.of(root.pm-meta.action2);
                    action2 => { root.pm-clicked("action2"); }
                    sections: root.pm-sections;
                    empty: root.pm-meta.empty;
                    empty-desc: root.pm-meta.empty-desc;
                    empty-action: root.pm-meta.empty-action;
                    back => { root.pm-back(); }
                    action => { root.pm-clicked("action"); }
                    clicked(id) => { root.pm-clicked(id); }
                    toggled(id, on) => { root.pm-toggled(id, on); }
                    if root.pm-issue != "": HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 8px;
                        Rectangle {
                            border-radius: 16px;
                            background: Theme.s.error.with-alpha(0.12);
                            HorizontalLayout {
                                padding: 14px;
                                spacing: 12px;
                                VerticalLayout { alignment: start; Icon { glyph: Icons.error; size: 20px; tint: Theme.s.error; } }
                                Text { text: root.pm-issue; font-size: 14px * Type.scale; color: Theme.s.error; wrap: word-wrap; horizontal-stretch: 1; }
                            }
                        }
                    }
                }
                if root.profiles-shown && root.profiles-page == "extend": ExtendPage {
                    x: root.po-x(parent.width);
                    y: root.po-y(parent.height);
                    width: root.po-w(parent.width);
                    height: parent.height - root.po-y(parent.height);
                    top: root.ext-top;
                    rules: root.ext-rules;
                    bottom: root.ext-bottom;
                    selecting: root.ext-selecting;
                    apply: root.ext-apply;
                    applying: root.ext-applying;
                    back => { root.ext-back(); }
                    clicked(id) => { root.ext-clicked(id); }
                    toggled(id, on) => { root.ext-toggled(id, on); }
                }
                if root.profiles-shown && root.profiles-page == "ext": SettingsPage {
                    x: root.po-x(parent.width);
                    y: root.po-y(parent.height);
                    width: root.po-w(parent.width);
                    height: parent.height - root.po-y(parent.height);
                    title: root.ext-meta.title;
                    action-glyph: Glyphs.of(root.ext-meta.action);
                    action2-glyph: Glyphs.of(root.ext-meta.action2);
                    long-press: root.ext-meta.long-press;
                    searchable: root.ext-meta.search;
                    searching <=> root.ext-searching;
                    query <=> root.ext-query;
                    search(q) => { root.ext-search(q); }
                    sections: root.ext-sections;
                    empty: root.ext-meta.empty;
                    empty-desc: root.ext-meta.empty-desc;
                    empty-action: root.ext-meta.empty-action;
                    back => { root.ext-back(); }
                    action => { root.ext-clicked("action"); }
                    action2 => { root.ext-clicked("action2"); }
                    clicked(id) => { root.ext-clicked(id); }
                    toggled(id, on) => { root.ext-toggled(id, on); }
                }
                if root.profiles-shown && root.profiles-page == "group-members": MemberPickerPage {
                    x: root.po-x(parent.width);
                    y: root.po-y(parent.height);
                    width: root.po-w(parent.width);
                    height: parent.height - root.po-y(parent.height);
                    title: root.pg-provider ? "添加筛选" : "添加节点";
                    sections: root.pg-pick-sections;
                    searchable: root.pg-pick-searchable;
                    empty: root.pg-pick-empty;
                    searching <=> root.pg-pick-searching;
                    query <=> root.pg-pick-query;
                    back => { root.pg-pick("back"); }
                    pick(a) => { root.pg-pick(a); }
                }
                if root.profiles-shown && root.profiles-page == "group-icon": IconPickerPage {
                    x: root.po-x(parent.width);
                    y: root.po-y(parent.height);
                    width: root.po-w(parent.width);
                    height: parent.height - root.po-y(parent.height);
                    value: root.gi-value;
                    value-title: root.gi-title;
                    value-subtitle: root.gi-subtitle;
                    chips: root.gi-chips;
                    chip: root.gi-chip;
                    sections: root.gi-sections;
                    empty: root.gi-empty;
                    searching <=> root.gi-searching;
                    query <=> root.gi-query;
                    back => { root.icon-pick("back"); }
                    pick(a) => { root.icon-pick(a); }
                }
                if (root.tab == 3 && root.tools-page == "") || root.tab-leaving == 3: Tools {
                    x: root.tab-x(3);
                    opacity: root.tab-opacity(3);
                    width: parent.width;
                    height: parent.height;
                    sections: root.tools-sections;
                    open(p) => { root.tools-clicked(p); }
                }
                // The page under a pushed tools page takes no touches.
                if root.tools-over && root.tools-page != "": Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: Theme.s.page;
                    TouchArea { }
                }
                if root.tools-shown && root.meta.known: SettingsPage {
                    locked: od-body.dragging;
                    action-glyph: Glyphs.of(root.meta.action);
                    action-empty: root.meta.action-empty;
                    action2-glyph: Glyphs.of(root.meta.action2);
                    long-press: root.meta.long-press;
                    selecting: root.meta.selecting;
                    sorting: root.set-sorting;
                    sort-titles: root.set-sort-titles;
                    sort-moved(f, t) => { root.set-clicked(root.tools-page, "sort-move:" + f + ":" + t); }
                    sort-done => { root.set-sorting = false; }
                    searchable: root.meta.search;
                    searching <=> root.set-searching;
                    query <=> root.set-query;
                    search(q) => { root.set-clicked(root.tools-page, "search:" + q); }
                    action => { root.set-clicked(root.tools-page, "action"); }
                    action2 => { root.set-clicked(root.tools-page, "action2"); }
                    width: parent.width;
                    height: parent.height;
                    title: root.meta.title;
                    sections: root.page-sections;
                    empty: root.meta.empty;
                    empty-desc: root.meta.empty-desc;
                    empty-action: root.meta.empty-action;
                    bottom-gap: root.meta.fab ? 96px : 24px;
                    back => {
                        if (root.meta.selecting) {
                            root.set-clicked(root.tools-page, "sel-clear");
                        } else {
                            root.tools-up(root.meta.parent);
                        }
                    }
                    clicked(id) => { root.set-clicked(root.tools-page, id); }
                    toggled(id, on) => { root.set-toggled(root.tools-page, id, on); }
                    if root.mitm-loading != "" && (root.tools-page == "advanced" || root.tools-page == "mitm-options" || root.tools-page == "mitm-modules" || root.tools-page == "mitm-module" || root.tools-page == "mitm-lines"): HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 8px;
                        Rectangle {
                            border-radius: 16px;
                            background: Theme.s.card;
                            HorizontalLayout {
                                padding: 14px;
                                spacing: 12px;
                                Spinner { width: 20px; height: 20px; indeterminate: true; }
                                Text { text: root.mitm-loading; font-size: 14px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            }
                        }
                    }
                    if root.tools-page == "custom-proxy" && root.cp-issue != "": HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 8px;
                        Rectangle {
                            border-radius: 16px;
                            background: Theme.s.error.with-alpha(0.12);
                            HorizontalLayout {
                                padding: 14px;
                                spacing: 12px;
                                VerticalLayout { alignment: start; Icon { glyph: Icons.error; size: 20px; tint: Theme.s.error; } }
                                Text { text: root.cp-issue; font-size: 14px * Type.scale; color: Theme.s.error; wrap: word-wrap; horizontal-stretch: 1; }
                            }
                        }
                    }
                    od-body := OnDemandBody {
                        visible: root.tools-page == "on-demand";
                        height: root.tools-page == "on-demand" ? self.preferred-height : 0px;
                        battery: root.od-battery;
                        location: root.od-location;
                        ssids: root.od-ssids;
                        selected: root.od-selected;
                        selecting: root.od-selecting;
                        clicked(id) => { root.od-clicked(id); }
                    }
                }
                if root.tools-shown && root.tools-page == "icon-set": IconSetPage {
                    width: parent.width;
                    height: parent.height;
                    title: root.iconset-title;
                    tiles: root.iconset-tiles;
                    empty: root.iconset-empty;
                    searching <=> root.iconset-searching;
                    query <=> root.iconset-query;
                    back => { root.tools-page = "icon-sets"; }
                    search(q) => { root.iconset-search(q); }
                }
                if root.tools-shown && root.tools-page == "editor": EditorPage {
                    width: parent.width;
                    height: parent.height;
                    title <=> root.tools-editor-title;
                    title-editable: root.tools-editor-title-editable;
                    readonly: root.tools-editor-readonly;
                    loading: root.tools-editor-loading;
                    error: root.tools-editor-error;
                    text <=> root.tools-editor-text;
                    key: "tools";
                    schema: root.tools-editor-schema;
                    keyboard: root.keyboard;
                    finding <=> root.editor-finding;
                    menu-open <=> root.editor-menu-open;
                    save(t) => { root.tools-editor-save(t); }
                    back => {
                        if (root.tools-editor-guard) {
                            root.tools-editor-back(root.tools-editor-text);
                        } else {
                            root.tools-page = root.tools-editor-parent;
                        }
                    }
                }
                if root.tools-shown && root.meta.known && root.meta.fab: Fab {
                    x: parent.width - self.width - 16px;
                    y: parent.height - self.height - 16px - Dock.pad;
                    glyph: Icons.plus;
                    clicked => { root.set-clicked(root.tools-page, "add"); }
                }
                if root.tools-shown && root.tools-page == "access": AccessPage {
                    width: parent.width;
                    height: parent.height;
                    rows: root.acc-rows;
                    enabled: root.acc-enabled;
                    changed: root.acc-changed;
                    all-selected: root.acc-all-selected;
                    can-select-all: root.acc-can-select-all;
                    loading: root.acc-loading;
                    needs-permission: root.acc-needs-permission;
                    authorize: root.acc-authorize;
                    status: root.acc-status;
                    count: root.acc-count;
                    searching <=> root.acc-searching;
                    query <=> root.acc-query;
                    back => { root.acc-back(); }
                    toggle(n) => { root.acc-toggle(n); }
                    select-all => { root.acc-select-all(); }
                    save => { root.acc-save(); }
                    menu => { root.acc-menu(); }
                    enable => { root.acc-enable(); }
                    grant => { root.acc-grant(); }
                    search(q) => { root.acc-search(q); }
                }
                if root.tools-shown && root.tools-page == "about": AboutPage {
                    width: parent.width;
                    height: parent.height;
                    icon: root.app-icon;
                    version: root.app-version;
                    checking: root.update-checking;
                    sections: root.page-sections;
                    back => { root.tools-page = ""; }
                    clicked(id) => { root.set-clicked("about", id); }
                    toggled(id, on) => { root.set-toggled("about", id, on); }
                    check-update => { root.check-update(); }
                    logo-tapped => { root.about-logo-tapped(); }
                }
                if root.req-tab-visible: RequestsPage {
                    width: parent.width;
                    height: parent.height;
                    mobile: !root.wide;
                    can-back: root.tab == 3;
                    segment: root.req-segment;
                    shows-http: root.req-shows-http;
                    rows: root.req-rows;
                    shift: root.req-shift;
                    shift-seq: root.req-shift-seq;
                    statuses: root.req-statuses;
                    counts: root.req-counts;
                    status: root.req-status;
                    conditions: root.req-conditions;
                    empty: root.req-empty;
                    empty-desc: root.req-empty-desc;
                    detail: root.req-detail;
                    has-menu: root.req-has-menu;
                    searching <=> root.req-searching;
                    query <=> root.req-query;
                    back => { root.tools-page = ""; }
                    search(q) => { root.req-search(q); }
                    open-menu => { root.req-open-menu(); }
                    set-segment(s) => { root.req-set-segment(s); }
                    status-menu => { root.req-status-menu(); }
                    add-condition => { root.req-add-condition(); }
                    edit-condition(i) => { root.req-edit-condition(i); }
                    remove-condition(i) => { root.req-remove-condition(i); }
                    clear-conditions => { root.req-clear-conditions(); }
                    cond-width-changed(w) => {
                        root.req-split = self.split;
                        root.req-cond-width(w);
                    }
                    split-changed(split) => {
                        root.req-split = split;
                        if (split) { root.req-sheet-open = false; } else if (root.req-detail.has) { root.req-sheet-open = true; }
                    }
                    select(id, split) => {
                        if (!split) { root.req-sheet-open = true; }
                        root.req-select(id, split);
                    }
                    row-menu(id) => { root.req-row-menu(id); }
                    detail-tab(i) => { root.req-detail-tab(i); }
                    detail-close => { root.req-detail-close(); }
                    detail-menu => { root.req-detail-menu(); }
                    detail-row(a) => { root.req-detail-row(a); }
                }
                if root.tools-shown && root.tools-page == "resources": ResourcesPage {
                    width: parent.width;
                    height: parent.height;
                    items: root.res-items;
                    icon-sets: root.res-icon-sets;
                    rule-sets: root.res-rule-sets;
                    scripts: root.res-scripts;
                    modules: root.res-modules;
                    auto: root.res-auto;
                    interval: root.res-interval;
                    updating: root.res-updating;
                    back => { root.tools-page = ""; }
                    update-all => { root.res-update-all(); }
                    set-auto(on) => { root.res-set-auto(on); }
                    open-interval => { root.res-open-interval(); }
                    tapped(k) => { root.res-tapped(k); }
                    menu(k) => { root.res-menu(k); }
                }
                if root.tools-shown && root.tools-page == "logs": Logs {
                    width: parent.width;
                    height: parent.height;
                    logs: root.logs;
                    offered: root.log-offered;
                    filters: root.log-filters;
                    searching <=> root.log-searching;
                    query <=> root.log-query;
                    back => { root.tools-page = ""; }
                    search(q) => { root.logs-search(q); }
                    open-filters => { root.logs-open-filters(); }
                    open-menu => { root.logs-open-menu(); }
                    filter(l) => { root.logs-filter(l); }
                    unfilter(l) => { root.logs-unfilter(l); }
                    set-following(on) => { root.logs-following(on); }
                    open(id) => { root.logs-open(id); }
                }
                if root.tools-shown && root.tools-page == "font": FontPage {
                    width: parent.width;
                    height: parent.height;
                    families: root.font-families;
                    loading: root.font-loading;
                    searchable: root.font-searchable;
                    selected: Type.family;
                    searching <=> root.font-searching;
                    query <=> root.font-query;
                    pick(f) => { root.font-pick(f); }
                    search(q) => { root.font-search(q); }
                    back => { root.tools-page = "theme"; }
                }
                if root.tools-shown && root.tools-page == "theme": ThemePage {
                    width: parent.width;
                    height: parent.height;
                    theme-mode: root.theme-mode;
                    pure-black: root.pure-black;
                    swatches: root.swatches;
                    can-reset: root.colors-can-reset;
                    style-label: root.color-style-label;
                    light: Theme.light;
                    dark: Theme.dark;
                    dark-standard: root.scheme-dark-standard;
                    dark-black: root.scheme-dark-black;
                    floating: root.floating-bar;
                    tab-fade: root.tab-fade;
                    font-family: Type.family;
                    text-scale-enable: root.text-scale-enable;
                    text-scale: root.text-scale;
                    open-font => { root.open-font-page(); }
                    set-text-scale-enable(on) => { root.set-text-scale-enable(on); }
                    set-text-scale(v) => { root.set-text-scale(v); }
                    set-floating(on) => { root.set-floating-bar(on); }
                    set-tab-animation(i) => { root.set-tab-animation(i); }
                    set-theme-mode(m) => { root.set-theme-mode(m); }
                    set-pure-black(on) => { root.set-pure-black(on); }
                    swatch-picked(i) => { root.swatch-picked(i); }
                    swatch-menu(i) => { root.swatch-menu(i); }
                    add-color => { root.add-color(); }
                    reset-colors => { root.reset-colors(); }
                    pick-style => { root.pick-color-style(); }
                    back => { root.tools-page = ""; }
                }
                if root.tools-shown && root.tools-page == "theme-color": ColorPage {
                    width: parent.width;
                    height: parent.height;
                    draft: root.color-draft;
                    light: root.color-light;
                    dark: root.color-dark;
                    hex <=> root.color-hex;
                    mode <=> root.color-mode;
                    grid: root.color-grid;
                    grid-selected: root.color-grid-selected;
                    grid-light-ink: root.color-light-ink;
                    spec-x: root.color-spec-x;
                    spec-y: root.color-spec-y;
                    hue: root.color-hue;
                    sat: root.color-sat;
                    val: root.color-val;
                    hue-color: root.color-hue-color;
                    sat-from: root.color-sat-from;
                    sat-to: root.color-sat-to;
                    val-to: root.color-val-to;
                    bottom-gap: 20px + root.keyboard;
                    hex-filter(t) => { return root.color-hex-filter(t); }
                    hex-edited(t) => { root.color-hex-edited(t); }
                    grid-pick(i) => { root.color-grid-pick(i); }
                    spectrum-pick(x, y) => { root.color-spectrum-pick(x, y); }
                    hsv(h, sv, v) => { root.color-hsv(h, sv, v); }
                    confirm => { root.color-confirm(); }
                    back => { root.tools-page = "theme"; }
                }

                if root.toast != "": Rectangle {
                    y: parent.height - self.height - max(88px, Dock.pad + 12px) - root.keyboard;
                    x: (parent.width - self.width) / 2;
                    width: min(parent.width - 40px, toast-text.preferred-width + 32px);
                    height: toast-text.preferred-height + 20px;
                    border-radius: 8px;
                    background: Theme.s.on-surface;
                    toast-text := Text {
                        x: 16px;
                        width: parent.width - 32px;
                        text: root.toast;
                        color: Theme.s.page;
                        font-size: 14px * Type.scale;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            // The floating dock (an approved departure from FlClash's bar): a rounded bar
            // clear of the screen's sides and bottom, with the pages scrolling under it.
            if !root.wide && root.keyboard == 0 && root.floating-bar && !root.po-modal: Rectangle {
                height: 0px;
                Rectangle {
                    x: 12px;
                    width: parent.width - 24px;
                    height: 64px;
                    y: -self.height - 12px - root.bottom-inset;
                    border-radius: 32px;
                    background: Theme.s.card;
                    border-width: 1px;
                    border-color: Theme.s.outline-variant.with-alpha(0.5);
                    TouchArea { }
                    HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    height: 64px;
                    NavItem { label: "仪表盘"; glyph: Icons.dashboard; active: root.tab == 0; clicked => { root.nav(0); } }
                    if root.has-proxies: NavItem { label: "代理"; glyph: Icons.proxies; active: root.tab == 1; clicked => { root.nav(1); } }
                    if root.captures-http: NavItem { label: "请求"; glyph: Icons.requests; active: root.tab == 4; clicked => { root.nav(4); } }
                    NavItem { label: "配置"; glyph: Icons.profiles; active: root.tab == 2; clicked => { root.nav(2); } }
                    NavItem { label: "工具"; glyph: Icons.tools; active: root.tab == 3; clicked => { root.nav(3); } }
                }
                }
            }
            // prism_ui's `NavigationBar`, where the dock is turned off: a bar of the floating
            // level, 80 high above the bottom inset, its pages ending at its top.
            if !root.wide && root.keyboard == 0 && !root.floating-bar && !root.po-modal: Rectangle {
                height: 80px + root.bottom-inset;
                background: Theme.is-dark ? Theme.s.block : Theme.s.card;
                TouchArea { }
                HorizontalLayout {
                    y: 0;
                    height: 80px;
                    BarItem { label: "仪表盘"; glyph: Icons.dashboard; active: root.tab == 0; clicked => { root.nav(0); } }
                    if root.has-proxies: BarItem { label: "代理"; glyph: Icons.proxies; active: root.tab == 1; clicked => { root.nav(1); } }
                    if root.captures-http: BarItem { label: "请求"; glyph: Icons.requests; active: root.tab == 4; clicked => { root.nav(4); } }
                    BarItem { label: "配置"; glyph: Icons.profiles; active: root.tab == 2; clicked => { root.nav(2); } }
                    BarItem { label: "工具"; glyph: Icons.tools; active: root.tab == 3; clicked => { root.nav(3); } }
                }
            }
        }
        }

        // `openDashboardFeed`: the requests page in a snap sheet over the dashboard, on DNS
        // for the DNS figure.
        if root.feed-open && root.tab == 0 && !root.tools-covering: SnapSheet {
            side: root.wide;
            top-inset: root.top-inset;
            tall <=> root.feed-tall;
            close => { root.close-feed(); }
            RequestsPage {
                mobile: true;
                can-back: false;
                segment: root.req-segment;
                shows-http: root.req-shows-http;
                rows: root.req-rows;
                shift: root.req-shift;
                shift-seq: root.req-shift-seq;
                statuses: root.req-statuses;
                counts: root.req-counts;
                status: root.req-status;
                conditions: root.req-conditions;
                empty: root.req-empty;
                empty-desc: root.req-empty-desc;
                detail: root.req-detail;
                has-menu: root.req-has-menu;
                searching <=> root.feed-searching;
                query <=> root.feed-query;
                search(q) => { root.req-search(q); }
                open-menu => { root.req-open-menu(); }
                set-segment(s) => { root.req-set-segment(s); }
                status-menu => { root.req-status-menu(); }
                add-condition => { root.req-add-condition(); }
                edit-condition(i) => { root.req-edit-condition(i); }
                remove-condition(i) => { root.req-remove-condition(i); }
                clear-conditions => { root.req-clear-conditions(); }
                cond-width-changed(w) => { root.req-cond-width(w); }
                select(id, split) => {
                    root.req-sheet-open = true;
                    root.req-select(id, false);
                }
                row-menu(id) => { root.req-row-menu(id); }
                detail-tab(i) => { root.req-detail-tab(i); }
                detail-close => { root.req-detail-close(); }
                detail-menu => { root.req-detail-menu(); }
                detail-row(a) => { root.req-detail-row(a); }
            }
        }

        // `showProxiesSheet`: the proxies page as a picker over the dashboard.
        if root.group-sheet-open && root.tab == 0: SnapSheet {
            side: root.wide;
            top-inset: root.top-inset;
            tall <=> root.group-sheet-tall;
            close => { root.close-group-sheet(); }
            Proxies {
                picker: true;
                groups: root.proxy-groups;
                style: root.proxy-style;
                current-group <=> root.current-group;
                searching <=> root.group-sheet-searching;
                testing: root.testing;
                hint: root.proxies-hint;
                view-width: self.width;
                open-group(g) => { root.open-group(g); }
                select-node(g, n) => { root.select-node(g, n); }
                test-group(g) => { root.test-group(g); }
                test-node(g, n) => { root.test-node(g, n); }
                toggle-group(g) => { root.toggle-group(g); }
                search(q) => { root.search-proxies(q); }
                locate(g) => { return root.locate(g); }
                node-menu(g, k, n, x, y, w, h) => {
                    root.ctx-kind = "node";
                    root.ctx-a = g;
                    root.ctx-b = n.name;
                    root.ctx-names = [];
                    root.ctx-items = k == "Selector"
                        ? (n.addable
                            ? [{ id: "select", glyph: "check-circle", label: "选中", check: true, checked: n.selected, enabled: true }, { id: "add-local", glyph: "list-add", label: "添加到本地代理", check: false, checked: false, enabled: true }]
                            : [{ id: "select", glyph: "check-circle", label: "选中", check: true, checked: n.selected, enabled: true }])
                        : k == "URLTest" || k == "Fallback" || k == "Smart"
                        ? (n.addable
                            ? [{ id: "select", glyph: "pin", label: "首选", check: true, checked: n.pinned, enabled: true }, { id: "add-local", glyph: "list-add", label: "添加到本地代理", check: false, checked: false, enabled: true }]
                            : [{ id: "select", glyph: "pin", label: "首选", check: true, checked: n.pinned, enabled: true }])
                        : n.addable ? [{ id: "add-local", glyph: "list-add", label: "添加到本地代理", check: false, checked: false, enabled: true }] : [];
                    root.ctx-x = x;
                    root.ctx-y = y;
                    root.ctx-w = w;
                    root.ctx-h = h;
                }
                group-menu(x, y, w, h) => {
                    root.ctx-kind = "group";
                    root.ctx-items = [];
                    root.ctx-names = root.proxy-group-names;
                    root.ctx-x = x;
                    root.ctx-y = y;
                    root.ctx-w = w;
                    root.ctx-h = h;
                }
            }
        }

        // `showProfilesSheet` (`ProfilesView(picker: true)`): the profiles, a tap makes one
        // current; with none, 暂无配置 and 添加配置 opening AddProfileMenu.
        if root.picker-open && root.tab == 0: DashSheet {
            side: root.wide;
            title: "配置";
            top-inset: root.top-inset;
            bottom-inset: root.bottom-inset;
            close => { root.picker-open = false; }
            if root.profiles.length == 0: VerticalLayout {
                padding-top: 48px;
                padding-bottom: 48px;
                spacing: 8px;
                Text { text: "暂无配置"; font-size: 18px * Type.scale; color: Theme.s.on-surface; horizontal-alignment: center; }
                Text { text: "添加一个配置文件后即可开始使用"; font-size: 14px * Type.scale; color: Theme.s.on-surface-variant; horizontal-alignment: center; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: center;
                    padding-top: 8px;
                    TextButton {
                        text: root.adding ? "加载中…" : "添加配置";
                        filled: true;
                        enabled: !root.adding;
                        clicked => {
                            root.ctx-x = self.absolute-position.x;
                            root.ctx-y = self.absolute-position.y;
                            root.ctx-w = self.width;
                            root.ctx-h = self.height;
                            root.add-menu-open = true;
                        }
                    }
                }
            }
            if root.profiles.length > 0: Rectangle {
                background: Theme.s.card;
                border-radius: 16px;
                height: self.preferred-height;
                VerticalLayout {
                    for pp[ppi] in root.profiles: Rectangle {
                        height: 60px;
                        background: pk-ta.pressed ? Theme.s.inset : transparent;
                        border-radius: 16px;
                        if ppi > 0: Rectangle { y: 0; x: 16px; width: parent.width - 32px; height: 1px; background: Theme.s.outline-variant.with-alpha(0.6); }
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: pp.name; font-size: 15px * Type.scale; font-weight: pp.active ? 600 : 400; color: Theme.s.on-surface; overflow: elide; }
                                Text { text: pp.subtitle; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; overflow: elide; }
                            }
                            if pp.active: VerticalLayout { alignment: center; Icon { glyph: Icons.check; size: 20px; tint: Theme.s.primary; } }
                        }
                        pk-ta := TouchArea {
                            clicked => {
                                root.picker-open = false;
                                if (!pp.active) { root.select-profile(pp.id); }
                            }
                        }
                    }
                }
            }
        }

        // The proxies page's menu (`_buildMenuItems`), as a sheet from the bottom.
        // The proxies page's ⋯ menu (`_buildMenuItems`): 风格, 排序, 布局, 尺寸 and, for the
        // list, 图标样式 each open their options with the current one checked; 隐藏超时代理
        // toggles. Layout and size list 宽松/标准/紧凑 (FlClash's enum order) over the stored
        // 0 紧凑 / 1 标准 / 2 宽松.
        if root.proxy-options-open: Rectangle {
            TouchArea { clicked => { root.proxy-options-open = false; root.proxy-sub = ""; } }
            Rectangle {
                x: parent.width - self.width - 8px;
                y: root.top-inset + 52px;
                width: 240px;
                height: pm.preferred-height;
                background: Theme.s.card;
                border-radius: 16px;
                border-width: 1px;
                border-color: Theme.s.outline-variant.with-alpha(0.5);
                clip: true;
                TouchArea { }
                pm := VerticalLayout {
                    padding-top: 6px;
                    padding-bottom: 6px;
                    if root.proxy-sub == "": VerticalLayout {
                        PopupRow { glyph: Icons.apps; label: "风格"; value: root.proxy-style.kind == 0 ? "标签页" : "列表"; more: true; clicked => { root.proxy-sub = "kind"; } }
                        Rectangle { height: 1px; background: Theme.s.outline-variant.with-alpha(0.5); }
                        PopupRow { glyph: Icons.sort; label: "排序"; value: root.proxy-style.sort == 1 ? "延迟" : root.proxy-style.sort == 2 ? "名称" : "默认"; more: true; clicked => { root.proxy-sub = "sort"; } }
                        PopupRow { glyph: Icons.dashboard; label: "布局"; value: root.proxy-style.layout == 0 ? "紧凑" : root.proxy-style.layout == 2 ? "宽松" : "标准"; more: true; clicked => { root.proxy-sub = "layout"; } }
                        PopupRow { glyph: Icons.unfold; label: "尺寸"; value: root.proxy-style.card == 0 ? "紧凑" : root.proxy-style.card == 2 ? "宽松" : "标准"; more: true; clicked => { root.proxy-sub = "card"; } }
                        if root.proxy-style.kind == 1: PopupRow { glyph: Icons.photos; label: "图标样式"; value: root.proxy-style.icon == 1 ? "纯图标" : root.proxy-style.icon == 2 ? "隐藏" : "色块"; more: true; clicked => { root.proxy-sub = "icon"; } }
                        Rectangle { height: 1px; background: Theme.s.outline-variant.with-alpha(0.5); }
                        PopupRow {
                            glyph: Icons.eye-off;
                            label: "隐藏超时代理";
                            checked: root.proxy-style.hide-timeout;
                            clicked => { root.proxy-style-changed("hide", root.proxy-style.hide-timeout ? 0 : 1); }
                        }
                    }
                    if root.proxy-sub != "": VerticalLayout {
                        PopupRow {
                            glyph: Icons.back;
                            label: root.proxy-sub == "kind" ? "风格" : root.proxy-sub == "sort" ? "排序" : root.proxy-sub == "layout" ? "布局" : root.proxy-sub == "card" ? "尺寸" : "图标样式";
                            clicked => { root.proxy-sub = ""; }
                        }
                        Rectangle { height: 1px; background: Theme.s.outline-variant.with-alpha(0.5); }
                        for o in (root.proxy-sub == "kind" ? [{ l: "标签页", v: 0 }, { l: "列表", v: 1 }]
                            : root.proxy-sub == "sort" ? [{ l: "默认", v: 0 }, { l: "延迟", v: 1 }, { l: "名称", v: 2 }]
                            : root.proxy-sub == "icon" ? [{ l: "色块", v: 0 }, { l: "纯图标", v: 1 }, { l: "隐藏", v: 2 }]
                            : [{ l: "宽松", v: 2 }, { l: "标准", v: 1 }, { l: "紧凑", v: 0 }]): PopupRow {
                            label: o.l;
                            checked: o.v == (root.proxy-sub == "kind" ? root.proxy-style.kind : root.proxy-sub == "sort" ? root.proxy-style.sort : root.proxy-sub == "layout" ? root.proxy-style.layout : root.proxy-sub == "card" ? root.proxy-style.card : root.proxy-style.icon);
                            clicked => {
                                root.proxy-style-changed(root.proxy-sub, o.v);
                                root.proxy-sub = "";
                                root.proxy-options-open = false;
                            }
                        }
                    }
                }
            }
        }

        // AddProfileMenu, anchored at the button that opened it; 从手机发送 only on a TV.
        if root.add-menu-open: AnchorMenu {
            items: root.is-tv ? [
                { id: "qr", glyph: "qr", label: "二维码", enabled: true },
                { id: "file", glyph: "import-file", label: "文件", enabled: true },
                { id: "link", glyph: "cloud", label: "链接", enabled: true },
                { id: "phone", glyph: "devices", label: "从手机发送", enabled: true },
                { id: "custom", glyph: "customize", label: "自定义", enabled: true },
            ] : [
                { id: "qr", glyph: "qr", label: "二维码", enabled: true },
                { id: "file", glyph: "import-file", label: "文件", enabled: true },
                { id: "link", glyph: "cloud", label: "链接", enabled: true },
                { id: "custom", glyph: "customize", label: "自定义", enabled: true },
            ];
            menu-width: 200px;
            ax: root.ctx-x;
            ay: root.ctx-y;
            aw: root.ctx-w;
            ah: root.ctx-h;
            picked(id) => {
                root.add-menu-open = false;
                if (id == "file") {
                    root.add-file();
                } else if (id == "qr") {
                    root.add-from-qr();
                } else if (id == "phone") {
                    root.send-from-phone();
                } else if (id == "custom") {
                    root.add-custom();
                } else {
                    root.link-open = true;
                    link-url.focus-input();
                }
            }
            dismiss => { root.add-menu-open = false; }
        }

        // The profile's long-press menu (ProfileItem._menuItems), anchored at its card; 更多
        // unfolds its sub items in place.
        if root.menu-open: AnchorMenu {
            items: root.menu-item.is-custom ? [
                    { id: "edit", glyph: "edit", label: "编辑", enabled: true },
                    { id: "rename", glyph: "text-short", label: "重命名", enabled: true },
                    { id: "preview", glyph: "eye", label: "运行时配置", enabled: true },
                    { id: "delete", glyph: "delete", label: "删除", danger: true, enabled: true },
                ]
                : root.menu-item.is-url
                ? (root.menu-more ? [
                    { id: "edit", glyph: "edit", label: "编辑", enabled: true },
                    { id: "extend", glyph: "puzzle", label: "扩展", enabled: true },
                    { id: "sync", glyph: "sync", label: "同步", enabled: true },
                    { id: "more", glyph: "more-circle", label: "更多", heading: "more", enabled: true },
                    { id: "preview", glyph: "eye", label: "运行时配置", sub: true, enabled: true },
                    { id: "copy", glyph: "copy", label: "复制链接", sub: true, enabled: true },
                    { id: "qr", glyph: "qr", label: "二维码", sub: true, enabled: true },
                    { id: "export", glyph: "export", label: "导出文件", sub: true, enabled: true },
                    { id: "delete", glyph: "delete", label: "删除", danger: true, enabled: true },
                ] : [
                    { id: "edit", glyph: "edit", label: "编辑", enabled: true },
                    { id: "extend", glyph: "puzzle", label: "扩展", enabled: true },
                    { id: "sync", glyph: "sync", label: "同步", enabled: true },
                    { id: "more", glyph: "more-circle", label: "更多", heading: "more", enabled: true },
                    { id: "delete", glyph: "delete", label: "删除", danger: true, enabled: true },
                ])
                : (root.menu-more ? [
                    { id: "edit", glyph: "edit", label: "编辑", enabled: true },
                    { id: "extend", glyph: "puzzle", label: "扩展", enabled: true },
                    { id: "more", glyph: "more-circle", label: "更多", heading: "more", enabled: true },
                    { id: "preview", glyph: "eye", label: "运行时配置", sub: true, enabled: true },
                    { id: "export", glyph: "export", label: "导出文件", sub: true, enabled: true },
                    { id: "delete", glyph: "delete", label: "删除", danger: true, enabled: true },
                ] : [
                    { id: "edit", glyph: "edit", label: "编辑", enabled: true },
                    { id: "extend", glyph: "puzzle", label: "扩展", enabled: true },
                    { id: "more", glyph: "more-circle", label: "更多", heading: "more", enabled: true },
                    { id: "delete", glyph: "delete", label: "删除", danger: true, enabled: true },
                ]);
            max-rows: 10;
            ax: root.ctx-x;
            ay: root.ctx-y;
            aw: root.ctx-w;
            ah: root.ctx-h;
            picked(id) => {
                if (id == "more") {
                    root.menu-more = !root.menu-more;
                    return;
                }
                root.menu-open = false;
                if (id == "edit") { root.edit-profile(root.menu-item.id); }
                if (id == "sync") { root.update-profile(root.menu-item.id); }
                if (id == "preview") { root.preview-profile(root.menu-item.id); }
                if (id == "copy") { root.copy-link(root.menu-item.id); }
                if (id == "qr") { root.show-qr(root.menu-item.id); }
                if (id == "export") { root.export-profile(root.menu-item.id); }
                if (id == "delete") { root.delete-profile(root.menu-item.id); }
                if (id == "rename") { root.rename-profile(root.menu-item.id); }
                if (id == "extend") { root.ext-open(root.menu-item.id); }
            }
            dismiss => { root.menu-open = false; }
        }

        // The custom profile page's title menu.
        if root.custom-menu-open: AnchorMenu {
            items: [
                { id: "rename", glyph: "text-short", label: "重命名", enabled: true },
                { id: "preview", glyph: "eye", label: "运行时配置", enabled: true },
            ];
            menu-width: 200px;
            ax: root.ctx-x;
            ay: root.ctx-y;
            aw: root.ctx-w;
            ah: root.ctx-h;
            picked(id) => {
                root.custom-menu-open = false;
                root.custom-action(id);
            }
            dismiss => { root.custom-menu-open = false; }
        }

        // The custom profile page's 导入 menu.
        if root.custom-import-open: AnchorMenu {
            items: [
                { id: "import-url", glyph: "cloud", label: "通过URL导入", enabled: true },
                { id: "import-file", glyph: "import-file", label: "通过文件导入", enabled: true },
            ];
            menu-width: 200px;
            ax: root.ctx-x;
            ay: root.ctx-y;
            aw: root.ctx-w;
            ah: root.ctx-h;
            picked(id) => {
                root.custom-import-open = false;
                root.custom-action(id);
            }
            dismiss => { root.custom-import-open = false; }
        }

        // 从链接导入 (showNamedUrlsForm): a name, the link and an age key, or a batch of links.
        // Kept in the tree so the inputs keep their text and focus.
        Dialog {
            visible: root.link-open;
            title: "从链接导入";
            keyboard: root.keyboard;
            top: root.top-inset;
            dismiss => { root.link-open = false; }
            link-name := Field { label: "名称"; placeholder: "可选"; visible: !root.link-batch; height: root.link-batch ? 0 : self.preferred-height; }
            link-url := Field {
                label: "链接";
                placeholder: root.link-batch ? "每行一个链接" : "订阅链接或代理分享链接";
                multi: root.link-batch;
               
            }
            link-age := Field { label: "age 私钥"; placeholder: "可选"; visible: !root.link-batch; height: root.link-batch ? 0 : self.preferred-height; }
            HorizontalLayout {
                spacing: 8px;
                TextButton { text: root.link-batch ? "单个导入" : "批量导入"; clicked => { root.link-batch = !root.link-batch; } }
                Rectangle { horizontal-stretch: 1; }
                TextButton { text: "取消"; clicked => { root.link-open = false; } }
                TextButton {
                    text: "导入";
                    enabled: !root.adding && link-url.text != "";
                    clicked => { root.import-links(link-name.text, link-url.text, link-age.text, root.link-batch); }
                }
            }
        }

        if root.age-open: Dialog {
            title: "age 私钥";
            keyboard: root.keyboard;
            top: root.top-inset;
            dismissable: false;
            Text { text: "该配置已用 age 加密，需要 age 私钥才能解密"; wrap: word-wrap; color: Theme.s.on-surface-variant; }
            age-key := Field { placeholder: "AGE-SECRET-KEY-…"; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                TextButton { text: "取消"; clicked => { root.age-open = false; root.age-submit(""); } }
                TextButton { text: "确定"; enabled: age-key.text != ""; clicked => { root.age-open = false; root.age-submit(age-key.text); } }
            }
        }

        if root.qr-open: Dialog {
            title: root.qr-title;
            top: root.top-inset;
            dismiss => { root.qr-open = false; root.qr-closed(); }
            if root.qr-kind != "send" || root.qr-image.width > 0: HorizontalLayout {
                alignment: center;
                Image { source: root.qr-image; width: root.qr-kind == "send" ? 200px : 240px; height: self.width; image-rendering: pixelated; }
            }
            Text { text: root.qr-kind == "send" ? root.qr-text : "在另一台设备上用 FlClash 扫码即可导入此配置。"; wrap: word-wrap; color: Theme.s.on-surface-variant; horizontal-alignment: center; }
            HorizontalLayout {
                alignment: end;
                TextButton { text: root.qr-kind == "send" ? "取消" : "确定"; clicked => { root.qr-open = false; root.qr-closed(); } }
            }
        }

        // `MemoryDetailSheet`: the total, what the app holds, and release memory.
        // ReorderableProfilesSheet: drag the profiles into order, then ✓ saves.
        if root.profiles-shown && root.profiles-page == "sort": DashSheet {
            side: root.wide;
            title: "配置排序";
            top-inset: root.top-inset;
            bottom-inset: root.bottom-inset;
            action-glyph: Icons.check;
            scroll-locked: sort-list.dragging;
            close => { root.profiles-page = ""; }
            action => { root.sort-save(); }
            sort-list := ReorderList {
                titles: root.sort-titles;
                moved(f, t) => { root.sort-move(f, t); }
            }
        }

        // `ServiceStatusSheet`: every enabled service, a tap checks one, ⚡ all of them;
        // the sliders open `ServiceManageView` to switch and order them.
        if root.svc-sheet-open && root.tab == 0: DashSheet {
            side: root.wide;
            title: root.svc-sheet-page == "manage" ? "管理服务" : "服务状态";
            top-inset: root.top-inset;
            bottom-inset: root.bottom-inset;
            can-back: root.svc-sheet-page == "manage";
            back => { root.svc-sheet-page = ""; }
            action-glyph: root.svc-sheet-page == "" ? Icons.bolt : "";
            action-loading: root.dash-services-checking;
            action2-glyph: root.svc-sheet-page == "" ? Icons.sliders : "";
            scroll-locked: root.svc-sheet-page == "manage" && root.svc-dragging;
            close => { root.svc-sheet-open = false; root.svc-sheet-page = ""; }
            action => { root.dash-check-service(""); }
            action2 => { root.svc-sheet-page = "manage"; }
            if root.svc-sheet-page == "": Rectangle {
                background: Theme.s.card;
                border-radius: 16px;
                height: root.dash-service-rows.length * 64px;
                for sr[sri] in root.dash-service-rows: Rectangle {
                    y: sri * 64px;
                    height: 64px;
                    background: svr-ta.pressed && !sr.loading ? Theme.s.block.with-alpha(0.5) : transparent;
                    border-radius: 16px;
                    svr-ta := TouchArea { clicked => { if (!sr.loading) { root.dash-check-service(sr.id); } } }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 16px;
                        spacing: 12px;
                        VerticalLayout { alignment: center; ServiceBadge { service: sr.id; size: 40px; radius: 4px; tile: Theme.s.block; under: Theme.s.card; dot: sr.loading ? 4 : sr.dot; } }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text { text: sr.label; font-size: 16px * Type.scale; color: Theme.s.on-surface; overflow: elide; }
                            if sr.loading || sr.ip == "": Text { text: sr.loading ? "…" : sr.place; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; overflow: elide; }
                            if !sr.loading && sr.ip != "": HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    border-radius: 6px;
                                    background: sip-ta.pressed ? Theme.s.block : transparent;
                                    sip-text := Text {
                                        text: (sr.region == "" ? "" : sr.region + " · ") + (root.dash-hide-ip ? "*****" : sr.ip);
                                        font-size: 13px * Type.scale;
                                        color: Theme.s.on-surface-variant;
                                        overflow: elide;
                                    }
                                    sip-ta := TouchArea { clicked => { root.open-service-ip(sr.ip, sr.region); } }
                                }
                            }
                        }
                        Text {
                            text: sr.status;
                            font-size: 13px * Type.scale;
                            font-weight: 600;
                            color: sr.tone == 1 ? Theme.success : sr.tone == 2 ? Theme.warning : sr.tone == 3 ? Theme.s.error : Theme.s.on-surface-variant;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            wrap: word-wrap;
                            max-width: parent.width * 0.5;
                        }
                    }
                    if sri < root.dash-service-rows.length - 1: Rectangle {
                        x: 64px;
                        y: parent.height - 1px;
                        width: parent.width - 64px;
                        height: 1px;
                        background: Theme.s.outline-variant.with-alpha(0.6);
                    }
                }
            }
            if root.svc-sheet-page == "manage": ServiceManageList {
                rows: root.dash-service-manage;
                changed dragging => { root.svc-dragging = self.dragging; }
                moved(f, t) => { root.dash-service-move(f, t); }
                toggled(id, on) => { root.dash-service-toggle(id, on); }
            }
        }

        if root.mem-sheet-open && root.tab == 0: DashSheet {
            side: root.wide;
            title: "内存信息";
            top-inset: root.top-inset;
            bottom-inset: root.bottom-inset;
            action-glyph: root.mem-releasing ? Icons.clock : Icons.broom;
            action-enabled: !root.mem-releasing;
            close => { root.mem-sheet-open = false; }
            action => { root.release-memory(); }
            VerticalLayout {
                padding-left: 4px;
                padding-top: 8px;
                spacing: 6px;
                Text { text: "总计"; font-size: 15px * Type.scale; color: Theme.s.on-surface-variant; }
                Text { text: root.dash-mem.total == "" ? "—" : root.dash-mem.total; font-size: 28px * Type.scale; font-weight: 700; color: Theme.s.on-surface; min-width: max(self.preferred-width, self.text.character-count * 28px * 0.62) * 1.1; }
                Rectangle { height: 8px; border-radius: 4px; background: Theme.s.primary; }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.s.primary; } }
                    Text { text: root.dash-mem.shared ? "应用及共享" : "应用"; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; }
                    Text { text: root.dash-mem.app; font-size: 12px * Type.scale; font-weight: 600; color: Theme.s.on-surface; }
                }
                Text { text: "基于进程常驻内存估算，可能与系统显示的数值不同。"; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; wrap: word-wrap; }
            }
            Rectangle { height: 4px; }
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                Text { text: root.dash-mem.shared ? "应用及共享" : "应用"; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; horizontal-stretch: 1; }
                Text { text: root.dash-mem.app; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; }
            }
            Rectangle {
                background: Theme.s.card;
                border-radius: 16px;
                height: self.preferred-height;
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 12px;
                    SheetRow { label: "常驻内存"; value: root.dash-mem.app; }
                    Rectangle { height: 4px; border-radius: 2px; background: Theme.s.primary; }
                }
            }
        }

        // `ProfileDetailSheet`: counts, subscription, update time, script and providers.
        if root.profile-sheet-open && root.tab == 0: DashSheet {
            side: root.wide;
            title: root.dash-profile.name;
            top-inset: root.top-inset;
            bottom-inset: root.bottom-inset;
            action-glyph: root.dash-profile.syncable ? (root.dash-profile.busy ? Icons.clock : Icons.sync) : "";
            action-enabled: !root.dash-profile.busy;
            action2-glyph: Icons.eye;
            close => { root.profile-sheet-open = false; }
            action => { root.update-profile(root.dash-profile.id); }
            action2 => {
                root.profile-sheet-open = false;
                root.preview-profile(root.dash-profile.id);
            }
            HorizontalLayout {
                spacing: 8px;
                padding-top: 8px;
                StatTile { label: "策略组"; value: root.profile-detail.groups; }
                StatTile { label: "代理"; value: root.profile-detail.proxies; }
            }
            HorizontalLayout {
                spacing: 8px;
                StatTile { label: "规则"; value: root.profile-detail.rules; }
                StatTile { label: "外部资源"; value: root.profile-detail.providers; }
            }
            if root.dash-profile.usage: VerticalLayout {
                spacing: 8px;
                Rectangle { height: 4px; }
                Text { text: "订阅信息"; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; }
                Rectangle {
                    background: Theme.s.card;
                    border-radius: 16px;
                    height: self.preferred-height;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: root.dash-profile.used; font-size: 15px * Type.scale; color: Theme.s.on-surface; horizontal-stretch: 1; overflow: elide; }
                            Text { text: root.dash-profile.end; font-size: 13px * Type.scale; color: root.dash-profile.warn ? Theme.warning : Theme.s.on-surface-variant; }
                        }
                        Rectangle {
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.s.block;
                            Rectangle { x: 0; width: parent.width * root.dash-profile.ratio; border-radius: 3px; background: root.dash-profile.ratio >= 0.9 ? Theme.warning : Theme.s.primary; }
                        }
                    }
                }
            }
            Rectangle { height: 4px; }
            Text { text: "配置"; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; }
            Rectangle {
                background: Theme.s.card;
                border-radius: 16px;
                height: self.preferred-height;
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    SheetRow { label: "上次更新"; value: root.profile-detail.updated; }
                    Rectangle { height: 1px; background: Theme.s.outline-variant.with-alpha(0.6); }
                    SheetRow { label: "扩展脚本"; value: root.profile-detail.script; }
                }
            }
            if root.profile-providers.length > 0: VerticalLayout {
                spacing: 8px;
                Rectangle { height: 4px; }
                HorizontalLayout {
                    Text { text: "外部资源"; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; horizontal-stretch: 1; }
                    if root.providers-updating: VerticalLayout {
                        alignment: center;
                        Rectangle { width: 40px; height: 40px; Spinner { width: 20px; height: 20px; indeterminate: true; } }
                    }
                    if !root.providers-updating: IconButton { glyph: Icons.sync; tint: Theme.s.on-surface-variant; clicked => { root.provider-act("update-all", ""); } }
                }
                Rectangle {
                    background: Theme.s.card;
                    border-radius: 16px;
                    height: self.preferred-height;
                    clip: true;
                    VerticalLayout {
                        for pr[pi] in root.profile-providers: Rectangle {
                            property <bool> long-fired;
                            height: pv-col.preferred-height;
                            background: pv-ta.pressed && !pr.busy ? Theme.s.inset : transparent;
                            if pi > 0: Rectangle { x: 16px; y: 0; width: parent.width - 16px; height: 1px; background: Theme.s.outline-variant.with-alpha(0.6); }
                            pv-col := HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 12px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: pr.name; font-size: 15px * Type.scale; color: Theme.s.on-surface; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                        if pr.chip != "": VerticalLayout { alignment: center; Chip { text: pr.chip; } }
                                        if pr.expire != "": VerticalLayout { alignment: center; Chip { text: pr.expire; tone: pr.expired ? Theme.s.error : Theme.s.primary; } }
                                    }
                                    if !pr.meter: Text { text: pr.subtitle; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; overflow: elide; }
                                    if pr.meter: VerticalLayout {
                                        spacing: 6px;
                                        Text { text: pr.traffic; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; overflow: elide; }
                                        Rectangle {
                                            height: 4px;
                                            border-radius: 2px;
                                            background: Theme.s.primary.with-alpha(0.15);
                                            Rectangle { x: 0; width: parent.width * pr.ratio; border-radius: 2px; background: Theme.s.primary; }
                                        }
                                    }
                                }
                                if pr.busy: VerticalLayout { alignment: center; Spinner { width: 24px; height: 24px; indeterminate: true; } }
                                if !pr.busy && pr.updated != "": VerticalLayout {
                                    alignment: center;
                                    Text { text: pr.updated; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; }
                                }
                            }
                            pv-ta := TouchArea {
                                enabled: !pr.busy;
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down) { parent.long-fired = false; }
                                }
                                clicked => {
                                    if (!parent.long-fired && pr.previewable) { root.provider-act("preview", pr.name); }
                                }
                            }
                            Timer {
                                interval: 500ms;
                                running: pv-ta.pressed && !parent.long-fired && !pr.busy;
                                triggered => {
                                    parent.long-fired = true;
                                    Anchor.x = parent.absolute-position.x;
                                    Anchor.y = parent.absolute-position.y;
                                    Anchor.w = parent.width;
                                    Anchor.h = parent.height;
                                    root.provider-act("menu", pr.name);
                                }
                            }
                        }
                    }
                }
            }
        }

        // `showIpQualitySheet`: the outbound address, its kind and network, and hide IP.
        if root.ip-sheet-open && root.tab == 0: Rectangle {
            background: #00000066;
            TouchArea { clicked => { root.ip-sheet-open = false; } }
            Rectangle {
                width: root.wide ? SideSheet.width(parent.width) : min(parent.width, 640px);
                x: root.wide ? parent.width - self.width : (parent.width - self.width) / 2;
                y: root.wide ? 0 : max(root.top-inset + 24px, parent.height - ipq-col.preferred-height - 60px);
                height: parent.height - self.y;
                background: Theme.s.page;
                border-top-left-radius: root.wide ? 0 : 24px;
                border-top-right-radius: root.wide ? 0 : 24px;
                clip: true;
                TouchArea { }
                VerticalLayout {
                    Rectangle {
                        height: root.wide ? root.top-inset + 8px : 16px;
                        if !root.wide: Rectangle { y: 8px; width: 36px; height: 4px; border-radius: 2px; background: Theme.s.outline-variant; }
                    }
                    HorizontalLayout {
                        height: 44px;
                        padding-left: 20px;
                        padding-right: 8px;
                        Text { text: "出站 IP详情"; font-size: 17px * Type.scale; font-weight: 600; color: Theme.s.on-surface; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        VerticalLayout { alignment: center; IconButton { glyph: Icons.close; clicked => { root.ip-sheet-open = false; } } }
                    }
                    Flickable {
                        vertical-stretch: 1;
                        content-height: ipq-col.preferred-height;
                        ipq-col := VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 4px;
                            padding-bottom: 20px + root.bottom-inset;
                            spacing: 8px;
                            Text { text: "依赖第三方api，仅供参考"; font-size: 14px * Type.scale; color: Theme.s.on-surface-variant; wrap: word-wrap; }
                            Rectangle { height: 4px; }
                            Text { text: "基础信息"; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; }
                            Rectangle {
                                background: Theme.s.card;
                                border-radius: 16px;
                                height: self.preferred-height;
                                VerticalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    HorizontalLayout {
                                        height: 48px;
                                        spacing: 12px;
                                        Text { text: "IP 地址"; font-size: 15px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; }
                                        Text { text: root.dash-hide-ip ? "*****" : root.ipq.ip; font-size: 15px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; horizontal-alignment: right; horizontal-stretch: 1; overflow: elide; }
                                    }
                                    Rectangle { height: 1px; background: Theme.s.outline-variant.with-alpha(0.6); }
                                    HorizontalLayout {
                                        height: 48px;
                                        spacing: 12px;
                                        Text { text: "类型"; font-size: 15px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; }
                                        Text { text: root.ipq.kind == "" ? "—" : root.ipq.kind; font-size: 15px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; horizontal-alignment: right; horizontal-stretch: 1; overflow: elide; }
                                    }
                                    Rectangle { height: 1px; background: Theme.s.outline-variant.with-alpha(0.6); }
                                    HorizontalLayout {
                                        height: 48px;
                                        spacing: 12px;
                                        Text { text: "等级"; font-size: 15px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; }
                                        Text { text: root.ipq.quality == 1 ? "优" : root.ipq.quality == 2 ? "普通" : root.ipq.quality == 3 ? "风险" : "—"; font-size: 15px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; horizontal-alignment: right; horizontal-stretch: 1; overflow: elide; }
                                    }
                                }
                            }
                            Rectangle { height: 4px; }
                            Text { text: "网络"; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; }
                            Rectangle {
                                background: Theme.s.card;
                                border-radius: 16px;
                                height: self.preferred-height;
                                VerticalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    HorizontalLayout {
                                        height: 48px;
                                        spacing: 12px;
                                        Text { text: "区域"; font-size: 15px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; }
                                        Text { text: root.ipq.country == "" ? "—" : root.ipq.country; font-size: 15px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; horizontal-alignment: right; horizontal-stretch: 1; overflow: elide; }
                                    }
                                    Rectangle { height: 1px; background: Theme.s.outline-variant.with-alpha(0.6); }
                                    HorizontalLayout {
                                        height: 48px;
                                        spacing: 12px;
                                        Text { text: "组织"; font-size: 15px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; }
                                        Text { text: root.ipq.org == "" ? "—" : root.ipq.org; font-size: 15px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; horizontal-alignment: right; horizontal-stretch: 1; overflow: elide; }
                                    }
                                }
                            }
                            Rectangle { height: 4px; }
                            Text { text: "其他"; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; }
                            Rectangle {
                                background: Theme.s.card;
                                border-radius: 16px;
                                height: self.preferred-height;
                                VerticalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    HorizontalLayout {
                                        height: 52px;
                                        spacing: 12px;
                                        Text { text: "隐藏 IP"; font-size: 15px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; horizontal-stretch: 1; }
                                        VerticalLayout { alignment: center; Switch { checked: root.dash-hide-ip; toggled(v) => { root.dash-set-hide-ip(v); } } }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // `_showLogDetail`: the record's time and level, then its whole payload.
        if root.log-detail-open && root.tools-shown && root.tools-page == "logs": Rectangle {
            background: #00000066;
            TouchArea { clicked => { root.log-detail-open = false; } }
            Rectangle {
                width: root.wide ? SideSheet.width(parent.width) : min(parent.width, 640px);
                x: root.wide ? parent.width - self.width : (parent.width - self.width) / 2;
                y: root.wide ? 0 : root.top-inset + 24px;
                height: parent.height - self.y;
                background: Theme.s.page;
                border-top-left-radius: root.wide ? 0 : 24px;
                border-top-right-radius: root.wide ? 0 : 24px;
                clip: true;
                TouchArea { }
                VerticalLayout {
                    Rectangle {
                        height: root.wide ? root.top-inset + 8px : 16px;
                        if !root.wide: Rectangle { y: 8px; width: 36px; height: 4px; border-radius: 2px; background: Theme.s.outline-variant; }
                    }
                    HorizontalLayout {
                        height: 44px;
                        padding-left: 20px;
                        padding-right: 8px;
                        Text { text: "日志详情"; font-size: 17px * Type.scale; font-weight: 600; color: Theme.s.on-surface; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        VerticalLayout { alignment: center; IconButton { glyph: Icons.copy; clicked => { root.logs-copy(root.log-detail.id); } } }
                        VerticalLayout { alignment: center; IconButton { glyph: Icons.close; clicked => { root.log-detail-open = false; } } }
                    }
                    Flickable {
                        vertical-stretch: 1;
                        content-height: ld-col.preferred-height;
                        ld-col := VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 8px;
                            padding-bottom: 20px + root.bottom-inset;
                            spacing: 8px;
                            Text { text: "基础信息"; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; }
                            Rectangle {
                                background: Theme.s.card;
                                border-radius: 16px;
                                height: ld-info.preferred-height;
                                ld-info := VerticalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    HorizontalLayout {
                                        height: 48px;
                                        spacing: 12px;
                                        Text { text: "时间"; font-size: 15px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; }
                                        Text { text: root.log-detail.time; font-size: 15px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; horizontal-alignment: right; horizontal-stretch: 1; overflow: elide; }
                                    }
                                    Rectangle { height: 1px; background: Theme.s.outline-variant.with-alpha(0.6); }
                                    HorizontalLayout {
                                        height: 48px;
                                        spacing: 12px;
                                        Text { text: "日志等级"; font-size: 15px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; }
                                        Text { text: root.log-detail.level; font-size: 15px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; horizontal-alignment: right; horizontal-stretch: 1; overflow: elide; }
                                    }
                                }
                            }
                            Rectangle { height: 8px; }
                            Text { text: "内容"; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; }
                            Rectangle {
                                background: Theme.s.card;
                                border-radius: 16px;
                                height: ld-body.preferred-height;
                                ld-body := VerticalLayout {
                                    padding: 16px;
                                    Text { text: root.log-detail.text; font-size: 15px * Type.scale; color: Theme.s.on-surface; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                }
            }
        }

        // The detail of the selection in a sheet, where no pane fits beside the list.
        if root.req-sheet-open && root.req-visible: Rectangle {
            background: #00000066;
            TouchArea { clicked => { root.req-sheet-open = false; root.req-sheet-closed(); } }
            // `showNestedSheet` → `showSheet`: a side sheet past the mobile width, with
            // the phone's title actions.
            Rectangle {
                width: root.wide ? SideSheet.width(parent.width) : parent.width;
                x: root.wide ? parent.width - self.width : 0;
                y: root.wide ? 0 : root.top-inset + 24px;
                height: parent.height - self.y;
                background: Theme.s.card;
                border-top-left-radius: root.wide ? 0 : 24px;
                border-top-right-radius: root.wide ? 0 : 24px;
                clip: true;
                TouchArea { }
                VerticalLayout {
                    Rectangle {
                        height: root.wide ? root.top-inset + 8px : 16px;
                        if !root.wide: Rectangle { y: 8px; width: 36px; height: 4px; border-radius: 2px; background: Theme.s.outline-variant; }
                    }
                    HorizontalLayout {
                        height: 44px;
                        padding-left: 20px;
                        padding-right: 8px;
                        Text { text: root.req-detail.sheet-title; font-size: 17px * Type.scale; font-weight: 600; color: Theme.s.on-surface; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        if root.req-detail.menu: VerticalLayout { alignment: center; IconButton { glyph: Icons.more; clicked => { root.req-detail-menu(); } } }
                        VerticalLayout { alignment: center; IconButton { glyph: Icons.close; clicked => { root.req-sheet-open = false; root.req-sheet-closed(); } } }
                    }
                    DetailView {
                        vertical-stretch: 1;
                        detail: root.req-detail;
                        stretch-tabs: !root.wide;
                        top-gap: 8px;
                        bottom-gap: root.bottom-inset;
                        tab(i) => { root.req-detail-tab(i); }
                        close => { root.req-detail-close(); }
                        menu => { root.req-detail-menu(); }
                        open-row(a) => { root.req-detail-row(a); }
                    }
                }
            }
        }

        if root.req-body-page != "": Rectangle {
            background: Theme.s.page;
            TouchArea { }
            VerticalLayout {
                padding-top: root.top-inset;
                if root.req-body-page == "text": EditorPage {
                    vertical-stretch: 1;
                    title <=> root.req-body-title;
                    text <=> root.req-body-text;
                    key: "body";
                    finding <=> root.editor-finding;
                    menu-open <=> root.editor-menu-open;
                    readonly: true;
                    back => { root.req-body-page = ""; }
                }
                if root.req-body-page == "hex": HexPage {
                    vertical-stretch: 1;
                    title: root.req-body-title;
                    lines: root.req-hex-lines;
                    truncated: root.req-body-truncated;
                    back => { root.req-body-page = ""; }
                    menu => { root.req-body-menu(); }
                    columns(n) => { root.req-hex-columns(n); }
                }
            }
        }

        // `ContextMenuRegion` and the ⋯ menus: a popup at the press or the button.
        if root.req-actions-open: AnchorMenu {
            items: root.req-actions;
            ax: MenuAnchor.x;
            ay: MenuAnchor.y;
            aw: MenuAnchor.w;
            ah: MenuAnchor.h;
            max-rows: 10;
            picked(id) => {
                if (id != "capture-limit" && id != "http-reject" && id != "http-map-local") { root.req-actions-open = false; }
                root.req-action(id);
            }
            dismiss => { root.req-actions-open = false; }
        }

        if root.cond-open: Dialog {
            title: root.cond-editing ? "编辑条件" : "添加条件";
            keyboard: root.keyboard;
            top: root.top-inset;
            dismiss => { root.cond-open = false; }
            VerticalLayout {
                spacing: 6px;
                HorizontalLayout { padding-left: 14px; Text { text: "字段"; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; } }
                ChoiceGrid {
                    choices: root.cond-fields;
                    value: root.cond-field;
                    picked(i) => { root.cond-field = i; root.cond-changed(); }
                }
            }
            VerticalLayout {
                spacing: 6px;
                HorizontalLayout { padding-left: 14px; Text { text: "条件"; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; } }
                ChoiceGrid {
                    choices: ["包含", "不包含", "等于", "不等于"];
                    value: root.cond-op;
                    picked(i) => { root.cond-op = i; root.cond-changed(); }
                }
            }
            Field {
                label: "值";
                text <=> root.cond-value;
                accepted => { if (root.cond-ready) { root.cond-submit(); } }
                init => { self.focus-input(); }
            }
            if root.cond-suggestions.length > 0: VerticalLayout {
                spacing: 6px;
                HorizontalLayout { padding-left: 14px; Text { text: root.cond-values-in; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; } }
                Flickable {
                    height: 32px;
                    content-width: sugg.preferred-width;
                    interactive: sugg.preferred-width > self.width;
                    sugg := HorizontalLayout {
                        spacing: 6px;
                        for g in root.cond-suggestions: Rectangle {
                            height: 32px;
                            width: sugg-row.preferred-width;
                            border-radius: 16px;
                            background: sta.pressed ? Theme.s.inset : Theme.s.block;
                            sugg-row := HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;
                                Text { text: g.value; font-size: 13px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; }
                                Text { text: g.count; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; }
                            }
                            sta := TouchArea { clicked => { root.cond-value = g.value; } }
                        }
                    }
                }
            }
            VerticalLayout {
                padding-left: 14px;
                spacing: 4px;
                Text { text: root.cond-shows; font-size: 13px * Type.scale; font-weight: 600; color: Theme.s.on-surface; }
                Text { text: root.cond-tip; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; wrap: word-wrap; }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                TextButton { text: "取消"; clicked => { root.cond-open = false; } }
                TextButton { text: root.cond-editing ? "保存" : "添加"; enabled: root.cond-ready; clicked => { root.cond-submit(); } }
            }
        }

        if root.res-dialog != "": Dialog {
            title: root.res-dialog-title;
            keyboard: root.keyboard;
            top: root.top-inset;
            dismiss => { root.res-dialog = ""; }
            HorizontalLayout {
                spacing: 12px;
                Field {
                    horizontal-stretch: 1;
                    text <=> root.res-dialog-value;
                    input-type: root.res-dialog == "interval" ? InputType.number : InputType.text;
                    init => { self.focus-input(); }
                }
                if root.res-dialog == "interval": Text { text: "小时"; font-size: 15px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; }
            }
            if root.res-error != "": HorizontalLayout { padding-left: 14px; Text { text: root.res-error; font-size: 13px * Type.scale; color: Theme.s.error; } }
            HorizontalLayout {
                spacing: 8px;
                if root.res-dialog-default != "": TextButton { text: "重置"; clicked => { root.res-dialog-value = root.res-dialog-default; } }
                Rectangle { horizontal-stretch: 1; }
                TextButton { text: "取消"; clicked => { root.res-dialog = ""; } }
                TextButton {
                    text: "确定";
                    enabled: root.res-check(root.res-dialog, root.res-dialog-value) == "";
                    clicked => {
                        root.res-dialog-submit(root.res-dialog, root.res-dialog-key, root.res-dialog-value);
                        root.res-dialog = "";
                    }
                }
            }
        }

        if root.confirm-open: Dialog {
            title: root.confirm-title;
            top: root.top-inset;
            dismissable: false;
            Text { text: root.confirm-text; wrap: word-wrap; color: Theme.s.on-surface-variant; font-size: 15px * Type.scale; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                TextButton { text: root.confirm-no != "" ? root.confirm-no : root.confirm-action == "access-save" || root.confirm-action == "pg-save" || root.confirm-action == "pr-save" ? "不保存" : "取消"; clicked => { root.confirm-open = false; root.confirm-answer(root.confirm-action, root.confirm-arg, false); } }
                TextButton {
                    text: root.confirm-yes != "" ? root.confirm-yes : root.confirm-action == "access-save" || root.confirm-action == "pg-save" || root.confirm-action == "pr-save" ? "保存" : root.confirm-action == "app-settings" ? "设置" : root.confirm-action == "delete" || root.confirm-action == "color-delete" || root.confirm-action == "ua-delete" || root.confirm-action == "pg-delete" || root.confirm-action == "pr-delete" || root.confirm-action == "icon-record-delete" || root.confirm-action == "mitm-detach" ? "删除" : root.confirm-action == "close-active" ? "关闭" : root.confirm-action == "color-reset" ? "重置" : root.confirm-action == "ci-replace" ? "替换" : "确定";
                    danger: root.confirm-danger || root.confirm-action == "delete" || root.confirm-action == "ua-delete" || root.confirm-action == "pg-delete" || root.confirm-action == "pr-delete" || root.confirm-action == "icon-record-delete" || root.confirm-action == "mitm-detach" || root.confirm-action == "close-active" || root.confirm-action == "color-delete" || root.confirm-action == "color-reset" || root.confirm-action == "ci-replace" || root.confirm-action == "cp-links-replace";
                    clicked => { root.confirm-open = false; root.confirm-answer(root.confirm-action, root.confirm-arg, true); }
                }
            }
        }

        if root.ctx-kind != "": AnchorMenu {
            items: root.ctx-items;
            names: root.ctx-names;
            current: root.ctx-kind == "group" ? root.current-group : "";
            // The access sub menus show whole, as FlClash's popup only scrolls past the screen.
            max-rows: root.ctx-kind == "acc" ? 12 : 7;
            ax: root.ctx-x;
            ay: root.ctx-y;
            aw: root.ctx-w;
            ah: root.ctx-h;
            picked(id) => {
                let kind = root.ctx-kind;
                root.ctx-kind = "";
                if (kind == "node" && id == "select") {
                    root.select-node(root.ctx-a, root.ctx-b);
                } else if (kind == "group") {
                    root.current-group = id;
                    root.open-group(id);
                } else {
                    root.ctx-picked(kind, root.ctx-a, root.ctx-b, id);
                }
            }
            dismiss => { root.ctx-kind = ""; }
        }

        if root.choice-open: ActionSheet {
            title: root.choice-title;
            items: root.choice-items;
            loading: root.choice-loading;
            bottom-inset: root.bottom-inset;
            picked(id) => { root.choice-open = false; root.choice-picked(id); }
            dismiss => { root.choice-open = false; }
        }

        if root.input-open: Dialog {
            title: root.input-title;
            keyboard: root.keyboard;
            top: root.top-inset;
            dismiss => { root.input-open = false; }
            Field {
                label: root.input-label;
                placeholder: root.input-hint;
                min-lines: root.input-lines;
                text <=> root.input-value;
                input-type: root.input-number ? InputType.number : InputType.text;
                init => { self.focus-input(); }
            }
            if root.input-label2 != "": Field { label: root.input-label2; text <=> root.input-value2; }
            if root.input-error != "": HorizontalLayout { padding-left: 14px; Text { text: root.input-error; font-size: 13px * Type.scale; color: Theme.s.error; wrap: word-wrap; max-height: 3 * 13px * Type.scale * 1.4; overflow: elide; } }
            HorizontalLayout {
                spacing: 8px;
                if root.input-removable && !root.input-holds: TextButton { text: "删除"; danger: true; clicked => { root.input-open = false; root.input-remove(root.input-key); } }
                Rectangle { horizontal-stretch: 1; }
                if !root.input-holds: TextButton { text: "取消"; clicked => { root.input-open = false; } }
                TextButton {
                    text: "确定";
                    enabled: root.input-holds ? !root.input-busy : root.input-error == "";
                    clicked => {
                        if (root.input-holds) {
                            root.input-busy = true;
                            root.input-fail = "";
                            root.input-submit(root.input-key, root.input-value, root.input-value2);
                            return;
                        }
                        root.input-open = false;
                        root.input-submit(root.input-key, root.input-value, root.input-value2);
                    }
                }
            }
        }

        if root.ports-open: Dialog {
            title: "端口";
            keyboard: root.keyboard;
            top: root.top-inset;
            dismiss => { root.ports-open = false; }
            Field { label: "混合端口"; text <=> root.port-mixed; input-type: InputType.number; init => { self.focus-input(); } }
            Field { label: "端口"; text <=> root.port-http; input-type: InputType.number; }
            Field { label: "Socks端口"; text <=> root.port-socks; input-type: InputType.number; }
            if root.ports-error != "": HorizontalLayout { padding-left: 14px; Text { text: root.ports-error; font-size: 13px * Type.scale; color: Theme.s.error; wrap: word-wrap; } }
            HorizontalLayout {
                spacing: 8px;
                TextButton { text: "重置"; clicked => { root.port-mixed = "7890"; root.port-http = "0"; root.port-socks = "0"; } }
                Rectangle { horizontal-stretch: 1; }
                TextButton { text: "取消"; clicked => { root.ports-open = false; } }
                TextButton {
                    text: "确定";
                    enabled: root.ports-error == "";
                    clicked => {
                        root.ports-open = false;
                        root.ports-submit(root.port-mixed, root.port-http, root.port-socks);
                    }
                }
            }
        }

        if root.dav-open: Dialog {
            title: "WebDAV配置";
            keyboard: root.keyboard;
            top: root.top-inset;
            dismiss => { root.dav-open = false; }
            Field { label: "地址"; text <=> root.dav-uri; init => { self.focus-input(); } }
            Field { label: "账号"; text <=> root.dav-user; }
            Field { label: "密码"; text <=> root.dav-pass; input-type: InputType.password; }
            if root.dav-error != "": HorizontalLayout { padding-left: 14px; Text { text: root.dav-error; font-size: 13px * Type.scale; color: Theme.s.error; wrap: word-wrap; } }
            HorizontalLayout {
                spacing: 8px;
                if root.dav-bound: TextButton { text: "删除"; danger: true; clicked => { root.dav-open = false; root.dav-delete(); } }
                Rectangle { horizontal-stretch: 1; }
                TextButton { text: "取消"; clicked => { root.dav-open = false; } }
                TextButton {
                    text: "保存";
                    enabled: root.dav-error == "";
                    clicked => {
                        root.dav-open = false;
                        root.dav-submit(root.dav-uri, root.dav-user, root.dav-pass);
                    }
                }
            }
        }

        // The expanded pane over the page at a laptop width; a tap outside closes it.
        if root.wide && !root.desktop && root.side-overlay-p > 0: Rectangle {
            TouchArea { clicked => { root.side-overlay = false; } }
            Rectangle {
                x: root.insets-known ? root.inset-left : 0px;
                y: root.top-inset;
                width: over-pane.width + 1px;
                height: parent.height - self.y;
                background: root.chrome;
                drop-shadow-blur: 8px;
                drop-shadow-color: #00000040;
                over-pane := NavSidebar {
                    x: 0;
                    height: parent.height;
                    items: root.side-items;
                    selected: root.side-index;
                    progress: root.side-overlay-p;
                    select(t) => {
                        root.go(t);
                        root.side-overlay = false;
                    }
                    toggle => { root.side-overlay = false; }
                }
                Rectangle { x: parent.width - 1px; width: 1px; background: Theme.s.on-surface.with-alpha(0.14); }
            }
        }

        if root.live-open && root.live-cards.length > 0: LiveDeck {
            cards: root.live-cards;
            front: root.live-front;
            asking: root.live-asking;
            expanded: root.live-expanded;
            top-inset: root.top-inset;
            bottom-inset: root.bottom-inset;
            close => { root.live-close(); }
            flip(d) => { root.live-flip(d); }
            action => { root.live-action(); }
            confirm => { root.live-confirm(); }
            unask => { root.live-unask(); }
            discard => { root.live-discard(); }
        }

        if root.alert-open: Dialog {
            title: root.alert-title;
            top: root.top-inset;
            dismiss => { root.alert-open = false; }
            Text { text: root.alert-text; wrap: word-wrap; color: Theme.s.on-surface-variant; font-size: 15px * Type.scale; }
            HorizontalLayout {
                alignment: end;
                TextButton { text: "确定"; clicked => { root.alert-open = false; } }
            }
        }
    }
}
