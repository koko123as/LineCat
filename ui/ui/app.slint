// Glyphs by the names Rust gives them.
global Glyphs {
    pure public function of(k: string) -> string {
        return k == "requests" ? Icons.requests : k == "resources" ? Icons.resources : k == "logs" ? Icons.logs
            : k == "language" ? Icons.language : k == "palette" ? Icons.palette : k == "paintbrush" ? Icons.paintbrush : k == "apps" ? Icons.apps
            : k == "cloud-sync" ? Icons.cloud-sync : k == "wrench" ? Icons.tools : k == "settings" ? Icons.settings
            : k == "cpu" ? Icons.memory : k == "info" ? Icons.info
            : k == "code" ? Icons.code : k == "key" ? Icons.key : k == "send" ? Icons.send : k == "dns" ? Icons.dns
            : k == "plus" ? Icons.plus : k == "add-circle" ? Icons.add-circle : k == "check" ? Icons.check
            : k == "delete" ? Icons.delete : k == "select-all" ? Icons.select-all : k == "list-add" ? Icons.list-add : k == "bolt" ? Icons.bolt
            : k == "rules" ? Icons.rule : k == "filter" ? Icons.filter : k == "proxies" ? Icons.proxies
            : k == "photos" ? Icons.photos : k == "sliders" ? Icons.sliders : k == "shield" ? Icons.shield
            : k == "pin" ? Icons.pin : k == "check-circle" ? Icons.check-circle : k == "edit" ? Icons.edit
            : k == "copy" ? Icons.copy : k == "swap" ? Icons.swap : k == "sync" ? Icons.sync : k == "export" ? Icons.export : k == "eye" ? Icons.eye
            : k == "qr" ? Icons.qr : k == "devices" ? Icons.devices : k == "sort" ? Icons.sort : k == "file" ? Icons.file
            : k == "import-file" ? Icons.import-file : k == "cloud" ? Icons.cloud : k == "more-circle" ? Icons.more-circle
            : k == "lock-open" ? Icons.lock-open : k == "clock" ? Icons.clock : k == "link" ? Icons.link : k == "play" ? Icons.play : k == "puzzle" ? Icons.puzzle
            : k == "customize" ? Icons.customize : k == "text-short" ? Icons.text-short : k == "compose" ? Icons.compose
            : k == "block" ? Icons.block : k == "eye-off" ? Icons.eye-off : k == "toggle" ? Icons.toggle : k == "toggle-on" ? Icons.toggle-on
            : k == "sparkle" ? Icons.sparkle : k == "paste" ? Icons.paste
            : k == "undo" ? Icons.undo : k == "redo" ? Icons.redo
            : k == "text-size" ? Icons.text-size : k == "wrap" ? Icons.wrap : k == "target" ? Icons.target : "";
    }
}

// Installed apps' icons by package name; `rev` moves when more arrive, so bindings that pass
// it ask again.
// `suspendProvider` while started: the Wi-Fi in use is excluded and the run is parked.
export global Suspend {
    in property <bool> suspended;
}

// Pictures by http url (`net_images.rs`); `rev` bumps as downloads land.
export global NetImages {
    in-out property <int> rev;
    pure callback image(string, int) -> image;
    pure callback has(string, int) -> bool;
}

// A match of the editor's find bar (`editor.rs`) in byte offsets, -1 when there is none.
export struct EditorMatch {
    start: int,
    end: int,
    count: int,
    label: string,
}

// The text an editor action leaves and where its cursor goes; nothing changes unless `ok`.
export struct EditorEdit {
    text: string,
    caret: int,
    ok: bool,
}

export struct EditorSuggestion {
    label: string,
    detail: string,
}

// The suggestions for the caret at byte `caret`; `cells` is the widest row in monospace cells.
export struct EditorCompletion {
    items: [EditorSuggestion],
    caret: int,
    cells: float,
}

// Each callback past `find` names the editor by its page's `key`, which owns one history.
export global EditorKit {
    in-out property <bool> wrap;
    in-out property <int> size;
    in-out property <length> font-px: 16px;
    callback menu(string, string, bool) -> [ActionItem];
    callback style(bool, int);
    // The page's schema name (`editor_complete::source_of`), the text and the caret.
    callback complete(string, string, int) -> EditorCompletion;
    callback accept(string, string, string, int, int) -> EditorEdit;
    callback opened(string, string);
    callback typed(string, string);
    callback undo(string, string) -> EditorEdit;
    callback redo(string, string) -> EditorEdit;
    pure callback find(string, string, bool, int, bool) -> EditorMatch;
    callback replace(string, string, string, bool, int, string) -> EditorEdit;
    callback replace-all(string, string, string, bool, string) -> EditorEdit;
}

export struct IconTile {
    url: string,
    label: string,
    // `_IconTile.isSelected`: the badge on the plate.
    selected: bool,
}

// A titled run of tiles (the picker's source, or one source's search results).
export struct IconSection {
    label: string,
    tiles: [IconTile],
}

// A row of the group form's members (`_MemberRow`): `tone` picks the chip's colour, 0 a
// proxy, provider or include-all, 1 a filter, 2 an exclude filter.
// A row of a custom profile's rules (`RuleItem`): tone 0 plain, 1 success, 2 warning,
// 3 tertiary, 4 error.
export struct RuleRow {
    id: string,
    name: string,
    content: string,
    target: string,
    tone: int,
    invalid: bool,
    selected: bool,
}

export struct MemberItem {
    title: string,
    chip: string,
    tone: int,
    invalid: bool,
}

// An entry of the member picker (`_buildEntry`); `mono` shows the subtitle as a regex.
export struct MemberPick {
    id: string,
    title: string,
    subtitle: string,
    mono: bool,
    selected: bool,
}

// `SliverCollapsibleSection`: folded until its header is tapped, open while searching.
export struct MemberPickSection {
    label: string,
    count: string,
    expanded: bool,
    collapsible: bool,
    rows: [MemberPick],
}

export global AppIcons {
    in-out property <int> rev;
    pure callback icon(string, int) -> image;
    pure callback has(string, int) -> bool;
}

// Where the last long press landed, in window coordinates, so the menu it opens can hang
// from that row.
export global Anchor {
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> w;
    in-out property <length> h;
}

