// SeasonCat UI. FlClash's mobile layout (bottom bar: dashboard, proxies, profiles, tools;
// dashboard cards with a start button at the bottom right; proxies as group tabs over a
// two-column grid of nodes; logs and theme under tools), drawn flat: plain filled
// surfaces, no blur, no glass, no shadows. Colors follow prism_ui's seeded scheme
// (see src/theme.rs, generated from color.dart).
import { Palette } from "std-widgets.slint";

export struct Scheme {
    primary: color,
    on-primary: color,
    primary-container: color,
    on-primary-container: color,
    page: color,
    card: color,
    block: color,
    inset: color,
    on-surface: color,
    on-surface-variant: color,
    outline-variant: color,
    error: color,
}

export global Theme {
    in property <Scheme> light;
    in property <Scheme> dark;
    // 0 follow system, 1 light, 2 dark
    in property <int> mode: 0;
    out property <bool> is-dark: mode == 2 || (mode == 0 && Palette.color-scheme == ColorScheme.dark);
    out property <Scheme> s: is-dark ? dark : light;
    // Status colors of prism_ui's ColorSchemeExtension (success / warning tones 40 and 80).
    out property <color> success: is-dark ? #7ddc7a : #1b6d24;
    out property <color> warning: is-dark ? #ffb870 : #8b5000;
}

export struct ProfileItem {
    id: string,
    name: string,
    // FlClash's subtitle: "used / total" from the subscription, else 远程 / 本地.
    subtitle: string,
    // Last update, compact ("3 小时前").
    trailing: string,
    // Expiry date chip, empty for none.
    expire: string,
    expired: bool,
    active: bool,
    busy: bool,
    is-url: bool,
}

export struct NodeItem {
    name: string,
    // The type, or for a group the type and the proxy it stands for.
    kind: string,
    // >0 ms, 0 untested, -1 timeout, -2 failed, -3 running, -4 queued
    delay: int,
    // In use by its group.
    selected: bool,
    // Pinned in a group that picks by itself.
    pinned: bool,
}

export struct ProxyGroup {
    name: string,
    kind: string,
    now: string,
    count: int,
    monogram: string,
    expanded: bool,
    testing: bool,
    nodes: [NodeItem],
}

// ProxiesStyleProps: kind 0 tab 1 list; sort 0 default 1 delay 2 name; layout 0 tight
// 1 standard 2 loose; card 0 compact 1 standard 2 loose; icon 0 filled 1 plain 2 hidden.
export struct DashTraffic {
    up-value: string,
    up-unit: string,
    up-total: string,
    up-peak: string,
    up-line: string,
    up-fill: string,
    down-value: string,
    down-unit: string,
    down-total: string,
    down-peak: string,
    down-line: string,
    down-fill: string,
}

export struct DashStatus {
    ip: string,
    country: string,
    // 住宅 / 移动网络 / 机房 / 类型未知
    kind: string,
    // 0 unknown, 1 good, 2 normal, 3 risky
    quality: int,
    org: string,
    probing: bool,
}

export struct DashProfile {
    id: string,
    name: string,
    // 剩余 N 天, or 远程 / 本地
    end: string,
    warn: bool,
    updated: string,
    usage: bool,
    percent: string,
    used: string,
    ratio: float,
    syncable: bool,
    busy: bool,
}

export struct ProxyStyle {
    kind: int,
    sort: int,
    layout: int,
    card: int,
    icon: int,
    hide-timeout: bool,
}

export struct LogItem {
    level: string,
    time: string,
    text: string,
}

// ---------------------------------------------------------------- Icons
// 24x24 outline glyphs, stroked.

