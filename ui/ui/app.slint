}

component StatusCard inherits DashCard {
    in property <DashStatus> status;
    in property <string> run-state;
    in property <string> run-time;
    in property <bool> compact;
    // A phone narrower than 400px: the address steps down so a full IPv4 fits.
    in property <bool> narrow;
    in property <bool> hide-ip;
    callback toggle();
    callback refresh();
    callback open-ip();
    property <bool> on: run-state == "STARTED";
    property <bool> busy: run-state == "STARTING" || run-state == "STOPPING" || run-state == "OFFLINE";
    glyph: Icons.status;
    title: "状态";
    HorizontalLayout {
        padding: 16px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 12px;
            DashHeader {
                glyph: Icons.status;
                title: "状态";
                Chip {
                    text: root.on && Suspend.suspended ? "挂起中…" : root.run-state == "STARTED" ? "运行中" : root.run-state == "STARTING" ? "启动中" : root.run-state == "STOPPING" ? "停止中" : "未运行";
                    tone: root.on && Suspend.suspended ? Theme.warning : root.on ? Theme.success : Theme.s.on-surface-variant;
                    dot: true;
                }
            }
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: badge-ta.pressed ? Theme.s.inset : Theme.s.block;
                        Text { text: root.status.country == "" ? "—" : root.status.country; font-size: 13px * Type.scale; font-weight: 700; color: Theme.s.on-surface; }
                        badge-ta := TouchArea { clicked => { root.refresh(); } }
                    }
                }
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: root.status.failed ? "检测失败" : root.status.ip == "" ? (root.status.probing ? "检测中…" : "—") : root.hide-ip ? "*****" : root.status.ip;
                        font-size: (root.compact || root.narrow ? 18px : 22px) * Type.scale;
                        font-weight: 700;
                        color: root.status.failed ? Theme.s.error : Theme.s.on-surface;
                        overflow: elide;
                        TouchArea {
                            enabled: root.status.ip != "" && !root.status.failed;
                            clicked => { root.open-ip(); }
                        }
                    }
                    if root.status.failed: Text { text: "点击图标重试"; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; overflow: elide; }
                    if !root.status.failed: HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        if root.status.kind != "": Chip { text: root.status.kind; }
                        if root.status.quality > 0: Chip {
                            text: root.status.quality == 1 ? "质量 优" : root.status.quality == 2 ? "质量 普通" : "质量 风险";
                            tone: root.status.quality == 1 ? Theme.success : root.status.quality == 2 ? Theme.s.on-surface-variant : Theme.s.error;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 20px;
                VerticalLayout {
                    spacing: 2px;
                    Text { text: "运行时长"; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; }
                    Text { text: root.run-time; font-size: 15px * Type.scale; font-weight: 600; color: Theme.s.on-surface; }
                }
                VerticalLayout {
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text { text: "组织"; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; }
                    Text { text: root.status.org == "" ? "—" : root.status.org; font-size: 15px * Type.scale; font-weight: 600; color: Theme.s.on-surface; overflow: elide; }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            CatButton {
                size: root.compact ? 64px : 76px;
                on: root.on;
                busy: root.busy;
                clicked => { root.toggle(); }
            }
        }
    }
}

// `SpeedCard`: one direction's speed, its total and its chart.
component SpeedTile inherits Rectangle {
    in property <bool> upload;
    in property <DashTraffic> traffic;
    in property <bool> peak;
    in property <bool> header;
    background: header ? Theme.s.card : Theme.s.block;
    border-radius: header ? 20px : 14px;
    clip: true;
    property <color> tint: root.upload ? Theme.s.primary : Theme.success;
    property <string> figure: root.upload ? root.traffic.up-value : root.traffic.down-value;
    property <string> unit: root.upload ? root.traffic.up-unit : root.traffic.down-unit;
    property <length> unit-w: max(unit-text.preferred-width, root.unit.character-count * 12px * 0.62) * 1.1;
    property <length> room: root.width - (root.header ? 32px : 24px) - root.unit-w - 4px;
    property <length> fig-size: clamp(root.room / max(1, root.figure.character-count * 0.62 * 1.1), 16px, 28px);
    Path {
        y: parent.height - self.height;
        width: parent.width;
        height: parent.width * 0.2;
        viewbox-width: 100;
        viewbox-height: 20;
        commands: root.upload ? root.traffic.up-fill : root.traffic.down-fill;
        fill: root.tint.with-alpha(0.14);
        stroke-width: 0;
    }
    Path {
        y: parent.height - self.height;
        width: parent.width;
        height: parent.width * 0.2;
        viewbox-width: 100;
        viewbox-height: 20;
        commands: root.upload ? root.traffic.up-line : root.traffic.down-line;
        fill: transparent;
        stroke: root.tint;
        stroke-width: 2px;
    }
    VerticalLayout {
        padding: root.header ? 16px : 12px;
        spacing: 4px;
        alignment: start;
        HorizontalLayout {
            spacing: 6px;
            VerticalLayout { alignment: center; Icon { glyph: root.upload ? Icons.up : Icons.down; size: 16px; tint: root.tint; } }
            Text { text: root.upload ? "上传" : "下载"; font-size: (root.header ? 15px : 13px) * Type.scale; font-weight: 600; color: Theme.s.on-surface; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            if root.peak: Text { text: root.upload ? root.traffic.up-peak : root.traffic.down-peak; font-size: 11px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; }
        }
        // The figure's width comes from its character count as well as its measured width,
        // so a device font that draws bold digits wider than it measures, or a width measured
        // for an older, shorter value, cannot clip it. A narrow tile shrinks the figure
        // instead of overflowing. Placed by hand so the tile's width never waits on it.
        Rectangle {
            height: 36px;
            fig := Text {
                x: 0;
                y: parent.height - self.height;
                text: root.figure;
                font-size: (root.fig-size) * Type.scale;
                font-weight: 700;
                color: Theme.s.on-surface;
                vertical-alignment: bottom;
                width: max(self.preferred-width, root.figure.character-count * root.fig-size * 0.62) * 1.1;
            }
            unit-text := Text {
                x: fig.width + 4px;
                y: parent.height - self.height - 5px;
                width: root.unit-w;
                text: root.unit;
                font-size: 12px * Type.scale;
                font-weight: 600;
                color: Theme.s.on-surface-variant;
            }
        }
        Text { text: root.upload ? root.traffic.up-total : root.traffic.down-total; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; }
    }
}

// `NetworkSpeedCard` on a phone: both directions side by side.
component SpeedCard inherits DashCard {
    in property <DashTraffic> traffic;
    height: 216px;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        DashHeader { glyph: Icons.speed; title: "网络速度"; }
        HorizontalLayout {
            spacing: 10px;
            SpeedTile { upload: true; traffic: root.traffic; }
            SpeedTile { upload: false; traffic: root.traffic; }
        }
    }
}

// One choice of the outbound mode.
component ModeTile inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> active;
    in property <bool> inline;
    callback clicked();
    border-radius: inline ? 18px : 14px;
    background: active ? Theme.s.primary : Theme.s.block;
    if !root.inline: VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout { alignment: center; Icon { glyph: root.glyph; size: 18px; tint: root.active ? Theme.s.on-primary : Theme.s.on-surface-variant; } }
        Text { text: root.label; font-size: 14px * Type.scale; font-weight: 600; horizontal-alignment: center; color: root.active ? Theme.s.on-primary : Theme.s.on-surface; }
    }
    if root.inline: HorizontalLayout {
        alignment: center;
        spacing: 6px;
        VerticalLayout { alignment: center; Icon { glyph: root.glyph; size: 16px; tint: root.active ? Theme.s.on-primary : Theme.s.on-surface-variant; } }
        Text { text: root.label; font-size: 14px * Type.scale; font-weight: 600; vertical-alignment: center; color: root.active ? Theme.s.on-primary : Theme.s.on-surface; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

// `OutboundModeCard` on a phone: three tiles under the header.
component ModeCard inherits DashCard {
    in property <int> mode;
    callback set-mode(int);
    height: 136px;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        DashHeader { glyph: Icons.route; title: "出站模式"; }
        HorizontalLayout {
            spacing: 8px;
            ModeTile { glyph: Icons.rule; label: "规则"; active: root.mode == 0; clicked => { root.set-mode(0); } }
            ModeTile { glyph: Icons.proxies; label: "全局"; active: root.mode == 1; clicked => { root.set-mode(1); } }
            ModeTile { glyph: Icons.target; label: "直连"; active: root.mode == 2; clicked => { root.set-mode(2); } }
        }
    }
}

// `OutboundModeBar` on a wide dashboard: the label, then the choices in a row.
component ModeBar inherits DashCard {
    in property <int> mode;
    callback set-mode(int);
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout { alignment: center; Icon { glyph: Icons.route; size: 18px; tint: Theme.s.on-surface-variant; } }
            Text { text: "出站模式"; font-size: 14px * Type.scale; font-weight: 600; color: Theme.s.on-surface; vertical-alignment: center; }
        }
        Rectangle { horizontal-stretch: 0.2; }
        ModeTile { inline: true; glyph: Icons.rule; label: "规则"; active: root.mode == 0; clicked => { root.set-mode(0); } }
        ModeTile { inline: true; glyph: Icons.proxies; label: "全局"; active: root.mode == 1; clicked => { root.set-mode(1); } }
        ModeTile { inline: true; glyph: Icons.target; label: "直连"; active: root.mode == 2; clicked => { root.set-mode(2); } }
    }
}

// `VpnCard` / `VpnTile`: the switch that starts and stops the VPN.
component VpnCard inherits DashCard {
    in property <string> run-state;
    in property <bool> slim;
    callback toggle();
    property <bool> on: run-state == "STARTED" || run-state == "STARTING";
    height: slim ? 60px : 84px;
    tapped => { if (root.run-state != "OFFLINE") { root.toggle(); } }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        if !root.slim: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: root.on ? Theme.s.primary : Theme.s.block;
                Icon { glyph: Icons.shield; size: 22px; tint: root.on ? Theme.s.on-primary : Theme.s.on-surface-variant; }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: "VPN"; font-size: (root.slim ? 14px : 16px) * Type.scale; font-weight: 600; color: Theme.s.on-surface; }
            if !root.slim: Text { text: root.on ? "已启用" : "已停用"; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; }
        }
        VerticalLayout {
            alignment: center;
            Switch { checked: root.on; toggled => { root.toggle(); } }
        }
    }
}

// `ProfilesCard`: the current profile, when it runs out and how much it has used.
component ProfileDashCard inherits DashCard {
    in property <DashProfile> profile;
    in property <bool> wide;
    // More than one profile: a swap button beside the name opens the picker.
    in property <bool> switchable;
    callback sync();
    callback switch();
    glyph: Icons.profiles;
    title: "配置";
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        alignment: start;
        DashHeader {
            glyph: Icons.profiles;
            title: "配置";
            chevron: true;
            Rectangle { horizontal-stretch: 100; }
            if root.profile.syncable: VerticalLayout {
                alignment: center;
                IconButton {
                    width: 30px;
                    height: 30px;
                    glyph: root.profile.busy ? Icons.clock : Icons.sync;
                    enabled: !root.profile.busy;
                    clicked => { root.sync(); }
                }
            }
        }
        HorizontalLayout {
            spacing: 4px;
            Text {
                text: root.profile.name == "" ? "添加配置" : root.profile.name;
                font-size: 17px * Type.scale;
                font-weight: 600;
                color: Theme.s.on-surface;
                overflow: elide;
                vertical-alignment: center;
                max-width: self.preferred-width * 1.1;
            }
            if root.profile.name != "" && root.switchable: IconButton {
                width: 28px;
                height: 28px;
                glyph: Icons.swap;
                clicked => { root.switch(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.profile.name != "": HorizontalLayout {
            spacing: 12px;
            Text { text: root.profile.updated; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; horizontal-stretch: 1; overflow: elide; }
            Text { text: root.profile.end; font-size: 12px * Type.scale; color: root.profile.warn ? Theme.warning : Theme.s.on-surface-variant; }
        }
        if root.profile.usage: VerticalLayout {
            spacing: 6px;
            padding-top: 4px;
            HorizontalLayout {
                spacing: 4px;
                Text { text: root.profile.percent; font-size: 20px * Type.scale; font-weight: 700; color: Theme.s.on-surface; min-width: max(self.preferred-width, self.text.character-count * 20px * 0.62) * 1.1; }
                VerticalLayout { alignment: end; padding-bottom: 3px; Text { text: "已用"; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; } }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: end; padding-bottom: 3px; Text { text: root.profile.used; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; } }
            }
            Rectangle {
                height: 6px;
                border-radius: 3px;
                background: Theme.s.block;
                Rectangle {
                    x: 0;
                    width: parent.width * root.profile.ratio;
                    border-radius: 3px;
                    background: root.profile.ratio >= 0.9 ? Theme.warning : Theme.s.primary;
                }
            }
        }
    }
}

// `ProxyGroupsCard`: the groups with the proxy each one picks; a tap opens it.
component GroupsDashCard inherits DashCard {
    in property <[ProxyGroup]> groups;
    in property <int> timed-out;
    in property <bool> running;
    in property <int> limit: 6;
    callback open(string);
    property <int> cols: self.width > 360px ? 2 : 1;
    property <length> tile-h: 52px;
    property <int> shown: min(groups.length, limit);
    property <length> cell-w: (self.width - 32px - (cols - 1) * 8px) / cols;
    height: 16px + 28px + 12px + (shown == 0 ? 40px : ceil(shown / cols) * (tile-h + 8px) - 8px) + 16px;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        alignment: start;
        DashHeader {
            glyph: Icons.node-group;
            title: "策略组";
            chevron: root.groups.length > 0;
            if root.groups.length > 0: Chip { text: root.groups.length; }
            if root.timed-out > 0: Chip { text: root.timed-out + " 超时"; tone: Theme.warning; }
        }
        if root.groups.length == 0: Text {
            height: 40px;
            text: root.running ? "暂无策略组" : "启动后在这里显示策略组";
            font-size: 13px * Type.scale;
            color: Theme.s.on-surface-variant;
            vertical-alignment: center;
        }
        if root.groups.length > 0: Rectangle {
            height: ceil(root.shown / root.cols) * (root.tile-h + 8px) - 8px;
            for g[i] in root.groups: Rectangle {
                visible: i < root.limit;
                x: mod(i, root.cols) * (root.cell-w + 8px);
                y: floor(i / root.cols) * (root.tile-h + 8px);
                width: root.cell-w;
                height: root.tile-h;
                border-radius: 14px;
                background: ta.pressed ? Theme.s.inset : Theme.s.block;
                ta := TouchArea { clicked => { root.open(g.name); } }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 10px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 10px;
                            background: Theme.s.card;
                            Text { text: g.monogram; font-size: 14px * Type.scale; font-weight: 700; color: Theme.s.on-surface-variant; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text { text: g.name; font-size: 14px * Type.scale; font-weight: 600; color: Theme.s.on-surface; overflow: elide; }
                        Text { text: g.now; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; overflow: elide; }
                    }
                }
            }
        }
    }
}

// `IntranetIpCard`: this device's address on its network.
// `IntranetIpCard`: the device's address (with the port while the LAN may connect), or
// 无网络, then the LAN proxy switch.
component IpDashCard inherits DashCard {
    in property <string> ip;
    in property <bool> allow-lan;
    in property <string> port;
    in property <bool> fill;
    callback copy(string);
    callback set-lan(bool);
    property <string> address: root.ip == "" ? "" : root.allow-lan ? root.ip + ":" + root.port : root.ip;
    height: root.fill ? 176px : ipc-col.preferred-height;
    ipc-col := VerticalLayout {
        padding: 16px;
        spacing: 10px;
        DashHeader {
            glyph: Icons.devices;
            title: "内网 IP";
            VerticalLayout { alignment: center; IconButton { width: 30px; height: 30px; glyph: Icons.copy; enabled: root.address != ""; clicked => { root.copy(root.address); } } }
        }
        Text {
            text: root.address == "" ? "无网络" : root.address;
            font-size: 22px * Type.scale;
            font-weight: 700;
            color: root.address == "" ? Theme.s.on-surface-variant : Theme.s.on-surface;
            overflow: elide;
        }
        if root.fill: Rectangle { vertical-stretch: 1; }
        Rectangle {
            height: 48px;
            border-radius: 16px;
            background: Theme.s.block;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 8px;
                Text { text: "局域网代理"; font-size: 14px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                VerticalLayout { alignment: center; Switch { checked: root.allow-lan; toggled(v) => { root.set-lan(v); } } }
            }
        }
    }
}

// `_ServiceBadge`: the service's mark on a tile, and its status dot in a notch cleared at
// the corner (drawn as a ring of what the badge sits on).
component ServiceBadge inherits Rectangle {
    in property <string> service;
    in property <length> size: 30px;
    in property <length> radius: 9px;
    in property <color> tile: Theme.s.card;
    in property <color> under: Theme.s.block;
    in property <color> ink: Theme.s.on-surface-variant;
    // 0 none, 1 ok, 2 warning, 3 error, 4 muted (checking).
    in property <int> dot;
    property <length> dot-r: max(root.size / 10, 4px);
    property <length> ring: max(root.size / 16, 2px);
    width: root.size;
    height: root.size;
    Rectangle { background: root.tile; border-radius: root.radius; }
    Path {
        x: root.size * 0.22;
        y: root.size * 0.22;
        width: root.size * 0.56;
        height: root.size * 0.56;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: ServiceGlyphs.of(root.service);
        fill: root.ink;
    }
    if root.service == "claude": Path {
        x: root.size * 0.22;
        y: root.size * 0.22;
        width: root.size * 0.56;
        height: root.size * 0.56;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: ServiceGlyphs.claude-rays;
        fill: transparent;
        stroke: root.ink;
        stroke-width: root.size * 0.56 / 12;
        stroke-line-cap: round;
    }
    if root.dot > 0: Rectangle {
        x: root.size - root.dot-r * 2 - root.ring;
        y: root.size - root.dot-r * 2 - root.ring;
        width: (root.dot-r + root.ring) * 2;
        height: self.width;
        border-radius: self.width / 2;
        background: root.under;
        Rectangle {
            width: root.dot-r * 2;
            height: self.width;
            border-radius: root.dot-r;
            background: root.dot == 1 ? Theme.success : root.dot == 2 ? Theme.warning : root.dot == 3 ? Theme.s.error : Theme.s.on-surface-variant;
        }
    }
}

// `ServiceStatusCard`: the first enabled services in a grid of badges and statuses with a
// verdict chip. A tap opens the sheet on a phone; wider, ⚡ checks them and › opens it.
component ServiceDashCard inherits DashCard {
    in property <[DashService]> services;
    in property <string> verdict;
    in property <bool> warn;
    in property <int> columns: 2;
    in property <bool> fill;
    in property <bool> mobile;
    in property <bool> compact;
    in property <bool> checking;
    callback retry();
    callback open();
    tapped => { if (root.mobile) { root.open(); } }
    property <bool> stacked: root.columns == 1;
    property <length> gap: root.compact ? 6px : 8px;
    property <length> cell-h: root.mobile ? 44px : root.compact ? 40px : 46px;
    property <bool> tiles: root.fill && root.services.length <= root.columns;
    property <length> cell-w: (self.width - 32px - (root.columns - 1) * root.gap) / root.columns;
    property <int> rows: max(1, ceil(root.services.length / root.columns));
    height: root.fill ? 176px : svc-col.preferred-height;
    svc-col := VerticalLayout {
        padding: 16px;
        padding-top: root.mobile ? 16px : 12px;
        spacing: root.mobile ? 12px : 0px;
        DashHeader {
            glyph: Icons.status;
            title: "服务状态";
            chevron: root.mobile;
            if !root.stacked && root.verdict != "": VerticalLayout { alignment: center; Chip { text: root.verdict; tone: root.warn ? Theme.warning : Theme.success; } }
            if !root.mobile: HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                if !root.stacked: IconButton { width: 32px; height: 32px; glyph: Icons.bolt; loading: root.checking; clicked => { root.retry(); } }
                IconButton { width: 32px; height: 32px; glyph: Icons.chevron; clicked => { root.open(); } }
            }
        }
        if !root.mobile: Rectangle { vertical-stretch: 1; }
        svc-cells := Rectangle {
            clip: true;
            height: root.tiles ? root.cell-h * 2 + root.gap : root.rows * root.cell-h + (root.rows - 1) * root.gap;
            for sv[si] in root.services: Rectangle {
                x: mod(si, root.columns) * (root.cell-w + root.gap);
                y: root.tiles ? 0px : floor(si / root.columns) * (root.cell-h + root.gap);
                width: root.cell-w;
                height: root.tiles ? parent.height : root.cell-h;
                border-radius: 14px;
                background: Theme.s.block;
                if root.tiles: VerticalLayout {
                    padding: 7px;
                    alignment: space-between;
                    HorizontalLayout { alignment: start; ServiceBadge { service: sv.id; size: root.cell-h - 14px; radius: 7px; dot: sv.dot; } }
                    HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        padding-bottom: 3px;
                        Text { text: sv.status; font-size: 12px * Type.scale; font-weight: 600; color: sv.tone == 1 ? Theme.success : sv.tone == 2 ? Theme.warning : sv.tone == 3 ? Theme.s.error : Theme.s.on-surface-variant; wrap: word-wrap; max-height: 32px; overflow: elide; }
                    }
                }
                if !root.tiles: HorizontalLayout {
                    padding-left: 7px;
                    padding-right: 12px;
                    spacing: 8px;
                    VerticalLayout { alignment: center; ServiceBadge { service: sv.id; size: root.cell-h - 14px; radius: 7px; dot: sv.dot; } }
                    Text { text: sv.status; font-size: 12px * Type.scale; font-weight: 600; color: sv.tone == 1 ? Theme.success : sv.tone == 2 ? Theme.warning : sv.tone == 3 ? Theme.s.error : Theme.s.on-surface-variant; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                }
            }
        }
    }
}

// `ConnectionStatsCard`: live connections, recent requests and DNS queries, each opening
// its list.
component StatsDashCard inherits DashCard {
    in property <DashStats> stats;
    in property <bool> fill;
    callback open(int);
    height: root.fill ? 120px : 84px;
    HorizontalLayout {
        padding: 8px;
        for cell[ci] in [
            { n: root.stats.connections, l: "实时连接" },
            { n: root.stats.requests, l: "最近请求" },
            { n: root.stats.dns, l: "DNS" },
        ]: Rectangle {
            horizontal-stretch: 1;
            border-radius: 12px;
            background: st-ta.pressed ? Theme.s.inset : transparent;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text { text: cell.n == "" ? "0" : cell.n; font-size: 22px * Type.scale; font-weight: 700; color: Theme.s.on-surface; horizontal-alignment: center; overflow: elide; }
                Text { text: cell.l; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; horizontal-alignment: center; overflow: elide; }
            }
            st-ta := TouchArea { clicked => { root.open(ci); } }
        }
    }
}

// `MemoryInfo`: what the app and its Core hold in memory.
component MemoryDashCard inherits DashCard {
    in property <string> memory;
    chevron: true;
    height: 120px;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        alignment: start;
        DashHeader { glyph: Icons.memory; title: "内存信息"; }
        Text { text: root.memory == "" ? "—" : root.memory; font-size: 22px * Type.scale; font-weight: 700; color: Theme.s.on-surface; }
        Text { text: "常驻内存（含内核）"; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; }
    }
}

// A card in the editor (`_EditableCard`): lifted by a hold anywhere on it, with a remove
// button on its corner unless it holds the start button. The column owns the drag: the
// lifted card follows the finger and the others make way as it passes their middles.
component EditFrame inherits Rectangle {
    // Only while editing does the frame take touches, and only a long press lifts the card:
    // outside editing every touch reaches the card itself.
    in property <bool> editing;
    in property <bool> removable;
    in property <bool> lifted;
    in property <bool> dragging;
    in property <length> shift;
    in property <length> offset;
    callback remove();
    // The finger's height in the window while it holds the card.
    callback lift(length);
    callback drag(length);
    callback drop();
    Rectangle {
        y: root.lifted ? root.shift : root.offset;
        animate y { duration: root.dragging && !root.lifted ? 160ms : 0ms; easing: ease-out; }
        width: parent.width;
        height: parent.height;
        z: root.lifted ? 1 : 0;
        border-radius: 20px;
        background: root.lifted ? Theme.s.card : transparent;
        drop-shadow-offset-y: root.lifted ? 6px : 0px;
        drop-shadow-blur: root.lifted ? 16px : 0px;
        drop-shadow-color: root.lifted ? #00000033 : transparent;
        @children
        Rectangle {
            visible: root.lifted;
            border-radius: 20px;
            border-width: 2px;
            border-color: Theme.s.primary;
        }
    }
    hold := Timer {
        interval: 400ms;
        running: root.editing && ef-ta.pressed && !root.dragging;
        triggered => { root.lift(root.absolute-position.y + ef-ta.mouse-y); }
    }
    ef-ta := TouchArea {
        enabled: root.editing;
        changed pressed => {
            if (!self.pressed && root.lifted) { root.drop(); }
        }
        moved => {
            if (root.lifted) { root.drag(root.absolute-position.y + self.mouse-y); }
        }
    }
    if root.removable && !root.dragging: Rectangle {
        x: parent.width - 34px;
        y: 6px;
        width: 28px;
        height: 28px;
        border-radius: 14px;
        background: Theme.s.error;
        Icon { glyph: "M7 12h10"; size: 16px; tint: Theme.s.on-primary; }
        TouchArea { clicked => { root.remove(); } }
    }
}

// A sheet's release: closed past half its height or flung down faster than 700 px/s,
// the speed measured over the last moves.
export global SheetDrag {
    public pure function closes(drag: length, height: length, velocity: float) -> bool {
        return velocity > 700 || (velocity > -700 && drag > height / 2);
    }
    // The finger's speed at `y` given the last sample, smoothed over moves closer than 40ms.
    public pure function speed(y: length, t: duration, last-y: length, last-t: duration, was: float) -> float {
        if (t - last-t <= 0ms) { return was; }
        let now = (y - last-y) / 1px * 1000 / ((t - last-t) / 1ms);
        return t - last-t < 40ms ? (was + now) / 2 : now;
    }
}

// `SelectionSheet._revealSelected`: the list offset that centres a row at `y` of height `h`,
// or the current one when the row already shows whole.
export global Reveal {
    public pure function offset(y: length, h: length, top: length, view: length, content: length) -> length {
        if (y >= top && y + h <= top + view) { return -top; }
        return -clamp(y + h / 2 - view / 2, 0px, max(0px, content - view));
    }
}

// prism's `UnfoldMotion`: UIKit's outline disclosure spring (mass 1, stiffness 631.65, damping
// 50.27, critically damped), run from where it stands at the speed it has, so a tap mid-motion
// turns it around without a jolt. `t` is in seconds since the run started.
export global UnfoldMotion {
    public pure function at(from: float, to: float, v0: float, t: float) -> float {
        let w = Math.sqrt(631.65);
        let c1 = from - to;
        return to + (c1 + (v0 + w * c1) * t) * Math.exp(-w * t);
    }
    public pure function velocity(from: float, to: float, v0: float, t: float) -> float {
        let w = Math.sqrt(631.65);
        let c2 = v0 + w * (from - to);
        return (v0 - w * c2 * t) * Math.exp(-w * t);
    }
    // `Tolerance(distance: 1e-3, velocity: 0.03)`: 0.367 s from rest.
    public pure function settled(from: float, to: float, v0: float, t: float) -> bool {
        return abs(UnfoldMotion.at(from, to, v0, t) - to) < 0.001 && abs(UnfoldMotion.velocity(from, to, v0, t)) < 0.03;
    }
}

// prism's `SideSheet`: 40% of the window, kept between 360 and 560 wide.
global SideSheet {
    pure public function width(view: length) -> length {
        return min(view, clamp(view * 0.4, 360px, 560px));
    }
}

// A sheet over the page: a grabber, a title with up to two actions, and its body.
component DashSheet inherits Rectangle {
    in property <string> title;
    in property <length> top-inset;
    in property <length> bottom-inset;
    in property <string> action-glyph;
    in property <bool> action-enabled: true;
    in property <bool> action-loading;
    in property <string> action2-glyph;
    // A page pushed inside the sheet: ‹ before the title goes back to the first.
    in property <bool> can-back;
    callback back();
    // Holds the body still while a row of it is dragged.
    in property <bool> scroll-locked;
    callback close();
    callback action();
    callback action2();
    // `showNestedSheet` past the mobile width: prism's `SideSheet` at the window's end.
    in property <bool> side;
    property <float> shown: 0;
    animate shown { duration: 300ms; easing: ease-out; }
    init => { root.shown = 1; }
    // `showModalBottomSheet`'s drag: the grabber or the title bar pulls the sheet down;
    // let go past half its height, or flung down, it closes, else it springs back.
    property <length> drag;
    property <float> fling;
    property <length> last-y;
    property <duration> last-t;
    property <length> sheet-top: max(root.top-inset + 24px, root.height - body.preferred-height - 60px - root.bottom-inset - 20px);
    function settle() {
        let d = root.drag;
        let v = animation-tick() - root.last-t > 100ms ? 0 : root.fling;
        root.drag = 0px;
        if (SheetDrag.closes(d, root.height - root.sheet-top, v)) { root.close(); }
    }
    background: #00000066;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        width: root.side ? SideSheet.width(parent.width) : min(parent.width, 640px);
        x: root.side ? parent.width - self.width * root.shown : (parent.width - self.width) / 2;
        y: root.side ? 0 : root.sheet-top + max(root.drag, 0px);
        height: root.side ? parent.height : parent.height - root.sheet-top;
        background: Theme.s.page;
        border-top-left-radius: root.side ? 0 : 24px;
        border-top-right-radius: root.side ? 0 : 24px;
        clip: true;
        TouchArea { }
        // Under the grabber and the title bar: their buttons still take their own taps.
        if !root.side: TouchArea {
            y: 0;
            height: 60px;
            moved => {
                root.drag += self.mouse-y - self.pressed-y;
                root.fling = SheetDrag.speed(self.absolute-position.y + self.mouse-y, animation-tick(), root.last-y, root.last-t, root.fling);
                root.last-y = self.absolute-position.y + self.mouse-y;
                root.last-t = animation-tick();
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.fling = 0;
                    root.last-y = self.absolute-position.y + self.mouse-y;
                    root.last-t = animation-tick();
                }
                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { root.settle(); }
            }
        }
        VerticalLayout {
            Rectangle {
                height: root.side ? root.top-inset + 8px : 16px;
                if !root.side: Rectangle { y: 8px; width: 36px; height: 4px; border-radius: 2px; background: Theme.s.outline-variant; }
            }
            HorizontalLayout {
                height: 44px;
                padding-left: root.can-back ? 4px : 20px;
                padding-right: 8px;
                if root.can-back: VerticalLayout { alignment: center; IconButton { glyph: Icons.back; tint: Theme.s.on-surface; clicked => { root.back(); } } }
                Text { text: root.title; font-size: 17px * Type.scale; font-weight: 600; color: Theme.s.on-surface; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                if root.action2-glyph != "": VerticalLayout { alignment: center; IconButton { glyph: root.action2-glyph; tint: Theme.s.on-surface; clicked => { root.action2(); } } }
                if root.action-glyph != "": VerticalLayout { alignment: center; IconButton { glyph: root.action-glyph; tint: Theme.s.on-surface; enabled: root.action-enabled; loading: root.action-loading; clicked => { root.action(); } } }
                VerticalLayout { alignment: center; IconButton { glyph: Icons.close; clicked => { root.close(); } } }
            }
            Flickable {
                vertical-stretch: 1;
                interactive: !root.scroll-locked;
                content-height: body.preferred-height;
                body := VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 4px;
                    padding-bottom: 20px + root.bottom-inset;
                    spacing: 8px;
                    @children
                }
            }
        }
    }
}

// `showSnapSheet`: a sheet over the page at 9/16 of the window's height that its handle
// drags up to 0.9 of it; let go past half of its first height lower, it closes.
component SnapSheet inherits Rectangle {
    in property <length> top-inset;
    in-out property <bool> tall;
    callback close();
    // Past the mobile width `showSnapSheet` opens the side sheet instead, with no detents.
    in property <bool> side;
    property <float> shown: 0;
    animate shown { duration: 300ms; easing: ease-out; }
    init => { root.shown = 1; }
    property <length> short-h: root.height * 9 / 16;
    property <length> tall-h: min(root.height * 0.9, root.height - root.top-inset);
    property <length> drag;
    property <float> fling;
    property <length> last-y;
    property <duration> last-t;
    property <length> sheet-h: clamp((root.tall ? root.tall-h : root.short-h) - root.drag, 0px, root.tall-h);
    function settle() {
        let d = root.drag;
        let v = animation-tick() - root.last-t > 100ms ? 0 : root.fling;
        root.drag = 0px;
        if (d > (root.tall ? root.tall-h - root.short-h / 2 : root.short-h / 2) || (!root.tall && SheetDrag.closes(d, root.short-h, v))) {
            root.close();
        } else if (root.tall && d > 48px) {
            root.tall = false;
        } else if (!root.tall && d < -48px) {
            root.tall = true;
        }
    }
    background: #00000066;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        width: root.side ? SideSheet.width(parent.width) : min(parent.width, 640px);
        x: root.side ? parent.width - self.width * root.shown : (parent.width - self.width) / 2;
        y: root.side ? 0 : parent.height - root.sheet-h;
        height: root.side ? parent.height : root.sheet-h;
        background: Theme.s.page;
        border-top-left-radius: root.side ? 0 : 24px;
        border-top-right-radius: root.side ? 0 : 24px;
        clip: true;
        TouchArea { }
        VerticalLayout {
            Rectangle {
                height: root.side ? root.top-inset : 24px;
                if !root.side: Rectangle { y: 10px; width: 36px; height: 4px; border-radius: 2px; background: Theme.s.outline-variant; }
                if !root.side: TouchArea {
                    moved => {
                        root.drag += self.mouse-y - self.pressed-y;
                        root.fling = SheetDrag.speed(self.absolute-position.y + self.mouse-y, animation-tick(), root.last-y, root.last-t, root.fling);
                        root.last-y = self.absolute-position.y + self.mouse-y;
                        root.last-t = animation-tick();
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            root.fling = 0;
                            root.last-y = self.absolute-position.y + self.mouse-y;
                            root.last-t = animation-tick();
                        }
                        if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { root.settle(); }
                    }
                }
            }
            @children
        }
    }
}

// A label and value row in a sheet's section.
component SheetRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    height: 48px;
    spacing: 12px;
    Text { text: root.label; font-size: 15px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; }
    Text { text: root.value; font-size: 15px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; horizontal-alignment: right; horizontal-stretch: 1; overflow: elide; }
}

// `_StatTile`: a count over its label.
component StatTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 72px;
    horizontal-stretch: 1;
    background: Theme.s.card;
    border-radius: 16px;
    VerticalLayout {
        padding-left: 16px;
        alignment: center;
        spacing: 2px;
        Text { text: root.value == "" ? "…" : root.value; font-size: 22px * Type.scale; font-weight: 700; color: Theme.s.on-surface; overflow: elide; }
        Text { text: root.label; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; overflow: elide; }
    }
}

// `ConnectionsTableCard`: tabs for live connections, recent requests and DNS with their
// counts, then the feed's table; a header tap sorts by that column.
component ConnTableCard inherits DashCard {
    in property <int> feed;
    in property <[string]> counts;
    in property <string> tcp;
    in property <string> udp;
    in property <[DashCol]> cols;
    in property <[DashRow]> rows;
    in property <bool> compact;
    callback select(int);
    callback sort(string);
    callback table-width(length);
    // `TableColumnResizer`: a boundary's drag from its start, its end, and a double tap.
    callback resize-start(int);
    callback resize(length);
    callback resize-end();
    callback reset();
    property <length> drag-x0;
    property <length> tab-h: root.compact ? 32px : 36px;
    property <length> row-h: root.compact ? 32px : 34px;
    property <length> side: 8px;
    property <length> table-w: self.width - root.side * 2;
    changed table-w => { root.table-width(self.table-w); }
    init => { root.table-width(self.table-w); }
    VerticalLayout {
        padding-top: 20px - root.tab-h / 2;
        padding-left: root.side;
        padding-right: root.side;
        spacing: 12px;
        HorizontalLayout {
            height: root.tab-h;
            padding-left: 20px - root.tab-h / 2 - root.side;
            padding-right: 20px - root.tab-h / 2 - root.side;
            spacing: 8px;
            Rectangle {
                width: tabs.preferred-width;
                border-radius: root.tab-h / 2;
                background: Theme.s.block;
                tabs := HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    for label[i] in ["实时连接", "最近请求", "DNS"]: Rectangle {
                        width: seg.preferred-width * 1.1;
                        border-radius: (root.tab-h - 4px) / 2;
                        background: root.feed == i ? Theme.s.primary : seg-ta.pressed ? Theme.s.card : transparent;
                        seg := HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 6px;
                            Text {
                                text: root.counts[i];
                                font-size: 14px * Type.scale;
                                font-weight: 700;
                                color: root.feed == i ? Theme.s.on-primary : Theme.s.on-surface;
                                vertical-alignment: center;
                            }
                            Text {
                                text: label;
                                font-size: 13px * Type.scale;
                                font-weight: 600;
                                color: root.feed == i ? Theme.s.on-primary : Theme.s.on-surface-variant;
                                vertical-alignment: center;
                            }
                        }
                        seg-ta := TouchArea { clicked => { root.select(i); } }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.feed == 0 && root.rows.length > 0 && root.table-w >= 620px: VerticalLayout {
                alignment: center;
                Chip { text: "TCP " + root.tcp; }
            }
            if root.feed == 0 && root.rows.length > 0 && root.table-w >= 620px: VerticalLayout {
                alignment: center;
                Chip { text: "UDP " + root.udp; }
            }
        }
        VerticalLayout {
            Rectangle {
                height: 32px;
                border-radius: 8px;
                background: Theme.s.block;
                for c in root.cols: Rectangle {
                    x: c.x;
                    width: c.w;
                    background: hd-ta.pressed ? Theme.s.card.with-alpha(0.6) : transparent;
                    border-radius: 8px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 2px;
                        alignment: c.end ? end : start;
                        Text {
                            text: c.label;
                            font-size: 12px * Type.scale;
                            font-weight: 600;
                            color: Theme.s.on-surface-variant;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if c.sort != 0: VerticalLayout {
                            alignment: center;
                            Icon { glyph: c.sort == 2 ? "M7 10l5 5 5-5" : "M7 14l5-5 5 5"; size: 12px; tint: Theme.s.on-surface-variant; }
                        }
                    }
                    hd-ta := TouchArea { clicked => { root.sort(c.id); } }
                }
                for c[i] in root.cols: handle := Rectangle {
                    visible: i < root.cols.length - 1;
                    x: c.x + c.w - 6px;
                    width: 12px;
                    Rectangle {
                        width: 2px;
                        height: 16px;
                        border-radius: 1px;
                        background: Theme.s.outline-variant;
                        visible: grip.has-hover || grip.pressed;
                    }
                    grip := TouchArea {
                        enabled: i < root.cols.length - 1;
                        mouse-cursor: col-resize;
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down {
                                root.drag-x0 = handle.x + self.mouse-x;
                                root.resize-start(i);
                            } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                                root.resize-end();
                            }
                        }
                        moved => { root.resize(handle.x + self.mouse-x - root.drag-x0); }
                        double-clicked => { root.reset(); }
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                clip: true;
                if root.rows.length == 0: Text {
                    y: 0;
                    height: parent.height - 24px;
                    text: "暂无数据";
                    font-size: 13px * Type.scale;
                    color: Theme.s.on-surface-variant;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Flickable {
                    content-height: root.rows.length * root.row-h + 2px;
                    for r[ri] in root.rows: Rectangle {
                        y: 2px + ri * root.row-h;
                        height: root.row-h;
                        border-radius: 8px;
                        background: Math.mod(ri, 2) == 1 ? Theme.s.block : transparent;
                        for cell[ci] in r.cells: HorizontalLayout {
                            x: root.cols[ci].x;
                            width: root.cols[ci].w;
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            alignment: root.cols[ci].end ? end : stretch;
                            if cell.badge != "" && root.cols[ci].id == "source": VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    border-radius: 7px;
                                    background: Theme.s.block;
                                    Text { text: cell.badge; font-size: 11px * Type.scale; font-weight: 700; color: Theme.s.on-surface-variant; }
                                }
                            }
                            if cell.badge != "" && root.cols[ci].id != "source": VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 18px;
                                    width: cb.preferred-width + 12px;
                                    border-radius: 9px;
                                    background: Theme.s.block;
                                    cb := Text { text: cell.badge; font-size: 11px * Type.scale; font-weight: 600; color: Theme.s.on-surface-variant; }
                                }
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: cell.text;
                                font-size: 13px * Type.scale;
                                font-weight: cell.tone == 2 || cell.tone == 4 ? 600 : 400;
                                color: cell.tone == 1 ? Theme.s.on-surface-variant : cell.tone == 3 ? Theme.s.error : cell.tone == 4 ? Theme.warning : Theme.s.on-surface;
                                horizontal-alignment: root.cols[ci].end ? right : left;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
    }
}

// The live status colors by tone: the container fill and what sits on it.
// FlClash: lib/views/dashboard/widgets/live_status*.
global LiveTone {
    public pure function fill(t: int) -> color {
        if (t == 1) { return Theme.s.error.with-alpha(0.16); }
        if (t == 2) { return Theme.warning.with-alpha(0.18); }
        if (t == 3) { return Theme.success.with-alpha(0.18); }
        if (t == 4) { return Theme.s.primary-container; }
        return Theme.s.block;
    }
    public pure function on(t: int) -> color {
        if (t == 1) { return Theme.s.error; }
        if (t == 2) { return Theme.warning; }
        if (t == 3) { return Theme.success; }
        if (t == 4) { return Theme.s.on-primary-container; }
        return Theme.s.on-surface;
    }
    public pure function strong(t: int) -> color {
        if (t == 1) { return Theme.s.error; }
        if (t == 2) { return Theme.warning; }
        if (t == 3) { return Theme.success; }
        return Theme.s.block;
    }
}

// `_PillProgressRing`: the download's share as an arc over a faint ring.
component ProgressRing inherits Rectangle {
    in property <float> value;
    in property <color> tint;
    in property <length> size: 16px;
    width: root.size;
    height: root.size;
    property <angle> a: clamp(root.value, 0, 0.999) * 360deg;
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M12 3a9 9 0 1 0 0.01 0z";
        stroke: root.tint.with-alpha(0.3);
        stroke-width: 2.6px;
        fill: transparent;
    }
    if root.value > 0: Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M12 3A9 9 0 " + (root.value > 0.5 ? "1" : "0") + " 1 " + (12 + 9 * Math.sin(root.a)) + " " + (12 - 9 * Math.cos(root.a));
        stroke: root.tint;
        stroke-width: 2.6px;
        stroke-line-cap: round;
        fill: transparent;
    }
}

// `LiveStatusButton`: the most important status's glyph and number, a check for a
// running core alone.
component LiveStatusButton inherits Rectangle {
    in property <LivePill> pill;
    callback open();
    property <color> fg: root.pill.kind == "running" ? Theme.success : LiveTone.on(root.pill.tone);
    height: 32px;
    width: root.pill.text == "" ? 32px : row.preferred-width * 1.1 + 20px;
    border-radius: 16px;
    background: ta.pressed ? LiveTone.fill(root.pill.kind == "running" ? 3 : root.pill.tone).darker(0.1) : LiveTone.fill(root.pill.kind == "running" ? 3 : root.pill.tone);
    row := HorizontalLayout {
        alignment: center;
        spacing: 4px;
        VerticalLayout {
            alignment: center;
            if root.pill.kind == "running": Icon { glyph: Icons.check; size: 16px; tint: root.fg; }
            if root.pill.kind == "stopped": Icon { glyph: Icons.error; size: 16px; tint: root.fg; }
            if root.pill.kind == "warnings" || root.pill.kind == "consent": Icon { glyph: root.pill.kind == "warnings" ? Icons.warning : Icons.puzzle; size: 16px; tint: root.fg; }
            if root.pill.kind == "ready": Icon { glyph: Icons.check-circle; size: 16px; tint: root.fg; }
            if root.pill.kind == "downloading": ProgressRing { value: root.pill.progress; tint: root.fg; }
            if root.pill.kind == "starting": Spinner { width: 16px; height: 16px; indeterminate: true; }
        }
        if root.pill.text != "": Text { text: root.pill.text; font-size: 13px * Type.scale; font-weight: 700; color: root.fg; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.open(); } }
}

// `_Node`: the app or the core as a round glyph over its label.
component LiveNode inherits VerticalLayout {
    in property <string> glyph;
    in property <string> label;
    in property <color> fill;
    in property <color> tint;
    in property <color> label-color;
    in property <bool> emphasized;
    width: 64px;
    spacing: 6px;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: root.fill;
            Icon { glyph: root.glyph; size: 22px; tint: root.tint; }
        }
    }
    Text { text: root.label; font-size: 12px * Type.scale; font-weight: root.emphasized ? 600 : 400; color: root.label-color; horizontal-alignment: center; overflow: elide; }
}

// `_HeroChip`.
component LiveChip inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    in property <bool> emphasized;
    height: 22px;
    width: min(t.preferred-width + 20px, 120px);
    border-radius: 11px;
    background: Theme.s.card;
    t := Text { x: 10px; width: parent.width - 20px; text: root.text; font-size: 13px * Type.scale; font-weight: root.emphasized ? 600 : 400; color: root.tint; vertical-alignment: center; horizontal-alignment: center; overflow: elide; }
}

// `_StatusCard`: the hero in its tint, the title and its line, then the action; an
// action that asks first swaps both for the question and its two buttons.
component LiveCardView inherits Rectangle {
    in property <LiveCard> card;
    in property <bool> asking;
    in property <bool> expanded;
    callback action();
    callback confirm();
    callback unask();
    callback discard();
    background: Theme.s.card;
    border-radius: 28px;
    clip: true;
    VerticalLayout {
        padding: 8px;
        hero := Rectangle {
            vertical-stretch: 1;
            border-radius: 20px;
            background: LiveTone.fill(root.card.tint);
            clip: true;
            if root.card.kind == "stopped" || root.card.kind == "starting" || root.card.kind == "running": HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        LiveNode {
                            glyph: Icons.devices;
                            label: "应用";
                            fill: Theme.s.card;
                            tint: Theme.s.on-surface-variant;
                            label-color: root.card.kind == "stopped" ? Theme.s.error : root.card.kind == "starting" ? Theme.s.on-primary-container : Theme.s.on-surface-variant;
                        }
                        VerticalLayout {
                            alignment: center;
                            padding-bottom: 22px;
                            width: 32px;
                            if root.card.kind == "starting": HorizontalLayout { alignment: center; Spinner { width: 16px; height: 16px; indeterminate: true; } }
                            if root.card.kind == "running": Rectangle { height: 2px; background: Theme.success; }
                            if root.card.kind == "stopped": HorizontalLayout {
                                height: 2px;
                                spacing: 4px;
                                for d in 4: Rectangle { width: 4px; border-radius: 1px; background: Theme.s.error; }
                            }
                        }
                        LiveNode {
                            glyph: Icons.memory;
                            label: "内核";
                            fill: root.card.kind == "stopped" ? Theme.s.error : root.card.kind == "running" ? Theme.success : Theme.s.card;
                            tint: root.card.kind == "starting" ? Theme.s.primary : Theme.s.card;
                            label-color: root.card.kind == "stopped" ? Theme.s.error : root.card.kind == "running" ? Theme.success : Theme.s.on-primary-container;
                            emphasized: root.card.kind != "starting";
                        }
                    }
                }
            }
            if root.card.kind == "downloading": Rectangle {
                width: 132px;
                height: 132px;
                Path { viewbox-width: 132; viewbox-height: 132; commands: root.card.ticks-off; stroke: Theme.s.primary.with-alpha(0.22); stroke-width: 2.4px; stroke-line-cap: round; }
                if root.card.ticks-on != "": Path { viewbox-width: 132; viewbox-height: 132; commands: root.card.ticks-on; stroke: Theme.s.primary; stroke-width: 2.4px; stroke-line-cap: round; }
                VerticalLayout {
                    alignment: center;
                    Text { text: root.card.big; font-size: 28px * Type.scale; font-weight: 700; color: Theme.s.on-primary-container; horizontal-alignment: center; }
                    Text { text: root.card.tag; font-size: 12px * Type.scale; color: Theme.s.on-primary-container; horizontal-alignment: center; }
                }
            }
            if root.card.kind == "ready" || root.card.kind == "consent": VerticalLayout {
                alignment: center;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 14px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 60px;
                        height: 60px;
                        border-radius: 30px;
                        background: root.card.kind == "ready" ? Theme.success : Theme.warning;
                        if root.card.kind == "ready": Icon { glyph: Icons.check; size: 28px; tint: Theme.s.card; }
                        if root.card.kind == "consent": FilledIcon { glyph: Icons.puzzle; size: 28px; tint: Theme.s.card; }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    for chip[i] in root.card.chips: HorizontalLayout {
                        spacing: 8px;
                        if root.card.kind == "ready" && i == 1: VerticalLayout { alignment: center; Icon { glyph: Icons.chevron; size: 16px; tint: Theme.success; } }
                        LiveChip {
                            text: chip;
                            tint: root.card.kind == "ready" && i == 1 ? Theme.success : Theme.s.on-surface-variant;
                            emphasized: root.card.kind == "ready" && i == 1;
                        }
                    }
                }
            }
            if root.card.kind == "ready": IconButton {
                x: parent.width - self.width - 8px;
                y: 8px;
                glyph: Icons.close;
                tint: Theme.s.on-surface-variant;
                clicked => { root.discard(); }
            }
            // `_WarningsHero`: three a line each, or all of them once opened.
            if root.card.kind == "warnings": Flickable {
                interactive: root.expanded;
                content-height: wl.preferred-height;
                wl := VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    alignment: start;
                    for w[i] in root.card.warnings: Rectangle {
                        visible: root.expanded || i < 3;
                        height: self.visible ? (root.expanded ? max(36px, wrow.preferred-height) : 36px) : 0px;
                        border-radius: 11px;
                        background: Theme.s.card;
                        wrow := HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: root.expanded ? 9px : 0px;
                            padding-bottom: root.expanded ? 9px : 0px;
                            spacing: 10px;
                            VerticalLayout { alignment: root.expanded ? start : center; FilledIcon { glyph: Icons.warning; size: 18px; tint: Theme.warning; } }
                            if !root.expanded: Text { horizontal-stretch: 1; text: w.message; font-size: 15px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; overflow: elide; }
                            if !root.expanded && w.path != "": Text { max-width: 96px; text: w.path; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; overflow: elide; }
                            if root.expanded: VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: w.message; font-size: 15px * Type.scale; color: Theme.s.on-surface; wrap: word-wrap; }
                                if w.path != "": Text { text: w.path; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; wrap: word-wrap; }
                            }
                        }
                    }
                }
            }
        }
        VerticalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: root.expanded ? 8px : 12px;
            padding-bottom: 4px;
            spacing: 8px;
            if !root.expanded: VerticalLayout {
                height: 52px;
                spacing: 2px;
                Text { text: root.asking ? root.card.ask-title : root.card.title; font-size: 17px * Type.scale; font-weight: 600; color: Theme.s.on-surface; overflow: elide; }
                Text { text: root.asking ? root.card.ask-body : root.card.body; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; wrap: word-wrap; max-height: 34px; overflow: elide; vertical-stretch: 1; }
            }
            if root.card.action != "" && !root.asking: Rectangle {
                height: 44px;
                border-radius: 22px;
                background: act.pressed ? LiveTone.strong(root.card.action-tone).darker(0.12) : LiveTone.strong(root.card.action-tone);
                Text {
                    text: root.card.kind == "warnings" && root.expanded ? "收起" : root.card.action;
                    font-size: 15px * Type.scale;
                    font-weight: 600;
                    color: root.card.action-tone == 0 ? Theme.s.on-surface : Theme.s.card;
                }
                act := TouchArea { clicked => { root.action(); } }
            }
            if root.asking: HorizontalLayout {
                height: 44px;
                spacing: 8px;
                Rectangle {
                    border-radius: 22px;
                    background: no.pressed ? Theme.s.block.darker(0.12) : Theme.s.block;
                    Text { text: "取消"; font-size: 15px * Type.scale; font-weight: 600; color: Theme.s.on-surface; }
                    no := TouchArea { clicked => { root.unask(); } }
                }
                Rectangle {
                    border-radius: 22px;
                    background: yes.pressed ? Theme.s.error.darker(0.12) : Theme.s.error;
                    Text { text: root.card.ask-label; font-size: 15px * Type.scale; font-weight: 600; color: Theme.s.card; }
                    yes := TouchArea { clicked => { root.confirm(); } }
                }
            }
        }
    }
}

// `LiveStatusDeck`: the statuses as a stack, the next two leaning back above the
// front one; a drag down brings the next forward and a drag up takes it back. On a
// phone it rests about the middle, elsewhere under the bar on the right.
component LiveDeck inherits Rectangle {
    in property <[LiveCard]> cards;
    in property <int> front;
    in property <bool> asking;
    in property <bool> expanded;
    in property <length> top-inset;
    in property <length> bottom-inset;
    callback close();
    callback flip(length);
    callback action();
    callback confirm();
    callback unask();
    callback discard();
    background: #00000066;
    property <bool> mobile: root.width <= 600px;
    property <length> card-w: min(320px, root.width - 32px);
    property <length> safe-h: root.height - root.top-inset - root.bottom-inset;
    property <length> max-h: max(300px, min(460px, root.mobile ? root.safe-h - 48px : root.height - root.bottom-inset - 16px - root.rest-y));
    property <length> front-h: root.expanded ? max(300px, min(root.max-h, 300px - 172px + 16px + 52px + root.card-list-h)) : 300px;
    property <length> card-list-h: 16px + root.cards[root.front].warnings.length * 66px;
    property <length> front-x: root.mobile ? max(0px, min((root.width - root.card-w) / 2, root.width - root.card-w - 24px)) : max(0px, root.width - 16px - 24px - root.card-w);
    property <length> rest-y: root.mobile ? root.top-inset + (root.safe-h - 300px) / 2 : max(0px, min(root.top-inset + 56px + 8px + 48px, root.height - root.bottom-inset - 16px - 300px));
    property <length> front-y: root.mobile ? root.rest-y + (300px - root.front-h) / 2 : root.rest-y;
    property <length> drag-dy;
    property <bool> dragging;
    TouchArea { clicked => { root.close(); } }
    for c[i] in root.cards: Rectangle {
        // 0 the front, 1 and 2 behind it, the rest hidden.
        property <int> pos: Math.mod(i - root.front + root.cards.length, root.cards.length);
        property <float> scale: pos == 0 ? 1 : pos == 1 ? 0.93 : 0.87;
        property <length> follow: pos == 0 && root.dragging ? clamp(root.drag-dy * 0.6, -60px, 90px) : 0px;
        visible: pos < 3;
        z: -pos;
        opacity: pos == 2 ? 0.85 : 1;
        width: root.card-w * self.scale;
        height: (pos == 0 ? root.front-h : 300px) * self.scale;
        x: root.front-x + (root.card-w - self.width) / 2 + (pos == 1 ? -10px : pos == 2 ? 10px : 0px);
        y: root.front-y + (pos == 1 ? -44px : pos == 2 ? -92px : 0px) + self.follow;
        animate x, y, width, height { duration: root.dragging ? 0ms : 300ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
        TouchArea {
            pointer-event(e) => {
                if (pos != 0) { return; }
                if (e.kind == PointerEventKind.down) { root.dragging = true; root.drag-dy = 0; }
                else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                    if (root.dragging) { root.dragging = false; root.flip(root.drag-dy); }
                }
            }
            moved => { if (pos == 0 && root.dragging) { root.drag-dy = self.mouse-y - self.pressed-y; } }
        }
        LiveCardView {
            card: c;
            asking: pos == 0 && root.asking;
            expanded: pos == 0 && root.expanded;
            action => { root.action(); }
            confirm => { root.confirm(); }
            unask => { root.unask(); }
            discard => { root.discard(); }
        }
        // A card behind takes a tap as a flip, never to its own buttons.
        if pos != 0: TouchArea { clicked => { root.flip(100px); } }
    }
}

component Dashboard inherits Rectangle {
    // `ServiceFaultsButton`: services that did not start, a badge in the bar.
    in property <int> fault-count;
    in property <LivePill> live-pill;
    callback open-live();
    in property <bool> switchable;
    callback open-faults();
    callback open-profile();
    callback switch-profile();
    callback open-memory();
    in property <string> run-state;
    in property <string> run-time;
    in property <DashStatus> status;
    in property <DashTraffic> traffic;
    in property <DashProfile> profile;
    in property <[ProxyGroup]> groups;
    in property <int> groups-timed-out;
    in property <[string]> widgets;
    in property <[DashAdd]> addable;
    in property <string> local-ip;
    in property <string> memory;
    in property <int> mode;
    in property <[DashService]> services;
    in property <string> service-verdict;
    in property <bool> service-warn;
    in property <DashStats> stats;
    in property <bool> allow-lan;
    in property <string> port;
    in property <bool> hide-ip;
    in-out property <bool> editing;
    callback toggle-vpn();
    callback set-mode(int);
    callback open-profiles();
    callback sync-profile(string);
    callback open-group(string);
    callback refresh-ip();
    callback open-ip();
    callback copy-ip(string);
    callback set-lan(bool);
    callback retry-services();
    in property <bool> services-checking;
    callback open-services();
    callback open-stats(int);
    callback edit(string, string);
    callback move(int, int);
    // The editor's drag (`drag.rs`): the cards' heights, where the lifted one lands and how
    // far the others move aside.
    callback card-height(int, length);
    pure callback drag-target(int, length, length, int) -> int;
    pure callback drag-offset(int, int, int, length) -> length;
    property <int> drag-from: -1;
    property <length> drag-y0;
    property <length> drag-y;
    property <length> drag-vy0;
    property <length> scroll-y;
    property <length> drag-shift: root.drag-y - root.drag-y0 + root.drag-vy0 - root.scroll-y;
    property <int> drag-to: root.drag-from < 0 ? -1 : root.drag-target(root.drag-from, root.drag-shift, root.gap, root.widgets.length);
    callback layout(bool, int, bool);
    // `ConnectionsTableCard` takes the summaries' place once the window is tall enough.
    in property <int> table-feed;
    in property <[string]> table-counts;
    in property <string> table-tcp;
    in property <string> table-udp;
    in property <[DashCol]> table-cols;
    in property <[DashRow]> table-rows;
    callback table-select(int);
    callback table-sort(string);
    callback table-width(length);
    callback table-shown(bool);
    callback table-resize-start(int);
    callback table-resize(length);
    callback table-resize-end();
    callback table-reset();
    property <length> view-h;
    property <length> rows-h: 28px + root.top-h + root.control-h + root.middle-h + root.gap * 3;
    property <length> table-min: 20px + (root.compact ? 16px : 18px) + 12px + 32px + (root.compact ? 32px : 34px) * 3;
    property <bool> tables-fit: root.wide && root.columns == 4 && root.view-h >= root.rows-h + root.table-min;
    changed tables-fit => { root.table-shown(self.tables-fit); }
    // `DashboardDensity`: a phone column under 640, else the fixed grid of 2 or 4 columns,
    // compact under 1040 with four columns or under 824 high.
    property <bool> wide: self.width >= 640px;
    property <int> columns: self.width < 860px ? 2 : 4;
    property <bool> compact: (root.columns == 4 && self.width < 1040px) || self.height < 824px;
    property <length> gap: self.width < 600px ? 8px : self.width < 840px ? 12px : 16px;
    property <length> side: max(16px, (self.width - 560px) / 2);
    property <length> cw: min((self.width - 40px - gap * (columns - 1)) / columns, 440px);
    property <length> inset: (self.width - 40px - gap * (columns - 1) - cw * columns) / 2;
    // `_DesktopDashboard`'s rows: 208/64/176, compact 176/56/152; the summaries 120/112.
    property <length> top-h: root.compact ? 176px : 208px;
    property <length> control-h: root.compact ? 56px : 64px;
    property <length> middle-h: root.compact ? 152px : 176px;
    property <length> summary-h: root.compact ? 112px : 120px;
    in property <bool> widgets-has-service;
    property <bool> shows-service: root.wide || root.widgets-has-service;
    // `ServiceStatusCard.columns`: one beside another card, two when a column is wide enough.
    property <int> service-columns: !root.wide ? 2 : root.columns == 4 && root.cw >= 290px ? 2 : 1;
    changed wide => { root.layout(root.wide, root.service-columns, root.shows-service); }
    changed service-columns => { root.layout(root.wide, root.service-columns, root.shows-service); }
    changed shows-service => { root.layout(root.wide, root.service-columns, root.shows-service); }
    init => {
        root.layout(root.wide, root.service-columns, root.shows-service);
        root.table-shown(root.tables-fit);
    }
    function span(n: int) -> length { return root.cw * n + root.gap * (n - 1); }

    VerticalLayout {
        AppBar {
            title: root.editing ? "编辑仪表盘" : "仪表盘";
            if !root.editing && root.fault-count > 0: VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 32px;
                    width: fault-row.preferred-width * 1.1 + 20px;
                    border-radius: 16px;
                    background: fault-ta.pressed ? Theme.s.error.with-alpha(0.24) : Theme.s.error.with-alpha(0.14);
                    fault-row := HorizontalLayout {
                        alignment: center;
                        spacing: 4px;
                        VerticalLayout { alignment: center; Icon { glyph: Icons.error; size: 16px; tint: Theme.s.error; } }
                        Text { text: root.fault-count; font-size: 13px * Type.scale; font-weight: 700; color: Theme.s.error; vertical-alignment: center; }
                    }
                    fault-ta := TouchArea { clicked => { root.open-faults(); } }
                }
            }
            if !root.editing && root.live-pill.kind != "": VerticalLayout {
                alignment: center;
                LiveStatusButton { pill: root.live-pill; open => { root.open-live(); } }
            }
            if !root.wide: VerticalLayout {
                alignment: center;
                IconButton {
                    glyph: root.editing ? Icons.check : Icons.edit;
                    tint: Theme.s.on-surface;
                    clicked => { root.editing = !root.editing; }
                }
            }
        }
        if !root.wide: mflick := Flickable {
            content-height: mobile.preferred-height + Dock.pad;
            interactive: root.drag-from < 0;
            init => { root.scroll-y = self.content-y; }
            changed content-y => { root.scroll-y = self.content-y; }
            // Scrolls while the lifted card is held near the top or above the dock.
            Timer {
                interval: 16ms;
                running: root.drag-from >= 0;
                triggered => {
                    let top = mflick.absolute-position.y;
                    if (root.drag-y > top + mflick.height - Dock.pad - 48px) {
                        mflick.content-y = max(mflick.content-y - 8px, min(0px, mflick.height - mflick.content-height));
                    } else if (root.drag-y < top + 48px) {
                        mflick.content-y = min(0px, mflick.content-y + 8px);
                    }
                }
            }
            mobile := VerticalLayout {
                alignment: start;
                padding-left: root.side;
                padding-right: root.side;
                padding-top: 4px;
                padding-bottom: 24px;
                spacing: root.gap;
                for w[i] in root.widgets: EditFrame {
                    height: card.preferred-height;
                    z: i == root.drag-from ? 1 : 0;
                    editing: root.editing;
                    removable: root.editing && w != "status";
                    lifted: i == root.drag-from;
                    dragging: root.drag-from >= 0;
                    shift: root.drag-shift;
                    offset: root.drag-from < 0 ? 0px : root.drag-offset(root.drag-from, root.drag-to, i, root.gap);
                    init => { root.card-height(i, self.height); }
                    changed height => { root.card-height(i, self.height); }
                    remove => { root.edit("remove", w); }
                    lift(y) => {
                        root.drag-y0 = y;
                        root.drag-y = y;
                        root.drag-vy0 = root.scroll-y;
                        root.drag-from = i;
                    }
                    drag(y) => { root.drag-y = y; }
                    drop => {
                        let from = root.drag-from;
                        let to = root.drag-to;
                        root.drag-from = -1;
                        if (to >= 0 && to != from) { root.move(from, to); }
                    }
                    card := VerticalLayout {
                        if w == "status": StatusCard {
                            height: 200px;
                            narrow: root.width < 400px;
                            status: root.status;
                            run-state: root.run-state;
                            run-time: root.run-time;
                            hide-ip: root.hide-ip;
                            toggle => { root.toggle-vpn(); }
                            refresh => { root.refresh-ip(); }
                            open-ip => { root.open-ip(); }
                        }
                        if w == "speed": SpeedCard { traffic: root.traffic; }
                        if w == "mode": ModeCard { mode: root.mode; set-mode(m) => { root.set-mode(m); } }
                        if w == "vpn": VpnCard { run-state: root.run-state; toggle => { root.toggle-vpn(); } }
                        if w == "service": ServiceDashCard {
                            services: root.services;
                            verdict: root.service-verdict;
                            warn: root.service-warn;
                            columns: 2;
                            mobile: true;
                            checking: root.services-checking;
                            open => { root.open-services(); }
                            retry => { root.retry-services(); }
                        }
                        if w == "profile": ProfileDashCard {
                            height: self.preferred-height;
                            profile: root.profile;
                            switchable: root.switchable;
                            switch => { root.switch-profile(); }
                            tapped => { if (root.profile.name == "") { root.open-profiles(); } else { root.open-profile(); } }
                            sync => { root.sync-profile(root.profile.id); }
                        }
                        if w == "groups": GroupsDashCard {
                            groups: root.groups;
                            timed-out: root.groups-timed-out;
                            running: root.run-state == "STARTED";
                            tapped => { root.open-group(""); }
                            open(g) => { root.open-group(g); }
                        }
                        if w == "stats": StatsDashCard { stats: root.stats; open(i) => { root.open-stats(i); } }
                        if w == "ip": IpDashCard {
                            ip: root.local-ip;
                            allow-lan: root.allow-lan;
                            port: root.port;
                            copy(a) => { root.copy-ip(a); }
                            set-lan(on) => { root.set-lan(on); }
                        }
                        if w == "memory": MemoryDashCard { memory: root.memory; tapped => { root.open-memory(); } }
                    }
                }
                // `_AddRow`s under 可添加.
                if root.editing && root.addable.length > 0: VerticalLayout {
                    spacing: 8px;
                    padding-top: 6px;
                    HorizontalLayout {
                        padding-left: 8px;
                        Text { text: "可添加"; font-size: 13px * Type.scale; font-weight: 600; color: Theme.s.on-surface-variant; }
                    }
                    for h in root.addable: Rectangle {
                        height: 60px;
                        border-radius: 18px;
                        background: Theme.s.card.with-alpha(0.55);
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 14px;
                                    background: add-ta.pressed ? Theme.s.primary.darker(0.15) : Theme.s.primary;
                                    Icon { glyph: Icons.plus; size: 16px; tint: Theme.s.on-primary; }
                                    add-ta := TouchArea { clicked => { root.edit("add", h.id); } }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    border-radius: 12px;
                                    background: Theme.s.card;
                                    Icon {
                                        size: 20px;
                                        tint: Theme.s.on-surface-variant;
                                        glyph: h.id == "speed" ? Icons.speed : h.id == "mode" ? Icons.route : h.id == "vpn" ? Icons.shield : h.id == "service" ? Icons.status : h.id == "profile" ? Icons.profiles : h.id == "groups" ? Icons.node-group : h.id == "stats" ? Icons.requests : h.id == "ip" ? Icons.devices : h.id == "memory" ? Icons.memory : Icons.status;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text { text: h.label; font-size: 15px * Type.scale; font-weight: 600; color: Theme.s.on-surface; overflow: elide; }
                                if h.desc != "": Text { text: h.desc; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; overflow: elide; }
                            }
                        }
                    }
                }
            }
        }
        // The wide dashboard (`_DesktopDashboard`): rows of fixed height across 2 or 4
        // columns, then the summaries.
        if root.wide: Flickable {
            content-height: grid.preferred-height + Dock.pad;
            init => { root.view-h = self.height; }
            changed height => { root.view-h = self.height; }
            grid := VerticalLayout {
                alignment: start;
                padding-left: 16px + root.inset;
                padding-right: 24px + root.inset;
                padding-top: 4px;
                padding-bottom: 24px;
                spacing: root.gap;
                if root.columns == 2: StatusCard {
                    height: root.top-h;
                    status: root.status;
                    run-state: root.run-state;
                    run-time: root.run-time;
                    hide-ip: root.hide-ip;
                    compact: root.compact;
                    toggle => { root.toggle-vpn(); }
                    refresh => { root.refresh-ip(); }
                    open-ip => { root.open-ip(); }
                }
                HorizontalLayout {
                    height: root.top-h;
                    spacing: root.gap;
                    if root.columns == 4: StatusCard {
                        width: root.span(2);
                        status: root.status;
                        run-state: root.run-state;
                        run-time: root.run-time;
                        hide-ip: root.hide-ip;
                        compact: true;
                        toggle => { root.toggle-vpn(); }
                        refresh => { root.refresh-ip(); }
                        open-ip => { root.open-ip(); }
                    }
                    SpeedTile { width: root.cw; header: true; peak: true; upload: true; traffic: root.traffic; }
                    SpeedTile { width: root.cw; header: true; peak: true; upload: false; traffic: root.traffic; }
                }
                if root.columns == 2: ModeBar { height: root.control-h; mode: root.mode; set-mode(m) => { root.set-mode(m); } }
                if root.columns == 2: VpnCard { height: root.control-h; slim: true; run-state: root.run-state; toggle => { root.toggle-vpn(); } }
                if root.columns == 4: HorizontalLayout {
                    height: root.control-h;
                    spacing: root.gap;
                    ModeBar { width: root.span(2); mode: root.mode; set-mode(m) => { root.set-mode(m); } }
                    VpnCard { width: root.span(2); height: root.control-h; slim: true; run-state: root.run-state; toggle => { root.toggle-vpn(); } }
                }
                HorizontalLayout {
                    height: root.middle-h;
                    spacing: root.gap;
                    IpDashCard {
                        width: root.cw;
                        fill: true;
                        height: root.middle-h;
                        ip: root.local-ip;
                        allow-lan: root.allow-lan;
                        port: root.port;
                        copy(a) => { root.copy-ip(a); }
                        set-lan(on) => { root.set-lan(on); }
                    }
                    ProfileDashCard {
                        width: root.cw;
                        wide: true;
                        profile: root.profile;
                        switchable: root.switchable;
                        switch => { root.switch-profile(); }
                        tapped => { if (root.profile.name == "") { root.open-profiles(); } else { root.open-profile(); } }
                        sync => { root.sync-profile(root.profile.id); }
                    }
                    if root.columns == 4: ServiceDashCard {
                        width: root.cw;
                        fill: true;
                        height: root.middle-h;
                        services: root.services;
                        verdict: root.service-verdict;
                        warn: root.service-warn;
                        columns: root.service-columns;
                        compact: root.compact;
                        checking: root.services-checking;
                        retry => { root.retry-services(); }
                        open => { root.open-services(); }
                    }
                    if root.columns == 4: MemoryDashCard { width: root.cw; height: root.middle-h; memory: root.memory; tapped => { root.open-memory(); } }
                }
                if root.columns == 2: HorizontalLayout {
                    height: root.middle-h;
                    spacing: root.gap;
                    ServiceDashCard {
                        width: root.cw;
                        fill: true;
                        height: root.middle-h;
                        services: root.services;
                        verdict: root.service-verdict;
                        warn: root.service-warn;
                        columns: 1;
                        compact: root.compact;
                        checking: root.services-checking;
                        retry => { root.retry-services(); }
                        open => { root.open-services(); }
                    }
                    MemoryDashCard { width: root.cw; height: root.middle-h; memory: root.memory; tapped => { root.open-memory(); } }
                }
                if root.tables-fit: HorizontalLayout {
                    height: root.view-h - root.rows-h;
                    spacing: root.gap;
                    ConnTableCard {
                        width: (root.span(4) - root.gap) * 3 / 5;
                        feed: root.table-feed;
                        counts: root.table-counts;
                        tcp: root.table-tcp;
                        udp: root.table-udp;
                        cols: root.table-cols;
                        rows: root.table-rows;
                        compact: root.compact;
                        select(f) => { root.table-select(f); }
                        sort(c) => { root.table-sort(c); }
                        table-width(w) => { root.table-width(w); }
                        resize-start(b) => { root.table-resize-start(b); }
                        resize(d) => { root.table-resize(d); }
                        resize-end => { root.table-resize-end(); }
                        reset => { root.table-reset(); }
                    }
                    GroupsDashCard {
                        height: root.view-h - root.rows-h;
                        limit: max(1, floor((root.view-h - root.rows-h - 64px) / 60px)) * 2;
                        groups: root.groups;
                        timed-out: root.groups-timed-out;
                        running: root.run-state == "STARTED";
                        tapped => { root.open-group(""); }
                        open(g) => { root.open-group(g); }
                    }
                }
                if !root.tables-fit: HorizontalLayout {
                    height: root.summary-h;
                    spacing: root.gap;
                    StatsDashCard { width: root.span(root.columns / 2); fill: true; height: root.summary-h; stats: root.stats; open(i) => { root.open-stats(i); } }
                    GroupsDashCard {
                        width: root.span(root.columns / 2);
                        height: root.summary-h;
                        limit: root.columns == 4 ? 2 : 1;
                        groups: root.groups;
                        timed-out: root.groups-timed-out;
                        running: root.run-state == "STARTED";
                        tapped => { root.open-group(""); }
                        open(g) => { root.open-group(g); }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------- Proxies

// The delay on a card (`_DelayText`): a bolt to test while untested, a clock while queued,
// dots while running, then the value; a tap tests the card again.
component DelayBadge inherits Rectangle {
    in property <int> delay;
    in property <color> idle: Theme.s.on-surface-variant;
    callback test();
    property <bool> busy: delay == -3 || delay == -4;
    width: delay > 0 || delay == -1 || delay == -2 ? label.preferred-width + 4px : 18px;
    height: 18px;
    if root.delay == 0: Icon { glyph: Icons.bolt; size: 15px; tint: root.idle; }
    if root.delay == -4: Icon { glyph: Icons.clock; size: 15px; tint: root.idle.with-alpha(0.5); }
    if root.delay == -3: Text { text: "···"; font-size: 13px * Type.scale; font-weight: 700; color: Theme.s.primary; horizontal-alignment: center; vertical-alignment: center; }
    label := Text {
        visible: root.delay > 0 || root.delay == -1 || root.delay == -2;
        text: root.delay == -1 ? "超时" : root.delay == -2 ? "失败" : root.delay + " ms";
        font-size: 12px * Type.scale;
        font-weight: 600;
        horizontal-alignment: right;
        vertical-alignment: center;
        color: root.delay > 0 && root.delay < 800 ? Theme.success : root.delay > 0 && root.delay < 1500 ? Theme.warning : Theme.s.error;
    }
    TouchArea {
        enabled: !root.busy;
        clicked => { root.test(); }
    }
}

// `getItemHeight`: two name lines of subheadline (one compact), a footnote row, 16 of
// padding, 8 between and 4 spare; loose adds a caption row and 6. Lines are the font's
// 1.45 em, so the card grows with the font scale instead of cutting its last row.
export global ProxyCardMetrics {
    out property <length> name-line: 14px * Type.scale * 1.45;
    out property <length> foot-line: max(18px, 12px * Type.scale * 1.45);
    out property <length> caption-line: max(18px, 11px * Type.scale * 1.45);
    public pure function height(size: int) -> length {
        return 16px + (size == 0 ? 1 : 2) * ProxyCardMetrics.name-line + 8px + ProxyCardMetrics.foot-line + 4px + (size == 2 ? ProxyCardMetrics.caption-line + 6px : 0px);
    }
    // The pinned header's offset in its group: none until the group's top leaves the
    // viewport, then following it down, at most to the group's last row.
    public pure function sticky(top-in-view: length, room: length) -> length {
        return clamp(-top-in-view, 0px, max(room, 0px));
    }
}

// FlClash's ProxyCard: the name (two lines, or one when compact), the type and the delay
// below, and a badge for the proxy in use or the pin.
component NodeCard inherits Card {
    in property <NodeItem> item;
    // 0 compact, 1 standard, 2 loose.
    in property <int> size: 1;
    // The group takes a pick (a selector) or a pin, so a long press opens its menu.
    in property <bool> menu-enabled;
    property <bool> long-fired;
    callback clicked();
    callback test();
    // The card's top left and size in window coordinates, where the menu anchors.
    callback menu(length, length, length, length);
    selected: item.selected;
    background: item.selected ? Theme.s.primary-container : (ta.pressed ? Theme.s.block : Theme.s.card);
    property <color> fg: item.selected ? Theme.s.on-primary-container : Theme.s.on-surface;
    property <color> fg2: item.selected ? Theme.s.on-primary-container : Theme.s.on-surface-variant;
    ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.long-fired = false; }
        }
        clicked => { if (!root.long-fired) { root.clicked(); } }
    }
    Timer {
        interval: 500ms;
        running: root.menu-enabled && ta.pressed && !root.long-fired;
        triggered => {
            root.long-fired = true;
            root.menu(root.absolute-position.x, root.absolute-position.y, root.width, root.height);
        }
    }
    VerticalLayout {
        padding-left: 12px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        HorizontalLayout {
            spacing: 4px;
            height: (root.size == 0 ? 1 : 2) * ProxyCardMetrics.name-line;
            Text {
                text: root.item.name;
                font-size: 14px * Type.scale;
                color: root.fg;
                wrap: root.size == 0 ? no-wrap : word-wrap;
                overflow: elide;
                vertical-alignment: top;
                horizontal-stretch: 1;
                height: parent.height;
            }
            if root.item.pinned || root.item.selected: VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: root.item.selected ? Theme.s.primary : Theme.s.primary.with-alpha(0.15);
                    Icon {
                        glyph: root.item.pinned ? Icons.pin : Icons.check;
                        size: 13px;
                        tint: root.item.selected ? Theme.s.on-primary : Theme.s.primary;
                    }
                }
            }
        }
        // The spare height goes above the type and delay, which stay on the card's bottom.
        Rectangle { vertical-stretch: 1; min-height: 8px; }
        if root.size == 2: Text { height: ProxyCardMetrics.foot-line; text: root.item.kind; font-size: 12px * Type.scale; color: root.fg2; overflow: elide; vertical-alignment: center; }
        if root.size == 2: Rectangle { height: 6px; }
        if root.size == 2: HorizontalLayout {
            height: ProxyCardMetrics.caption-line;
            DelayBadge { delay: root.item.delay; idle: root.fg2; test => { root.test(); } }
            Rectangle { }
        }
        if root.size != 2: HorizontalLayout {
            spacing: 6px;
            height: ProxyCardMetrics.foot-line;
            Text {
                horizontal-stretch: 1;
                text: root.item.kind;
                font-size: 12px * Type.scale;
                color: root.fg2;
                overflow: elide;
                vertical-alignment: center;
            }
            DelayBadge { delay: root.item.delay; idle: root.fg2; test => { root.test(); } }
        }
    }
}

// A group's cards in rows of `columns`.
component NodeGrid inherits Rectangle {
    in property <[NodeItem]> nodes;
    in property <int> columns: 2;
    in property <length> card-height;
    in property <int> size;
    in property <bool> menu-enabled;
    callback select(string);
    callback test(string);
    callback menu(NodeItem, length, length, length, length);
    property <length> gap: 8px;
    property <length> cell-w: (self.width - (columns - 1) * gap) / columns;
    height: max(0px, ceil(nodes.length / columns) * (card-height + gap) - gap);
    for n[i] in root.nodes: NodeCard {
        x: mod(i, root.columns) * (root.cell-w + root.gap);
        y: floor(i / root.columns) * (root.card-height + root.gap);
        width: root.cell-w;
        height: root.card-height;
        item: n;
        size: root.size;
        menu-enabled: root.menu-enabled;
        clicked => { root.select(n.name); }
        test => { root.test(n.name); }
        menu(x, y, w, h) => { root.menu(n, x, y, w, h); }
    }
}

// The list style's group header (`ListHeader`): icon, name and its pick, then the
// locate and test buttons while unfolded or the type while folded, and the fold toggle.
component GroupHeader inherits Card {
    in property <ProxyGroup> group;
    // 0 filled, 1 plain, 2 hidden.
    in property <int> icon;
    // How far the rows are out, 0 folded to 1 unfolded.
    in property <float> unfold: root.group.expanded ? 1 : 0;
    callback toggle();
    callback test();
    callback locate();
    height: 64px;
    border-radius: 16px;
    ta := TouchArea { clicked => { root.toggle(); } }
    HorizontalLayout {
        padding-left: root.icon == 2 ? 14px : 10px;
        padding-right: 6px;
        spacing: 10px;
        if root.icon == 0: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 42px;
                height: 42px;
                border-radius: 10px;
                background: Theme.s.block;
                Text { text: root.group.monogram; font-size: 18px * Type.scale; font-weight: 600; color: Theme.s.on-surface-variant; }
            }
        }
        if root.icon == 1: VerticalLayout {
            alignment: center;
            Text { text: root.group.monogram; width: 28px; font-size: 22px * Type.scale; font-weight: 700; color: Theme.s.primary; horizontal-alignment: center; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.group.name; font-size: 16px * Type.scale; font-weight: 600; color: Theme.s.on-surface; overflow: elide; }
            if root.group.now != "": Text { text: root.group.now; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; overflow: elide; }
        }
        if root.group.expanded: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 84px;
                height: 36px;
                border-radius: 18px;
                background: Theme.s.block;
                HorizontalLayout {
                    IconButton { width: 42px; height: 36px; glyph: Icons.locate; clicked => { root.locate(); } }
                    IconButton {
                        width: 42px;
                        height: 36px;
                        glyph: root.group.testing ? Icons.clock : Icons.bolt;
                        enabled: !root.group.testing;
                        clicked => { root.test(); }
                    }
                }
            }
        }
        if !root.group.expanded: Text { text: root.group.kind; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; }
        // `Glyphs.caretDown` turned from pointing at the label (-90°) to down with the rows.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: fold-ta.pressed ? Theme.s.inset : transparent;
                Rectangle {
                    width: 20px;
                    height: 20px;
                    transform-rotation: -90deg * (1 - root.unfold);
                    FilledIcon { size: 20px; glyph: Icons.caret-down; tint: Theme.s.on-surface-variant; }
                }
                fold-ta := TouchArea { clicked => { root.toggle(); } }
            }
        }
    }
}

component Proxies inherits Rectangle {
    // `ProxiesView(picker: true)`: in a sheet, without locate and the ⋯ menu.
    in property <bool> picker;
    in property <[ProxyGroup]> groups;
    in property <ProxyStyle> style;
    in-out property <string> current-group;
    in property <bool> testing;
    in property <string> hint;
    in-out property <bool> searching;
    in-out property <string> query;
    // The window's width, for FlClash's view modes (mobile up to 600, laptop up to 840).
    in property <length> view-width;
    property <bool> mobile: root.view-width <= 600px;
    property <length> group-gap: root.mobile ? 8px : root.view-width <= 840px ? 12px : 16px;
    // The list style lays groups out in columns of at least 360 wide, at most 3, off mobile.
    out property <int> group-columns: root.style.kind == 1 && !root.mobile ? max(1, min(3, floor((self.width - 32px + root.group-gap) / (360px + root.group-gap)))) : 1;
    property <length> group-width: (self.width - 32px - (root.group-columns - 1) * root.group-gap) / root.group-columns;
    // `getProxiesColumns` (from the group's width less its insets in the list) and the card
    // heights of `getItemHeight`.
    out property <int> columns: max(ceil((root.style.kind == 1 ? root.group-width - 20px : self.width - 32px) / 250px), 2) + (style.layout == 0 ? 1 : style.layout == 2 ? -1 : 0);
    out property <length> card-height: ProxyCardMetrics.height(style.card);
    callback open-group(string);
    callback select-node(string, string);
    callback test-group(string);
    callback test-node(string, string);
    callback toggle-group(string);
    callback search(string);
    callback open-options();
    callback locate(string) -> length;
    // A node's long press: its group and the group's type, the node and the card's window
    // rectangle.
    callback node-menu(string, string, NodeItem, length, length, length, length);
    // The tab bar's ▾: the groups to pick from, anchored at the button.
    callback group-menu(length, length, length, length);

    pure function pickable(kind: string) -> bool {
        return kind == "Selector" || kind == "URLTest" || kind == "Fallback" || kind == "Smart";
    }

    // The group whose rows are moving (`UnfoldMotion.run`); another tap on it turns the
    // motion around, a tap on another group settles this one.
    property <string> unfold-group;
    property <float> unfold-from;
    property <float> unfold-to;
    property <float> unfold-v0;
    property <duration> unfold-start;
    property <bool> unfold-running;
    property <float> unfold-t: root.unfold-running ? UnfoldMotion.at(root.unfold-from, root.unfold-to, root.unfold-v0, (animation-tick() - root.unfold-start) / 1s) : root.unfold-to;

    pure function moving(group: string) -> bool {
        return root.unfold-running && root.unfold-group == group;
    }

    pure function unfold-of(g: ProxyGroup) -> float {
        return root.moving(g.name) ? clamp(root.unfold-t, 0, 1) : g.expanded ? 1 : 0;
    }

    function start-unfold(group: string, expanded: bool) {
        let now = animation-tick();
        if (root.moving(group)) {
            let t = (now - root.unfold-start) / 1s;
            let x = UnfoldMotion.at(root.unfold-from, root.unfold-to, root.unfold-v0, t);
            let v = UnfoldMotion.velocity(root.unfold-from, root.unfold-to, root.unfold-v0, t);
            root.unfold-from = x;
            root.unfold-v0 = v;
            root.unfold-to = 1 - root.unfold-to;
        } else {
            root.unfold-from = expanded ? 1 : 0;
            root.unfold-v0 = 0;
            root.unfold-to = expanded ? 0 : 1;
        }
        root.unfold-group = group;
        root.unfold-start = now;
        root.unfold-running = true;
    }

    unfold-timer := Timer {
        interval: 16ms;
        running: root.unfold-running;
        triggered => {
            if (UnfoldMotion.settled(root.unfold-from, root.unfold-to, root.unfold-v0, (animation-tick() - root.unfold-start) / 1s)) {
                root.unfold-running = false;
            }
        }
    }

    changed query => { root.search(root.query); }

    function go-to(group: string) {
        flick.content-y = -min(max(0px, root.locate(group) - 8px), max(0px, flick.content-height - flick.height));
    }

    VerticalLayout {
        if !root.searching: AppBar {
            title: "代理";
            VerticalLayout { alignment: center; IconButton { glyph: Icons.search; tint: Theme.s.on-surface; clicked => { root.searching = true; } } }
            // The primary action (`_buildPrimaryAction`): the open group's delay test.
            if root.style.kind == 0 && root.groups.length > 0: VerticalLayout {
                alignment: center;
                IconButton { glyph: Icons.bolt; loading: root.testing; tint: Theme.s.on-surface; clicked => { root.test-group(root.current-group); } }
            }
            if !root.picker && root.style.kind == 0 && root.groups.length > 0: VerticalLayout {
                alignment: center;
                IconButton { glyph: Icons.locate; tint: Theme.s.on-surface; clicked => { root.go-to(root.current-group); } }
            }
            if !root.picker: VerticalLayout { alignment: center; IconButton { glyph: Icons.more; tint: Theme.s.on-surface; clicked => { root.open-options(); } } }
        }
        if root.searching: HorizontalLayout {
            height: 56px;
            padding-left: 4px;
            padding-right: 12px;
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                IconButton { glyph: Icons.back; tint: Theme.s.on-surface; clicked => { root.query = ""; root.searching = false; } }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Rectangle {
                    height: 44px;
                    border-radius: 22px;
                    background: Theme.s.block;
                    Text {
                        x: 16px;
                        visible: search-input.text == "";
                        text: "搜索";
                        color: Theme.s.on-surface-variant;
                        font-size: 15px * Type.scale;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    search-input := TextInput {
                        x: 16px;
                        width: parent.width - 32px;
                        height: parent.height;
                        vertical-alignment: center;
                        single-line: true;
                        font-size: 15px * Type.scale;
                        color: Theme.s.on-surface;
                        text <=> root.query;
                        init => { self.focus(); }
                    }
                }
            }
            if root.style.kind == 0 && root.groups.length > 0: VerticalLayout {
                alignment: center;
                IconButton { glyph: Icons.bolt; loading: root.testing; tint: Theme.s.on-surface; clicked => { root.test-group(root.current-group); } }
            }
        }

        // Group tabs, FlClash's scrollable tab bar, with the ▾ group menu once they overflow.
        if root.style.kind == 0 && root.groups.length > 0: tabbar := Rectangle {
            height: 44px;
            property <bool> overflow: tabs.preferred-width > self.width;
            Flickable {
                width: tabbar.overflow ? tabbar.width - 44px : tabbar.width;
                x: 0;
                content-width: max(tabs.preferred-width, self.width);
                tabs := HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    for g in root.groups: Rectangle {
                        property <bool> active: g.name == root.current-group;
                        width: label.preferred-width + 24px;
                        label := Text {
                            text: g.name;
                            font-size: 14px * Type.scale;
                            font-weight: parent.active ? 600 : 400;
                            color: parent.active ? Theme.s.primary : Theme.s.on-surface-variant;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            y: parent.height - 3px;
                            width: label.preferred-width;
                            height: 3px;
                            border-radius: 1.5px;
                            background: parent.active ? Theme.s.primary : transparent;
                        }
                        TouchArea {
                            clicked => {
                                root.current-group = g.name;
                                flick.content-y = 0;
                                root.open-group(g.name);
                            }
                        }
                    }
                }
            }
            if tabbar.overflow: IconButton {
                x: parent.width - self.width - 2px;
                glyph: Icons.unfold;
                tint: Theme.s.on-surface-variant;
                clicked => { root.group-menu(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.s.outline-variant; }
        }

        Rectangle {
            flick := Flickable {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                content-height: max(content.preferred-height, self.height) + Dock.pad;
                content := VerticalLayout {
                    alignment: start;
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 8px;
                    padding-bottom: 24px;
                    spacing: 10px;
                    // Groups go to the columns in turn (`SliverCrossAxisGroup`), each column
                    // stacking its own.
                    if root.style.kind == 1: HorizontalLayout {
                        spacing: root.group-gap;
                        for c in root.group-columns: VerticalLayout {
                            alignment: start;
                            width: root.group-width;
                            for g[i] in root.groups: VerticalLayout {
                                // `PinnedHeaderSliver`: scrolled into an unfolded group, its header
                                // stays at the top until the group's last row pushes it off.
                                if mod(i, root.group-columns) == c: Rectangle {
                                    group-body := VerticalLayout {
                                        padding-bottom: 10px;
                                        header-slot := Rectangle { height: 64px; }
                                        // `UnfoldSliver`: while moving, the rows slide out from behind
                                        // the header as one block of at most a screen, clipped at its
                                        // bottom edge, and what follows moves with the block's bottom.
                                        if g.expanded || root.moving(g.name): Rectangle {
                                            property <bool> in-motion: root.moving(g.name);
                                            property <length> full: rows.height + 8px;
                                            property <length> extent: min(self.full, flick.height);
                                            property <length> shown: self.extent * root.unfold-of(g);
                                            height: self.in-motion ? self.shown : self.full;
                                            clip: self.in-motion;
                                            rows := NodeGrid {
                                                y: parent.in-motion ? parent.shown - parent.extent + 8px : 8px;
                                                nodes: g.nodes;
                                                columns: root.columns;
                                                card-height: root.card-height;
                                                size: root.style.card;
                                                menu-enabled: root.pickable(g.kind);
                                                select(n) => { root.select-node(g.name, n); }
                                                test(n) => { root.test-node(g.name, n); }
                                                menu(n, x, y, w, h) => { root.node-menu(g.name, g.kind, n, x, y, w, h); }
                                            }
                                        }
                                    }
                                    GroupHeader {
                                        y: ProxyCardMetrics.sticky(header-slot.absolute-position.y - flick.absolute-position.y, group-body.height - 10px - 64px);
                                        width: parent.width;
                                        group: g;
                                        icon: root.style.icon;
                                        unfold: root.unfold-of(g);
                                        toggle => {
                                            root.start-unfold(g.name, g.expanded);
                                            root.toggle-group(g.name);
                                        }
                                        test => { root.test-group(g.name); }
                                        locate => { root.go-to(g.name); }
                                    }
                                }
                            }
                        }
                    }
                    if root.style.kind == 0: VerticalLayout {
                        for g in root.groups: VerticalLayout {
                            if g.name == root.current-group: NodeGrid {
                                nodes: g.nodes;
                                columns: root.columns;
                                card-height: root.card-height;
                                size: root.style.card;
                                menu-enabled: root.pickable(g.kind);
                                select(n) => { root.select-node(g.name, n); }
                                test(n) => { root.test-node(g.name, n); }
                                menu(n, x, y, w, h) => { root.node-menu(g.name, g.kind, n, x, y, w, h); }
                            }
                        }
                    }
                }
            }
            if root.groups.length == 0: Empty { text: root.searching && root.query != "" ? "没有匹配的代理" : root.hint; }
        }
    }

}

// ---------------------------------------------------------------- Profiles

// FlClash's ProfileItem: title with the expiry chip, the usage or the type below, the last
// update and the selection badge on the right; the more
// button opens its menu.
component ProfileCard inherits Card {
    in property <ProfileItem> item;
    property <bool> long-fired;
    callback select();
    // A long press (`ContextMenuRegion`), with the card's window rectangle; none while it
    // updates.
    callback menu(length, length, length, length);
    selected: item.active;
    height: 72px;
    property <color> fg: item.active ? Theme.s.on-primary-container : Theme.s.on-surface;
    property <color> fg2: item.active ? Theme.s.on-primary-container : Theme.s.on-surface-variant;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.item.name;
                    font-size: 17px * Type.scale;
                    color: root.fg;
                    overflow: elide;
                    horizontal-stretch: 1;
                    max-width: self.preferred-width;
                }
                if root.item.expire != "": Rectangle {
                    width: chip.preferred-width + 16px;
                    height: 20px;
                    border-radius: 10px;
                    background: (root.item.expired ? Theme.s.error : Theme.s.primary).with-alpha(0.15);
                    chip := Text {
                        text: root.item.expire;
                        font-size: 11px * Type.scale;
                        font-weight: 600;
                        color: root.item.expired ? Theme.s.error : Theme.s.primary;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
                Rectangle { horizontal-stretch: 0.001; }
            }
            Text { text: root.item.subtitle; font-size: 13px * Type.scale; color: root.fg2; overflow: elide; }
        }
        if !root.item.is-custom: VerticalLayout {
            alignment: center;
            Text {
                text: root.item.busy ? "更新中…" : root.item.trailing;
                font-size: 12px * Type.scale;
                color: root.fg2;
            }
        }
        // Square-cornered so a lone digit never reads as a second selection badge.
        if root.item.is-custom: VerticalLayout {
            alignment: center;
            Rectangle {
                width: max(24px, groups-text.preferred-width * 1.1 + 12px);
                height: 24px;
                border-radius: 6px;
                background: Theme.s.primary.with-alpha(0.15);
                groups-text := Text {
                    text: root.item.groups;
                    font-size: 13px * Type.scale;
                    font-weight: 600;
                    color: Theme.s.primary;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }
        if root.item.active: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: Theme.s.primary;
                Icon { glyph: Icons.check; size: 16px; tint: Theme.s.on-primary; }
            }
        }
    }
    pc-ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.long-fired = false; }
        }
        clicked => { if (!root.long-fired) { root.select(); } }
    }
    Timer {
        interval: 500ms;
        running: !root.item.busy && pc-ta.pressed && !root.long-fired;
        triggered => {
            root.long-fired = true;
            root.menu(root.absolute-position.x, root.absolute-position.y, root.width, root.height);
        }
    }
}

component Profiles inherits Rectangle {
    in property <[ProfileItem]> profiles;
    in property <bool> adding;
    // The window's width, for FlClash's card spacing by view mode.
    in property <length> view-width;
    // The add menu, anchored at the button that opens it.
    callback add(length, length, length, length);
    callback update-all();
    callback open-sort();
    callback select-profile(string);
    callback menu(ProfileItem, length, length, length, length);
    property <length> gap: root.view-width <= 600px ? 8px : root.view-width <= 840px ? 12px : 16px;
    // `getProfilesColumns`: cards at least 300 wide, at most 3 a row.
    property <int> columns: max(1, min(3, floor((self.width - 32px + root.gap) / (300px + root.gap))));
    property <length> cell-w: (self.width - 32px - (root.columns - 1) * root.gap) / root.columns;

    VerticalLayout {
        AppBar {
            title: "配置";
            if root.profiles.length > 0: VerticalLayout {
                alignment: center;
                IconButton { glyph: Icons.sync; tint: Theme.s.on-surface; clicked => { root.update-all(); } }
            }
            if root.profiles.length > 0: VerticalLayout {
                alignment: center;
                IconButton { glyph: Icons.sort; tint: Theme.s.on-surface; clicked => { root.open-sort(); } }
            }
            if root.profiles.length > 0: VerticalLayout {
                alignment: center;
                IconButton {
                    glyph: Icons.add-circle;
                    loading: root.adding;
                    tint: Theme.s.on-surface;
                    clicked => { root.add(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                }
            }
        }
        if root.profiles.length == 0: Rectangle {
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text { text: "暂无配置"; font-size: 18px * Type.scale; color: Theme.s.on-surface; horizontal-alignment: center; }
                Text { text: "添加一个配置文件后即可开始使用"; font-size: 14px * Type.scale; color: Theme.s.on-surface-variant; horizontal-alignment: center; }
                HorizontalLayout {
                    alignment: center;
                    padding-top: 8px;
                    TextButton {
                        text: root.adding ? "加载中…" : "添加配置";
                        filled: true;
                        enabled: !root.adding;
                        clicked => { root.add(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                    }
                }
            }
        }
        if root.profiles.length > 0: Flickable {
            content-height: grid.height + 16px + Dock.pad;
            grid := Rectangle {
                x: 16px;
                y: 4px;
                width: parent.width - 32px;
                height: max(0px, ceil(root.profiles.length / root.columns) * (72px + root.gap) - root.gap);
                for p[i] in root.profiles: ProfileCard {
                    x: mod(i, root.columns) * (root.cell-w + root.gap);
                    y: floor(i / root.columns) * (72px + root.gap);
                    width: root.cell-w;
                    item: p;
                    select => { root.select-profile(p.id); }
                    menu(x, y, w, h) => { root.menu(p, x, y, w, h); }
                }
            }
        }
    }
}

// `_sectionRow`: glyph, title, the section's state and the chevron to its page.
component CustomRowView inherits Rectangle {
    in property <CustomRow> item;
    in property <bool> divider;
    callback clicked();
    height: 52px;
    background: crv-ta.pressed ? Theme.s.inset : transparent;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 14px;
        VerticalLayout { alignment: center; Icon { glyph: Glyphs.of(root.item.glyph); tint: Theme.s.on-surface-variant; } }
        Text {
            text: root.item.title;
            font-size: 16px * Type.scale;
            color: Theme.s.on-surface;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 4px;
            Text {
                text: root.item.state;
                horizontal-alignment: right;
                font-size: 15px * Type.scale;
                color: root.item.tone == 2 ? Theme.s.error : root.item.tone == 1 ? Theme.s.primary : Theme.s.on-surface-variant;
                vertical-alignment: center;
                overflow: elide;
            }
            VerticalLayout { alignment: center; Icon { glyph: Icons.chevron; size: 20px; tint: Theme.s.on-surface-variant; } }
        }
    }
    if root.divider: Rectangle {
        x: 54px;
        y: parent.height - 1px;
        width: parent.width - self.x;
        height: 1px;
        background: Theme.s.outline-variant.with-alpha(0.6);
    }
    crv-ta := TouchArea { clicked => { root.clicked(); } }
}

// A reorderable grouped list (`PrismReorderableListView` with a `SortHandle` per row): a
// long press lifts a row, it follows the finger while the rows it passes make way, and the
// move lands on release. Nothing changes in the model until then.
component ReorderList inherits Rectangle {
    in property <[string]> titles;
    in property <[string]> subtitles;
    out property <bool> dragging: root.drag-from >= 0;
    callback moved(int, int);
    property <length> row-h: root.subtitles.length > 0 ? 64px : 52px;
    property <int> drag-from: -1;
    property <length> press-y;
    property <length> shift;
    property <int> drag-to: root.drag-from < 0 ? -1 : max(0, min(root.titles.length - 1, root.drag-from + round(root.shift / root.row-h)));
    height: root.titles.length * root.row-h;
    Rectangle {
        background: Theme.s.card;
        border-radius: 16px;
    }
    for t[i] in root.titles: Rectangle {
        property <bool> lifted: i == root.drag-from;
        y: root.drag-from < 0 || self.lifted ? i * root.row-h
            : i > root.drag-from && i <= root.drag-to ? (i - 1) * root.row-h
            : i < root.drag-from && i >= root.drag-to ? (i + 1) * root.row-h
            : i * root.row-h;
        z: self.lifted ? 1 : 0;
        height: root.row-h;
        animate y { duration: 150ms; easing: ease-out; }
        Rectangle {
            y: parent.lifted ? root.shift : 0px;
            background: parent.lifted ? Theme.s.card : transparent;
            border-radius: parent.lifted ? 16px : 0px;
            drop-shadow-offset-y: parent.lifted ? 6px : 0px;
            drop-shadow-blur: parent.lifted ? 16px : 0px;
            drop-shadow-color: parent.lifted ? #00000033 : transparent;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text { text: t; font-size: 16px * Type.scale; color: Theme.s.on-surface; overflow: elide; }
                    if i < root.subtitles.length && root.subtitles[i] != "": Text { text: root.subtitles[i]; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; overflow: elide; }
                }
                VerticalLayout { alignment: center; Icon { glyph: "M5 9h14 M5 15h14"; size: 20px; tint: Theme.s.on-surface-variant; } }
            }
            if !parent.lifted && i < root.titles.length - 1: Rectangle {
                x: 16px;
                y: parent.height - 1px;
                width: parent.width - 16px;
                height: 1px;
                background: Theme.s.outline-variant.with-alpha(0.6);
            }
        }
        rl-ta := TouchArea {
            changed pressed => {
                if (!self.pressed && root.drag-from == i) {
                    let from = root.drag-from;
                    let to = root.drag-to;
                    root.drag-from = -1;
                    root.shift = 0px;
                    if (from != to) { root.moved(from, to); }
                }
            }
            moved => {
                if (root.drag-from == i) { root.shift = self.mouse-y - root.press-y; }
            }
        }
        Timer {
            interval: 400ms;
            running: rl-ta.pressed && root.drag-from < 0;
            triggered => {
                root.press-y = rl-ta.mouse-y;
                root.shift = 0px;
                root.drag-from = i;
            }
        }
    }
}

// `_ProxyGroupItem`: the icon or monogram, name and type, the issue mark and the circle
// checkbox. A tap edits, or selects while selecting; a long press opens the menu.
component GroupRowView inherits Rectangle {
    in property <GroupRow> item;
    in property <bool> divider;
    in property <bool> selecting;
    callback clicked(string);
    property <bool> long-fired;
    property <bool> pictured: root.item.icon != "" && NetImages.has(root.item.icon, NetImages.rev);
    height: 64px;
    background: gr-ta.pressed ? Theme.s.inset : root.item.selected ? Theme.s.primary.with-alpha(0.08) : transparent;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 50px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                if root.pictured: Image {
                    width: 32px;
                    height: 32px;
                    image-fit: contain;
                    source: NetImages.image(root.item.icon, NetImages.rev);
                }
                if !root.pictured: Text {
                    text: root.item.mark;
                    font-size: 20px * Type.scale;
                    font-weight: 600;
                    color: Theme.s.on-surface-variant;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.item.name; font-size: 16px * Type.scale; color: Theme.s.on-surface; overflow: elide; }
            Text { text: root.item.kind; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; overflow: elide; }
        }
        if root.item.invalid: VerticalLayout {
            alignment: center;
            Icon { glyph: Icons.error; size: 20px; tint: Theme.s.error; }
        }
    }
    if root.divider: Rectangle {
        x: 62px;
        y: parent.height - 1px;
        width: parent.width - self.x;
        height: 1px;
        background: Theme.s.outline-variant.with-alpha(0.6);
    }
    gr-ta := TouchArea {
        x: 0;
        width: parent.width - 50px;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.long-fired = false; }
        }
        clicked => {
            if (root.long-fired) { return; }
            root.clicked((root.selecting ? "select:" : "open:") + root.item.id);
        }
    }
    Timer {
        interval: 500ms;
        running: !root.selecting && gr-ta.pressed && !root.long-fired;
        triggered => {
            root.long-fired = true;
            Anchor.x = root.absolute-position.x;
            Anchor.y = root.absolute-position.y;
            Anchor.w = root.width;
            Anchor.h = root.height;
            root.clicked("long:" + root.item.id);
        }
    }
    Rectangle {
        x: parent.width - 50px;
        width: 50px;
        Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 11px;
            border-width: root.item.selected ? 0px : 2px;
            border-color: Theme.s.on-surface-variant;
            background: root.item.selected ? Theme.s.primary : transparent;
            if root.item.selected: Icon { glyph: Icons.check; size: 16px; tint: Theme.s.on-primary; }
        }
        TouchArea { clicked => { root.clicked("select:" + root.item.id); } }
    }
}

// CustomProfileView: the title opens 重命名 / 运行时配置, 导入 opens 通过URL导入 / 通过文件导入
// (a spinner in its place while importing), then the issue banner, the overview rows and
// `CustomProxyGroupsSection`, whose header carries the groups' own actions.
component CustomProfilePage inherits Rectangle {
    in property <string> title;
    in property <[CustomRow]> rows;
    in property <int> issues;
    in property <int> group-count;
    in property <[GroupRow]> groups;
    in property <[string]> group-titles;
    in property <[string]> group-kinds;
    in property <bool> selecting;
    in property <bool> sorting;
    in property <bool> importing;
    callback back();
    callback title-menu(length, length, length, length);
    callback import-menu(length, length, length, length);
    callback open-row(CustomRow);
    callback group(string);
    background: Theme.s.page;
    VerticalLayout {
        HorizontalLayout {
            height: 56px;
            padding-left: 4px;
            padding-right: 8px;
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                IconButton { glyph: Icons.back; tint: Theme.s.on-surface; clicked => { root.back(); } }
            }
            Rectangle {
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 2px;
                    cpp-title := Text {
                        text: root.title;
                        font-size: 22px * Type.scale;
                        color: Theme.s.on-surface;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                        max-width: self.preferred-width;
                    }
                    VerticalLayout {
                        alignment: center;
                        Icon { glyph: Icons.unfold; size: 18px; tint: Theme.s.on-surface-variant; }
                    }
                    Rectangle { horizontal-stretch: 0.001; }
                }
                TouchArea {
                    width: min(parent.width, cpp-title.width + 24px);
                    x: 0;
                    clicked => { root.title-menu(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                }
            }
            VerticalLayout {
                alignment: center;
                if root.importing: HorizontalLayout {
                    width: 64px;
                    alignment: center;
                    Spinner { width: 22px; height: 22px; indeterminate: true; }
                }
                if !root.importing: TextButton {
                    text: "导入";
                    filled: true;
                    clicked => { root.import-menu(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                }
            }
        }
        Flickable {
            interactive: !cpp-sort.dragging;
            content-height: cpp-body.preferred-height + Dock.pad;
            cpp-body := VerticalLayout {
                alignment: start;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: 24px;
                spacing: 8px;
                if root.issues > 0: Rectangle {
                    height: max(48px, cpp-issue.preferred-height + 24px);
                    border-radius: 16px;
                    background: Theme.s.error.with-alpha(0.12);
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        VerticalLayout { alignment: center; Icon { glyph: Icons.error; size: 20px; tint: Theme.s.error; } }
                        cpp-issue := Text {
                            text: root.issues + " 项存在问题，应用配置可能失败";
                            font-size: 14px * Type.scale;
                            color: Theme.s.error;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
                Rectangle {
                    background: Theme.s.card;
                    border-radius: 16px;
                    clip: true;
                    VerticalLayout {
                        for r[i] in root.rows: CustomRowView {
                            item: r;
                            divider: i < root.rows.length - 1;
                            clicked => { root.open-row(r); }
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 14px;
                    padding-top: 12px;
                    height: 52px;
                    Text { text: "策略组"; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; horizontal-stretch: 1; }
                    if root.selecting: IconButton { glyph: Icons.delete; tint: Theme.s.on-surface; clicked => { root.group("delete"); } }
                    if root.selecting: IconButton { glyph: Icons.select-all; tint: Theme.s.on-surface; clicked => { root.group("select-all"); } }
                    if !root.selecting && (root.sorting || root.group-count > 1): IconButton {
                        glyph: root.sorting ? Icons.check : Icons.sort;
                        tint: Theme.s.on-surface;
                        clicked => { root.group(root.sorting ? "sort-done" : "sort"); }
                    }
                    if !root.selecting && !root.sorting: IconButton { glyph: Icons.add-circle; tint: Theme.s.on-surface; clicked => { root.group("add"); } }
                }
                if root.group-count > 0 && !root.sorting: Rectangle {
                    background: Theme.s.card;
                    border-radius: 16px;
                    clip: true;
                    VerticalLayout {
                        for g[i] in root.groups: GroupRowView {
                            item: g;
                            selecting: root.selecting;
                            divider: i < root.groups.length - 1;
                            clicked(id) => { root.group(id); }
                        }
                    }
                }
                cpp-sort := ReorderList {
                    visible: root.sorting;
                    titles: root.sorting ? root.group-titles : [];
                    subtitles: root.group-kinds;
                    moved(f, t) => { root.group("move:" + f + ":" + t); }
                }
                if root.group-count == 0: Text {
                    height: 120px;
                    text: "策略组为空";
                    font-size: 16px * Type.scale;
                    font-weight: 600;
                    color: Theme.s.on-surface;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// An outlined text field with its label above, as FlClash's forms.
component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> multi;
    // `minLines` with no `maxLines`: at least this many lines, growing with the text, which
    // wraps anywhere as a link does.
    in property <int> min-lines;
    property <bool> grows: root.min-lines > 0;
    property <length> line-h: 15px * Type.scale * 1.4;
    in property <bool> enabled: true;
    in property <InputType> input-type: InputType.text;
    in-out property <string> text <=> input.text;
    callback accepted();
    public function focus-input() { input.focus(); }
    spacing: 6px;
    if root.label != "": Text { text: root.label; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; }
    Rectangle {
        height: root.multi ? 160px : root.grows ? max(root.min-lines * root.line-h, min(input.preferred-height, 10 * root.line-h)) + 24px : 50px;
        border-radius: 8px;
        border-width: input.has-focus ? 2px : 1px;
        border-color: input.has-focus ? Theme.s.primary : Theme.s.outline-variant;
        clip: true;
        Text {
            x: 14px;
            y: root.multi || root.grows ? 12px : (parent.height - self.height) / 2;
            visible: input.text == "";
            text: root.placeholder;
            color: Theme.s.on-surface-variant;
            font-size: 15px * Type.scale;
        }
        input := TextInput {
            x: 14px;
            y: root.multi || root.grows ? 12px : 0px;
            width: parent.width - 28px;
            height: root.multi || root.grows ? parent.height - 24px : parent.height;
            vertical-alignment: root.multi || root.grows ? top : center;
            single-line: !root.multi && !root.grows;
            wrap: root.grows ? char-wrap : root.multi ? word-wrap : no-wrap;
            input-type: root.input-type;
            font-size: 15px * Type.scale;
            color: Theme.s.on-surface;
            selection-background-color: Theme.s.primary-container;
            enabled: root.enabled;
            accepted => { root.accepted(); }
        }
    }
}


// EditProfileView: name, url, age key, auto update and its interval, and the profile file
// (edit or upload).
component EditProfilePage inherits Rectangle {
    in property <bool> is-url;
    in-out property <string> name;
    in-out property <string> url;
    in-out property <string> age;
    in-out property <bool> auto;
    in-out property <string> interval;
    in property <string> file-info;
    in property <bool> busy;
    callback save();
    callback back();
    callback edit-file();
    callback upload-file();
    background: Theme.s.page;
    VerticalLayout {
        AppBar {
            title: "编辑";
            can-back: true;
            back => { root.back(); }
            VerticalLayout {
                alignment: center;
                TextButton { text: root.busy ? "保存中…" : "保存"; enabled: !root.busy; clicked => { root.save(); } }
            }
        }
        Flickable {
            content-height: form.preferred-height + Dock.pad;
            form := VerticalLayout {
                alignment: start;
                padding: 16px;
                spacing: 14px;
                Field { label: "名称"; placeholder: "必填"; text <=> root.name; }
                if root.is-url: Field { label: "URL"; placeholder: "必填"; text <=> root.url; }
                Field { label: "age 私钥"; placeholder: "可选"; text <=> root.age; }
                if root.is-url: HorizontalLayout {
                    height: 48px;
                    Text { text: "自动更新"; font-size: 16px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; horizontal-stretch: 1; }
                    VerticalLayout { alignment: center; Switch { checked <=> root.auto; } }
                }
                if root.is-url && root.auto: HorizontalLayout {
                    spacing: 8px;
                    Field { label: "自动更新间隔"; placeholder: "必填"; input-type: InputType.number; text <=> root.interval; }
                    VerticalLayout {
                        alignment: end;
                        Text { text: "分钟"; height: 50px; vertical-alignment: center; color: Theme.s.on-surface-variant; }
                    }
                }
                Card {
                    height: 64px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 4px;
                        spacing: 4px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text { text: "配置"; font-size: 16px * Type.scale; color: Theme.s.on-surface; }
                            Text { text: root.file-info; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; }
                        }
                        VerticalLayout { alignment: center; IconButton { glyph: Icons.edit; clicked => { root.edit-file(); } } }
                        VerticalLayout { alignment: center; IconButton { glyph: Icons.upload; clicked => { root.upload-file(); } } }
                    }
                }
            }
        }
    }
}

// EditorPage: the profile file to edit, or the runtime config to read.
component NullStatus inherits Rectangle {
    in property <string> label;
    in property <string> description;
    // `TonalButton` under the text, when given.
    in property <string> action;
    callback act();
    VerticalLayout {
        alignment: center;
        spacing: 6px;
        padding-left: 32px;
        padding-right: 32px;
        Text { text: root.label; font-size: 16px * Type.scale; font-weight: 600; color: Theme.s.on-surface; horizontal-alignment: center; wrap: word-wrap; }
        if root.description != "": Text { text: root.description; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; horizontal-alignment: center; wrap: word-wrap; }
        if root.action != "": HorizontalLayout {
            alignment: center;
            padding-top: 12px;
            Rectangle {
                height: 44px;
                min-width: nsa-row.preferred-width * 1.1 + 40px;
                border-radius: 22px;
                background: nsa.pressed ? Theme.s.primary-container.darker(0.1) : Theme.s.primary-container;
                nsa-row := HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    VerticalLayout { alignment: center; Icon { glyph: Icons.add-circle; size: 20px; tint: Theme.s.on-primary-container; } }
                    Text { text: root.action; font-size: 15px * Type.scale; font-weight: 600; color: Theme.s.on-primary-container; vertical-alignment: center; }
                }
                nsa := TouchArea { clicked => { root.act(); } }
            }
        }
    }
}

// prism's `NullStatusSwitcher` loading slot: the page opens at once and shows it while its
// data loads, for at least 400 ms once shown (`minimumLoadingDuration`).
component LoadingHold {
    in property <bool> loading;
    out property <bool> shown: root.loading || root.held;
    property <bool> held;
    init => {
        if (root.loading) { root.held = true; }
    }
    changed loading => {
        if (root.loading) { root.held = true; }
    }
    Timer {
        interval: 400ms;
        running: root.held;
        triggered => { root.held = false; }
    }
}

// `ServiceManageView`: every service with its switch, in a grouped run; a tap switches
// it (not the last one on), a long press lifts it to drag into another place.
component ServiceManageList inherits Rectangle {
    in property <[ServiceManageRow]> rows;
    out property <bool> dragging: root.drag-from >= 0;
    callback moved(int, int);
    callback toggled(string, bool);
    property <length> row-h: 64px;
    property <int> drag-from: -1;
    property <length> press-y;
    property <length> shift;
    property <bool> fired;
    property <int> drag-to: root.drag-from < 0 ? -1 : max(0, min(root.rows.length - 1, root.drag-from + round(root.shift / root.row-h)));
    height: root.rows.length * root.row-h;
    Rectangle {
        background: Theme.s.card;
        border-radius: 16px;
    }
    for r[i] in root.rows: Rectangle {
        property <bool> lifted: i == root.drag-from;
        y: root.drag-from < 0 || self.lifted ? i * root.row-h
            : i > root.drag-from && i <= root.drag-to ? (i - 1) * root.row-h
            : i < root.drag-from && i >= root.drag-to ? (i + 1) * root.row-h
            : i * root.row-h;
        z: self.lifted ? 1 : 0;
        height: root.row-h;
        animate y { duration: 150ms; easing: ease-out; }
        Rectangle {
            y: parent.lifted ? root.shift : 0px;
            background: parent.lifted ? Theme.s.card : sm-ta.pressed && !r.locked ? Theme.s.block.with-alpha(0.5) : transparent;
            border-radius: parent.lifted ? 16px : 0px;
            drop-shadow-offset-y: parent.lifted ? 6px : 0px;
            drop-shadow-blur: parent.lifted ? 16px : 0px;
            drop-shadow-color: parent.lifted ? #00000033 : transparent;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;
                VerticalLayout { alignment: center; ServiceBadge { service: r.id; size: 40px; radius: 4px; tile: Theme.s.block; under: Theme.s.card; ink: r.enabled ? Theme.s.on-surface-variant : Theme.s.on-surface-variant.with-alpha(0.38); } }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text { text: r.label; font-size: 16px * Type.scale; color: r.enabled ? Theme.s.on-surface : Theme.s.on-surface-variant; overflow: elide; }
                    if r.shown: Text { text: "显示在仪表盘"; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; overflow: elide; }
                }
                VerticalLayout { alignment: center; Switch { checked: r.enabled; opacity: r.locked ? 0.38 : 1; } }
            }
            if !parent.lifted && i < root.rows.length - 1: Rectangle {
                x: 64px;
                y: parent.height - 1px;
                width: parent.width - 64px;
                height: 1px;
                background: Theme.s.outline-variant.with-alpha(0.6);
            }
        }
        sm-ta := TouchArea {
            changed pressed => {
                if (self.pressed) {
                    root.fired = false;
                } else if (root.drag-from == i) {
                    let from = root.drag-from;
                    let to = root.drag-to;
                    root.drag-from = -1;
                    root.shift = 0px;
                    if (from != to) { root.moved(from, to); }
                }
            }
            clicked => {
                if (!root.fired && !r.locked) { root.toggled(r.id, !r.enabled); }
            }
            moved => {
                if (root.drag-from == i) { root.shift = self.mouse-y - root.press-y; }
            }
        }
        Timer {
            interval: 400ms;
            running: sm-ta.pressed && root.drag-from < 0 && !root.fired;
            triggered => {
                root.fired = true;
                root.press-y = sm-ta.mouse-y;
                root.shift = 0px;
                root.drag-from = i;
            }
        }
    }
}

// A row of a popup menu (FlClash's PopupMenuItem).
// A row in a popup menu (`PopupMenuItem`): glyph, label, the current value with a chevron
// for an item with options, or a check.
component PopupRow inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <string> value;
    in property <bool> more;
    in property <bool> checked;
    in property <bool> danger;
    // A sub item shown under its parent, indented.
    in property <bool> indent;
    in property <bool> enabled: true;
    callback clicked();
    height: 44px;
    opacity: root.enabled ? 1 : 0.38;
    background: pr-ta.pressed ? Theme.s.inset : transparent;
    HorizontalLayout {
        padding-left: root.indent ? 30px : 14px;
        padding-right: 12px;
        spacing: 12px;
        if root.glyph != "": VerticalLayout { alignment: center; Icon { glyph: root.glyph; size: 18px; tint: root.danger ? Theme.s.error : Theme.s.on-surface-variant; } }
        Text { text: root.label; font-size: 15px * Type.scale; color: root.danger ? Theme.s.error : Theme.s.on-surface; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        if root.value != "": Text { text: root.value; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; }
        if root.more: VerticalLayout { alignment: center; Icon { glyph: Icons.chevron; size: 16px; tint: Theme.s.on-surface-variant; } }
        if root.checked: VerticalLayout { alignment: center; Icon { glyph: Icons.check; size: 18px; tint: Theme.s.primary; } }
    }
    pr-ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

// A centered dialog card over a scrim.
component Dialog inherits Rectangle {
    in property <string> title;
    in property <length> keyboard;
    in property <length> top;
    in property <bool> dismissable: true;
    callback dismiss();
    background: #00000066;
    TouchArea { clicked => { if (root.dismissable) { root.dismiss(); } } }
    Rectangle {
        x: 24px;
        width: parent.width - 48px;
        height: body.preferred-height;
        y: max(root.top + 24px, (parent.height - root.keyboard - self.height) / 2);
        background: Theme.s.card;
        border-radius: 24px;
        TouchArea { }
        body := VerticalLayout {
            padding: 24px;
            padding-bottom: 16px;
            spacing: 16px;
            if root.title != "": Text { text: root.title; font-size: 22px * Type.scale; color: Theme.s.on-surface; wrap: word-wrap; }
            @children
        }
    }
}

// ---------------------------------------------------------------- Tools

component SetRowView inherits Rectangle {
    in property <SetRow> item;
    in property <bool> divider;
    // A long press sends `long:<id>` (starts selecting, as FlClash's lists do).
    in property <bool> long-press;
    property <bool> long-fired;
    callback clicked(string);
    callback toggled(string, bool);
    property <bool> pictured: root.item.image != "";
    property <bool> eye: root.item.kind == "value" && (root.item.glyph == "eye" || root.item.glyph == "eye-off");
    property <bool> leading: !root.pictured && root.item.glyph != "" && root.item.kind != "value" && root.item.kind != "check";
    // `_buildExit`: the subtitle keeps every line, so the row grows with them.
    property <bool> exit: root.item.kind == "exit";
    // A row follows the text size down to a 44 tap target as it follows it up (FlClash: lib/ui/list_item.dart);
    // a 16 title adds about 19 a line, a 13 subtitle about 16.
    height: root.exit ? max(64px, row-lay.preferred-height) : max(44px, root.item.subtitle != "" ? 64px + 35px * (Type.scale - 1) : 52px + 19px * (Type.scale - 1));
    background: ta.pressed && root.item.kind != "person" ? Theme.s.inset : transparent;
    opacity: root.item.enabled ? 1 : 0.45;
    row-lay := HorizontalLayout {
        padding-left: root.item.lead != "" ? 52px : 16px;
        padding-right: 16px;
        padding-top: root.exit ? 10px : 0px;
        padding-bottom: root.exit ? 10px : 0px;
        spacing: 14px;
        if root.item.kind == "check": VerticalLayout {
            alignment: center;
            width: 24px;
            if root.item.on: Icon { glyph: Icons.check; size: 20px; tint: Theme.s.primary; }
        }
        if root.pictured: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                if NetImages.has(root.item.image, NetImages.rev): Image {
                    width: 32px;
                    height: 32px;
                    image-fit: contain;
                    source: NetImages.image(root.item.image, NetImages.rev);
                }
            }
        }
        if root.leading && root.item.kind == "person": VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: Theme.s.primary-container;
                Text { text: root.item.glyph; font-size: 16px * Type.scale; font-weight: 600; color: Theme.s.on-primary-container; }
            }
        }
        if root.leading && root.item.kind == "link": VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                background: Theme.s.block;
                Icon { glyph: Glyphs.of(root.item.glyph); size: 20px; tint: Theme.s.on-surface-variant; }
            }
        }
        if root.leading && root.item.kind != "person" && root.item.kind != "link": VerticalLayout {
            alignment: center;
            Icon { glyph: Glyphs.of(root.item.glyph); tint: Theme.s.on-surface-variant; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 6px;
                if root.item.kind != "host": Text { text: root.item.title; font-size: 16px * Type.scale; color: root.item.kind == "danger" ? Theme.s.error : root.item.lead == "add" ? Theme.s.primary : Theme.s.on-surface; overflow: elide; horizontal-stretch: root.item.chip == "" ? 1 : 0; }
                // A MITM host (`MitmHostRowItem`), in the monospaced face.
                if root.item.kind == "host": Text { text: root.item.title; font-size: 16px * Type.scale; font-family: "monospace"; color: Theme.s.on-surface; overflow: elide; horizontal-stretch: 1; }
                if root.item.chip != "": VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            width: chip-text.preferred-width + 12px;
                            height: chip-text.preferred-height + 4px;
                            border-radius: self.height / 2;
                            background: Theme.s.block;
                            chip-text := Text { text: root.item.chip; font-size: 11px * Type.scale; color: Theme.s.on-surface-variant; }
                        }
                    }
                }
            }
            if root.item.subtitle != "" && !root.exit: Text { text: root.item.subtitle; font-size: 13px * Type.scale; color: root.item.invalid && (root.item.kind == "line" || root.item.kind == "host") ? Theme.s.error : Theme.s.on-surface-variant; overflow: elide; }
            if root.item.subtitle != "" && root.exit: Text { text: root.item.subtitle; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; wrap: word-wrap; }
        }
        if root.item.trailing != "" && !root.exit: Text { text: root.item.trailing; font-size: 13px * Type.scale; color: root.item.kind == "host" ? Theme.warning : Theme.s.on-surface-variant; vertical-alignment: center; }
        // The target in monospace, red once it names nothing the profile has.
        if root.exit: Text { text: root.item.trailing; font-size: 15px * Type.scale; font-family: "monospace"; color: root.item.invalid ? Theme.s.error : Theme.s.tertiary; vertical-alignment: center; }
        if root.item.invalid && !root.exit && root.item.kind != "issue": VerticalLayout {
            alignment: center;
            Icon { glyph: Icons.error; size: 20px; tint: Theme.s.error; }
        }
        // `CustomIssueButton`: the row's issues in an alert, sent as `issue:<id>`.
        if root.item.invalid && root.item.kind == "issue": VerticalLayout {
            alignment: center;
            IconButton { glyph: Icons.info; tint: Theme.s.error; clicked => { root.clicked("issue:" + root.item.id); } }
        }
        if root.item.kind == "toggle": VerticalLayout {
            alignment: center;
            Switch { checked: root.item.on; toggled(on) => { root.toggled(root.item.id, on); } }
        }
        if root.item.kind == "open" || root.item.kind == "value-icon": VerticalLayout {
            alignment: center;
            Icon { glyph: Icons.chevron; size: 20px; tint: Theme.s.on-surface-variant; }
        }
        // A row that opens its page beside a switch of its own (`_MitmModuleRow`), or its spinner.
        if root.item.kind == "switch": VerticalLayout {
            alignment: center;
            Switch { checked: root.item.on; toggled(on) => { root.toggled(root.item.id, on); } }
        }
        if root.item.kind == "busy": VerticalLayout {
            alignment: center;
            Spinner { width: 24px; height: 24px; indeterminate: true; }
        }
        if root.item.kind == "link": VerticalLayout {
            alignment: center;
            Icon { glyph: Icons.external; size: 20px; tint: Theme.s.on-surface-variant; }
        }
        if (root.item.kind == "check" && root.item.glyph == "edit") || root.eye: Rectangle { width: 40px; }
        // `Checkbox(isCircle: true)` at the row's end.
        if root.item.kind == "select": VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 11px;
                border-width: root.item.on ? 0px : 2px;
                border-color: Theme.s.on-surface-variant;
                background: root.item.on ? Theme.s.primary : transparent;
                if root.item.on: Icon { glyph: Icons.check; size: 16px; tint: Theme.s.on-primary; }
            }
        }
    }
    if root.divider: Rectangle {
        x: root.item.lead != "" ? 52px : root.pictured ? 62px : root.leading ? 54px : 16px;
        y: parent.height - 1px;
        width: parent.width - self.x;
        height: 1px;
        background: Theme.s.outline-variant.with-alpha(0.6);
    }
    if root.eye: IconButton {
        x: parent.width - self.width - 8px;
        y: (parent.height - self.height) / 2;
        glyph: root.item.glyph == "eye" ? Icons.eye : Icons.eye-off;
        tint: Theme.s.on-surface-variant;
        clicked => { root.clicked("reveal:" + root.item.id); }
    }
    if root.item.kind == "check" && root.item.glyph == "edit": IconButton {
        x: parent.width - self.width - 8px;
        y: (parent.height - self.height) / 2;
        glyph: Icons.edit;
        tint: Theme.s.on-surface-variant;
        clicked => { root.clicked("edit:" + root.item.id); }
    }
    ta := TouchArea {
        width: (root.item.kind == "check" && root.item.glyph == "edit") || root.eye || (root.item.kind == "issue" && root.item.invalid) ? parent.width - 56px : root.item.kind == "switch" ? parent.width - 84px : root.item.kind == "select" ? parent.width - 52px : parent.width - self.x;
        x: root.item.lead == "remove" ? 48px : 0;
        enabled: root.item.enabled && root.item.kind != "person";
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.long-fired = false; }
        }
        clicked => {
            if (root.long-fired) { return; }
            if (root.item.kind == "toggle") {
                root.toggled(root.item.id, !root.item.on);
            } else {
                root.clicked(root.item.id);
            }
        }
    }
    if root.item.kind == "select": TouchArea {
        x: parent.width - 52px;
        width: 52px;
        clicked => { root.clicked("select:" + root.item.id); }
    }
    Timer {
        interval: 500ms;
        running: root.long-press && ta.pressed && !root.long-fired;
        triggered => {
            root.long-fired = true;
            Anchor.x = root.absolute-position.x;
            Anchor.y = root.absolute-position.y;
            Anchor.w = root.width;
            Anchor.h = root.height;
            root.clicked("long:" + root.item.id);
        }
    }
    if root.item.lead == "remove": Rectangle {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: rta.pressed ? Theme.s.error.with-alpha(0.12) : transparent;
        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: Theme.s.error;
            Rectangle { width: 10px; height: 2px; border-radius: 1px; background: #ffffff; }
        }
        rta := TouchArea { clicked => { root.clicked("remove:" + root.item.id); } }
    }
    if root.item.lead == "add": Rectangle {
        x: 18px;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: Theme.s.primary;
        Rectangle { width: 10px; height: 2px; border-radius: 1px; background: #ffffff; }
        Rectangle { width: 2px; height: 10px; border-radius: 1px; background: #ffffff; }
    }
}

// `generateSection`s one under the other.
component Sections inherits VerticalLayout {
    in property <[SetSection]> sections;
    in property <bool> long-press;
    callback clicked(string);
    callback toggled(string, bool);
    padding-left: 16px;
    padding-right: 16px;
    spacing: 4px;
    for sec in root.sections: VerticalLayout {
        if sec.rows.length > 0 && sec.title != "": HorizontalLayout {
            padding-left: 14px;
            Text { text: sec.title; height: 36px; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; }
        }
        if sec.rows.length > 0 && sec.title == "": Rectangle { height: 8px; }
        if sec.rows.length > 0: Rectangle {
            background: Theme.s.card;
            border-radius: 16px;
            clip: true;
            VerticalLayout {
                for r[i] in sec.rows: SetRowView {
                    item: r;
                    long-press: root.long-press;
                    divider: i < sec.rows.length - 1;
                    clicked(id) => { root.clicked(id); }
                    toggled(id, on) => { root.toggled(id, on); }
                }
            }
        }
        if sec.footer != "" && (sec.rows.length > 0 || sec.title == ""): HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 6px;
            Text { text: sec.footer; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; wrap: word-wrap; }
        }
    }
}


// `_buildAuthorizeButton`: filled once authorized, error-toned until then, as wide as the
// longer of its two labels.
component AuthorizeButton inherits Rectangle {
    in property <bool> authorized;
    callback clicked();
    height: 40px;
    width: max(80px, ab-sizer.preferred-width * 1.1 + 24px);
    border-radius: 20px;
    background: root.authorized ? (ab-ta.pressed ? Theme.s.primary.darker(0.1) : Theme.s.primary) : (ab-ta.pressed ? Theme.s.error.with-alpha(0.22) : Theme.s.error.with-alpha(0.14));
    ab-sizer := Text { text: "点击授权"; font-size: 14px * Type.scale; opacity: 0; }
    Text {
        text: root.authorized ? "已授权" : "点击授权";
        font-size: 14px * Type.scale;
        font-weight: 600;
        color: root.authorized ? Theme.s.on-primary : Theme.s.error;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ab-ta := TouchArea { clicked => { root.clicked(); } }
}

// `OnDemandView` below the bar: the prerequisites, then the excluded SSIDs with their
// header actions, each row with its circle checkbox; a long press lifts a row to drag it.
component OnDemandBody inherits VerticalLayout {
    // 0 while asking, 1 not exempt, 2 exempt.
    in property <int> battery;
    in property <bool> location;
    in property <[string]> ssids;
    in property <[bool]> selected;
    out property <bool> dragging: root.drag-from >= 0;
    callback clicked(string);
    in property <bool> selecting;
    property <length> row-h: 52px;
    property <int> drag-from: -1;
    property <length> press-y;
    property <length> shift;
    property <bool> fired;
    property <int> drag-to: root.drag-from < 0 ? -1 : max(0, min(root.ssids.length - 1, root.drag-from + round(root.shift / root.row-h)));
    padding-left: 16px;
    padding-right: 16px;
    spacing: 0px;
    HorizontalLayout {
        padding-left: 14px;
        Text { text: "前置条件"; height: 36px; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; }
    }
    Rectangle {
        background: Theme.s.card;
        border-radius: 16px;
        VerticalLayout {
            for p[i] in [{ id: "battery", title: "忽略电池优化" }, { id: "location", title: "位置权限" }]: Rectangle {
                height: 56px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 12px;
                    Text { text: p.title; font-size: 16px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    VerticalLayout {
                        alignment: center;
                        if p.id == "battery" && root.battery == 0: HorizontalLayout { alignment: end; width: 80px; Spinner { width: 24px; height: 24px; indeterminate: true; } }
                        if p.id != "battery" || root.battery != 0: AuthorizeButton {
                            authorized: p.id == "battery" ? root.battery == 2 : root.location;
                            clicked => { root.clicked(p.id); }
                        }
                    }
                }
                if i == 0: Rectangle {
                    x: 16px;
                    y: parent.height - 1px;
                    width: parent.width - 16px;
                    height: 1px;
                    background: Theme.s.outline-variant.with-alpha(0.6);
                }
            }
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 6px;
        Text { text: "根据系统要求，获取Wi-Fi名称需要您授予位置权限。Android 上请选择“始终允许”，否则应用在后台时无法获取 Wi-Fi 名称。"; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; wrap: word-wrap; }
    }
    Rectangle { height: 12px; }
    HorizontalLayout {
        padding-left: 14px;
        height: 40px;
        Text { text: "排除SSIDs"; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; horizontal-stretch: 1; }
        if root.selecting: IconButton { glyph: Icons.delete; tint: Theme.s.on-surface; clicked => { root.clicked("delete"); } }
        if root.selecting: IconButton { glyph: Icons.select-all; tint: Theme.s.on-surface; clicked => { root.clicked("select-all"); } }
        if !root.selecting: IconButton { glyph: Icons.add-circle; tint: Theme.s.on-surface; clicked => { root.clicked("add"); } }
    }
    if root.ssids.length == 0: VerticalLayout {
        padding-top: 48px;
        padding-bottom: 48px;
        spacing: 12px;
        HorizontalLayout { alignment: center; Icon { glyph: Icons.wifi; size: 48px; tint: Theme.s.on-surface-variant.with-alpha(0.6); } }
        Text { text: "SSIDs为空"; font-size: 16px * Type.scale; font-weight: 600; color: Theme.s.on-surface; horizontal-alignment: center; }
    }
    if root.ssids.length > 0: Rectangle {
        height: root.ssids.length * root.row-h;
        z: root.dragging ? 1 : 0;
        Rectangle { background: Theme.s.card; border-radius: 16px; }
        for t[i] in root.ssids: Rectangle {
            property <bool> lifted: i == root.drag-from;
            property <bool> on: i < root.selected.length && root.selected[i];
            y: root.drag-from < 0 || self.lifted ? i * root.row-h
                : i > root.drag-from && i <= root.drag-to ? (i - 1) * root.row-h
                : i < root.drag-from && i >= root.drag-to ? (i + 1) * root.row-h
                : i * root.row-h;
            z: self.lifted ? 1 : 0;
            height: root.row-h;
            animate y { duration: 150ms; easing: ease-out; }
            Rectangle {
                y: parent.lifted ? root.shift : 0px;
                background: parent.lifted ? Theme.s.card : od-ta.pressed ? Theme.s.inset : transparent;
                border-radius: parent.lifted || i == 0 || i == root.ssids.length - 1 ? 16px : 0px;
                drop-shadow-offset-y: parent.lifted ? 6px : 0px;
                drop-shadow-blur: parent.lifted ? 16px : 0px;
                drop-shadow-color: parent.lifted ? #00000033 : transparent;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 10px;
                    spacing: 8px;
                    Text { text: t; font-size: 16px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    Rectangle { width: 36px; }
                }
                if !parent.lifted && i < root.ssids.length - 1: Rectangle {
                    x: 16px;
                    y: parent.height - 1px;
                    width: parent.width - 16px;
                    height: 1px;
                    background: Theme.s.outline-variant.with-alpha(0.6);
                }
            }
            od-ta := TouchArea {
                width: parent.width - 52px;
                x: 0;
                changed pressed => {
                    if (self.pressed) {
                        root.fired = false;
                    } else if (root.drag-from == i) {
                        let from = root.drag-from;
                        let to = root.drag-to;
                        root.drag-from = -1;
                        root.shift = 0px;
                        if (from != to) { root.clicked("move:" + from + ":" + to); }
                    }
                }
                clicked => {
                    if (root.fired) { return; }
                    root.clicked((root.selecting ? "select:" : "edit:") + i);
                }
                moved => {
                    if (root.drag-from == i) { root.shift = self.mouse-y - root.press-y; }
                }
            }
            Timer {
                interval: 400ms;
                running: od-ta.pressed && root.drag-from < 0 && !root.fired;
                triggered => {
                    root.fired = true;
                    root.press-y = od-ta.mouse-y;
                    root.shift = 0px;
                    root.drag-from = i;
                }
            }
            // `Checkbox(isCircle: true)` at the row's end.
            Rectangle {
                x: parent.width - 52px;
                width: 52px;
                y: parent.lifted ? root.shift : 0px;
                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 11px;
                    border-width: (i < root.selected.length && root.selected[i]) ? 0px : 2px;
                    border-color: Theme.s.on-surface-variant;
                    background: (i < root.selected.length && root.selected[i]) ? Theme.s.primary : transparent;
                    if (i < root.selected.length && root.selected[i]): Icon { glyph: Icons.check; size: 16px; tint: Theme.s.on-primary; }
                }
                TouchArea { clicked => { root.clicked("select:" + i); } }
            }
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 6px;
        Text { text: "连接到被排除 SSID 的 Wi-Fi 时，将会自动切换应用运行状态。"; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; wrap: word-wrap; }
    }
}

// `AppBarSearchState`'s field in place of the bar, back clearing and closing it.
component SearchBar inherits HorizontalLayout {
    in-out property <string> query;
    callback close();
    height: 56px;
    padding-left: 4px;
    padding-right: 16px;
    spacing: 4px;
    VerticalLayout {
        alignment: center;
        IconButton { glyph: Icons.back; tint: Theme.s.on-surface; clicked => { root.close(); } }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Rectangle {
            height: 44px;
            border-radius: 22px;
            background: Theme.s.block;
            Text {
                x: 16px;
                visible: is-input.text == "";
                text: "搜索";
                color: Theme.s.on-surface-variant;
                font-size: 15px * Type.scale;
                vertical-alignment: center;
                height: parent.height;
            }
            is-input := TextInput {
                x: 16px;
                width: parent.width - 32px;
                height: parent.height;
                vertical-alignment: center;
                single-line: true;
                font-size: 15px * Type.scale;
                color: Theme.s.on-surface;
                text <=> root.query;
                init => { self.focus(); }
            }
        }
    }
}

// A settings page: the bar, anything given as children, then the sections.
component SettingsPage inherits Rectangle {
    in property <string> title;
    in property <bool> can-back: true;
    in property <[SetSection]> sections;
    in property <length> bottom-gap: 24px;
    in property <string> action-glyph;
    in property <string> action2-glyph;
    in property <bool> long-press;
    // `NullStatus` in place of the list while there are no sections, when given.
    in property <string> empty;
    in property <string> empty-desc;
    in property <string> empty-action;
    in property <bool> action-empty;
    in property <bool> selecting;
    property <bool> is-empty: root.empty != "" && root.sections.length == 0;
    // The Scaffold's sort mode: the rows below as a reorderable list, ✓ to leave.
    in property <bool> sorting;
    in property <[string]> sort-titles;
    // A child dragging a row holds the page still.
    in property <bool> locked;
    in property <bool> searchable;
    in-out property <bool> searching;
    in-out property <string> query;
    callback search(string);
    changed query => { root.search(root.query); }
    callback sort-moved(int, int);
    callback sort-done();
    callback back();
    callback action();
    callback action2();
    callback clicked(string);
    callback toggled(string, bool);
    VerticalLayout {
        if root.searchable && root.searching && !root.sorting: SearchBar {
            query <=> root.query;
            close => { root.query = ""; root.searching = false; }
        }
        if !(root.searchable && root.searching && !root.sorting): AppBar {
            title: root.title;
            can-back: root.can-back;
            back => { root.back(); }
            if !root.sorting && root.searchable && !root.is-empty: VerticalLayout { alignment: center; IconButton { glyph: Icons.search; tint: Theme.s.on-surface; clicked => { root.searching = true; } } }
            if root.sorting: VerticalLayout { alignment: center; IconButton { glyph: Icons.check; tint: Theme.s.on-surface; clicked => { root.sort-done(); } } }
            if root.selecting: VerticalLayout { alignment: center; IconButton { glyph: Icons.delete; tint: Theme.s.on-surface; clicked => { root.clicked("sel-delete"); } } }
            if root.selecting: VerticalLayout { alignment: center; IconButton { glyph: Icons.select-all; tint: Theme.s.on-surface; clicked => { root.clicked("sel-all"); } } }
            if !root.sorting && !root.selecting && root.action2-glyph != "": VerticalLayout { alignment: center; IconButton { glyph: root.action2-glyph; tint: Theme.s.on-surface; clicked => { root.action2(); } } }
            if !root.sorting && !root.selecting && root.action-glyph != "" && (!root.is-empty || root.action-empty): VerticalLayout {
                alignment: center;
                IconButton {
                    glyph: root.action-glyph;
                    tint: Theme.s.on-surface;
                    clicked => {
                        Anchor.x = self.absolute-position.x;
                        Anchor.y = self.absolute-position.y;
                        Anchor.w = self.width;
                        Anchor.h = self.height;
                        root.action();
                    }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            Flickable {
                visible: !root.is-empty && !root.sorting;
                interactive: !root.locked;
                content-height: page-col.preferred-height + Dock.pad;
                page-col := VerticalLayout {
                    alignment: start;
                    padding-bottom: root.bottom-gap;
                    @children
                    Sections {
                        sections: root.sections;
                        long-press: root.long-press;
                        clicked(id) => { root.clicked(id); }
                        toggled(id, on) => { root.toggled(id, on); }
                    }
                }
            }
            if root.sorting: Flickable {
                interactive: !sort-list.dragging;
                content-height: sort-col.preferred-height + Dock.pad;
                sort-col := VerticalLayout {
                    alignment: start;
                    padding: 16px;
                    padding-bottom: root.bottom-gap;
                    sort-list := ReorderList {
                        titles: root.sort-titles;
                        moved(f, t) => { root.sort-moved(f, t); }
                    }
                }
            }
        }
    }
    if root.is-empty: NullStatus {
        y: 56px;
        height: parent.height - 56px;
        label: root.empty;
        description: root.empty-desc;
        action: root.empty-action;
        act => {
            if (root.action-empty) {
                root.clicked("empty-action");
            } else {
                root.action();
            }
        }
    }
}

// `_IconSetPreviewView`: the set's icons as `SliverIconGrid` (88 wide at most, 8 apart, a
// 56px plate holding the 40px icon over its label), searchable by label. Only the rows near
// the view ask for their pictures.
component IconSetPage inherits Rectangle {
    in property <string> title;
    in property <[IconTile]> tiles;
    in property <string> empty;
    in-out property <bool> searching;
    in-out property <string> query;
    callback back();
    callback search(string);
    changed query => { root.search(root.query); }
    property <length> gap: 8px;
    property <int> columns: max(1, ceil((root.width - 32px + root.gap) / (88px + root.gap)));
    property <length> cell-w: (root.width - 32px - (root.columns - 1) * root.gap) / root.columns;
    property <length> label-h: 16px * Type.scale;
    property <length> cell-h: 56px + 6px + root.label-h;
    property <int> rows: ceil(root.tiles.length / root.columns);
    VerticalLayout {
        if !root.searching: AppBar {
            title: root.title;
            can-back: true;
            back => { root.back(); }
            VerticalLayout { alignment: center; IconButton { glyph: Icons.search; tint: Theme.s.on-surface; clicked => { root.searching = true; } } }
        }
        if root.searching: SearchBar {
            query <=> root.query;
            close => { root.query = ""; root.searching = false; }
        }
        Rectangle {
            vertical-stretch: 1;
            if root.tiles.length == 0: NullStatus { label: root.empty; }
            grid := Flickable {
                visible: root.tiles.length > 0;
                content-height: 8px + max(0px, root.rows * (root.cell-h + root.gap) - root.gap) + 20px + Dock.pad;
                for t[i] in root.tiles: tile := Rectangle {
                    property <int> line: floor(i / root.columns);
                    x: 16px + mod(i, root.columns) * (root.cell-w + root.gap);
                    y: 8px + self.line * (root.cell-h + root.gap);
                    width: root.cell-w;
                    height: root.cell-h;
                    property <bool> near: self.y + self.height >= -grid.content-y - grid.height && self.y <= -grid.content-y + 2 * grid.height;
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: 0;
                        width: 56px;
                        height: 56px;
                        border-radius: 12px;
                        background: tile-ta.pressed ? Theme.s.inset : Theme.s.card;
                        clip: true;
                        if tile.near && NetImages.has(t.url, NetImages.rev): Image {
                            width: 40px;
                            height: 40px;
                            image-fit: contain;
                            source: NetImages.image(t.url, NetImages.rev);
                        }
                        tile-ta := TouchArea { }
                    }
                    Text {
                        y: 62px;
                        width: parent.width;
                        height: root.label-h;
                        text: t.label;
                        font-size: 12px * Type.scale;
                        color: Theme.s.on-surface-variant;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

// `ProxyGroupMembersSliver`: each member with its remove button, kind chip, issue mark and
// handle, then the add row. A 400ms hold lifts a row; it follows the finger, the others
// slide aside, and the order changes on release.
component MemberList inherits VerticalLayout {
    in property <string> title;
    in property <string> add-label;
    in property <[MemberItem]> items;
    out property <bool> dragging: root.drag-from >= 0;
    callback clicked(string);
    property <length> row-h: 60px;
    property <length> add-h: 52px;
    property <int> drag-from: -1;
    property <length> press-y;
    property <length> shift;
    property <int> drag-to: root.drag-from < 0 ? -1 : max(0, min(root.items.length - 1, root.drag-from + round(root.shift / root.row-h)));
    HorizontalLayout {
        padding-left: 14px;
        Text { text: root.title; height: 36px; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; }
    }
    Rectangle {
        height: root.items.length * root.row-h + root.add-h;
        background: Theme.s.card;
        border-radius: 16px;
        for it[i] in root.items: Rectangle {
            property <bool> lifted: i == root.drag-from;
            y: root.drag-from < 0 || self.lifted ? i * root.row-h
                : i > root.drag-from && i <= root.drag-to ? (i - 1) * root.row-h
                : i < root.drag-from && i >= root.drag-to ? (i + 1) * root.row-h
                : i * root.row-h;
            z: self.lifted ? 1 : 0;
            height: root.row-h;
            animate y { duration: 150ms; easing: ease-out; }
            Rectangle {
                y: parent.lifted ? root.shift : 0px;
                background: parent.lifted ? Theme.s.card : ml-ta.pressed ? Theme.s.inset : transparent;
                border-radius: parent.lifted ? 16px : 0px;
                drop-shadow-offset-y: parent.lifted ? 6px : 0px;
                drop-shadow-blur: parent.lifted ? 16px : 0px;
                drop-shadow-color: parent.lifted ? #00000033 : transparent;
                HorizontalLayout {
                    padding-left: 52px;
                    padding-right: 12px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text { text: it.title; font-size: 16px * Type.scale; color: Theme.s.on-surface; overflow: elide; }
                        if it.chip != "": HorizontalLayout {
                            alignment: start;
                            Rectangle {
                                property <color> fg: it.tone == 2 ? Theme.s.error : it.tone == 1 ? Theme.s.primary : Theme.s.on-surface-variant;
                                width: min(mc-text.preferred-width + 16px, root.width - 140px);
                                height: mc-text.preferred-height + 4px;
                                border-radius: self.height / 2;
                                background: it.tone == 0 ? Theme.s.block : self.fg.with-alpha(0.14);
                                mc-text := Text { x: 8px; width: parent.width - 16px; text: it.chip; font-size: 11px * Type.scale; color: parent.fg; overflow: elide; }
                            }
                        }
                    }
                    if it.invalid: Rectangle { width: 32px; }
                    VerticalLayout { alignment: center; Icon { glyph: "M5 9h14 M5 15h14"; size: 20px; tint: Theme.s.on-surface-variant; } }
                }
                if !parent.lifted: Rectangle {
                    x: 52px;
                    y: parent.height - 1px;
                    width: parent.width - 52px;
                    height: 1px;
                    background: Theme.s.outline-variant.with-alpha(0.6);
                }
                ml-ta := TouchArea {
                    x: 48px;
                    width: parent.width - 48px;
                    changed pressed => {
                        if (!self.pressed && root.drag-from == i) {
                            let from = root.drag-from;
                            let to = root.drag-to;
                            root.drag-from = -1;
                            root.shift = 0px;
                            if (from != to) { root.clicked("move:" + from + ":" + to); }
                        }
                    }
                    moved => {
                        if (root.drag-from == i) { root.shift = self.mouse-y - root.press-y; }
                    }
                }
                Timer {
                    interval: 400ms;
                    running: ml-ta.pressed && root.drag-from < 0;
                    triggered => {
                        root.press-y = ml-ta.mouse-y;
                        root.shift = 0px;
                        root.drag-from = i;
                    }
                }
                Rectangle {
                    x: 12px;
                    y: (parent.height - self.height) / 2;
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    background: mr-ta.pressed ? Theme.s.error.with-alpha(0.12) : transparent;
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        background: Theme.s.error;
                        Rectangle { width: 10px; height: 2px; border-radius: 1px; background: #ffffff; }
                    }
                    mr-ta := TouchArea { enabled: root.drag-from < 0; clicked => { root.clicked("remove:" + i); } }
                }
                if it.invalid: IconButton {
                    x: parent.width - 44px - self.width;
                    y: (parent.height - self.height) / 2;
                    glyph: Icons.error;
                    tint: Theme.s.error;
                    clicked => { root.clicked("info:" + i); }
                }
            }
        }
        Rectangle {
            y: root.items.length * root.row-h;
            height: root.add-h;
            background: ma-ta.pressed ? Theme.s.inset : transparent;
            border-radius: root.items.length == 0 ? 16px : 0px;
            Rectangle {
                x: 18px;
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: Theme.s.primary;
                Rectangle { width: 10px; height: 2px; border-radius: 1px; background: #ffffff; }
                Rectangle { width: 2px; height: 10px; border-radius: 1px; background: #ffffff; }
            }
            Text { x: 52px; width: parent.width - 68px; height: parent.height; text: root.add-label; font-size: 16px * Type.scale; color: Theme.s.primary; vertical-alignment: center; overflow: elide; }
            ma-ta := TouchArea { enabled: root.drag-from < 0; clicked => { root.clicked("add"); } }
        }
    }
}

// `EditProxyGroupView`: 常规, the members, then 选项 and 操作, under the issue banner.
component EditProxyGroupPage inherits Rectangle {
    in property <string> title;
    in property <string> issue;
    // A proxy provider's options: the members are its filters, and there is no quick edit.
    in property <bool> provider;
    in property <[SetSection]> head;
    in property <[MemberItem]> members;
    in property <[SetSection]> tail;
    callback back();
    callback clicked(string);
    callback toggled(string, bool);
    callback member(string);
    VerticalLayout {
        AppBar {
            title: root.title;
            can-back: true;
            back => { root.back(); }
            if !root.provider: VerticalLayout { alignment: center; IconButton { glyph: Icons.compose; tint: Theme.s.on-surface; clicked => { root.clicked("action2"); } } }
            VerticalLayout { alignment: center; IconButton { glyph: Icons.check; tint: Theme.s.on-surface; clicked => { root.clicked("action"); } } }
        }
        Flickable {
            vertical-stretch: 1;
            interactive: !members.dragging;
            content-height: pg-col.preferred-height + Dock.pad;
            pg-col := VerticalLayout {
                alignment: start;
                padding-bottom: 24px;
                spacing: 4px;
                if root.issue != "": HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 8px;
                    Rectangle {
                        border-radius: 16px;
                        background: Theme.s.error.with-alpha(0.12);
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 12px;
                            VerticalLayout { alignment: start; Icon { glyph: Icons.error; size: 20px; tint: Theme.s.error; } }
                            Text { text: root.issue; font-size: 14px * Type.scale; color: Theme.s.error; wrap: word-wrap; horizontal-stretch: 1; }
                        }
                    }
                }
                Sections {
                    sections: root.head;
                    clicked(id) => { root.clicked(id); }
                    toggled(id, on) => { root.toggled(id, on); }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    members := MemberList {
                        title: root.provider ? "筛选" : "节点";
                        add-label: root.provider ? "添加筛选" : "添加节点";
                        items: root.members;
                        clicked(a) => {
                            if (a == "add") { root.clicked("pg-members-add"); } else { root.member(a); }
                        }
                    }
                }
                Sections {
                    sections: root.tail;
                    clicked(id) => { root.clicked(id); }
                    toggled(id, on) => { root.toggled(id, on); }
                }
            }
        }
    }
}

// `_MemberPicker`: the categories folded, a tap picks or unpicks an entry (the form takes
// it at once), a search once there are ten entries.
component MemberPickerPage inherits Rectangle {
    in property <string> title: "添加节点";
    in property <[MemberPickSection]> sections;
    in property <bool> searchable;
    in property <string> empty;
    in-out property <bool> searching;
    in-out property <string> query;
    callback back();
    callback pick(string);
    changed query => { root.pick("search:" + root.query); }
    VerticalLayout {
        if !root.searching: AppBar {
            title: root.title;
            can-back: true;
            back => { root.back(); }
            if root.searchable: VerticalLayout { alignment: center; IconButton { glyph: Icons.search; tint: Theme.s.on-surface; clicked => { root.searching = true; } } }
        }
        if root.searching: SearchBar {
            query <=> root.query;
            close => { root.query = ""; root.searching = false; }
        }
        Rectangle {
            vertical-stretch: 1;
            if root.sections.length == 0: NullStatus { label: root.empty; }
            Flickable {
                visible: root.sections.length > 0;
                content-height: mp-col.preferred-height + Dock.pad;
                mp-col := VerticalLayout {
                    alignment: start;
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 8px;
                    padding-bottom: 16px;
                    spacing: 4px;
                    for sec in root.sections: VerticalLayout {
                        Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 8px;
                                spacing: 8px;
                                Text { text: sec.label; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                if sec.collapsible: Text { text: sec.count; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; }
                                if sec.collapsible: VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        Icon { glyph: sec.expanded ? "M6 9l6 6 6-6" : Icons.chevron; size: 20px; tint: Theme.s.on-surface-variant; }
                                    }
                                }
                            }
                            TouchArea { enabled: sec.collapsible; clicked => { root.pick("expand:" + sec.label); } }
                        }
                        if sec.expanded: Rectangle {
                            background: Theme.s.card;
                            border-radius: 16px;
                            clip: true;
                            VerticalLayout {
                                for r[i] in sec.rows: Rectangle {
                                    height: r.subtitle != "" ? 64px : 52px;
                                    background: pr-ta.pressed ? Theme.s.inset : r.selected ? Theme.s.primary.with-alpha(0.08) : transparent;
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 12px;
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            Text { text: r.title; font-size: 16px * Type.scale; color: Theme.s.on-surface; overflow: elide; }
                                            if r.subtitle != "": Text { text: r.subtitle; font-size: 13px * Type.scale; font-family: r.mono ? "monospace" : Type.family; color: r.mono ? Theme.s.primary : Theme.s.on-surface-variant; overflow: elide; }
                                        }
                                        if r.selected: VerticalLayout { alignment: center; Icon { glyph: Icons.check; size: 20px; tint: Theme.s.primary; } }
                                    }
                                    if i < sec.rows.length - 1: Rectangle {
                                        x: 16px;
                                        y: parent.height - 1px;
                                        width: parent.width - 16px;
                                        height: 1px;
                                        background: Theme.s.outline-variant.with-alpha(0.6);
                                    }
                                    pr-ta := TouchArea { clicked => { root.pick("toggle:" + r.id); } }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// `SliverIconGrid` inside a scrolling page: 88 wide at most, 8 apart, the 56px plate over
// its label, the badge on the chosen one. Only tiles within a screen of `view-top` (the
// visible top, in the grid's coordinates) ask for their pictures.
component IconGrid inherits Rectangle {
    in property <[IconTile]> tiles;
    in property <length> view-top;
    in property <length> view-h;
    callback picked(int);
    callback long(int);
    property <length> gap: 8px;
    property <int> columns: max(1, ceil((root.width - 32px + root.gap) / (88px + root.gap)));
    property <length> cell-w: (root.width - 32px - (root.columns - 1) * root.gap) / root.columns;
    property <length> label-h: 16px * Type.scale;
    property <length> cell-h: 56px + 6px + root.label-h;
    height: max(0px, ceil(root.tiles.length / root.columns) * (root.cell-h + root.gap) - root.gap);
    for t[i] in root.tiles: tile := Rectangle {
        property <bool> near: self.y + self.height >= root.view-top - root.view-h && self.y <= root.view-top + 2 * root.view-h;
        property <bool> long-fired;
        x: 16px + mod(i, root.columns) * (root.cell-w + root.gap);
        y: floor(i / root.columns) * (root.cell-h + root.gap);
        width: root.cell-w;
        height: root.cell-h;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 0;
            width: 56px;
            height: 56px;
            border-radius: 12px;
            background: ig-ta.pressed ? Theme.s.inset : Theme.s.card;
            clip: true;
            if tile.near && NetImages.has(t.url, NetImages.rev): Image {
                width: 40px;
                height: 40px;
                image-fit: contain;
                source: NetImages.image(t.url, NetImages.rev);
            }
            if tile.near && !NetImages.has(t.url, NetImages.rev): Icon { glyph: Icons.photos; size: 28px; tint: Theme.s.on-surface-variant.with-alpha(0.5); }
            ig-ta := TouchArea {
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) { tile.long-fired = false; }
                }
                clicked => { if (!tile.long-fired) { root.picked(i); } }
            }
            Timer {
                interval: 500ms;
                running: ig-ta.pressed && !tile.long-fired;
                triggered => { tile.long-fired = true; root.long(i); }
            }
        }
        if t.selected: Rectangle {
            x: (parent.width + 56px) / 2 - 16px;
            y: -4px;
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: Theme.s.primary;
            Icon { glyph: Icons.check; size: 14px; tint: Theme.s.on-primary; }
        }
        Text {
            y: 62px;
            width: parent.width;
            height: root.label-h;
            text: t.label;
            font-size: 12px * Type.scale;
            color: Theme.s.on-surface-variant;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

// `IconPickerView`: the current icon with its remove button, then the sources as chips
// over the chosen one's grid (推荐 first), or the search across them; 🔗 sets an icon by url.
component IconPickerPage inherits Rectangle {
    in property <string> value;
    in property <string> value-title;
    in property <string> value-subtitle;
    in property <[string]> chips;
    in property <int> chip;
    in property <[IconSection]> sections;
    in property <string> empty;
    in-out property <bool> searching;
    in-out property <string> query;
    callback back();
    callback pick(string);
    changed query => { root.pick("search:" + root.query); }
    property <bool> has-current: root.value != "";
    property <bool> pictured: root.has-current && NetImages.has(root.value, NetImages.rev);
    VerticalLayout {
        if !root.searching: AppBar {
            title: "图标";
            can-back: true;
            back => { root.back(); }
            VerticalLayout { alignment: center; IconButton { glyph: Icons.search; tint: Theme.s.on-surface; clicked => { root.searching = true; } } }
            VerticalLayout { alignment: center; IconButton { glyph: Icons.link; tint: Theme.s.on-surface; clicked => { root.pick("link"); } } }
        }
        if root.searching: SearchBar {
            query <=> root.query;
            close => { root.query = ""; root.searching = false; }
        }
        ip-fl := Flickable {
            vertical-stretch: 1;
            content-height: ip-col.preferred-height + Dock.pad;
            ip-col := VerticalLayout {
                alignment: start;
                padding-top: 8px;
                padding-bottom: 20px;
                if root.has-current: HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 16px;
                    Rectangle {
                        background: Theme.s.card;
                        border-radius: 20px;
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    if root.pictured: Image { width: 40px; height: 40px; image-fit: contain; source: NetImages.image(root.value, NetImages.rev); }
                                    if !root.pictured: Icon { glyph: Icons.photos; size: 28px; tint: Theme.s.on-surface-variant.with-alpha(0.5); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text { text: root.value-title; font-size: 16px * Type.scale; color: Theme.s.on-surface; overflow: elide; }
                                if root.value-subtitle != "": Text { text: root.value-subtitle; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; overflow: elide; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 16px;
                                    background: cr-ta.pressed ? Theme.s.error.with-alpha(0.12) : transparent;
                                    Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        border-radius: 10px;
                                        background: Theme.s.error;
                                        Rectangle { width: 10px; height: 2px; border-radius: 1px; background: #ffffff; }
                                    }
                                    cr-ta := TouchArea { clicked => { root.pick("remove"); } }
                                }
                            }
                        }
                    }
                }
                if root.sections.length == 0: Rectangle {
                    height: 320px;
                    NullStatus { label: root.empty; }
                }
                if !root.searching && root.sections.length > 0 && root.chips.length > 0: Flickable {
                    height: 36px;
                    content-width: max(self.width, chip-row.preferred-width);
                    chip-row := HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 8px;
                        alignment: start;
                        for c[i] in root.chips: Rectangle {
                            height: 36px;
                            width: chip-label.preferred-width + 28px;
                            border-radius: 18px;
                            background: i == root.chip ? Theme.s.primary : chip-ta.pressed ? Theme.s.inset : Theme.s.card;
                            chip-label := Text { text: c; font-size: 14px * Type.scale; color: i == root.chip ? Theme.s.on-primary : Theme.s.on-surface; }
                            chip-ta := TouchArea { clicked => { root.pick("source:" + i); } }
                        }
                    }
                }
                if !root.searching && root.sections.length > 0 && root.chips.length > 0: Rectangle { height: 16px; }
                for sec[si] in root.sections: VerticalLayout {
                    if sec.label != "": HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Text { text: sec.label; height: 40px; font-size: 15px * Type.scale; font-weight: 600; color: Theme.s.on-surface; vertical-alignment: center; overflow: elide; }
                    }
                    grid := IconGrid {
                        tiles: sec.tiles;
                        view-top: -ip-fl.content-y - parent.y - self.y;
                        view-h: ip-fl.height;
                        picked(i) => { root.pick("select:" + si + ":" + i); }
                        long(i) => {
                            Anchor.x = self.absolute-position.x;
                            Anchor.y = self.absolute-position.y;
                            root.pick("long:" + si + ":" + i);
                        }
                    }
                    if sec.label != "": Rectangle { height: 8px; }
                }
            }
        }
    }
}

// `RuleItem` in a grouped run: the type's name over the payload, the target in its tone
// with the issue mark, and the circle checkbox. A tap edits, or selects while selecting;
// a long press opens the menu, or with `hold-drags` lifts the row (`ReorderDragStartListener`)
// and reports the finger's window y while it moves.
component RuleRowView inherits Rectangle {
    in property <RuleRow> item;
    in property <bool> first;
    in property <bool> last;
    in property <bool> selecting;
    in property <bool> hold-drags;
    in property <bool> lifted;
    in property <length> lift;
    // The issue mark is a button that sends `info:<id>`.
    in property <bool> info-button;
    callback clicked(string);
    callback hold(length);
    callback drag(length);
    callback drop();
    property <bool> long-fired;
    property <length> top-r: root.first || root.lifted ? 16px : 0px;
    property <length> bottom-r: root.last || root.lifted ? 16px : 0px;
    height: 56px;
    Rectangle {
        x: 16px;
        y: root.lift;
        width: parent.width - 32px;
        background: Theme.s.card;
        border-top-left-radius: root.top-r;
        border-top-right-radius: root.top-r;
        border-bottom-left-radius: root.bottom-r;
        border-bottom-right-radius: root.bottom-r;
        drop-shadow-offset-y: root.lifted ? 6px : 0px;
        drop-shadow-blur: root.lifted ? 16px : 0px;
        drop-shadow-color: root.lifted ? #00000033 : transparent;
        rr-ta := TouchArea {
            x: 0;
            width: parent.width - 50px;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) { root.long-fired = false; }
            }
            clicked => {
                if (root.long-fired) { return; }
                root.clicked((root.selecting ? "select:" : "open:") + root.item.id);
            }
            moved => {
                if (root.lifted) { root.drag(self.absolute-position.y + self.mouse-y); }
            }
            changed pressed => {
                if (!self.pressed && root.lifted) { root.drop(); }
            }
        }
        Rectangle {
            border-top-left-radius: root.top-r;
            border-top-right-radius: root.top-r;
            border-bottom-left-radius: root.bottom-r;
            border-bottom-right-radius: root.bottom-r;
            background: rr-ta.pressed ? Theme.s.inset : root.item.selected ? Theme.s.primary.with-alpha(0.08) : transparent;
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 50px;
            spacing: 16px;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text { text: root.item.name; font-family: "monospace"; font-size: 14px * Type.scale; color: Theme.s.on-surface; overflow: elide; }
                if root.item.content != "": Text { text: root.item.content; font-family: "monospace"; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; overflow: elide; }
            }
            HorizontalLayout {
                horizontal-stretch: 0;
                max-width: root.width * 0.42;
                spacing: 4px;
                if root.item.invalid && !root.info-button: VerticalLayout { alignment: center; Icon { glyph: Icons.error; size: 18px; tint: Theme.s.error; } }
                if root.item.invalid && root.info-button: VerticalLayout {
                    alignment: center;
                    IconButton { glyph: Icons.info; tint: Theme.s.error; clicked => { root.clicked("info:" + root.item.id); } }
                }
                Text {
                    text: root.item.target;
                    font-family: "monospace";
                    font-size: 14px * Type.scale;
                    color: root.item.tone == 1 ? Theme.success : root.item.tone == 2 ? Theme.warning : root.item.tone == 3 ? Theme.s.tertiary : root.item.tone == 4 ? Theme.s.error : Theme.s.on-surface;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        if !root.last && !root.lifted: Rectangle {
            x: 16px;
            y: parent.height - 1px;
            width: parent.width - 16px;
            height: 1px;
            background: Theme.s.outline-variant.with-alpha(0.6);
        }
        Timer {
            interval: 500ms;
            running: (root.hold-drags || !root.selecting) && rr-ta.pressed && !root.long-fired;
            triggered => {
                root.long-fired = true;
                if (root.hold-drags) {
                    root.hold(rr-ta.absolute-position.y + rr-ta.mouse-y);
                    return;
                }
                Anchor.x = root.absolute-position.x + 16px;
                Anchor.y = root.absolute-position.y;
                Anchor.w = root.width - 32px;
                Anchor.h = root.height;
                root.clicked("long:" + root.item.id);
            }
        }
        Rectangle {
            x: parent.width - 50px;
            width: 50px;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 11px;
                border-width: root.item.selected ? 0px : 2px;
                border-color: Theme.s.on-surface-variant;
                background: root.item.selected ? Theme.s.primary : transparent;
                if root.item.selected: Icon { glyph: Icons.check; size: 16px; tint: Theme.s.on-primary; }
            }
            TouchArea { clicked => { root.clicked("select:" + root.item.id); } }
        }
    }
}

// `AddedRulesSection`'s `SliverPrismReorderableList`: the rows lift after a hold, the others
// slide aside as the lifted one passes their middle, and the order lands on release as
// `move:<from>:<to>`.
component AddedRuleList inherits Rectangle {
    in property <[RuleRow]> rows;
    in property <bool> selecting;
    out property <bool> dragging: root.drag-from >= 0;
    callback clicked(string);
    property <length> row-h: 56px;
    property <int> drag-from: -1;
    property <length> press-y;
    property <length> shift;
    property <int> drag-to: root.drag-from < 0 ? -1 : max(0, min(root.rows.length - 1, root.drag-from + round(root.shift / root.row-h)));
    height: root.rows.length * root.row-h;
    for r[i] in root.rows: RuleRowView {
        y: root.drag-from < 0 || i == root.drag-from ? i * root.row-h
            : i > root.drag-from && i <= root.drag-to ? (i - 1) * root.row-h
            : i < root.drag-from && i >= root.drag-to ? (i + 1) * root.row-h
            : i * root.row-h;
        z: i == root.drag-from ? 1 : 0;
        animate y { duration: 150ms; easing: ease-out; }
        item: r;
        first: i == 0;
        last: i == root.rows.length - 1;
        selecting: root.selecting;
        hold-drags: true;
        info-button: true;
        lifted: i == root.drag-from;
        lift: i == root.drag-from ? root.shift : 0px;
        clicked(a) => { root.clicked(a); }
        hold(y) => {
            root.press-y = y;
            root.shift = 0px;
            root.drag-from = i;
        }
        drag(y) => {
            if (root.drag-from == i) { root.shift = y - root.press-y; }
        }
        drop => {
            if (root.drag-from != i) { return; }
            let from = root.drag-from;
            let to = root.drag-to;
            root.drag-from = -1;
            root.shift = 0px;
            if (from != to) { root.clicked("move:" + from + ":" + to); }
        }
    }
}

// `ExtendView`: 脚本, the profile's own 附加规则 under their header actions, then
// 控制全局附加规则 and 出口; 立即应用 shows in the bar while the active profile has changes.
component ExtendPage inherits Rectangle {
    in property <[SetSection]> top;
    in property <[RuleRow]> rules;
    in property <[SetSection]> bottom;
    in property <bool> selecting;
    in property <bool> apply;
    in property <bool> applying;
    callback back();
    callback clicked(string);
    callback toggled(string, bool);
    background: Theme.s.page;
    VerticalLayout {
        AppBar {
            title: "扩展";
            can-back: true;
            back => { root.back(); }
            if root.applying: VerticalLayout {
                alignment: center;
                Spinner { width: 22px; height: 22px; indeterminate: true; }
            }
            if root.apply || root.applying: VerticalLayout {
                alignment: center;
                TextButton {
                    text: "立即应用";
                    filled: true;
                    enabled: !root.applying;
                    clicked => { root.clicked("apply"); }
                }
            }
        }
        Flickable {
            interactive: !ext-rules.dragging;
            content-height: ext-body.preferred-height + Dock.pad;
            ext-body := VerticalLayout {
                alignment: start;
                padding-bottom: 24px;
                Sections {
                    sections: root.top;
                    clicked(id) => { root.clicked(id); }
                    toggled(id, on) => { root.toggled(id, on); }
                }
                HorizontalLayout {
                    padding-left: 30px;
                    padding-right: 16px;
                    padding-top: 12px;
                    spacing: 4px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: "附加规则"; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; }
                        Text { text: "在脚本之后插入，排在配置规则前面"; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; wrap: word-wrap; }
                    }
                    if root.selecting: VerticalLayout { alignment: center; IconButton { glyph: Icons.delete; tint: Theme.s.on-surface; clicked => { root.clicked("hdr-delete"); } } }
                    if root.selecting: VerticalLayout { alignment: center; IconButton { glyph: Icons.select-all; tint: Theme.s.on-surface; clicked => { root.clicked("hdr-select-all"); } } }
                    if !root.selecting: VerticalLayout { alignment: center; IconButton { glyph: Icons.bolt; tint: Theme.s.on-surface; clicked => { root.clicked("hdr-presets"); } } }
                    if !root.selecting: VerticalLayout { alignment: center; IconButton { glyph: Icons.add-circle; tint: Theme.s.on-surface; clicked => { root.clicked("hdr-add"); } } }
                }
                VerticalLayout {
                    padding-top: root.rules.length > 0 ? 8px : 0px;
                    padding-bottom: root.rules.length > 0 ? 8px : 0px;
                    ext-rules := AddedRuleList {
                        rows: root.rules;
                        selecting: root.selecting;
                        clicked(a) => { root.clicked("ar:" + a); }
                    }
                }
                Sections {
                    sections: root.bottom;
                    clicked(id) => { root.clicked(id); }
                    toggled(id, on) => { root.toggled(id, on); }
                }
            }
        }
    }
}

// `CustomRulesView` on `ListEditorPage`: search, sort once there are two, ⊕ with 添加 /
// 快捷操作 / 快速编辑, and while selecting 删除 and 全选. Rows load as they scroll into view;
// the sort mode turns them into the drag list.
component ProfileRulesPage inherits Rectangle {
    in property <[RuleRow]> rows;
    in property <int> total;
    in property <[string]> sort-titles;
    in property <[string]> sort-subtitles;
    in property <bool> selecting;
    in property <bool> sorting;
    in-out property <bool> searching;
    in-out property <string> query;
    callback act(string);
    changed query => { root.act("search:" + root.query); }
    background: Theme.s.page;
    VerticalLayout {
        if root.searching && !root.selecting && !root.sorting: SearchBar {
            query <=> root.query;
            close => { root.query = ""; root.searching = false; }
        }
        if !(root.searching && !root.selecting && !root.sorting): AppBar {
            title: "规则";
            can-back: true;
            back => { root.act("back"); }
            if root.selecting: VerticalLayout { alignment: center; IconButton { glyph: Icons.delete; tint: Theme.s.on-surface; clicked => { root.act("delete"); } } }
            if root.selecting: VerticalLayout { alignment: center; IconButton { glyph: Icons.select-all; tint: Theme.s.on-surface; clicked => { root.act("select-all"); } } }
            if !root.selecting && !root.sorting && root.total > 0: VerticalLayout { alignment: center; IconButton { glyph: Icons.search; tint: Theme.s.on-surface; clicked => { root.searching = true; } } }
            if !root.selecting && (root.sorting || root.total > 1): VerticalLayout {
                alignment: center;
                IconButton {
                    glyph: root.sorting ? Icons.check : Icons.sort;
                    tint: Theme.s.on-surface;
                    clicked => { root.act(root.sorting ? "sort-done" : "sort"); }
                }
            }
            if !root.selecting && !root.sorting: VerticalLayout {
                alignment: center;
                IconButton {
                    glyph: Icons.add-circle;
                    tint: Theme.s.on-surface;
                    clicked => {
                        Anchor.x = self.absolute-position.x;
                        Anchor.y = self.absolute-position.y;
                        Anchor.w = self.width;
                        Anchor.h = self.height;
                        root.act("add");
                    }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            if !root.sorting && root.rows.length > 0: ListView {
                y: 8px;
                height: parent.height - 8px;
                for r[i] in root.rows: RuleRowView {
                    item: r;
                    first: i == 0;
                    last: i == root.rows.length - 1;
                    selecting: root.selecting;
                    clicked(a) => { root.act(a); }
                }
            }
            if root.sorting: Flickable {
                interactive: !pr-sort.dragging;
                content-height: pr-sort-col.preferred-height;
                pr-sort-col := VerticalLayout {
                    alignment: start;
                    padding: 16px;
                    padding-top: 8px;
                    pr-sort := ReorderList {
                        titles: root.sort-titles;
                        subtitles: root.sort-subtitles;
                        moved(f, t) => { root.act("move:" + f + ":" + t); }
                    }
                }
            }
            if !root.sorting && root.rows.length == 0: NullStatus {
                label: root.total == 0 ? "规则为空" : "没有匹配的结果";
            }
        }
        Rectangle { height: Dock.pad; }
    }
}

// A form over the custom profile page (`NestedFormSheet`): the bar's actions, the issue
// banner, then the sections.
component ProfileFormPage inherits Rectangle {
    in property <string> title;
    in property <string> issue;
    in property <[SetSection]> sections;
    in property <string> action-glyph;
    callback back();
    callback clicked(string);
    callback toggled(string, bool);
    background: Theme.s.page;
    VerticalLayout {
        AppBar {
            title: root.title;
            can-back: true;
            back => { root.back(); }
            if root.action-glyph != "": VerticalLayout { alignment: center; IconButton { glyph: Glyphs.of(root.action-glyph); tint: Theme.s.on-surface; clicked => { root.clicked("action"); } } }
        }
        Flickable {
            vertical-stretch: 1;
            content-height: pf-col.preferred-height + Dock.pad;
            pf-col := VerticalLayout {
                alignment: start;
                padding-bottom: 24px;
                spacing: 4px;
                if root.issue != "": HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 8px;
                    Rectangle {
                        border-radius: 16px;
                        background: Theme.s.error.with-alpha(0.12);
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 12px;
                            VerticalLayout { alignment: start; Icon { glyph: Icons.error; size: 20px; tint: Theme.s.error; } }
                            Text { text: root.issue; font-size: 14px * Type.scale; color: Theme.s.error; wrap: word-wrap; horizontal-stretch: 1; }
                        }
                    }
                }
                Sections {
                    sections: root.sections;
                    clicked(id) => { root.clicked(id); }
                    toggled(id, on) => { root.toggled(id, on); }
                }
            }
        }
    }
}

// The logo (five taps turn on developer mode), name, version, the description and the
// update check, then the sections. FlClash: lib/views/about.dart.
component AboutPage inherits Rectangle {
    in property <image> icon;
    in property <string> version;
    in property <bool> checking;
    in property <[SetSection]> sections;
    callback back();
    callback clicked(string);
    callback toggled(string, bool);
    callback check-update();
    callback logo-tapped();
    SettingsPage {
        title: "关于";
        sections: root.sections;
        back => { root.back(); }
        clicked(id) => { root.clicked(id); }
        toggled(id, on) => { root.toggled(id, on); }
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 24px;
            padding-bottom: 8px;
            spacing: 0px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 96px;
                    height: 96px;
                    border-radius: 24px;
                    background: Theme.s.primary-container;
                    Image { source: root.icon; width: 96px; height: 96px; }
                    TouchArea { clicked => { root.logo-tapped(); } }
                }
            }
            Rectangle { height: 20px; }
            Text { text: "SeasonCat"; font-size: 22px * Type.scale; font-weight: 700; color: Theme.s.on-surface; horizontal-alignment: center; }
            Rectangle { height: 10px; }
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Rectangle {
                    height: 24px;
                    width: vpill.preferred-width * 1.1 + 24px;
                    border-radius: 12px;
                    background: Theme.s.primary;
                    vpill := Text { text: root.version; font-size: 12px * Type.scale; font-weight: 600; color: Theme.s.on-primary; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    height: 24px;
                    width: lpill.preferred-width * 1.1 + 24px;
                    border-radius: 12px;
                    background: Theme.s.block;
                    lpill := Text { text: "GPL-3.0"; font-size: 12px * Type.scale; font-weight: 600; color: Theme.s.on-surface-variant; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            Rectangle { height: 16px; }
            Text {
                text: "基于 Concord 内核的多平台代理客户端，简单易用，开源无广告。";
                font-size: 15px * Type.scale;
                color: Theme.s.on-surface-variant;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Rectangle { height: 20px; }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    height: 44px;
                    width: ubtn.preferred-width + 40px;
                    border-radius: 22px;
                    background: uta.pressed ? Theme.s.primary-container.darker(0.08) : Theme.s.primary-container;
                    opacity: root.checking ? 0.5 : 1;
                    ubtn := HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        VerticalLayout { alignment: center; Icon { glyph: Icons.sync; size: 20px; tint: Theme.s.on-primary-container; } }
                        Text { text: "检查更新"; font-size: 15px * Type.scale; color: Theme.s.on-primary-container; vertical-alignment: center; }
                    }
                    uta := TouchArea { enabled: !root.checking; clicked => { root.check-update(); } }
                }
            }
        }
    }
}

component Tools inherits Rectangle {
    in property <[SetSection]> sections;
    callback open(string);
    SettingsPage {
        title: "工具";
        can-back: false;
        sections: root.sections;
        clicked(id) => { root.open(id); }
    }
}

// `RecordLabel`: the level as a tonal chip; a tap filters by it.
component LevelLabel inherits Rectangle {
    in property <string> level;
    callback tapped();
    property <color> tone: root.level == "error" ? Theme.s.error : root.level == "warning" ? Theme.warning : Theme.s.on-surface-variant;
    height: 22px;
    width: ll-text.preferred-width + 16px;
    border-radius: 11px;
    background: ll-ta.pressed ? root.tone.with-alpha(0.24) : root.tone.with-alpha(0.12);
    ll-text := Text { text: root.level; font-size: 12px * Type.scale; font-weight: 600; color: root.tone; vertical-alignment: center; horizontal-alignment: center; }
    ll-ta := TouchArea { clicked => { root.tapped(); } }
}

// `LogItem` in a `RecordListItem`: the time and level, then `_LogBody`.
component LogRow inherits Rectangle {
    in property <LogItem> log;
    callback open(int);
    callback filter(string);
    height: lr-col.preferred-height + 8px;
    Rectangle {
        y: 0;
        height: parent.height - 8px;
        border-radius: 20px;
        background: lr-ta.pressed ? Theme.s.inset : Theme.s.card;
        lr-ta := TouchArea { clicked => { root.open(root.log.id); } }
        lr-col := VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 10px;
            padding-bottom: 12px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: root.log.time; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; overflow: elide; }
                LevelLabel { level: root.log.level; tapped => { root.filter(root.log.level); } }
                Rectangle { horizontal-stretch: 1; }
            }
            if !root.log.has-route: VerticalLayout {
                spacing: 2px;
                Text { text: root.log.message; font-size: 15px * Type.scale; color: Theme.s.on-surface; wrap: word-wrap; }
                if root.log.tag != "": Text { text: root.log.tag; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; wrap: word-wrap; }
            }
            if root.log.has-route: VerticalLayout {
                spacing: 2px;
                Text { text: root.log.dest; font-size: 15px * Type.scale; font-weight: 600; color: Theme.s.on-surface; wrap: word-wrap; }
                if root.log.error != "": Text { text: root.log.error; font-size: 13px * Type.scale; color: root.log.level == "warning" ? Theme.warning : root.log.level == "error" ? Theme.s.error : Theme.s.on-surface-variant; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 0px;
                    if root.log.rule != "": Text { text: root.log.rule; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; overflow: elide; max-width: lr-col.width * 0.5; }
                    if root.log.rule != "": Text { text: " → "; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; }
                    Text { text: root.log.proxy; font-size: 13px * Type.scale; font-weight: 600; color: Theme.s.primary; overflow: elide; max-width: lr-col.width * (root.log.rule != "" ? 0.45 : 1); }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text { text: root.log.source; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; wrap: word-wrap; }
            }
        }
    }
}

// `FloatingScrollbar` over a list: a thumb that fades 1.2s after the last scroll and drags
// the list, slowed by moving the finger sideways, with the hint at that point beside it.
component FeedBar inherits Rectangle {
    in property <length> content-height;
    in property <string> hint;
    in property <length> bottom-gap;
    in-out property <length> content-y;
    out property <length> range: max(0px, root.content-height - root.height);
    out property <float> fraction: root.range > 0 ? clamp(-root.content-y / root.range, 0, 1) : 0;
    out property <bool> scrubbing: bar-ta.pressed && root.range > 0;
    callback dragged();
    property <length> track: root.height - 4px;
    property <length> thumb: clamp(root.range > 0 ? root.track * root.height / root.content-height : root.track, min(48px, root.track), root.track);
    property <length> thumb-y: 2px + root.fraction * (root.track - root.thumb);
    property <bool> shown;
    property <int> idle;
    property <float> rate: 1;
    property <length> last-y;
    property <length> origin-x;
    public function poke() {
        root.shown = true;
        root.idle = 0;
    }
    changed scrubbing => {
        if (!self.scrubbing) { hint-hold.running = true; }
    }
    Timer {
        interval: 200ms;
        running: root.shown && !root.scrubbing;
        triggered => {
            root.idle += 1;
            if (root.idle >= 6) { root.shown = false; }
        }
    }
    hint-hold := Timer {
        interval: 500ms;
        running: false;
        triggered => { self.running = false; }
    }
    if root.range > 0: Rectangle {
        property <float> t: root.scrubbing ? 1 : 0;
        x: parent.width - self.width - 2px;
        y: root.thumb-y;
        width: 6px + 4px * self.t;
        height: root.thumb;
        border-radius: self.width / 2;
        opacity: root.shown || root.scrubbing ? 1 : 0;
        background: Theme.s.on-surface.with-alpha(Theme.is-dark ? 0.35 + 0.3 * self.t : 0.25 + 0.25 * self.t);
        animate width, background { duration: 120ms; easing: ease-out; }
        animate opacity { duration: 250ms; }
    }
    bar-ta := TouchArea {
        x: parent.width - 24px;
        y: root.thumb-y - 8px;
        width: 24px;
        height: root.thumb + 16px;
        enabled: root.range > 0 && (root.shown || self.pressed);
        changed pressed => {
            if (self.pressed) {
                root.last-y = self.mouse-y;
                root.origin-x = self.mouse-x;
                root.rate = 1;
                root.poke();
            } else {
                root.dragged();
            }
        }
        moved => {
            // `_scrubRateFor`: each 48px sideways halves the speed, down to 1/8.
            root.rate = abs(self.mouse-x - root.origin-x) >= 144px ? 0.125 : abs(self.mouse-x - root.origin-x) >= 96px ? 0.25 : abs(self.mouse-x - root.origin-x) >= 48px ? 0.5 : 1;
            if (root.track > root.thumb) {
                root.content-y = clamp(root.content-y - (self.mouse-y - root.last-y) * root.rate * root.range / (root.track - root.thumb), -root.range, 0px);
            }
            root.last-y = self.mouse-y;
            root.dragged();
        }
    }
    if root.range > 0 && (root.scrubbing || hint-hold.running) && root.hint != "": Rectangle {
        x: parent.width - 40px - self.width;
        y: clamp(root.thumb-y + root.thumb / 2 - self.height / 2, 0px, max(0px, parent.height - root.bottom-gap - 8px - self.height));
        width: pill.preferred-width + 24px;
        height: pill.preferred-height + 12px;
        border-radius: self.height / 2;
        background: Theme.s.card;
        drop-shadow-offset-y: 4px;
        drop-shadow-blur: 16px;
        drop-shadow-color: #0000001f;
        pill := HorizontalLayout {
            x: 12px;
            y: 6px;
            spacing: 6px;
            Text { text: root.hint; font-size: 13px * Type.scale; font-weight: 600; color: Theme.s.on-surface; }
            if root.scrubbing && root.rate < 1: Text { text: root.rate + "×"; font-size: 13px * Type.scale; font-weight: 600; color: Theme.s.on-surface-variant; }
        }
    }
}

// FlClash: lib/views/logs.dart. Search, the level filters (from the bar and a row's label) as a
// strip of chips, export and the log level in the menu, newest first; a tap opens the
// record's details.
component Logs inherits Rectangle {
    in property <[LogItem]> logs;
    in property <[string]> offered;
    in property <[string]> filters;
    in-out property <bool> searching;
    in-out property <string> query;
    in property <length> bottom-gap;
    callback back();
    callback search(string);
    callback open-filters();
    callback open-menu();
    callback filter(string);
    callback unfilter(string);
    callback open(int);
    // `ScrollToEndBox`: off the newest, new lines wait until the list is back at it.
    callback set-following(bool);
    init => { root.set-following(true); }
    changed query => { root.search(root.query); }
    VerticalLayout {
        if !root.searching: AppBar {
            title: "日志";
            can-back: true;
            back => { root.back(); }
            VerticalLayout { alignment: center; IconButton { glyph: Icons.search; tint: Theme.s.on-surface; clicked => { root.searching = true; } } }
            if root.offered.length > 0: VerticalLayout { alignment: center; IconButton { glyph: Icons.filter; tint: Theme.s.on-surface; clicked => { root.open-filters(); } } }
            VerticalLayout { alignment: center; IconButton { glyph: Icons.more; tint: Theme.s.on-surface; clicked => { root.open-menu(); } } }
        }
        if root.searching: HorizontalLayout {
            height: 56px;
            padding-left: 4px;
            padding-right: 8px;
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                IconButton { glyph: Icons.back; tint: Theme.s.on-surface; clicked => { root.query = ""; root.searching = false; } }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Rectangle {
                    height: 44px;
                    border-radius: 22px;
                    background: Theme.s.block;
                    Text {
                        x: 16px;
                        visible: log-input.text == "";
                        text: "搜索";
                        color: Theme.s.on-surface-variant;
                        font-size: 15px * Type.scale;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    log-input := TextInput {
                        x: 16px;
                        width: parent.width - 32px;
                        height: parent.height;
                        vertical-alignment: center;
                        single-line: true;
                        font-size: 15px * Type.scale;
                        color: Theme.s.on-surface;
                        text <=> root.query;
                        init => { self.focus(); }
                    }
                }
            }
            if root.offered.length > 0: VerticalLayout { alignment: center; IconButton { glyph: Icons.filter; tint: Theme.s.on-surface; clicked => { root.open-filters(); } } }
            VerticalLayout { alignment: center; IconButton { glyph: Icons.more; tint: Theme.s.on-surface; clicked => { root.open-menu(); } } }
        }
        // `_KeywordStrip`
        if root.filters.length > 0: Flickable {
            height: 44px;
            content-width: kw.preferred-width;
            interactive: kw.preferred-width > self.width;
            kw := HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 8px;
                spacing: 8px;
                for f in root.filters: Rectangle {
                    height: 36px;
                    width: kw-row.preferred-width;
                    border-radius: 18px;
                    background: Theme.s.block;
                    kw-row := HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 6px;
                        spacing: 4px;
                        Text { text: f; font-size: 14px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; }
                        Rectangle {
                            width: 26px;
                            Icon { glyph: Icons.close; size: 16px; tint: Theme.s.on-surface-variant; }
                            TouchArea { clicked => { root.unfilter(f); } }
                        }
                    }
                }
            }
        }
        if root.logs.length == 0: NullStatus {
            vertical-stretch: 1;
            label: "暂无日志";
        }
        if root.logs.length > 0: Rectangle {
            vertical-stretch: 1;
            log-lv := ListView {
                vertical-scrollbar-policy: always-off;
                scrolled => {
                    root.set-following(self.content-y >= -0.5px);
                    log-bar.poke();
                }
                for l in root.logs: HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    LogRow {
                        log: l;
                        open(id) => { root.open(id); }
                        filter(level) => { root.filter(level); }
                    }
                }
            }
            log-bar := FeedBar {
                content-height: log-lv.content-height;
                content-y <=> log-lv.content-y;
                hint: root.logs[clamp(round(self.fraction * (root.logs.length - 1)), 0, root.logs.length - 1)].time;
                dragged => { root.set-following(log-lv.content-y >= -0.5px); }
            }
        }
        Rectangle { height: Dock.pad; }
        Rectangle { height: root.bottom-gap; }
    }
}

// `ConnectedButtonBar`: one button per choice, joined.
component SegmentBar inherits HorizontalLayout {
    in property <[string]> items;
    in property <int> value;
    in property <length> bar-height: 40px;
    callback picked(int);
    spacing: 2px;
    for label[i] in root.items: Rectangle {
        height: root.bar-height;
        horizontal-stretch: 1;
        min-width: seg-text.preferred-width * 1.15 + 24px;
        border-top-left-radius: i == 0 ? self.height / 2 : 6px;
        border-bottom-left-radius: i == 0 ? self.height / 2 : 6px;
        border-top-right-radius: i == root.items.length - 1 ? self.height / 2 : 6px;
        border-bottom-right-radius: i == root.items.length - 1 ? self.height / 2 : 6px;
        background: i == root.value ? Theme.s.primary : (seg-ta.pressed ? Theme.s.inset : Theme.s.block);
        seg-text := Text {
            text: label;
            font-size: 14px * Type.scale;
            font-weight: i == root.value ? 600 : 400;
            color: i == root.value ? Theme.s.on-primary : Theme.s.on-surface;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        seg-ta := TouchArea { clicked => { root.picked(i); } }
    }
}

// The shapes of `_PageSketch`, placed in units of a twentieth of the sketched screen's
// width. FlClash: lib/views/theme_preview.dart.
component MPill inherits Rectangle {
    in property <length> u;
    in property <float> px;
    in property <float> py;
    in property <float> pw;
    in property <float> ph;
    in property <color> c;
    x: root.px * root.u;
    y: root.py * root.u;
    width: root.pw * root.u;
    height: root.ph * root.u;
    border-radius: self.height / 2;
    background: root.c;
}

component MDot inherits Rectangle {
    in property <length> u;
    in property <float> cx;
    in property <float> cy;
    in property <float> r;
    in property <color> c;
    x: (root.cx - root.r) * root.u;
    y: (root.cy - root.r) * root.u;
    width: root.r * 2 * root.u;
    height: self.width;
    border-radius: self.width / 2;
    background: root.c;
}

// `_block`: `AppCorner.fit` of five units on the 96-wide sketch is `sm`, of 2.9 `xs`.
component MBlock inherits Rectangle {
    in property <length> u;
    in property <float> px;
    in property <float> py;
    in property <float> pw;
    in property <float> ph;
    in property <float> corner: 8 / 4.8;
    in property <color> c;
    x: root.px * root.u;
    y: root.py * root.u;
    width: root.pw * root.u;
    height: root.ph * root.u;
    border-radius: root.corner * root.u;
    background: root.c;
}

// One page of a `MiniScreen`: 0 dashboard, 1 proxies, 2 profiles, 3 tools.
component MiniPage inherits Rectangle {
    in property <Scheme> s;
    in property <int> page;
    in property <length> u;
    property <float> w: 17;
    property <color> text: root.s.on-surface.with-alpha(0.72);
    property <color> line: root.s.on-surface-variant.with-alpha(0.4);
    property <color> faint: root.s.on-surface-variant.with-alpha(0.16);
    property <int> actions: root.page == 0 ? 1 : root.page == 3 ? 0 : 2;
    MPill { u: root.u; px: 0; py: 0.45; pw: 7; ph: 1.1; c: root.text; }
    for i in root.actions: Rectangle {
        MDot { u: root.u; cx: root.w - 1 - i * 2.4; cy: 1; r: 1; c: root.s.card; }
        MDot { u: root.u; cx: root.w - 1 - i * 2.4; cy: 1; r: 0.3; c: root.line; }
    }
    if root.page == 0: Rectangle {
        MBlock {
            u: root.u; px: 0; py: 2.8; pw: root.w; ph: 6.2; c: root.s.card;
            clip: true;
            MDot { u: root.u; cx: root.w - 3; cy: 3.1; r: 4.6; c: root.s.primary.with-alpha(0.1); }
        }
        MDot { u: root.u; cx: root.w - 3; cy: 5.9; r: 1.8; c: root.s.primary; }
        MPill { u: root.u; px: root.w - 3.675; py: 5.3; pw: 0.35; ph: 1.2; c: root.s.on-primary; }
        MPill { u: root.u; px: root.w - 2.675; py: 5.3; pw: 0.35; ph: 1.2; c: root.s.on-primary; }
        MPill { u: root.u; px: 1; py: 3.7; pw: 3; ph: 0.7; c: root.line; }
        MDot { u: root.u; cx: 1.9; cy: 5.8; r: 0.9; c: root.s.inset; }
        MPill { u: root.u; px: 3.5; py: 5.1; pw: 5; ph: 0.9; c: root.text; }
        MPill { u: root.u; px: 3.5; py: 6.3; pw: 2.4; ph: 0.7; c: root.s.inset; }
        MPill { u: root.u; px: 1; py: 7.6; pw: 2.4; ph: 0.7; c: root.line; }
        MPill { u: root.u; px: 4.6; py: 7.6; pw: 3.6; ph: 0.7; c: root.line; }
        MBlock { u: root.u; px: 0; py: 9.6; pw: root.w; ph: 5.8; c: root.s.card; }
        MPill { u: root.u; px: 1; py: 10.5; pw: 4.5; ph: 0.7; c: root.line; }
        for i in 2: MBlock {
            u: root.u; px: 1 + i * 7.8; py: 11.7; pw: 7.2; ph: 2.9; corner: 4 / 4.8; c: root.s.inset;
            clip: true;
            Path {
                width: 100%;
                height: 100%;
                viewbox-width: 7.2;
                viewbox-height: 2.9;
                commands: i == 0
                    ? "M 0.00 1.97 L 0.45 2.25 L 0.90 2.31 L 1.35 2.12 L 1.80 1.82 L 2.25 1.63 L 2.70 1.70 L 3.15 1.98 L 3.60 2.25 L 4.05 2.31 L 4.50 2.12 L 4.95 1.81 L 5.40 1.63 L 5.85 1.71 L 6.30 1.98 L 6.75 2.25 L 7.20 2.31 L 7.20 2.90 L 0 2.90 Z"
                    : "M 0.00 2.32 L 0.45 2.15 L 0.90 1.85 L 1.35 1.64 L 1.80 1.68 L 2.25 1.94 L 2.70 2.23 L 3.15 2.32 L 3.60 2.15 L 4.05 1.84 L 4.50 1.64 L 4.95 1.68 L 5.40 1.95 L 5.85 2.23 L 6.30 2.32 L 6.75 2.14 L 7.20 1.84 L 7.20 2.90 L 0 2.90 Z";
                fill: root.s.primary.with-alpha(i == 0 ? 0.1 : 0.2);
            }
            Path {
                width: 100%;
                height: 100%;
                viewbox-width: 7.2;
                viewbox-height: 2.9;
                commands: i == 0
                    ? "M 0.00 1.97 L 0.45 2.25 L 0.90 2.31 L 1.35 2.12 L 1.80 1.82 L 2.25 1.63 L 2.70 1.70 L 3.15 1.98 L 3.60 2.25 L 4.05 2.31 L 4.50 2.12 L 4.95 1.81 L 5.40 1.63 L 5.85 1.71 L 6.30 1.98 L 6.75 2.25 L 7.20 2.31"
                    : "M 0.00 2.32 L 0.45 2.15 L 0.90 1.85 L 1.35 1.64 L 1.80 1.68 L 2.25 1.94 L 2.70 2.23 L 3.15 2.32 L 3.60 2.15 L 4.05 1.84 L 4.50 1.64 L 4.95 1.68 L 5.40 1.95 L 5.85 2.23 L 6.30 2.32 L 6.75 2.14 L 7.20 1.84";
                stroke: root.s.primary.with-alpha(i == 0 ? 0.5 : 1);
                stroke-width: root.u * 0.15;
            }
            MPill { u: root.u; px: 0.6; py: 0.55; pw: 2.4; ph: 0.7; c: root.line; }
        }
        MBlock { u: root.u; px: 0; py: 16; pw: root.w; ph: 4.4; c: root.s.card; }
        MPill { u: root.u; px: 1; py: 16.9; pw: 4; ph: 0.7; c: root.line; }
        for i in 3: Rectangle {
            MPill { u: root.u; px: 1 + i * 5.1; py: 18.1; pw: 4.8; ph: 1.6; c: i == 0 ? root.s.primary : root.s.inset; }
            MDot { u: root.u; cx: 3.4 + i * 5.1; cy: 18.9; r: 0.3; c: i == 0 ? root.s.on-primary : root.line; }
        }
        MBlock { u: root.u; px: 0; py: 21; pw: root.w; ph: 3; c: root.s.card; }
        MDot { u: root.u; cx: 1.9; cy: 22.5; r: 0.9; c: root.s.primary; }
        MPill { u: root.u; px: 3.4; py: 22.1; pw: 2.4; ph: 0.8; c: root.line; }
        MPill { u: root.u; px: root.w - 3.6; py: 21.8; pw: 2.6; ph: 1.4; c: root.s.primary; }
        MDot { u: root.u; cx: root.w - 1.7; cy: 22.5; r: 0.55; c: root.s.on-primary; }
        for i in 3: Rectangle {
            MBlock { u: root.u; px: 0; py: 24.6 + i * 5.1; pw: root.w; ph: 4.5; c: root.s.card; }
            MPill { u: root.u; px: 1; py: 25.5 + i * 5.1; pw: 3.5 + mod(i, 2); ph: 0.7; c: root.line; }
        }
    }
    if root.page == 1: Rectangle {
        for i in 9: Rectangle {
            MBlock { u: root.u; px: 0; py: 2.8 + i * 3.2; pw: root.w; ph: 2.6; c: root.s.card; }
            MDot { u: root.u; cx: 1.5; cy: 4.1 + i * 3.2; r: 0.8; c: root.s.inset; }
            MPill { u: root.u; px: 3; py: 3.4 + i * 3.2; pw: 3 + mod(i, 3); ph: 0.7; c: root.line; }
            MPill { u: root.u; px: 3; py: 4.35 + i * 3.2; pw: 4; ph: 0.5; c: root.faint; }
            MPill { u: root.u; px: root.w - 4.4; py: 3.85 + i * 3.2; pw: 1.8; ph: 0.5; c: root.faint; }
            MDot { u: root.u; cx: root.w - 1.3; cy: 4.1 + i * 3.2; r: 0.55; c: root.s.inset; }
        }
    }
    if root.page == 2: Rectangle {
        for i in 3: Rectangle {
            MBlock { u: root.u; px: 0; py: 2.8 + i * 3.4; pw: root.w; ph: 2.8; c: root.s.card; }
            MPill { u: root.u; px: 1; py: 3.5 + i * 3.4; pw: 3.4 - i * 0.6; ph: 0.75; c: root.line; }
            MPill { u: root.u; px: 4.8 - i * 0.6; py: 3.52 + i * 3.4; pw: 2.6; ph: 0.7; c: root.s.primary.with-alpha(0.16); }
            MPill { u: root.u; px: 1; py: 4.5 + i * 3.4; pw: 3; ph: 0.5; c: root.faint; }
            MPill { u: root.u; px: root.w - 4.1; py: 3.95 + i * 3.4; pw: 1.6; ph: 0.5; c: root.faint; }
            if i == 0: MDot { u: root.u; cx: root.w - 1.4; cy: 4.2; r: 0.6; c: root.s.primary; }
        }
    }
    if root.page == 3: Rectangle {
        // Two groups of 4 and 7 rows, 2.4 units each, after `_tools`.
        for g in 2: grp := Rectangle {
            property <int> rows: g == 0 ? 4 : 7;
            property <float> top: g == 0 ? 2.8 : 2.8 + 1.3 + 4 * 2.4 + 1.2;
            MPill { u: root.u; px: 0.8; py: grp.top + 0.2; pw: 1.6 + grp.rows * 0.15; ph: 0.5; c: root.faint; }
            MBlock { u: root.u; px: 0; py: grp.top + 1.3; pw: root.w; ph: grp.rows * 2.4; c: root.s.card; }
            for i in grp.rows: row := Rectangle {
                property <float> top: grp.top + 1.3 + i * 2.4;
                MDot { u: root.u; cx: 1.3; cy: row.top + 1.2; r: 0.45; c: root.line; }
                MPill { u: root.u; px: 2.6; py: row.top + 0.85; pw: 4 + mod(i * 3 + grp.rows, 4); ph: 0.7; c: root.line; }
                if i < grp.rows - 1: MBlock { u: root.u; px: 2.6; py: row.top + 2.37; pw: root.w - 3.4; ph: 0.06; corner: 0; c: root.faint; }
            }
        }
    }
}

// `MiniScreen` (FlClash: lib/views/theme_preview.dart): the home page sketched in a scheme. With
// `previous` set, the page is caught `progress` of the way through a switch from it.
component MiniScreen inherits Rectangle {
    in property <Scheme> s;
    in property <bool> dark;
    in property <bool> floating: true;
    in property <int> selected;
    in property <int> previous: -1;
    in property <float> progress: 1;
    in property <bool> fade;
    callback select(int);
    property <length> u: self.width / 20;
    property <length> margin: self.u * 1.5;
    property <length> bar-h: root.floating ? self.u * 3.2 : self.u * 3.6;
    property <length> page-bottom: root.floating ? 0 : root.bar-h;
    property <color> dock: root.dark ? root.s.block : root.s.card;
    property <color> indicator: root.dark ? root.s.inset : root.s.block;
    property <float> dir: root.previous > root.selected ? -1 : 1;
    background: root.s.page;
    clip: true;
    Rectangle {
        x: root.margin;
        y: root.margin;
        width: root.width - root.margin * 2;
        height: root.height - root.margin - root.page-bottom;
        clip: true;
        if root.previous >= 0: MiniPage {
            x: root.fade ? 0 : -root.dir * root.width * root.progress;
            opacity: root.fade ? 1 - root.progress : 1;
            s: root.s;
            page: root.previous;
            u: root.u;
        }
        MiniPage {
            x: root.previous >= 0 && !root.fade ? root.dir * root.width * (1 - root.progress) : 0;
            opacity: root.previous >= 0 && root.fade ? root.progress : 1;
            s: root.s;
            page: root.selected;
            u: root.u;
        }
    }
    bar := Rectangle {
        x: root.floating ? root.margin : 0;
        y: root.floating ? root.height - root.margin - root.bar-h : root.height - root.bar-h;
        width: root.floating ? root.width - root.margin * 2 : root.width;
        height: root.bar-h;
        border-radius: root.floating ? self.height / 2 : 0;
        background: root.dock;
        drop-shadow-color: root.floating ? #0000001f : transparent;
        drop-shadow-blur: root.u;
        drop-shadow-offset-y: root.u * 0.3;
        property <length> cell: self.width / 4;
        for i in 4: dest := Rectangle {
            x: i * bar.cell;
            width: bar.cell;
            property <bool> on: i == root.selected;
            property <color> ink: self.on ? root.s.primary : root.s.on-surface-variant;
            if dest.on: Rectangle {
                x: root.floating ? root.u * 0.25 : (bar.cell - root.u * 2.8) / 2;
                y: root.floating ? root.u * 0.25 : bar.height / 2 - root.u * 0.4 - root.u * 0.75;
                width: root.floating ? bar.cell - root.u * 0.5 : root.u * 2.8;
                height: root.floating ? bar.height - root.u * 0.5 : root.u * 1.5;
                border-radius: self.height / 2;
                background: root.indicator;
            }
            Rectangle {
                x: (bar.cell - self.width) / 2;
                y: bar.height / 2 - root.u * 0.4 - self.height / 2;
                width: root.u * 0.9;
                height: self.width;
                border-radius: self.width / 2;
                background: dest.ink;
            }
            Rectangle {
                x: (bar.cell - self.width) / 2;
                y: bar.height / 2 + root.u * 0.8 - self.height / 2;
                width: root.u * 1.7;
                height: root.u * 0.35;
                border-radius: self.height / 2;
                background: dest.on ? dest.ink : dest.ink.with-alpha(0.6);
            }
            TouchArea { clicked => { root.select(i); } }
        }
    }
}

// `MiniScreenThumb`: the foot of a 96 by 128 sketch, 66 of it tall, shown 30 high.
component MiniThumb inherits Rectangle {
    in property <Scheme> s;
    in property <bool> dark;
    // A second scheme drawn over the right half, for "follow system".
    in property <Scheme> s2;
    in property <bool> split;
    in property <bool> floating: true;
    in property <int> selected;
    in property <int> previous: -1;
    in property <float> progress: 1;
    in property <bool> fade;
    property <length> sw: self.height * 96 / 66;
    width: self.height * 96 / 66;
    height: 30px;
    border-radius: 8px;
    clip: true;
    MiniScreen {
        y: root.height - self.height;
        width: root.sw;
        height: root.sw * 128 / 96;
        s: root.s;
        dark: root.dark;
        floating: root.floating;
        selected: root.selected;
        previous: root.previous;
        progress: root.progress;
        fade: root.fade;
    }
    if root.split: Rectangle {
        x: root.sw / 2;
        width: root.sw / 2;
        clip: true;
        MiniScreen {
            x: -root.sw / 2;
            y: root.height - self.height;
            width: root.sw;
            height: root.sw * 128 / 96;
            s: root.s2;
            dark: true;
            floating: root.floating;
        }
    }
}

// `InfoHeader`: a section's glyph and label above its group, with actions on the right.
component InfoHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> glyph;
    height: 40px;
    padding-left: 16px;
    padding-right: 8px;
    spacing: 8px;
    VerticalLayout { alignment: center; Icon { glyph: root.glyph; size: 20px; tint: Theme.s.primary; } }
    Text { text: root.title; font-size: 15px * Type.scale; font-weight: 600; color: Theme.s.on-surface; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
    @children
}

// `PreviewChoiceGroup`'s row: the pictogram, the label, and a check on the chosen one.
component PreviewRow inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> divider;
    callback clicked();
    height: 56px;
    background: ta.pressed ? Theme.s.inset : transparent;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        VerticalLayout { alignment: center; @children }
        Text { text: root.text; font-size: 16px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        VerticalLayout {
            alignment: center;
            width: 22px;
            if root.checked: Icon { glyph: Icons.check; size: 22px; tint: Theme.s.primary; }
        }
    }
    if root.divider: Rectangle {
        x: 16px + 44px + 14px;
        y: parent.height - 1px;
        width: parent.width - self.x;
        height: 1px;
        background: Theme.s.outline-variant.with-alpha(0.6);
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Group inherits Rectangle {
    background: Theme.s.card;
    border-radius: 16px;
    clip: true;
    VerticalLayout { @children }
}

// `_ColorSwatch`: the colour's dot, a ring round it and a check when chosen; the system's
// colour carries an eyedropper badge. A long press asks for its menu.
component SwatchView inherits Rectangle {
    in property <Swatch> item;
    callback clicked();
    callback long-pressed();
    property <bool> long-fired;
    property <color> fill: Theme.is-dark ? root.item.fill-dark : root.item.fill;
    property <bool> light-ink: Theme.is-dark ? root.item.light-ink-dark : root.item.light-ink;
    width: 44px;
    height: 44px;
    if root.item.selected: Rectangle {
        border-radius: self.width / 2;
        border-width: 2.5px;
        border-color: root.fill;
    }
    Rectangle {
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: root.fill;
    }
    if root.item.selected: Icon { glyph: Icons.check; size: 18px; tint: root.light-ink ? #ffffff : #000000; }
    if root.item.system: Rectangle {
        x: parent.width - self.width;
        y: parent.height - self.height;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: Theme.s.card;
        Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: Theme.s.block;
            Icon { glyph: Icons.eyedropper; size: 12px; tint: Theme.s.on-surface; }
        }
    }
    sw-ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.long-fired = false; }
        }
        clicked => {
            if (!root.long-fired) { root.clicked(); }
        }
    }
    Timer {
        interval: 500ms;
        running: sw-ta.pressed && !root.long-fired && !root.item.system;
        triggered => {
            root.long-fired = true;
            root.long-pressed();
        }
    }
}

// `_ColorSwatches`: the colours in a wrap whose gaps share out the spare width.
component SwatchGrid inherits Rectangle {
    in property <[Swatch]> items;
    callback picked(int);
    callback menu(int);
    callback add();
    property <length> inset: 10px;
    property <int> count: root.items.length + 1;
    property <int> cols: max(1, floor((root.width - root.inset * 2 + 6px) / 50px));
    property <length> gap: root.cols > 1 ? floor((root.width - root.inset * 2 - root.cols * 44px) / (root.cols - 1) / 1px) * 1px : 0;
    property <int> rows: ceil(root.count / root.cols);
    background: Theme.s.card;
    border-radius: 24px;
    height: root.inset * 2 + root.rows * 44px + (root.rows - 1) * root.gap;
    for sw[i] in root.items: SwatchView {
        x: root.inset + mod(i, root.cols) * (44px + root.gap);
        y: root.inset + floor(i / root.cols) * (44px + root.gap);
        item: sw;
        clicked => { root.picked(i); }
        long-pressed => { root.menu(i); }
    }
    Rectangle {
        x: root.inset + mod(root.items.length, root.cols) * (44px + root.gap);
        y: root.inset + floor(root.items.length / root.cols) * (44px + root.gap);
        width: 44px;
        height: 44px;
        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: add-ta.pressed ? Theme.s.inset : Theme.s.block;
            Icon { glyph: Icons.plus; size: 20px; tint: Theme.s.on-surface-variant; }
        }
        add-ta := TouchArea { clicked => { root.add(); } }
    }
}

// `ListItem.options`: the title, the chosen option and the up-down chevron.
component OptionsRow inherits Rectangle {
    in property <string> title;
    in property <string> value;
    callback clicked();
    height: 52px;
    background: ta.pressed ? Theme.s.inset : transparent;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 6px;
        Text { text: root.title; font-size: 16px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Text { text: root.value; font-size: 16px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; }
        VerticalLayout { alignment: center; Icon { glyph: Icons.updown; size: 18px; tint: Theme.s.on-surface-variant; } }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// The round reset button beside a section's title (`_ResetButton`).
component ResetButton inherits Rectangle {
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: rb-ta.pressed ? Theme.s.inset : Theme.s.card;
    Icon { glyph: Icons.reset; size: 18px; tint: Theme.s.on-surface-variant; }
    rb-ta := TouchArea { clicked => { root.clicked(); } }
}

// `ThemeLivePreview`: the home page as the settings draw it, in a phone 168 wide at 9:17;
// its destinations can be tapped to try the tab animation.
component ThemeLivePreview inherits Rectangle {
    in property <bool> floating;
    in property <bool> fade;
    property <int> selected;
    property <int> previous: -1;
    property <duration> started;
    property <duration> span: root.fade ? 220ms : 300ms;
    property <float> t: root.previous >= 0 ? clamp((animation-tick() - root.started) / root.span, 0, 1) : 1;
    // Curves.easeInOut for a fade, Curves.easeOut for a slide.
    property <float> eased: root.fade ? root.t * root.t * (3 - 2 * root.t) : 1 - (1 - root.t) * (1 - root.t);
    changed fade => { root.select(mod(root.selected + 1, 4)); }
    function select(i: int) {
        if (i == root.selected) { return; }
        root.previous = root.selected;
        root.selected = i;
        root.started = animation-tick();
        done.restart();
    }
    height: phone.height + 48px;
    background: Theme.s.card;
    border-radius: 28px;
    done := Timer {
        interval: root.span;
        running: false;
        triggered => {
            root.previous = -1;
            self.stop();
        }
    }
    phone := Rectangle {
        width: 168px;
        height: self.width * 17 / 9;
        border-radius: 28px;
        clip: true;
        MiniScreen {
            s: Theme.s;
            dark: Theme.is-dark;
            floating: root.floating;
            selected: root.selected;
            previous: root.previous;
            progress: root.eased;
            fade: root.fade;
            select(i) => { root.select(i); }
        }
    }
}

// prism_ui's gapped `Slider`: a 16-high track split round a 4 by 44 bar, with a tick at
// every division and the value in a bubble above the bar while it moves.
component StepSlider inherits Rectangle {
    in property <float> value;
    in property <int> divisions;
    in property <bool> enabled: true;
    in property <string> label;
    callback moved(float);
    callback released(float);
    property <bool> active: st-ta.pressed;
    property <length> bar: root.active ? 2px : 4px;
    property <length> travel: self.width - 4px;
    property <length> at: 2px + root.travel * clamp(root.value, 0, 1);
    property <color> on: root.enabled ? Theme.s.primary : Theme.s.on-surface.with-alpha(0.38);
    property <color> off: root.enabled ? Theme.s.primary-container : Theme.s.on-surface.with-alpha(0.12);
    height: 44px;
    Rectangle {
        y: 14px;
        width: max(0px, root.at - root.bar / 2 - 6px);
        height: 16px;
        x: 0;
        border-top-left-radius: 8px;
        border-bottom-left-radius: 8px;
        border-top-right-radius: 2px;
        border-bottom-right-radius: 2px;
        background: root.on;
    }
    Rectangle {
        x: min(root.width, root.at + root.bar / 2 + 6px);
        y: 14px;
        width: root.width - self.x;
        height: 16px;
        border-top-left-radius: 2px;
        border-bottom-left-radius: 2px;
        border-top-right-radius: 8px;
        border-bottom-right-radius: 8px;
        background: root.off;
    }
    for i in root.divisions + 1: Rectangle {
        property <length> tx: 2px + root.travel * i / root.divisions;
        visible: self.tx < root.at - root.bar / 2 - 8px || self.tx > root.at + root.bar / 2 + 8px;
        x: self.tx - 2px;
        y: 20px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: self.tx < root.at
            ? (root.enabled ? Theme.s.on-primary : Theme.s.page)
            : (root.enabled ? Theme.s.on-primary-container : Theme.s.on-surface);
    }
    Rectangle {
        x: root.at - root.bar / 2;
        width: root.bar;
        height: 44px;
        border-radius: self.width / 2;
        background: root.on;
    }
    if root.active && root.label != "": Rectangle {
        x: root.at - self.width / 2;
        y: -42px;
        width: st-label.preferred-width + 16px;
        height: 32px;
        border-radius: 16px;
        background: Theme.s.on-surface;
        st-label := Text { text: root.label; font-size: 14px; font-weight: 600; color: Theme.s.page; }
    }
    st-ta := TouchArea {
        enabled: root.enabled;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.moved(clamp((self.mouse-x - 2px) / root.travel, 0, 1));
            } else if (e.kind == PointerEventKind.up) {
                root.released(clamp((self.mouse-x - 2px) / root.travel, 0, 1));
            }
        }
        moved => {
            if (self.pressed) { root.moved(clamp((self.mouse-x - 2px) / root.travel, 0, 1)); }
        }
    }
}

// `_TextScaleFactorItem`: follow the system or a custom scale, its sample drawn at the
// scale being chosen, the slider from 80% to 140% in steps of 5%.
component TextScaleSection inherits VerticalLayout {
    in property <bool> enable;
    in property <float> value: 1;
    callback set-enable(bool);
    callback set-scale(float);
    property <bool> dragging;
    property <float> draft: 1;
    property <float> shown: root.dragging ? root.draft : root.value;
    property <string> percent: round(root.shown * 100) + "%";
    function snap(t: float) -> float {
        return round((0.8 + t * 0.6) * 20) / 20;
    }
    InfoHeader {
        title: "文本缩放";
        glyph: Icons.text-size;
        if root.enable && root.value != 1: VerticalLayout { alignment: center; ResetButton { clicked => { root.set-scale(1); } } }
    }
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        spacing: 8px;
        SegmentBar {
            items: ["跟随系统", "自定义"];
            value: root.enable ? 1 : 0;
            picked(i) => { root.set-enable(i == 1); }
        }
        Rectangle {
            background: Theme.s.card;
            border-radius: 20px;
            VerticalLayout {
                padding: 16px;
                padding-bottom: 8px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Text { text: "Aa"; font-size: 20px * root.shown; color: Theme.s.on-surface; }
                        Text { text: "应用内的文字将以这个大小显示"; font-size: 15px * root.shown; color: Theme.s.on-surface-variant; wrap: word-wrap; }
                    }
                    VerticalLayout {
                        alignment: start;
                        Rectangle {
                            width: ts-pct.preferred-width + 20px;
                            height: ts-pct.preferred-height + 8px;
                            border-radius: self.height / 2;
                            background: Theme.s.block;
                            ts-pct := Text { text: root.percent; font-size: 15px * Type.scale; font-weight: 600; color: Theme.s.on-surface-variant; }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "A"; font-size: 13px; color: Theme.s.on-surface-variant; vertical-alignment: center; }
                    StepSlider {
                        horizontal-stretch: 1;
                        value: (root.shown - 0.8) / 0.6;
                        divisions: 12;
                        enabled: root.enable;
                        label: root.percent;
                        moved(t) => {
                            root.draft = root.snap(t);
                            root.dragging = true;
                        }
                        released(t) => {
                            root.dragging = false;
                            root.set-scale(root.snap(t));
                        }
                    }
                    Text { text: "A"; font-size: 22px; color: Theme.s.on-surface-variant; vertical-alignment: center; }
                }
            }
        }
    }
}

// `_FontFamilyItem`: "Aa" and the family's name in that family, opening the font page.
component FontSection inherits VerticalLayout {
    in property <string> family;
    callback open();
    InfoHeader { title: "字体"; glyph: Icons.font; }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        Rectangle {
            background: fs-ta.pressed ? Theme.s.block : Theme.s.card;
            border-radius: 20px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                padding-top: 11px;
                padding-bottom: 11px;
                spacing: 12px;
                Text { text: "Aa"; font-size: 17px * Type.scale; font-weight: 600; font-family: root.family; color: Theme.s.on-surface; vertical-alignment: center; }
                Text {
                    horizontal-stretch: 1;
                    text: root.family == "" ? "默认" : root.family;
                    font-size: 15px * Type.scale;
                    font-family: root.family;
                    color: Theme.s.on-surface-variant;
                    vertical-alignment: center;
                    overflow: elide;
                }
                VerticalLayout { alignment: center; Icon { glyph: Icons.chevron; size: 20px; tint: Theme.s.on-surface-variant; } }
            }
            fs-ta := TouchArea { clicked => { root.open(); } }
        }
    }
}

// `DecorationListItem` with a `SelectionCheck`, the title in `family` when given.
component PickRow inherits Rectangle {
    in property <string> text;
    in property <string> family;
    in property <bool> checked;
    in property <bool> divider;
    callback clicked();
    height: max(52px, pr-text.preferred-height + 24px);
    background: pr-ta.pressed ? Theme.s.inset : transparent;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        pr-text := Text { text: root.text; font-family: root.family; font-size: 16px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        VerticalLayout {
            alignment: center;
            width: 22px;
            if root.checked: Icon { glyph: Icons.check; size: 22px; tint: Theme.s.primary; }
        }
    }
    if root.divider: Rectangle {
        x: 16px;
        y: parent.height - 1px;
        width: parent.width - self.x;
        height: 1px;
        background: Theme.s.outline-variant.with-alpha(0.6);
    }
    pr-ta := TouchArea { clicked => { root.clicked(); } }
}

// `SelectionSheet` (FlClash: lib/views/font_family.dart): 默认, then 已安装字体 with each name in
// its own family; a search once there are ten or more.
component FontPage inherits Rectangle {
    in property <[string]> families;
    in property <bool> loading;
    in property <bool> searchable;
    in property <string> selected;
    in-out property <bool> searching;
    in-out property <string> query;
    in property <length> bottom-gap: 32px;
    callback pick(string);
    callback search(string);
    callback back();
    changed query => { root.search(root.query); }
    hold := LoadingHold { loading: root.loading; }
    VerticalLayout {
        if !root.searching: AppBar {
            title: "字体";
            can-back: true;
            back => { root.back(); }
            if root.searchable: VerticalLayout { alignment: center; IconButton { glyph: Icons.search; tint: Theme.s.on-surface; clicked => { root.searching = true; } } }
        }
        if root.searching: HorizontalLayout {
            height: 56px;
            padding-left: 4px;
            padding-right: 8px;
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                IconButton { glyph: Icons.back; tint: Theme.s.on-surface; clicked => { root.query = ""; root.searching = false; } }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Rectangle {
                    height: 44px;
                    border-radius: 22px;
                    background: Theme.s.block;
                    Text {
                        x: 16px;
                        visible: ff-input.text == "";
                        text: "搜索";
                        color: Theme.s.on-surface-variant;
                        font-size: 15px * Type.scale;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    ff-input := TextInput {
                        x: 16px;
                        width: parent.width - 32px;
                        height: parent.height;
                        vertical-alignment: center;
                        single-line: true;
                        font-size: 15px * Type.scale;
                        color: Theme.s.on-surface;
                        text <=> root.query;
                        init => { self.focus(); }
                    }
                }
            }
        }
        if hold.shown: Rectangle {
            vertical-stretch: 1;
            Spinner { width: 32px; height: 32px; indeterminate: true; }
        }
        if !hold.shown && root.searching && root.query != "" && root.families.length == 0: Rectangle { vertical-stretch: 1; }
        if !hold.shown && !(root.searching && root.query != "" && root.families.length == 0): ff-flick := Flickable {
            // `_revealSelected`: once the list is in, the picked font is brought to the middle
            // unless it already shows.
            property <bool> revealed;
            vertical-stretch: 1;
            content-height: ff-col.preferred-height + Dock.pad;
            ff-col := VerticalLayout {
                alignment: start;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: root.bottom-gap;
                if !root.searching || root.query == "": VerticalLayout {
                    padding-bottom: 16px;
                    Group {
                        PickRow {
                            text: "默认";
                            checked: root.selected == "";
                            clicked => { root.pick(""); }
                        }
                    }
                }
                if root.families.length > 0: VerticalLayout {
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-top: 4px;
                        padding-bottom: 8px;
                        Text { text: "已安装字体"; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; }
                    }
                    Group {
                        for f[i] in root.families: PickRow {
                            text: f;
                            family: f;
                            checked: root.selected == f;
                            divider: i < root.families.length - 1;
                            clicked => { root.pick(f); }
                            init => {
                                if (self.checked && !ff-flick.revealed) {
                                    ff-flick.revealed = true;
                                    ff-flick.content-y = Reveal.offset(self.absolute-position.y - ff-col.absolute-position.y, self.height, -ff-flick.content-y, ff-flick.height, ff-flick.content-height);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Theme mode and pure black with sketches of the app, then the colours.
// FlClash: lib/views/theme.dart.
component ThemePage inherits Rectangle {
    in property <int> theme-mode;
    in property <bool> pure-black;
    in property <[Swatch]> swatches;
    in property <bool> can-reset;
    in property <string> style-label;
    // The schemes the sketches are drawn in: light, dark, and dark standard / pure black.
    in property <Scheme> light;
    in property <Scheme> dark;
    in property <Scheme> dark-standard;
    in property <Scheme> dark-black;
    in property <bool> floating;
    in property <bool> tab-fade;
    in property <string> font-family;
    in property <bool> text-scale-enable;
    in property <float> text-scale: 1;
    in property <length> bottom-gap: 32px;
    callback open-font();
    callback set-text-scale-enable(bool);
    callback set-text-scale(float);
    callback set-floating(bool);
    callback set-tab-animation(int);
    callback set-theme-mode(int);
    callback set-pure-black(bool);
    callback swatch-picked(int);
    callback swatch-menu(int);
    callback add-color();
    callback reset-colors();
    callback pick-style();
    callback back();
    VerticalLayout {
        AppBar { title: "主题"; can-back: true; back => { root.back(); } }
        Flickable {
            content-height: theme-col.preferred-height + Dock.pad;
            theme-col := VerticalLayout {
                alignment: start;
                padding-bottom: root.bottom-gap;
                spacing: 16px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 8px;
                    ThemeLivePreview { floating: root.floating; fade: root.tab-fade; }
                }
                VerticalLayout {
                    InfoHeader { title: "主题模式"; glyph: Icons.sun; }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 8px;
                        Group {
                            PreviewRow {
                                text: "自动";
                                checked: root.theme-mode == 0;
                                divider: true;
                                clicked => { root.set-theme-mode(0); }
                                MiniThumb { s: root.light; s2: root.dark; split: true; floating: root.floating; }
                            }
                            PreviewRow {
                                text: "浅色";
                                checked: root.theme-mode == 1;
                                divider: true;
                                clicked => { root.set-theme-mode(1); }
                                MiniThumb { s: root.light; floating: root.floating; }
                            }
                            PreviewRow {
                                text: "深色";
                                checked: root.theme-mode == 2;
                                clicked => { root.set-theme-mode(2); }
                                MiniThumb { s: root.dark; dark: true; floating: root.floating; }
                            }
                        }
                    }
                }
                VerticalLayout {
                    InfoHeader { title: "纯黑模式"; glyph: Icons.moon; }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 8px;
                        Group {
                            PreviewRow {
                                text: "标准";
                                checked: !root.pure-black;
                                divider: true;
                                clicked => { root.set-pure-black(false); }
                                MiniThumb { s: root.dark-standard; dark: true; floating: root.floating; }
                            }
                            PreviewRow {
                                text: "纯黑";
                                checked: root.pure-black;
                                clicked => { root.set-pure-black(true); }
                                MiniThumb { s: root.dark-black; dark: true; floating: root.floating; }
                            }
                        }
                    }
                }
                VerticalLayout {
                    InfoHeader {
                        title: "主题色彩";
                        glyph: Icons.palette;
                        if root.can-reset: VerticalLayout { alignment: center; ResetButton { clicked => { root.reset-colors(); } } }
                    }
                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 8px;
                        spacing: 8px;
                        SwatchGrid {
                            items: root.swatches;
                            picked(i) => { root.swatch-picked(i); }
                            menu(i) => { root.swatch-menu(i); }
                            add => { root.add-color(); }
                        }
                        Group {
                            OptionsRow { title: "配色风格"; value: root.style-label; clicked => { root.pick-style(); } }
                        }
                    }
                }
                VerticalLayout {
                    InfoHeader { title: "底栏"; glyph: Icons.layers; }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 8px;
                        Group {
                            PreviewRow {
                                text: "悬浮";
                                checked: root.floating;
                                divider: true;
                                clicked => { root.set-floating(true); }
                                MiniThumb { s: Theme.s; dark: Theme.is-dark; floating: true; }
                            }
                            PreviewRow {
                                text: "固定";
                                checked: !root.floating;
                                clicked => { root.set-floating(false); }
                                MiniThumb { s: Theme.s; dark: Theme.is-dark; floating: false; }
                            }
                        }
                    }
                }
                VerticalLayout {
                    InfoHeader { title: "选项卡动画"; glyph: Icons.motion; }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 8px;
                        Group {
                            PreviewRow {
                                text: "滑动";
                                checked: !root.tab-fade;
                                divider: true;
                                clicked => { root.set-tab-animation(0); }
                                MiniThumb { s: Theme.s; dark: Theme.is-dark; floating: root.floating; selected: 1; previous: 0; progress: 0.55; }
                            }
                            PreviewRow {
                                text: "淡入";
                                checked: root.tab-fade;
                                clicked => { root.set-tab-animation(1); }
                                MiniThumb { s: Theme.s; dark: Theme.is-dark; floating: root.floating; selected: 1; previous: 0; progress: 0.55; fade: true; }
                            }
                        }
                    }
                }
                FontSection { family: root.font-family; open => { root.open-font(); } }
                TextScaleSection {
                    enable: root.text-scale-enable;
                    value: root.text-scale;
                    set-enable(on) => { root.set-text-scale-enable(on); }
                    set-scale(v) => { root.set-text-scale(v); }
                }
            }
        }
    }
}

// `_GradientSlider`: a pill of the gradient, ringed faintly, with a thumb of the colour.
component GradientSlider inherits Rectangle {
    in property <float> value;
    in property <brush> track;
    in property <color> thumb;
    callback changed(float);
    height: 28px;
    property <length> travel: self.width - 28px;
    Rectangle {
        y: 4px;
        height: 20px;
        border-radius: 10px;
        background: root.track;
        border-width: 1px;
        border-color: Theme.s.outline-variant.with-alpha(0.6);
    }
    Rectangle {
        x: root.travel * clamp(root.value, 0, 1);
        width: 28px;
        height: 28px;
        border-radius: 14px;
        background: #ffffff;
        drop-shadow-color: #00000047;
        drop-shadow-blur: 2.5px;
        drop-shadow-offset-y: 1px;
        Rectangle { width: 22px; height: 22px; border-radius: 11px; background: root.thumb; }
    }
    gs-ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.changed(clamp((self.mouse-x - 14px) / root.travel, 0, 1));
            }
        }
        moved => {
            if (self.pressed) { root.changed(clamp((self.mouse-x - 14px) / root.travel, 0, 1)); }
        }
    }
}

component LabeledSlider inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 10px;
    HorizontalLayout {
        Text { text: root.label; font-size: 15px * Type.scale; font-weight: 600; color: Theme.s.on-surface-variant; horizontal-stretch: 1; }
        Text { text: root.value; font-size: 15px * Type.scale; color: Theme.s.on-surface-variant; }
    }
    @children
}

// The custom colour sheet (`_CustomColorSheet`): the colour sketched light and dark beside
// its hex digits, then the grid, spectrum and sliders. FlClash: lib/widgets/palette.dart.
component ColorPage inherits Rectangle {
    in property <color> draft;
    in property <Scheme> light;
    in property <Scheme> dark;
    in-out property <string> hex;
    in-out property <int> mode;
    in property <[color]> grid;
    in property <int> grid-cols: 12;
    in property <int> grid-selected: -1;
    in property <bool> grid-light-ink;
    in property <float> spec-x;
    in property <float> spec-y;
    in property <float> hue;
    in property <float> sat;
    in property <float> val;
    in property <color> hue-color;
    in property <color> sat-from;
    in property <color> sat-to;
    in property <color> val-to;
    in property <length> bottom-gap: 20px;
    pure callback hex-filter(string) -> string;
    callback hex-edited(string);
    callback grid-pick(int);
    callback spectrum-pick(float, float);
    callback hsv(float, float, float);
    callback confirm();
    callback back();
    property <int> grid-rows: ceil(root.grid.length / root.grid-cols);
    VerticalLayout {
        AppBar {
            title: "自定义颜色";
            can-back: true;
            back => { root.back(); }
            VerticalLayout { alignment: center; IconButton { glyph: Icons.check; tint: Theme.s.on-surface; clicked => { root.confirm(); } } }
        }
        Flickable {
            content-height: color-col.preferred-height + Dock.pad;
            color-col := VerticalLayout {
                alignment: start;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: root.bottom-gap;
                spacing: 16px;
                Rectangle {
                    background: Theme.s.card;
                    border-radius: 24px;
                    HorizontalLayout {
                        padding: 16px;
                        spacing: 12px;
                        Rectangle {
                            width: 72px;
                            height: 96px;
                            border-radius: 16px;
                            clip: true;
                            MiniScreen { s: root.light; }
                        }
                        Rectangle {
                            width: 72px;
                            height: 96px;
                            border-radius: 16px;
                            clip: true;
                            MiniScreen { s: root.dark; dark: true; }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            min-width: 96px;
                            Rectangle {
                                height: 48px;
                                border-radius: 14px;
                                background: Theme.s.block;
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 12px;
                                    spacing: 2px;
                                    Text { text: "#"; font-size: 16px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; horizontal-stretch: 0; }
                                    hex-input := TextInput {
                                        horizontal-stretch: 1;
                                        text <=> root.hex;
                                        font-size: 16px * Type.scale;
                                        color: Theme.s.on-surface;
                                        vertical-alignment: center;
                                        single-line: true;
                                        input-type: text;
                                        edited => {
                                            let clean = root.hex-filter(self.text);
                                            if (clean != self.text) { self.text = clean; }
                                            root.hex-edited(clean);
                                        }
                                    }
                                }
                                if root.hex == "": Text { x: 30px; text: "十六进制"; font-size: 16px * Type.scale; color: Theme.s.on-surface-variant.with-alpha(0.6); vertical-alignment: center; }
                            }
                        }
                    }
                }
                SegmentBar {
                    items: ["网格", "光谱", "滑块"];
                    value: root.mode;
                    picked(i) => { root.mode = i; }
                }
                if root.mode == 0: Rectangle {
                    height: self.width * root.grid-rows / root.grid-cols;
                    border-radius: 8px;
                    clip: true;
                    property <length> cw: self.width / root.grid-cols;
                    property <length> ch: self.height / root.grid-rows;
                    for c[i] in root.grid: Rectangle {
                        x: floor(mod(i, root.grid-cols) * parent.cw / 1px) * 1px;
                        y: floor(floor(i / root.grid-cols) * parent.ch / 1px) * 1px;
                        width: floor((mod(i, root.grid-cols) + 1) * parent.cw / 1px) * 1px - self.x;
                        height: floor((floor(i / root.grid-cols) + 1) * parent.ch / 1px) * 1px - self.y;
                        background: c;
                        if i == root.grid-selected: Rectangle {
                            x: 1.5px;
                            y: 1.5px;
                            width: parent.width - 3px;
                            height: parent.height - 3px;
                            border-radius: 4px;
                            border-width: 3px;
                            border-color: root.grid-light-ink ? #ffffff : #000000;
                        }
                    }
                    TouchArea {
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) { root.pick-cell(self.mouse-x, self.mouse-y, self.width, self.height); }
                        }
                        moved => {
                            if (self.pressed) { root.pick-cell(self.mouse-x, self.mouse-y, self.width, self.height); }
                        }
                    }
                }
                if root.mode == 1: Rectangle {
                    height: self.width * 5 / 6;
                    border-radius: 8px;
                    clip: true;
                    background: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.67%, #00ff00 33.33%, #00ffff 50%, #0000ff 66.67%, #ff00ff 83.33%, #ff0000 100%);
                    Rectangle {
                        background: @linear-gradient(180deg, #ffffff 0%, #ffffff00 50%, #00000000 50%, #000000 100%);
                    }
                    Rectangle {
                        x: root.spec-x * parent.width - 14px;
                        y: root.spec-y * parent.height - 14px;
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: #ffffff;
                        drop-shadow-color: #00000047;
                        drop-shadow-blur: 2.5px;
                        drop-shadow-offset-y: 1px;
                        Rectangle { width: 22px; height: 22px; border-radius: 11px; background: root.draft; }
                    }
                    TouchArea {
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) { root.spectrum-pick(clamp(self.mouse-x / self.width, 0, 1), clamp(self.mouse-y / self.height, 0, 1)); }
                        }
                        moved => {
                            if (self.pressed) { root.spectrum-pick(clamp(self.mouse-x / self.width, 0, 1), clamp(self.mouse-y / self.height, 0, 1)); }
                        }
                    }
                }
                if root.mode == 2: Rectangle {
                    background: Theme.s.card;
                    border-radius: 24px;
                    VerticalLayout {
                        padding: 16px;
                        padding-bottom: 20px;
                        spacing: 20px;
                        LabeledSlider {
                            label: "色相";
                            value: round(root.hue) + "°";
                            GradientSlider {
                                value: root.hue / 360;
                                thumb: root.hue-color;
                                track: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.67%, #00ff00 33.33%, #00ffff 50%, #0000ff 66.67%, #ff00ff 83.33%, #ff0000 100%);
                                changed(v) => { root.hsv(v * 360, root.sat, root.val); }
                            }
                        }
                        LabeledSlider {
                            label: "饱和度";
                            value: round(root.sat * 100) + "%";
                            GradientSlider {
                                value: root.sat;
                                thumb: root.draft;
                                track: @linear-gradient(90deg, root.sat-from 0%, root.sat-to 100%);
                                changed(v) => { root.hsv(root.hue, v, root.val); }
                            }
                        }
                        LabeledSlider {
                            label: "亮度";
                            value: round(root.val * 100) + "%";
                            GradientSlider {
                                value: root.val;
                                thumb: root.draft;
                                track: @linear-gradient(90deg, #000000 0%, root.val-to 100%);
                                changed(v) => { root.hsv(root.hue, root.sat, v); }
                            }
                        }
                    }
                }
            }
        }
    }
    function pick-cell(px: length, py: length, w: length, h: length) {
        let col = clamp(floor(px / w * root.grid-cols), 0, root.grid-cols - 1);
        let row = clamp(floor(py / h * root.grid-rows), 0, root.grid-rows - 1);
        root.grid-pick(row * root.grid-cols + col);
    }
}

// ---------------------------------------------------------------- Requests

// `SegmentedControl` (compact): a tray with the chosen segment raised.
// `_StatusMenuButton`: the status shown with its count, opening a menu of the statuses.
component StatusBar inherits Rectangle {
    in property <[string]> items;
    in property <[string]> counts;
    in property <int> value;
    callback open-menu();
    height: 36px;
    min-width: 0px;
    Rectangle {
            x: 0;
            width: min(row.preferred-width, root.width);
            height: root.height;
            border-radius: 18px;
            background: ta.pressed ? Theme.s.inset : Theme.s.card;
            row := HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 6px;
                Text {
                    text: root.value < root.items.length ? root.items[root.value] : "";
                    font-size: 15px * Type.scale;
                    font-weight: 600;
                    color: Theme.s.on-surface;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: root.value < root.counts.length ? root.counts[root.value] : "";
                    min-width: self.preferred-width * 1.08;
                    font-size: 15px * Type.scale;
                    color: Theme.s.on-surface-variant;
                    vertical-alignment: center;
                }
                VerticalLayout { alignment: center; Icon { glyph: Icons.updown; size: 16px; tint: Theme.s.on-surface-variant; } }
            }
            ta := TouchArea {
                clicked => {
                    MenuAnchor.at(self.absolute-position.x, self.absolute-position.y, 0px, self.height);
                    root.open-menu();
                }
            }
    }
}

// The conditions set (`ConditionBlock`): a field's line of chips, then clear all.
component ConditionBlock inherits Rectangle {
    in property <[ConditionLine]> lines;
    callback edit(int);
    callback remove(int);
    callback clear();
    background: Theme.s.block;
    border-radius: 14px;
    height: col.preferred-height;
    col := VerticalLayout {
        padding-left: 16px;
        padding-right: 8px;
        padding-top: 4px;
        for line[li] in root.lines: VerticalLayout {
            HorizontalLayout {
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 8px;
                Text {
                    text: line.label;
                    width: 64px;
                    height: 32px;
                    font-size: 13px * Type.scale;
                    color: Theme.s.on-surface-variant;
                    vertical-alignment: center;
                    overflow: elide;
                }
                // The chips wrap as `Wrap` does; Rust breaks them into rows by the width
                // `RequestsPage.cond-width` gives.
                VerticalLayout {
                    spacing: 6px;
                    for row in line.rows: HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for item in row.items: HorizontalLayout {
                            spacing: 6px;
                            if item.or: Text { text: "或"; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: center; }
                            Rectangle {
                                height: 32px;
                                width: min(chip-row.preferred-width, root.width - 120px);
                                border-radius: 16px;
                                background: Theme.s.card;
                                chip-row := HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 4px;
                                    spacing: 2px;
                                    Text { text: item.text; font-size: 13px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; overflow: elide; }
                                    Rectangle {
                                        width: 24px;
                                        Icon { glyph: Icons.close; size: 14px; tint: Theme.s.on-surface-variant; }
                                        TouchArea { clicked => { root.remove(item.index); } }
                                    }
                                }
                                TouchArea {
                                    width: parent.width - 28px;
                                    x: 0;
                                    clicked => { root.edit(item.index); }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.s.outline-variant.with-alpha(0.6); }
        }
        HorizontalLayout {
            height: 40px;
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: "同一行满足其一，各行都要满足";
                font-size: 12px * Type.scale;
                color: Theme.s.on-surface-variant;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle {
                width: clear-text.preferred-width * 1.1 + 16px;
                clear-text := Text { text: "清除全部"; font-size: 13px * Type.scale; color: Theme.s.primary; vertical-alignment: center; }
                TouchArea { clicked => { root.clear(); } }
            }
        }
    }
}

// `RecordLabelLine` (FlClash: lib/widgets/record_label_line.dart): a record's text, then its labels
// at their own widths, four apart. The text gives way first, then the last label within
// itself; the labels before it never shrink. A part left less than twice its height that
// does not fit whole is dropped.
export global RecordLine {
    out property <length> gap: 4px;
    public pure function shows(natural: length, height: length, room: length) -> bool {
        return room >= 2 * height || natural <= room;
    }
    // `w` holds each label's natural width, `n` how many there are.
    public pure function before(w: [length], k: int) -> length {
        return (k > 0 ? w[0] + 4px : 0px) + (k > 1 ? w[1] + 4px : 0px) + (k > 2 ? w[2] + 4px : 0px)
            + (k > 3 ? w[3] + 4px : 0px) + (k > 4 ? w[4] + 4px : 0px);
    }
    public pure function layout(room: length, text: length, text-h: length, label-h: length, w: [length], n: int) -> LineLayout {
        let before-last = n > 0 ? RecordLine.before(w, n - 1) : 0px;
        let last-room = room - before-last;
        let last-shown = n > 0 && RecordLine.shows(w[n - 1], label-h, last-room);
        let last-w = n > 0 ? min(w[n - 1], max(0px, last-room)) : 0px;
        let labels = before-last + (last-shown ? last-w + 4px : 0px);
        let text-room = room - labels;
        let text-shown = text > 0px && RecordLine.shows(text, text-h, text-room);
        return {
            text-shown: text-shown,
            text-w: text-shown ? min(text, max(0px, text-room)) : 0px,
            last-shown: last-shown,
            last-w: last-w,
            before-last: before-last
        };
    }
}

component RecordChip inherits Rectangle {
    in property <RecordLabel> label;
    in property <bool> shown: true;
    property <color> tone: root.label.tone == 1 ? Theme.s.error : root.label.tone == 2 ? Theme.success : root.label.tone == 3 ? Theme.warning : Theme.s.on-surface-variant;
    visible: root.shown && root.label.text != "";
    height: 20px;
    border-radius: 6px;
    background: root.label.tone == 0 ? Theme.s.block : root.tone.with-alpha(0.14);
    Text {
        x: 6px;
        width: max(0px, parent.width - 12px);
        text: root.label.text;
        font-size: 11px * Type.scale;
        font-weight: 600;
        color: root.tone;
        vertical-alignment: center;
        overflow: elide;
    }
}

component RecordLabelLine inherits Rectangle {
    in property <string> text;
    in property <[RecordLabel]> labels;
    in property <length> font-size: 12px * Type.scale;
    in property <color> tint: Theme.s.on-surface-variant;
    property <length> label-h: 20px;
    property <int> n: min(root.labels.length, 5);
    property <[length]> natural: [
        m0.preferred-width + 12px, m1.preferred-width + 12px, m2.preferred-width + 12px,
        m3.preferred-width + 12px, m4.preferred-width + 12px
    ];
    property <LineLayout> line: RecordLine.layout(self.width, root.text == "" ? 0px : mt.preferred-width, mt.preferred-height, root.label-h, root.natural, root.n);
    property <length> start: root.line.text-shown ? root.line.text-w + RecordLine.gap : 0px;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: (root.text == "" ? 0px : mt.preferred-width + RecordLine.gap) + RecordLine.before(root.natural, root.n);
    height: root.text == "" && root.n == 0 ? 0px : max(root.text == "" ? 0px : mt.preferred-height, root.n > 0 ? root.label-h : 0px);
    clip: true;
    mt := Text { visible: false; text: root.text; font-size: root.font-size; }
    m0 := Text { visible: false; text: root.labels[0].text; font-size: 11px * Type.scale; font-weight: 600; }
    m1 := Text { visible: false; text: root.labels[1].text; font-size: 11px * Type.scale; font-weight: 600; }
    m2 := Text { visible: false; text: root.labels[2].text; font-size: 11px * Type.scale; font-weight: 600; }
    m3 := Text { visible: false; text: root.labels[3].text; font-size: 11px * Type.scale; font-weight: 600; }
    m4 := Text { visible: false; text: root.labels[4].text; font-size: 11px * Type.scale; font-weight: 600; }
    if root.line.text-shown: Text {
        x: 0;
        width: root.line.text-w;
        text: root.text;
        font-size: root.font-size;
        color: root.tint;
        vertical-alignment: center;
        overflow: elide;
    }
    for l[i] in root.labels: RecordChip {
        property <bool> is-last: i == root.n - 1;
        x: root.start + (self.is-last ? root.line.before-last : RecordLine.before(root.natural, i));
        y: (parent.height - self.height) / 2;
        width: self.is-last ? root.line.last-w : root.natural[i];
        label: l;
        shown: i < root.n && (!self.is-last || root.line.last-shown);
    }
}

// `TrackerAppWell` without the app's icon (its name's first letter), or `LabelWell`.
component Well inherits Rectangle {
    in property <string> text;
    in property <bool> label;
    in property <string> app;
    in property <length> size: 40px;
    property <bool> iconed: root.app != "" && AppIcons.has(root.app, AppIcons.rev);
    width: size;
    height: size;
    border-radius: size * 0.28;
    background: root.iconed ? transparent : label ? Theme.s.block : Theme.s.primary-container;
    if root.iconed: Image {
        width: root.size;
        height: root.size;
        source: AppIcons.icon(root.app, AppIcons.rev);
    }
    if !root.iconed: Text {
        text: root.text;
        font-size: (root.label ? (root.text.character-count > 3 ? root.size * 0.26 : root.size * 0.32) : root.size * 0.42) * Type.scale;
        font-weight: 600;
        color: root.label ? Theme.s.on-surface-variant : Theme.s.on-primary-container;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A row of a requests list; a long press or a right click opens its menu.
component RecordRowView inherits Rectangle {
    in property <RecordRow> rec;
    in property <bool> marks;
    callback select(int);
    callback menu(int);
    property <bool> fired;
    property <color> muted: Theme.s.on-surface-variant;
    height: root.rec.header ? 40px : 64px;
    if root.rec.header: HorizontalLayout {
        padding-left: 28px;
        padding-right: 16px;
        padding-top: 14px;
        spacing: 8px;
        Text { text: root.rec.label; font-size: 13px * Type.scale; font-weight: 600; color: root.muted; vertical-alignment: center; }
        Text { text: root.rec.count; font-size: 13px * Type.scale; color: root.muted; vertical-alignment: center; horizontal-stretch: 1; }
    }
    if !root.rec.header: Rectangle {
        x: 16px;
        width: parent.width - 32px;
        background: (root.rec.selected && root.marks) || ta.pressed ? Theme.s.block : Theme.s.card;
        border-top-left-radius: root.rec.first ? 16px : 0;
        border-top-right-radius: root.rec.first ? 16px : 0;
        border-bottom-left-radius: root.rec.last ? 16px : 0;
        border-bottom-right-radius: root.rec.last ? 16px : 0;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 14px;
            spacing: 12px;
            VerticalLayout { alignment: center; Well { text: root.rec.well; label: root.rec.well-label; app: root.rec.app; } }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                horizontal-stretch: 1;
                Text { text: root.rec.title; font-size: 15px * Type.scale; color: Theme.s.on-surface; overflow: elide; }
                RecordLabelLine { text: root.rec.line; labels: root.rec.labels; }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                top := Text {
                    text: root.rec.top;
                    min-width: self.preferred-width * 1.12;
                    font-size: 13px * Type.scale;
                    font-weight: root.rec.top-strong ? 600 : 400;
                    horizontal-alignment: right;
                    color: root.rec.top-tone == 1 ? Theme.s.error : root.rec.top-tone == 2 ? Theme.success : root.rec.top-tone == 3 ? Theme.warning : root.rec.top-tone == 4 ? root.muted : Theme.s.on-surface;
                }
                if root.rec.bottom != "": Text {
                    text: root.rec.bottom;
                    min-width: self.preferred-width * 1.12;
                    font-size: 11px * Type.scale;
                    color: root.muted;
                    horizontal-alignment: right;
                }
            }
        }
        if !root.rec.last: Rectangle {
            x: 64px;
            y: parent.height - 1px;
            width: parent.width - 64px;
            height: 1px;
            background: Theme.s.outline-variant.with-alpha(0.6);
        }
        if root.rec.selected && root.marks: Rectangle {
            x: 0;
            width: 3px;
            height: 16px;
            border-radius: 1.5px;
            background: Theme.s.primary;
        }
        ta := TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    MenuAnchor.at(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y, 0px, 0px);
                    if (e.button == PointerEventButton.right) {
                        root.fired = true;
                        root.menu(root.rec.id);
                    } else {
                        root.fired = false;
                        hold.running = true;
                    }
                } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                    hold.running = false;
                }
            }
            moved => {
                if (abs(self.mouse-x - self.pressed-x) > 8px || abs(self.mouse-y - self.pressed-y) > 8px) {
                    hold.running = false;
                }
            }
            clicked => {
                if (!root.fired) { root.select(root.rec.id); }
            }
        }
        hold := Timer {
            interval: 450ms;
            running: false;
            triggered => {
                self.running = false;
                root.fired = true;
                root.menu(root.rec.id);
            }
        }
    }
}

// `NullStatus`: what an empty list or pane says.
component DetailRowView inherits Rectangle {
    in property <DetailRow> item;
    in property <bool> divider;
    callback tapped(string);
    property <color> muted: Theme.s.on-surface-variant;
    property <color> toned: root.item.tone == 1 ? Theme.s.error : root.item.tone == 2 ? Theme.success : root.item.tone == 3 ? Theme.warning : muted;
    property <bool> opens: root.item.kind == "link" || (root.item.arg != "" && root.item.kind != "traffic");
    property <bool> fired;
    height: body.preferred-height;
    background: ta.pressed && opens ? Theme.s.inset : transparent;
    ta := TouchArea {
        enabled: root.opens;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.fired = false;
                if (root.item.menu) {
                    MenuAnchor.at(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y, 0px, 0px);
                    if (e.button == PointerEventButton.right) {
                        root.fired = true;
                        root.tapped("menu:" + root.item.arg);
                    } else {
                        hold.running = true;
                    }
                }
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                hold.running = false;
            }
        }
        moved => {
            if (abs(self.mouse-x - self.pressed-x) > 8px || abs(self.mouse-y - self.pressed-y) > 8px) {
                hold.running = false;
            }
        }
        clicked => {
            if (!root.fired) { root.tapped(root.item.arg); }
        }
    }
    hold := Timer {
        interval: 450ms;
        running: false;
        triggered => {
            self.running = false;
            root.fired = true;
            root.tapped("menu:" + root.item.arg);
        }
    }
    body := VerticalLayout {
        if root.item.kind == "text": HorizontalLayout {
            height: 48px;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 24px;
            Text { text: root.item.title; font-size: 15px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; min-width: min(self.preferred-width, 72px); }
            if root.item.value != "": Text {
                text: root.item.value;
                font-size: 15px * Type.scale;
                color: root.item.tone == 0 ? root.muted : root.toned;
                vertical-alignment: center;
                horizontal-alignment: right;
                overflow: elide;
                max-width: self.preferred-width * 1.08;
                horizontal-stretch: 2;
            }
        }
        if root.item.kind == "stacked": HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 12px;
            if root.item.tone == 1: VerticalLayout { alignment: start; Icon { glyph: Icons.error; size: 20px; tint: Theme.s.error; } }
            VerticalLayout {
                spacing: 2px;
                Text { text: root.item.title; font-size: 15px * Type.scale; color: Theme.s.on-surface; wrap: word-wrap; }
                if root.item.value != "": Text { text: root.item.value; font-size: 13px * Type.scale; color: root.muted; wrap: word-wrap; overflow: elide; max-height: 54px; }
                if root.item.labels.length > 0: VerticalLayout {
                    padding-top: 2px;
                    RecordLabelLine { labels: root.item.labels; }
                }
            }
        }
        if root.item.kind == "rail" || root.item.kind == "link": HorizontalLayout {
            height: root.item.note == "" && root.item.labels.length == 0 ? 48px : 58px;
            padding-left: root.item.kind == "rail" ? 0 : 16px;
            padding-right: 16px;
            spacing: 4px;
            if root.item.kind == "rail": Rectangle {
                width: 44px;
                property <length> cy: root.item.note == "" && root.item.labels.length == 0 ? self.height / 2 : self.height / 2 - 9px;
                if !root.item.first: Rectangle { x: (parent.width - 1.5px) / 2; y: 0; width: 1.5px; height: max(0px, parent.cy - 8px); background: Theme.s.outline-variant; }
                if !root.item.last: Rectangle { x: (parent.width - 1.5px) / 2; y: parent.cy + 8px; width: 1.5px; height: max(0px, parent.height - parent.cy - 8px); background: Theme.s.outline-variant; }
                Rectangle {
                    x: (parent.width - 10px) / 2;
                    y: parent.cy - 5px;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    border-width: root.item.mark == 0 ? 1.7px : 0;
                    border-color: Theme.s.on-surface-variant;
                    background: root.item.mark == 1 ? Theme.s.primary : root.item.mark == 2 ? Theme.s.error : transparent;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text { text: root.item.title; font-size: 15px * Type.scale; font-weight: root.item.mark == 1 && root.item.kind == "rail" ? 600 : 400; color: Theme.s.on-surface; overflow: elide; }
                if root.item.note != "" || root.item.labels.length > 0: RecordLabelLine { text: root.item.note; labels: root.item.labels; font-size: 13px * Type.scale; }
            }
            if root.item.trailing != "": Text {
                text: root.item.trailing;
                min-width: self.preferred-width * 1.1;
                font-size: 13px * Type.scale;
                color: root.item.kind == "link" ? root.toned : root.muted;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            if root.item.kind == "link": VerticalLayout { alignment: center; Icon { glyph: Icons.chevron; size: 18px; tint: root.muted; } }
        }
        if root.item.kind == "code": HorizontalLayout {
            padding: 12px;
            Text { text: root.item.value; font-family: "monospace"; font-size: 12px * Type.scale; color: Theme.s.on-surface; wrap: word-wrap; }
        }
        if root.item.kind == "image": Rectangle {
            height: min(240px, root.item.image.height * 1px) + 24px;
            Image {
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                height: parent.height - 24px;
                source: root.item.image;
                image-fit: contain;
            }
        }
        if root.item.kind == "traffic": HorizontalLayout {
            spacing: 8px;
            for cell[ci] in [{ glyph: Icons.down, label: "下载", figure: root.item.title, speed: root.item.note }, { glyph: Icons.up, label: "上传", figure: root.item.value, speed: root.item.trailing }]: Rectangle {
                horizontal-stretch: 1;
                border-radius: 14px;
                background: Theme.s.block;
                height: cell-col.preferred-height;
                cell-col := VerticalLayout {
                    padding: 12px;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 4px;
                        Icon { glyph: cell.glyph; size: 16px; tint: Theme.s.primary; }
                        Text { text: cell.label; font-size: 13px * Type.scale; color: root.muted; vertical-alignment: center; }
                    }
                    Text { text: cell.figure; font-size: 17px * Type.scale; font-weight: 700; color: Theme.s.on-surface; min-width: max(self.preferred-width, self.text.character-count * 17px * 0.62) * 1.1; }
                    if cell.speed != "": Text { text: cell.speed + "/s"; font-size: 12px * Type.scale; color: root.muted; }
                }
            }
        }
        if root.divider: Rectangle { height: 1px; background: Theme.s.outline-variant.with-alpha(0.6); }
    }
}

// `_MitmHexView`: every byte of a body, as many bytes a line, in fours, as the width holds.
component HexPage inherits Rectangle {
    in property <string> title;
    in property <[string]> lines;
    in property <bool> truncated;
    callback back();
    callback menu();
    callback columns(int);
    property <length> margin: 16px;
    property <int> cols: floor((root.width - 2 * root.margin) / max(1px, probe.preferred-width / 10));
    changed cols => { root.columns(root.cols); }
    init => { root.columns(root.cols); }
    background: Theme.s.page;
    probe := Text { visible: false; text: "0000000000"; font-family: "monospace"; font-size: 12px * Type.scale; }
    VerticalLayout {
        AppBar {
            title: root.title;
            can-back: true;
            back => { root.back(); }
            VerticalLayout { alignment: center; IconButton { glyph: Icons.more; tint: Theme.s.on-surface; clicked => { MenuAnchor.at(self.absolute-position.x, self.absolute-position.y, self.width, self.height); root.menu(); } } }
        }
        if root.truncated: HorizontalLayout {
            padding-left: root.margin;
            padding-right: root.margin;
            padding-bottom: 12px;
            Text { text: "只记录了这段内容的开头部分。"; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; wrap: word-wrap; }
        }
        ListView {
            vertical-stretch: 1;
            for line in root.lines: HorizontalLayout {
                height: probe.preferred-height + 4px;
                padding-left: root.margin;
                padding-right: root.margin;
                Text { text: line; font-family: "monospace"; font-size: 12px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; overflow: clip; }
            }
        }
        Rectangle { height: Dock.pad; }
    }
}

// A record's detail: its head, its tabs (`DetailTabs`) and the sections of the tab shown.
component DetailView inherits Rectangle {
    in property <ReqDetail> detail;
    in property <bool> stretch-tabs;
    in property <bool> head-menu;
    in property <length> top-gap: 20px;
    in property <length> bottom-gap;
    callback tab(int);
    callback close();
    callback menu();
    callback open-row(string);
    if !root.detail.has: NullStatus { label: root.detail.empty; description: root.detail.hint; }
    if root.detail.has: VerticalLayout {
        padding-top: root.top-gap;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 8px;
            padding-bottom: 16px;
            spacing: 12px;
            if root.detail.well != "": VerticalLayout { alignment: center; Well { text: root.detail.well; label: root.detail.well-label; app: root.detail.app; size: 40px; } }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                horizontal-stretch: 1;
                Text { text: root.detail.title; font-size: 17px * Type.scale; font-weight: 600; color: Theme.s.on-surface; overflow: elide; }
                if root.detail.subtitle != "" || root.detail.labels.length > 0: RecordLabelLine { text: root.detail.subtitle; labels: root.detail.labels; font-size: 13px * Type.scale; }
            }
            if root.detail.closable: VerticalLayout { alignment: center; IconButton { glyph: Icons.block; tint: Theme.s.error; clicked => { root.close(); } } }
            if root.head-menu && root.detail.menu: VerticalLayout { alignment: center; IconButton { glyph: Icons.more; clicked => { root.menu(); } } }
        }
        if root.detail.tabs.length > 1: HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            alignment: root.stretch-tabs ? stretch : start;
            SegmentBar {
                items: root.detail.tabs;
                value: root.detail.tab;
                bar-height: 36px;
                picked(i) => { root.tab(i); }
            }
        }
        if root.detail.loading || root.detail.sections.length == 0: NullStatus {
            vertical-stretch: 1;
            label: root.detail.loading ? "" : root.detail.empty;
        }
        if !root.detail.loading && root.detail.sections.length > 0: Flickable {
            vertical-stretch: 1;
            content-height: max(secs.preferred-height, self.height) + Dock.pad;
            secs := VerticalLayout {
                alignment: start;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 4px;
                padding-bottom: 16px + root.bottom-gap;
                for sec in root.detail.sections: VerticalLayout {
                    if sec.title != "": HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        Text { text: sec.title; height: 40px; font-size: 15px * Type.scale; font-weight: 600; color: Theme.s.on-surface-variant; vertical-alignment: bottom; horizontal-stretch: 1; }
                        if sec.caption != "": Text { text: sec.caption; height: 40px; min-width: self.preferred-width * 1.1; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: bottom; horizontal-alignment: right; }
                    }
                    if sec.title != "": Rectangle { height: 6px; }
                    if sec.title == "": Rectangle { height: 12px; }
                    if sec.plain: VerticalLayout {
                        for r in sec.rows: DetailRowView { item: r; tapped(a) => { root.open-row(a); } }
                    }
                    if !sec.plain && sec.rows.length > 0: Rectangle {
                        background: Theme.s.block;
                        border-radius: 14px;
                        clip: true;
                        VerticalLayout {
                            for r[ri] in sec.rows: DetailRowView {
                                item: r;
                                divider: ri < sec.rows.length - 1 && r.kind != "rail";
                                tapped(a) => { root.open-row(a); }
                            }
                        }
                    }
                    if sec.footer != "": HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 6px;
                        Text { text: sec.footer; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; wrap: word-wrap; }
                    }
                }
            }
        }
    }
}

// The page's head: the segments, then the filter row and the conditions.
component ReqHeader inherits VerticalLayout {
    in property <int> segment;
    in property <bool> shows-http;
    in property <[string]> statuses;
    in property <[string]> counts;
    in property <int> status;
    in property <[ConditionLine]> conditions;
    callback set-segment(int);
    callback status-menu();
    callback add-condition();
    callback edit-condition(int);
    callback remove-condition(int);
    callback clear-conditions();
    padding-top: 4px;
    padding-bottom: 4px;
    spacing: 12px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        SegmentBar {
            items: root.shows-http ? ["连接", "HTTP", "DNS"] : ["连接", "DNS"];
            value: root.segment == 2 ? (root.shows-http ? 2 : 1) : root.segment;
            picked(i) => { root.set-segment(!root.shows-http && i == 1 ? 2 : i); }
        }
    }
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            StatusBar {
                horizontal-stretch: 1;
                items: root.statuses;
                counts: root.counts;
                value: root.status;
                open-menu => { root.status-menu(); }
            }
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: add-ta.pressed ? Theme.s.inset : Theme.s.block;
                Icon { glyph: Icons.plus; size: 18px; tint: Theme.s.on-surface; }
                add-ta := TouchArea { clicked => { root.add-condition(); } }
            }
        }
        if root.conditions.length > 0: ConditionBlock {
            lines: root.conditions;
            edit(i) => { root.edit-condition(i); }
            remove(i) => { root.remove-condition(i); }
            clear => { root.clear-conditions(); }
        }
    }
}

// `RecordFeedView`: the list follows the newest until scrolled away from it and again once
// back at it (`ScrollToEndBox`), and rows that come in meanwhile leave the rows read in
// place (`FollowEndScrollPhysics`).
component ReqList inherits Rectangle {
    in property <[RecordRow]> rows;
    in property <bool> marks;
    in property <string> empty;
    in property <string> empty-desc;
    in property <length> bottom-gap;
    in property <int> segment;
    in property <length> shift;
    in property <int> shift-seq;
    callback select(int);
    callback menu(int);
    property <bool> following: true;

    changed segment => {
        root.following = true;
        lv.content-y = 0;
    }
    changed shift-seq => {
        if (root.following) {
            lv.content-y = 0;
        } else {
            lv.content-y = max(lv.content-y - root.shift, min(0px, lv.height - lv.content-height));
        }
    }

    if root.rows.length == 0: NullStatus { label: root.empty; description: root.empty-desc; }
    lv := ListView {
        visible: root.rows.length > 0;
        vertical-scrollbar-policy: always-off;
        scrolled => {
            root.following = self.content-y >= -0.5px;
            bar.poke();
        }
        for r in root.rows: RecordRowView {
            rec: r;
            marks: root.marks;
            select(id) => { root.select(id); }
            menu(id) => { root.menu(id); }
        }
    }
    bar := FeedBar {
        visible: root.rows.length > 0;
        content-height: lv.content-height;
        content-y <=> lv.content-y;
        bottom-gap: root.bottom-gap;
        hint: root.rows.length > 0 ? root.rows[clamp(round(self.fraction * (root.rows.length - 1)), 0, root.rows.length - 1)].time : "";
        dragged => { root.following = lv.content-y >= -0.5px; }
    }
}

// The installed apps with a checkbox each, a floating bar saying what the selection does,
// select all and save in the bar, the rest in the menu. FlClash: lib/views/access.dart.
component AccessPage inherits Rectangle {
    in property <[AccessRow]> rows;
    in property <bool> enabled;
    in property <bool> changed;
    in property <bool> all-selected;
    in property <bool> can-select-all;
    in property <bool> loading;
    in property <bool> needs-permission;
    in property <bool> authorize;
    in property <string> status;
    in property <string> count;
    in property <length> bottom-gap;
    in-out property <bool> searching;
    in-out property <string> query;
    callback back();
    callback toggle(string);
    callback select-all();
    callback save();
    callback menu();
    callback enable();
    callback grant();
    callback search(string);
    changed query => { root.search(root.query); }
    VerticalLayout {
        if !root.searching: AppBar {
            title: "应用访问控制";
            can-back: true;
            back => { root.back(); }
            VerticalLayout { alignment: center; IconButton { glyph: Icons.search; tint: Theme.s.on-surface; clicked => { root.searching = true; } } }
            if root.enabled && !root.needs-permission: VerticalLayout {
                alignment: center;
                IconButton { glyph: root.all-selected ? Icons.deselect : Icons.select-all; enabled: root.can-select-all; tint: Theme.s.on-surface; clicked => { root.select-all(); } }
            }
            if root.changed: VerticalLayout { alignment: center; IconButton { glyph: Icons.check; tint: Theme.s.primary; clicked => { root.save(); } } }
            VerticalLayout { alignment: center; IconButton { glyph: Icons.more; tint: Theme.s.on-surface; clicked => { MenuAnchor.at(self.absolute-position.x, self.absolute-position.y, self.width, self.height); root.menu(); } } }
        }
        if root.searching: HorizontalLayout {
            height: 56px;
            padding-left: 4px;
            padding-right: 8px;
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                IconButton { glyph: Icons.back; tint: Theme.s.on-surface; clicked => { root.query = ""; root.searching = false; } }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Rectangle {
                    height: 44px;
                    border-radius: 22px;
                    background: Theme.s.block;
                    Text {
                        x: 16px;
                        visible: acc-input.text == "";
                        text: "搜索";
                        color: Theme.s.on-surface-variant;
                        font-size: 15px * Type.scale;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    acc-input := TextInput {
                        x: 16px;
                        width: parent.width - 32px;
                        height: parent.height;
                        vertical-alignment: center;
                        single-line: true;
                        font-size: 15px * Type.scale;
                        color: Theme.s.on-surface;
                        text <=> root.query;
                        init => { self.focus(); }
                    }
                }
            }
            if root.enabled && !root.needs-permission: VerticalLayout {
                alignment: center;
                IconButton { glyph: root.all-selected ? Icons.deselect : Icons.select-all; enabled: root.can-select-all; tint: Theme.s.on-surface; clicked => { root.select-all(); } }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            if root.needs-permission: VerticalLayout {
                alignment: center;
                spacing: 6px;
                padding-left: 32px;
                padding-right: 32px;
                Text { text: "需要读取应用列表权限"; font-size: 16px * Type.scale; font-weight: 600; color: Theme.s.on-surface; horizontal-alignment: center; wrap: word-wrap; }
                Text { text: "当前系统在授权前不会提供已安装的应用列表，授权后即可配置分应用代理。"; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; horizontal-alignment: center; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: center;
                    padding-top: 12px;
                    TextButton { text: "授权"; filled: true; clicked => { root.grant(); } }
                }
            }
            if !root.needs-permission && root.loading: Spinner { width: 32px; height: 32px; indeterminate: true; }
            if !root.needs-permission && !root.loading && root.rows.length == 0: NullStatus { label: "暂无数据"; }
            if !root.needs-permission && !root.loading && root.rows.length > 0: Rectangle {
                opacity: root.enabled ? 1 : 0.45;
                ListView {
                    y: 0;
                    height: parent.height - 80px - root.bottom-gap;
                    for r in root.rows: Rectangle {
                        height: 72px;
                        background: row-ta.pressed ? Theme.s.inset : transparent;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 16px;
                            VerticalLayout {
                                alignment: center;
                                acc-icon := Rectangle {
                                    property <bool> iconed: AppIcons.has(r.name, AppIcons.rev);
                                    width: 44px;
                                    height: 44px;
                                    border-radius: 12px;
                                    background: self.iconed ? transparent : Theme.s.primary-container;
                                    if acc-icon.iconed: Image { width: 44px; height: 44px; source: AppIcons.icon(r.name, AppIcons.rev); }
                                    if !acc-icon.iconed: Text { text: r.monogram; font-size: 18px * Type.scale; font-weight: 600; color: Theme.s.on-primary-container; }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text { text: r.label; font-size: 16px * Type.scale; color: Theme.s.on-surface; overflow: elide; }
                                Text { text: r.name; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; overflow: elide; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    border-radius: 4px;
                                    border-width: r.checked ? 0px : 2px;
                                    border-color: Theme.s.on-surface-variant;
                                    background: r.checked ? Theme.s.primary : transparent;
                                    if r.checked: Icon { glyph: Icons.check; size: 16px; tint: Theme.s.on-primary; }
                                }
                            }
                        }
                        row-ta := TouchArea {
                            enabled: root.enabled;
                            clicked => { root.toggle(r.name); }
                        }
                    }
                }
            }
            if !root.needs-permission: Rectangle {
                x: 16px;
                y: parent.height - self.height - 12px - root.bottom-gap;
                width: parent.width - 32px;
                height: max(56px, foot.preferred-height);
                border-radius: 16px;
                background: Theme.s.card;
                border-width: 1px;
                border-color: Theme.s.outline-variant.with-alpha(0.6);
                foot := HorizontalLayout {
                    padding-left: 16px;
                    padding-right: root.enabled && !root.authorize ? 16px : 8px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 12px;
                    VerticalLayout { alignment: center; Icon { glyph: root.enabled && !root.authorize ? Icons.apps : Icons.info; size: 20px; tint: Theme.s.on-surface-variant; } }
                    Text { horizontal-stretch: 1; text: root.status; font-size: 13px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; wrap: word-wrap; overflow: elide; }
                    if root.authorize: VerticalLayout { alignment: center; TextButton { text: "授权"; clicked => { root.grant(); } } }
                    if root.enabled && !root.authorize: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 28px;
                            min-width: chip.preferred-width * 1.1 + 20px;
                            border-radius: 14px;
                            background: Theme.s.primary.with-alpha(0.15);
                            chip := Text { text: root.count; font-size: 13px * Type.scale; color: Theme.s.primary; }
                        }
                    }
                    if !root.enabled: VerticalLayout { alignment: center; TextButton { text: "开启"; clicked => { root.enable(); } } }
                }
            }
        }
    }
}

// The connections, HTTP requests and DNS queries of this run; beside the list on a wide
// page the selection's detail, else a sheet. FlClash: lib/views/connection/requests.dart.
component RequestsPage inherits Rectangle {
    in property <bool> mobile;
    in property <bool> can-back;
    in property <int> segment;
    in property <bool> shows-http;
    in property <[RecordRow]> rows;
    in property <length> shift;
    in property <int> shift-seq;
    in property <[string]> statuses;
    in property <[string]> counts;
    in property <int> status;
    in property <[ConditionLine]> conditions;
    in property <string> empty;
    in property <string> empty-desc;
    in property <ReqDetail> detail;
    in property <bool> has-menu;
    in-out property <bool> searching;
    in-out property <string> query;
    out property <bool> split: !root.mobile && root.width >= 392px + 496px;
    // Room for a condition line's chips: the header's width less the block's insets and
    // the field label.
    out property <length> cond-width: (root.split ? 392px : root.width) - 32px - 24px - 72px - 8px;
    callback cond-width-changed(length);
    changed cond-width => { root.cond-width-changed(root.cond-width); }
    init => { root.cond-width-changed(root.cond-width); }
    // `_settleDetail`: the selection moves between the sheet and the pane.
    callback split-changed(bool);
    changed split => { root.split-changed(root.split); }
    callback back();
    callback search(string);
    callback open-menu();
    callback set-segment(int);
    callback status-menu();
    callback add-condition();
    callback edit-condition(int);
    callback remove-condition(int);
    callback clear-conditions();
    callback select(int, bool);
    callback row-menu(int);
    callback detail-tab(int);
    callback detail-close();
    callback detail-menu();
    callback detail-row(string);

    changed query => { root.search(root.query); }

    VerticalLayout {
        if !root.searching: AppBar {
            title: "请求";
            can-back: root.can-back;
            back => { root.back(); }
            VerticalLayout { alignment: center; IconButton { glyph: Icons.search; tint: Theme.s.on-surface; clicked => { root.searching = true; } } }
            if root.has-menu: VerticalLayout { alignment: center; IconButton { glyph: Icons.more; tint: Theme.s.on-surface; clicked => { MenuAnchor.at(self.absolute-position.x, self.absolute-position.y, self.width, self.height); root.open-menu(); } } }
        }
        if root.searching: HorizontalLayout {
            height: 56px;
            padding-left: 4px;
            padding-right: 12px;
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                IconButton { glyph: Icons.back; tint: Theme.s.on-surface; clicked => { root.query = ""; root.searching = false; } }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Rectangle {
                    height: 44px;
                    border-radius: 22px;
                    background: Theme.s.block;
                    Text {
                        x: 16px;
                        visible: req-input.text == "";
                        text: "搜索";
                        color: Theme.s.on-surface-variant;
                        font-size: 15px * Type.scale;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    req-input := TextInput {
                        x: 16px;
                        width: parent.width - 32px;
                        height: parent.height;
                        vertical-alignment: center;
                        single-line: true;
                        font-size: 15px * Type.scale;
                        color: Theme.s.on-surface;
                        text <=> root.query;
                        init => { self.focus(); }
                    }
                }
            }
            if root.has-menu: VerticalLayout { alignment: center; IconButton { glyph: Icons.more; tint: Theme.s.on-surface; clicked => { MenuAnchor.at(self.absolute-position.x, self.absolute-position.y, self.width, self.height); root.open-menu(); } } }
        }
        if !root.split: ReqHeader {
            segment: root.segment;
            shows-http: root.shows-http;
            statuses: root.statuses;
            counts: root.counts;
            status: root.status;
            conditions: root.conditions;
            set-segment(s) => { root.set-segment(s); }
            status-menu => { root.status-menu(); }
            add-condition => { root.add-condition(); }
            edit-condition(i) => { root.edit-condition(i); }
            remove-condition(i) => { root.remove-condition(i); }
            clear-conditions => { root.clear-conditions(); }
        }
        if !root.split: ReqList {
            vertical-stretch: 1;
            rows: root.rows;
            segment: root.segment;
            shift: root.shift;
            shift-seq: root.shift-seq;
            marks: !root.mobile;
            empty: root.empty;
            empty-desc: root.empty-desc;
            select(id) => { root.select(id, false); }
            menu(id) => { root.row-menu(id); }
        }
        if root.split: HorizontalLayout {
            vertical-stretch: 1;
            VerticalLayout {
                width: 392px;
                ReqHeader {
                    segment: root.segment;
                    shows-http: root.shows-http;
                    statuses: root.statuses;
                    counts: root.counts;
                    status: root.status;
                    conditions: root.conditions;
                    set-segment(s) => { root.set-segment(s); }
                    status-menu => { root.status-menu(); }
                    add-condition => { root.add-condition(); }
                    edit-condition(i) => { root.edit-condition(i); }
                    remove-condition(i) => { root.remove-condition(i); }
                    clear-conditions => { root.clear-conditions(); }
                }
                ReqList {
                    vertical-stretch: 1;
                    rows: root.rows;
                    segment: root.segment;
                    shift: root.shift;
                    shift-seq: root.shift-seq;
                    marks: true;
                    empty: root.empty;
                    empty-desc: root.empty-desc;
                    select(id) => { root.select(id, true); }
                    menu(id) => { root.row-menu(id); }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                padding-top: 4px;
                padding-left: 4px;
                padding-right: 12px;
                padding-bottom: 12px;
                Rectangle {
                    background: Theme.s.card;
                    border-radius: 28px;
                    clip: true;
                    DetailView {
                        detail: root.detail;
                        head-menu: true;
                        tab(i) => { root.detail-tab(i); }
                        close => { root.detail-close(); }
                        menu => { root.detail-menu(); }
                        open-row(a) => { root.detail-row(a); }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------- Resources

component ResourceRow inherits Rectangle {
    in property <ResourceItem> item;
    in property <bool> divider;
    callback tapped(string);
    callback menu(string);
    property <bool> fired;
    height: 64px;
    background: rta.pressed ? Theme.s.inset : transparent;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.item.title; font-size: 16px * Type.scale; color: Theme.s.on-surface; overflow: elide; }
            Text { text: root.item.subtitle; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; overflow: elide; }
        }
        if root.item.busy: VerticalLayout { alignment: center; Spinner { width: 22px; height: 22px; indeterminate: true; } }
        if !root.item.busy && root.item.chip != "": VerticalLayout {
            alignment: center;
            Rectangle {
                height: 24px;
                width: chip-text.preferred-width * 1.1 + 20px;
                border-radius: 12px;
                background: Theme.s.block;
                chip-text := Text { text: root.item.chip; font-size: 12px * Type.scale; font-weight: 600; color: Theme.s.on-surface-variant; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
    if root.divider: Rectangle { x: 16px; y: parent.height - 1px; width: parent.width - 16px; height: 1px; background: Theme.s.outline-variant.with-alpha(0.6); }
    rta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                if (e.button == PointerEventButton.right) {
                    root.fired = true;
                    root.menu(root.item.key);
                } else {
                    root.fired = false;
                    rhold.running = true;
                }
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                rhold.running = false;
            }
        }
        moved => {
            if (abs(self.mouse-x - self.pressed-x) > 8px || abs(self.mouse-y - self.pressed-y) > 8px) {
                rhold.running = false;
            }
        }
        clicked => { if (!root.fired) { root.tapped(root.item.key); } }
    }
    rhold := Timer {
        interval: 450ms;
        running: false;
        triggered => {
            self.running = false;
            root.fired = true;
            root.menu(root.item.key);
        }
    }
}

// The geo files' auto update and each file. FlClash: lib/views/resources.dart.
component ResourcesPage inherits Rectangle {
    in property <[ResourceItem]> items;
    in property <[ResourceItem]> icon-sets;
    in property <[ResourceItem]> rule-sets;
    in property <[ResourceItem]> scripts;
    in property <[ResourceItem]> modules;
    in property <bool> auto;
    in property <string> interval;
    in property <bool> updating;
    callback back();
    callback update-all();
    callback set-auto(bool);
    callback open-interval();
    callback tapped(string);
    callback menu(string);
    VerticalLayout {
        AppBar {
            title: "资源";
            can-back: true;
            back => { root.back(); }
            VerticalLayout {
                alignment: center;
                if root.updating: Rectangle { width: 40px; height: 40px; Spinner { width: 22px; height: 22px; indeterminate: true; } }
                if !root.updating: IconButton { glyph: Icons.sync; tint: Theme.s.on-surface; clicked => { root.update-all(); } }
            }
        }
        Flickable {
            content-height: max(res-col.preferred-height, self.height) + Dock.pad;
            res-col := VerticalLayout {
                alignment: start;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: 24px;
                spacing: 6px;
                Rectangle {
                    background: Theme.s.card;
                    border-radius: 16px;
                    clip: true;
                    VerticalLayout {
                        HorizontalLayout {
                            height: 56px;
                            padding-left: 16px;
                            padding-right: 16px;
                            Text { text: "自动更新"; font-size: 16px * Type.scale; color: Theme.s.on-surface; vertical-alignment: center; horizontal-stretch: 1; }
                            VerticalLayout { alignment: center; Switch { checked: root.auto; toggled(on) => { root.set-auto(on); } } }
                        }
                        if root.auto: HorizontalLayout { padding-left: 16px; Rectangle { height: 1px; background: Theme.s.outline-variant.with-alpha(0.6); } }
                        if root.auto: Rectangle {
                            height: 64px;
                            background: ita.pressed ? Theme.s.inset : transparent;
                            VerticalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: center;
                                spacing: 2px;
                                Text { text: "自动更新间隔"; font-size: 16px * Type.scale; color: Theme.s.on-surface; }
                                Text { text: root.interval; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; }
                            }
                            ita := TouchArea { clicked => { root.open-interval(); } }
                        }
                    }
                }
                HorizontalLayout { padding-left: 14px; Text { text: "Geo"; height: 40px; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: bottom; } }
                Rectangle {
                    background: Theme.s.card;
                    border-radius: 16px;
                    clip: true;
                    VerticalLayout {
                        for it[i] in root.items: ResourceRow {
                            item: it;
                            divider: i < root.items.length - 1;
                            tapped(k) => { root.tapped(k); }
                            menu(k) => { root.menu(k); }
                        }
                    }
                }
                if root.icon-sets.length > 0: HorizontalLayout { padding-left: 14px; Text { text: "图标集"; height: 40px; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: bottom; } }
                if root.icon-sets.length > 0: Rectangle {
                    background: Theme.s.card;
                    border-radius: 16px;
                    clip: true;
                    VerticalLayout {
                        for it[i] in root.icon-sets: ResourceRow {
                            item: it;
                            divider: i < root.icon-sets.length - 1;
                            tapped(k) => { root.tapped(k); }
                            menu(k) => { root.menu(k); }
                        }
                    }
                }
                if root.rule-sets.length > 0: HorizontalLayout { padding-left: 14px; Text { text: "规则集"; height: 40px; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: bottom; } }
                if root.rule-sets.length > 0: Rectangle {
                    background: Theme.s.card;
                    border-radius: 16px;
                    clip: true;
                    VerticalLayout {
                        for it[i] in root.rule-sets: ResourceRow {
                            item: it;
                            divider: i < root.rule-sets.length - 1;
                            tapped(k) => { root.tapped(k); }
                            menu(k) => { root.menu(k); }
                        }
                    }
                }
                if root.scripts.length > 0: HorizontalLayout { padding-left: 14px; Text { text: "脚本"; height: 40px; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: bottom; } }
                if root.scripts.length > 0: Rectangle {
                    background: Theme.s.card;
                    border-radius: 16px;
                    clip: true;
                    VerticalLayout {
                        for it[i] in root.scripts: ResourceRow {
                            item: it;
                            divider: i < root.scripts.length - 1;
                            tapped(k) => { root.tapped(k); }
                            menu(k) => { root.menu(k); }
                        }
                    }
                }
                if root.modules.length > 0: HorizontalLayout { padding-left: 14px; Text { text: "模块"; height: 40px; font-size: 13px * Type.scale; color: Theme.s.on-surface-variant; vertical-alignment: bottom; } }
                if root.modules.length > 0: Rectangle {
                    background: Theme.s.card;
                    border-radius: 16px;
                    clip: true;
                    VerticalLayout {
                        for it[i] in root.modules: ResourceRow {
                            item: it;
                            divider: i < root.modules.length - 1;
                            tapped(k) => { root.tapped(k); }
                            menu(k) => { root.menu(k); }
                        }
                    }
                }
            }
        }
    }
}

// A menu as a sheet from the bottom (`PopupMenuItem`s: a heading starts a titled section,
// section a plain one; sub rows sit under the row that opened them).
component ActionSheet inherits Rectangle {
    in property <string> title;
    in property <[ActionItem]> items;
    in property <length> bottom-inset;
    // `SelectionSheet.loadingStatus`: the list loads late; the picked row is still revealed.
    in property <bool> loading;
    callback picked(string);
    callback dismiss();
    hold := LoadingHold { loading: root.loading; }
    background: #00000066;
    TouchArea { clicked => { root.dismiss(); } }
    Rectangle {
        y: parent.height - self.height;
        height: min((hold.shown ? 12px + (root.title != "" ? 40px : 0px) + 160px : sheet-col.preferred-height) + root.bottom-inset, parent.height - 48px);
        background: Theme.s.card;
        border-top-left-radius: 24px;
        border-top-right-radius: 24px;
        TouchArea { }
        if hold.shown: VerticalLayout {
            height: parent.height - root.bottom-inset;
            padding-top: 12px;
            if root.title != "": HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                Text { text: root.title; font-size: 16px * Type.scale; color: Theme.s.on-surface-variant; height: 40px; vertical-alignment: center; overflow: elide; }
            }
            Rectangle {
                height: 160px;
                Spinner { width: 32px; height: 32px; indeterminate: true; }
            }
        }
        sheet-flick := Flickable {
            property <bool> revealed;
            visible: !hold.shown;
            height: parent.height - root.bottom-inset;
            content-height: sheet-col.preferred-height;
            sheet-col := VerticalLayout {
                padding-top: 12px;
                padding-bottom: 8px;
                if root.title != "": HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    Text { text: root.title; font-size: 16px * Type.scale; color: Theme.s.on-surface-variant; height: 40px; vertical-alignment: center; overflow: elide; }
                }
                for a[ai] in root.items: VerticalLayout {
                    if ai > 0 && (a.section || a.heading != ""): Rectangle { height: 8px; Rectangle { y: 3px; height: 1px; background: Theme.s.outline-variant.with-alpha(0.6); } }
                    if a.heading != "": HorizontalLayout {
                        padding-left: 16px;
                        Text { text: a.heading; font-size: 13px * Type.scale; color: Theme.s.primary; height: 32px; vertical-alignment: center; }
                    }
                    Rectangle {
                        height: a.subtitle != "" ? 60px : 48px;
                        opacity: a.enabled ? 1 : 0.4;
                        background: ata.pressed ? Theme.s.inset : transparent;
                        HorizontalLayout {
                            padding-left: a.sub ? 40px : 16px;
                            padding-right: 16px;
                            spacing: 14px;
                            if a.glyph != "": VerticalLayout {
                                alignment: center;
                                Icon {
                                    size: 20px;
                                    tint: a.danger ? Theme.s.error : Theme.s.on-surface-variant;
                                    glyph: a.glyph == "copy" ? Icons.copy : a.glyph == "filter" ? Icons.filter : a.glyph == "eye-off" ? Icons.eye-off : a.glyph == "block" ? Icons.block : a.glyph == "sync" ? Icons.sync : a.glyph == "edit" ? Icons.edit : a.glyph == "delete" ? Icons.delete : a.glyph == "fold" ? Icons.fold : a.glyph == "unfold" ? Icons.unfold : Glyphs.of(a.glyph);
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text { text: a.label; font-size: 15px * Type.scale; color: a.danger ? Theme.s.error : Theme.s.on-surface; overflow: elide; }
                                if a.subtitle != "": Text { text: a.subtitle; font-size: 12px * Type.scale; color: Theme.s.on-surface-variant; overflow: elide; }
                            }
                            if a.check: VerticalLayout {
                                alignment: center;
                                width: 20px;
                                if a.checked: Icon { glyph: Icons.check; size: 20px; tint: Theme.s.primary; }
                            }
                        }
                        ata := TouchArea {
                            enabled: a.enabled;
                            clicked => { root.picked(a.id); }
                        }
                        property <bool> live: !hold.shown;
                        function reveal() {
                            if (self.live && a.check && a.checked && !sheet-flick.revealed) {
                                sheet-flick.revealed = true;
                                sheet-flick.content-y = Reveal.offset(self.absolute-position.y - sheet-col.absolute-position.y, self.height, -sheet-flick.content-y, sheet-flick.height, sheet-flick.content-height);
                            }
                        }
                        init => { self.reveal(); }
                        changed live => { self.reveal(); }
                    }
                }
            }
        }
    }
}

// Where the next popup menu anchors (`ContextMenuRegion`'s press point, or the ⋯ that
// opened it), in window coordinates.
export global MenuAnchor {
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> w;
    in-out property <length> h;
    public function at(x: length, y: length, w: length, h: length) {
        MenuAnchor.x = x;
        MenuAnchor.y = y;
        MenuAnchor.w = w;
        MenuAnchor.h = h;
    }
}

// A popup menu anchored at a rectangle of the window (`PopupAnchor` with `PopupMenu`):
// under the anchor, or over it when the window has no room below, kept inside the window.
// It lists `items`, or `names` with `current` checked; `max-rows` scrolls past that many.
component AnchorMenu inherits Rectangle {
    in property <[ActionItem]> items;
    in property <[string]> names;
    in property <string> current;
    in property <length> ax;
    in property <length> ay;
    in property <length> aw;
    in property <length> ah;
    in property <length> menu-width: 220px;
    in property <int> max-rows: 7;
    // Items' `enabled` greys them out; most menus leave it set on every item.
    in property <bool> dim-disabled;
    callback picked(string);
    callback dismiss();
    property <length> row-h: 44px;
    property <int> count: root.names.length > 0 ? root.names.length : root.items.length;
    property <length> menu-height: min(col.preferred-height, root.max-rows * root.row-h + 12px, root.height - 16px);
    TouchArea { clicked => { root.dismiss(); } }
    Rectangle {
        width: min(root.menu-width, root.width - 16px);
        height: root.menu-height;
        x: max(8px, min(root.ax + root.aw - self.width, root.width - self.width - 8px));
        y: root.ay + root.ah + 4px + self.height <= root.height - 8px ? root.ay + root.ah + 4px : max(8px, root.ay - self.height - 4px);
        background: Theme.s.card;
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.s.outline-variant.with-alpha(0.5);
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000030;
        drop-shadow-offset-y: 4px;
        clip: true;
        TouchArea { }
        Flickable {
            content-height: col.preferred-height;
            col := VerticalLayout {
                padding-top: 6px;
                padding-bottom: 6px;
                for n in root.names: PopupRow {
                    height: root.row-h;
                    label: n;
                    checked: n == root.current;
                    clicked => { root.picked(n); }
                }
                // `PopupMenuSection`: a divider before a section, then its title if it has one.
                for a[i] in root.items: VerticalLayout {
                    if i > 0 && (a.section || (a.heading != "" && a.heading != "more")): Rectangle {
                        height: 9px;
                        Rectangle { y: 4px; height: 1px; background: Theme.s.outline-variant; }
                    }
                    if a.heading != "" && a.heading != "more": HorizontalLayout {
                        height: 30px;
                        padding-left: 14px;
                        Text {
                            text: a.heading;
                            font-size: 13px * Type.scale;
                            color: Theme.s.primary;
                            vertical-alignment: center;
                        }
                    }
                    PopupRow {
                        height: root.row-h;
                        glyph: Glyphs.of(a.glyph);
                        label: a.label;
                        value: a.subtitle;
                        checked: a.check && a.checked;
                        danger: a.danger;
                        indent: a.sub;
                        more: a.heading == "more";
                        enabled: !root.dim-disabled || a.enabled;
                        clicked => { root.picked(a.id); }
                    }
                }
            }
        }
    }
}

// `FindPanel`'s field: a glyph, the text, then what trails it (the count, 区分大小写).
component FindField inherits Rectangle {
    in property <string> glyph;
    in property <string> hint;
    in property <string> count;
    in property <bool> case-toggle;
    in-out property <bool> match-case;
    in-out property <string> text <=> input.text;
    callback edited();
    callback accepted();
    callback case-changed();
    public function focus-input() { input.focus(); }
    height: 40px;
    border-radius: 20px;
    background: Theme.s.block;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 4px;
        spacing: 8px;
        VerticalLayout { alignment: center; Icon { glyph: root.glyph; size: 18px; tint: Theme.s.on-surface-variant; } }
        Rectangle {
            horizontal-stretch: 1;
            Text {
                x: 0;
                width: parent.width;
                height: parent.height;
                visible: input.text == "";
                text: root.hint;
                font-size: 15px * Type.scale;
                color: Theme.s.on-surface-variant;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                width: parent.width;
                height: parent.height;
                vertical-alignment: center;
                single-line: true;
                font-size: 15px * Type.scale;
                color: Theme.s.on-surface;
                selection-background-color: Theme.s.primary-container;
                edited => { root.edited(); }
                accepted => { root.accepted(); }
            }
        }
        if root.count != "": Text {
            text: root.count;
            font-size: 13px * Type.scale;
            color: Theme.s.on-surface-variant;
            vertical-alignment: center;
        }
        if root.case-toggle: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: root.match-case ? Theme.s.primary : case-ta.pressed ? Theme.s.inset : transparent;
                Text {
                    text: "Aa";
                    font-size: 13px * Type.scale;
                    font-weight: 600;
                    color: root.match-case ? Theme.s.on-primary : Theme.s.on-surface-variant;
                }
                case-ta := TouchArea {
                    clicked => {
                        root.match-case = !root.match-case;
                        root.case-changed();
                    }
                }
            }
        }
    }
}

// `FindPanel`: the find field with its steps, 替换 and close beside it, or under it when
// the page is narrower than `_findInlineMinWidth`; the replace row under them.
component FindBar inherits Rectangle {
    in property <bool> readonly;
    in property <string> count;
    in property <bool> has-matches;
    in-out property <bool> replacing;
    in-out property <bool> match-case;
    in-out property <string> query;
    in-out property <string> replacement;
    callback edited();
    callback previous();
    callback next();
    callback replace();
    callback replace-all();
    callback close();
    property <bool> inline: root.width >= 440px * Type.scale;
    property <bool> show-replace: root.replacing && !root.readonly;
    background: Theme.s.page;
    height: col.preferred-height;
    col := VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 4px;
            find-field := FindField {
                horizontal-stretch: 1;
                glyph: Icons.search;
                hint: "搜索";
                count: root.count;
                case-toggle: true;
                text <=> root.query;
                match-case <=> root.match-case;
                init => { self.focus-input(); }
                edited => { root.edited(); }
                case-changed => { root.edited(); }
                accepted => { root.next(); }
            }
            if root.inline: HorizontalLayout {
                spacing: 4px;
                padding-left: 4px;
                IconButton { glyph: Icons.up; enabled: root.has-matches; clicked => { root.previous(); } }
                IconButton { glyph: Icons.down; enabled: root.has-matches; clicked => { root.next(); } }
                if !root.readonly: IconButton {
                    glyph: Icons.swap;
                    tint: root.replacing ? Theme.s.on-primary : Theme.s.on-surface-variant;
                    background: root.replacing ? Theme.s.primary : transparent;
                    clicked => { root.replacing = !root.replacing; }
                }
                IconButton { glyph: Icons.close; clicked => { root.close(); } }
            }
        }
        if !root.inline: HorizontalLayout {
            spacing: 4px;
            IconButton { glyph: Icons.up; enabled: root.has-matches; clicked => { root.previous(); } }
            IconButton { glyph: Icons.down; enabled: root.has-matches; clicked => { root.next(); } }
            if !root.readonly: IconButton {
                glyph: Icons.swap;
                tint: root.replacing ? Theme.s.on-primary : Theme.s.on-surface-variant;
                background: root.replacing ? Theme.s.primary : transparent;
                clicked => { root.replacing = !root.replacing; }
            }
            Rectangle { horizontal-stretch: 1; }
            IconButton { glyph: Icons.close; clicked => { root.close(); } }
        }
        if root.show-replace: HorizontalLayout {
            spacing: 8px;
            FindField {
                horizontal-stretch: 1;
                glyph: Icons.swap;
                hint: "替换";
                text <=> root.replacement;
                accepted => { if (root.has-matches) { root.replace(); } }
            }
            VerticalLayout { alignment: center; TextButton { text: "替换"; filled: true; enabled: root.has-matches; clicked => { root.replace(); } } }
            VerticalLayout { alignment: center; TextButton { text: "全部替换"; filled: true; enabled: root.has-matches; clicked => { root.replace-all(); } } }
        }
    }
}

component EditorPage inherits Rectangle {
    in-out property <string> title;
    in-out property <string> text;
    in property <bool> readonly;
    // `EditorView`'s document still loading, or why it could not (`editorUnavailable`).
    in property <bool> loading;
    in property <string> error;
    hold := LoadingHold { loading: root.loading; }
    property <bool> ready: !hold.shown && root.error == "";
    // `titleEditable`: the title is a field, 未命名 while empty.
    in property <bool> title-editable;
    // Names this editor's history in `EditorKit`.
    in property <string> key;
    in property <string> schema;
    in property <length> keyboard;
    // The find bar and the ⋮ menu are open; the window's back closes them before the page.
    in-out property <bool> finding;
    in-out property <bool> menu-open;
    property <[ActionItem]> menu-items;
    property <EditorCompletion> completion: { items: [], caret: -1, cells: 0 };
    property <length> caret-x;
    property <length> caret-y;
    property <bool> sizes-open;
    property <bool> replacing;
    property <bool> match-case;
    property <string> query;
    property <string> replacement;
    property <EditorMatch> hit: { start: -1, end: -1, count: 0, label: "" };
    callback save(string);
    callback back();
    background: Theme.s.page;
    init => {
        root.finding = false;
        root.menu-open = false;
        if (root.ready) { EditorKit.opened(root.key, root.text); }
    }
    changed ready => {
        if (root.ready) { EditorKit.opened(root.key, root.text); }
    }
    changed finding => {
        root.close-completion();
        if (!root.finding) {
            root.replacing = false;
            root.hit = { start: -1, end: -1, count: 0, label: "" };
        }
    }

    function selection-start() -> int {
        return min(editor.cursor-position-byte-offset, editor.anchor-position-byte-offset);
    }
    function seek(from: int, backward: bool) {
        root.hit = EditorKit.find(root.text, root.query, root.match-case, from, backward);
        if (root.hit.start >= 0) {
            editor.set-selection-offsets(root.hit.start, root.hit.end);
        }
    }
    function step(backward: bool) {
        if (root.hit.start < 0) {
            root.seek(root.selection-start(), backward);
        } else {
            root.seek(backward ? root.hit.start : root.hit.start + 1, backward);
        }
    }
    function apply(e: EditorEdit) {
        root.close-completion();
        root.text = e.text;
        editor.set-selection-offsets(e.caret, e.caret);
    }
    function close-completion() {
        root.completion = { items: [], caret: -1, cells: 0 };
    }
    function suggest() {
        if (root.readonly) {
            return;
        }
        root.completion = EditorKit.complete(root.schema, root.text, editor.cursor-position-byte-offset);
    }
    function pick(i: int) {
        let e = EditorKit.accept(root.key, root.schema, root.text, root.completion.caret, i);
        root.close-completion();
        if (e.ok) {
            root.text = e.text;
            editor.set-selection-offsets(e.caret, e.caret);
        }
    }
    function replace-one() {
        let e = EditorKit.replace(root.key, root.text, root.query, root.match-case, root.hit.start, root.replacement);
        if (e.ok) {
            root.apply(e);
            root.seek(e.caret, false);
        }
    }
    function replace-every() {
        let e = EditorKit.replace-all(root.key, root.text, root.query, root.match-case, root.replacement);
        if (e.ok) {
            root.apply(e);
            root.seek(0, false);
        }
    }
    // The text input scrolls itself only while it has the focus; a match selected from the
    // find field is brought into view here.
    function menu-picked(id: string) {
        if (id == "font") {
            root.sizes-open = !root.sizes-open;
            root.menu-items = EditorKit.menu(root.key, root.text, root.sizes-open);
            return;
        }
        root.menu-open = false;
        if (id == "wrap") {
            EditorKit.style(!EditorKit.wrap, EditorKit.size);
        } else if (id == "font:0" || id == "font:1" || id == "font:2") {
            EditorKit.style(EditorKit.wrap, id == "font:0" ? 0 : id == "font:1" ? 1 : 2);
        } else if (id == "undo") {
            let e = EditorKit.undo(root.key, root.text);
            if (e.ok) { root.apply(e); }
        } else if (id == "redo") {
            let e = EditorKit.redo(root.key, root.text);
            if (e.ok) { root.apply(e); }
        }
    }
    function reveal(y: length) {
        let line = editor.font-size * 1.6;
        let top = y + editor.y;
        let max-y = max(0px, flick.content-height - flick.height);
        if (top < -flick.content-y) {
            flick.content-y = -max(0px, top - line);
        } else if (top + line > -flick.content-y + flick.height - Dock.pad) {
            flick.content-y = -min(max-y, top + 2 * line - flick.height + Dock.pad);
        }
    }

    VerticalLayout {
        AppBar {
            title: root.title;
            can-back: true;
            custom-title: root.title-editable;
            back => {
                root.finding = false;
                root.menu-open = false;
                root.back();
            }
            if root.title-editable: Rectangle {
                horizontal-stretch: 1;
                if root.title == "": Text {
                    x: 0;
                    width: parent.width;
                    text: "未命名";
                    font-size: 22px * Type.scale;
                    color: Theme.s.on-surface-variant;
                    vertical-alignment: center;
                }
                TextInput {
                    width: parent.width;
                    text <=> root.title;
                    single-line: true;
                    font-size: 22px * Type.scale;
                    color: Theme.s.on-surface;
                    vertical-alignment: center;
                    selection-background-color: Theme.s.primary-container;
                }
            }
            if root.ready: VerticalLayout {
                alignment: center;
                IconButton { glyph: Icons.search; tint: Theme.s.on-surface; clicked => { root.finding = true; } }
            }
            if !root.readonly && root.ready: VerticalLayout {
                alignment: center;
                TextButton { text: "保存"; clicked => { root.save(root.text); } }
            }
            if root.ready: VerticalLayout {
                alignment: center;
                IconButton {
                    glyph: Icons.more;
                    tint: Theme.s.on-surface;
                    clicked => {
                        MenuAnchor.at(self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                        root.sizes-open = false;
                        root.menu-items = EditorKit.menu(root.key, root.text, false);
                        root.menu-open = true;
                    }
                }
            }
        }
        if root.finding && root.ready: FindBar {
            readonly: root.readonly;
            count: root.hit.label;
            has-matches: root.hit.count > 0;
            replacing <=> root.replacing;
            match-case <=> root.match-case;
            query <=> root.query;
            replacement <=> root.replacement;
            edited => { root.seek(root.selection-start(), false); }
            previous => { root.step(true); }
            next => { root.step(false); }
            replace => { root.replace-one(); }
            replace-all => { root.replace-every(); }
            close => { root.finding = false; }
        }
        Rectangle {
            vertical-stretch: 1;
            if hold.shown: Spinner { width: 32px; height: 32px; indeterminate: true; }
            if !hold.shown && root.error != "": NullStatus { label: "编辑器不可用"; description: root.error; }
            Rectangle {
                visible: root.ready;
                background: Theme.s.card;
                flick := Flickable {
                    content-height: max(editor.preferred-height + 24px, self.height) + Dock.pad;
                    content-width: EditorKit.wrap ? self.width : max(self.width, editor.preferred-width + 24px);
                    editor := TextInput {
                        x: 12px;
                        y: 12px;
                        width: EditorKit.wrap ? parent.width - 24px : max(parent.width - 24px, self.preferred-width);
                        text <=> root.text;
                        read-only: root.readonly;
                        single-line: false;
                        wrap: EditorKit.wrap ? TextWrap.word-wrap : TextWrap.no-wrap;
                        font-family: "monospace";
                        font-size: EditorKit.font-px * Type.scale;
                        color: Theme.s.on-surface;
                        selection-background-color: Theme.s.primary-container;
                        edited => {
                            EditorKit.typed(root.key, root.text);
                            if (root.finding && root.query != "") {
                                root.hit = EditorKit.find(root.text, root.query, root.match-case, max(0, root.hit.start), false);
                            }
                            root.suggest();
                        }
                        cursor-position-changed(p) => {
                            root.caret-x = p.x;
                            root.caret-y = p.y;
                            if (self.cursor-position-byte-offset != root.completion.caret) { root.close-completion(); }
                            if (!self.has-focus) { root.reveal(p.y); }
                        }
                    }
                    // `EditorCompletionPopup`: under the caret, or over it when the rest of the
                    // view is too short; rows untinted, since a phone highlights none.
                    if root.completion.items.length > 0: pop := Rectangle {
                        property <length> row-h: editor.font-size * 2 + 4px;
                        property <length> line: editor.font-size * 1.4;
                        property <length> view-top: -flick.content-y;
                        property <length> view-bottom: -flick.content-y + flick.height - max(Dock.pad, root.keyboard);
                        property <length> below: editor.y + root.caret-y + self.line + 2px;
                        width: min(flick.width - 16px, max(160px, root.completion.cells * editor.font-size * 0.6 + 36px));
                        height: min(6, root.completion.items.length) * self.row-h + 12px;
                        x: max(-flick.content-x + 8px, min(editor.x + root.caret-x, -flick.content-x + flick.width - self.width - 8px));
                        y: self.below + self.height <= self.view-bottom || editor.y + root.caret-y - self.height - 2px < self.view-top ? self.below : editor.y + root.caret-y - self.height - 2px;
                        background: Theme.s.card;
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: Theme.s.outline-variant.with-alpha(0.5);
                        drop-shadow-blur: 16px;
                        drop-shadow-color: #00000030;
                        drop-shadow-offset-y: 4px;
                        clip: true;
                        TouchArea { }
                        Flickable {
                            y: 6px;
                            height: parent.height - 12px;
                            content-height: root.completion.items.length * pop.row-h;
                            for s[i] in root.completion.items: Rectangle {
                                x: 8px;
                                y: i * pop.row-h;
                                width: parent.width - 16px;
                                height: pop.row-h;
                                border-radius: 8px;
                                background: sug-ta.pressed ? Theme.s.inset : transparent;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 16px;
                                    Text {
                                        text: s.label;
                                        font-family: "monospace";
                                        font-size: editor.font-size;
                                        color: Theme.s.on-surface;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    if s.detail != "": Text {
                                        text: s.detail;
                                        font-family: "monospace";
                                        font-size: editor.font-size * 0.85;
                                        color: Theme.s.on-surface-variant;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        overflow: elide;
                                    }
                                }
                                sug-ta := TouchArea { clicked => { root.pick(i); } }
                            }
                        }
                    }
                }
            }
        }
    }
    if root.menu-open: AnchorMenu {
        ax: MenuAnchor.x - root.absolute-position.x;
        ay: MenuAnchor.y - root.absolute-position.y;
        aw: MenuAnchor.w;
        ah: MenuAnchor.h;
        dim-disabled: true;
        items: root.menu-items;
        picked(id) => { root.menu-picked(id); }
        dismiss => { root.menu-open = false; }
    }
}

// A dialog's choices in two or three columns (`_ChoiceGrid`).
component ChoiceGrid inherits VerticalLayout {
    in property <[string]> choices;
    in property <int> value;
    callback picked(int);
    property <int> cols: root.choices.length > 4 ? 3 : 2;
    spacing: 6px;
    for r in ceil(root.choices.length / root.cols): HorizontalLayout {
        spacing: 6px;
        for c in root.cols: Rectangle {
            property <int> i: r * root.cols + c;
            height: 40px;
            preferred-width: 0px;
            min-width: 0px;
            horizontal-stretch: 1;
            border-radius: 20px;
            background: self.i >= root.choices.length ? transparent : self.i == root.value ? Theme.s.primary : Theme.s.block;
            Text {
                text: parent.i < root.choices.length ? root.choices[parent.i] : "";
                font-size: 14px * Type.scale;
                color: parent.i == root.value ? Theme.s.on-primary : Theme.s.on-surface;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                enabled: parent.i < root.choices.length;
                clicked => { root.picked(parent.i); }
            }
        }
    }
}

// ---------------------------------------------------------------- Shell

// Material 3 navigation bar destination: a pill behind the active icon, label below.
component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <string> glyph;
    callback clicked();
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 60px;
                height: 32px;
                border-radius: 16px;
                background: root.active ? Theme.s.primary-container : transparent;
                Icon {
                    glyph: root.glyph;
                    tint: root.active ? Theme.s.on-primary-container : Theme.s.on-surface-variant;
                }
            }
        }
        Text {
            text: root.label;
            font-size: 12px * Type.scale;
            horizontal-alignment: center;
            color: root.active ? Theme.s.on-surface : Theme.s.on-surface-variant;
        }
    }
    TouchArea { clicked => { root.clicked(); } }
}

// `NavigationBar`'s `_Destination`: a 64 by 32 pill one level up behind the chosen icon.
component BarItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <string> glyph;
    callback clicked();
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 64px;
                height: 32px;
                Rectangle {
                    border-radius: 16px;
                    background: Theme.is-dark ? Theme.s.inset : Theme.s.block;
                    opacity: root.active ? 1 : 0;
                    animate opacity { duration: 250ms; easing: ease-in-out; }
                }
                Icon { glyph: root.glyph; tint: root.active ? Theme.s.primary : Theme.s.on-surface-variant; }
            }
        }
        Text {
            text: root.label;
            font-size: 12px * Type.scale;
            font-weight: 600;
            horizontal-alignment: center;
            overflow: elide;
            color: root.active ? Theme.s.on-surface : Theme.s.on-surface-variant;
        }
    }
    TouchArea { clicked => { root.clicked(); } }
}

export struct SideDest {
    tab: int,
    label: string,
    glyph: string,
}

// prism_ui's `NavigationSidebar` (FlClash: plugins/prism_ui/lib/sidebar.dart): the
// toggle, then the destinations. `progress` runs from compact (0, 48 wide) to expanded
// (1, 220 wide); rows keep the expanded width and are clipped while it moves.
component NavSidebar inherits Rectangle {
    in property <[SideDest]> items;
    in property <int> selected;
    in property <float> progress;
    callback select(int);
    callback toggle();
    property <length> item-h: 40px + 15px * Type.scale - 15px;
    property <length> stride: root.item-h + 4px;
    property <float> label-opacity: clamp((root.progress - 0.4) / 0.6, 0, 1);
    property <float> divider: 8.5 + 3 * root.progress;
    // `_SelectionIndicator`: the leading edge sets off at once and the trailing one
    // catches up, so the bar stretches toward the new row.
    property <length> target: root.selected * root.stride + (root.stride - 16px) / 2;
    property <length> lead: root.target;
    property <length> trail: root.target;
    animate lead { duration: 192ms; easing: cubic-bezier(0.215, 0.61, 0.355, 1); }
    animate trail { delay: 112ms; duration: 208ms; easing: cubic-bezier(0.645, 0.045, 0.355, 1); }
    width: 48px + 172px * root.progress;
    clip: true;
    TouchArea { }
    Rectangle {
        x: 4px;
        y: 6px;
        width: 40px;
        height: root.item-h;
        border-radius: 10px;
        background: toggle-ta.pressed ? Theme.s.on-surface.with-alpha(0.06) : transparent;
        Icon {
            glyph: "M6.5 4.5H17.5A3.5 3.5 0 0 1 21 8V16A3.5 3.5 0 0 1 17.5 19.5H6.5A3.5 3.5 0 0 1 3 16V8A3.5 3.5 0 0 1 6.5 4.5Z M" + root.divider + " 4.5V19.5 M5.5 8.5H" + (root.divider - 2.5) + " M5.5 11H" + (root.divider - 2.5) + " M5.5 13.5H" + (root.divider - 2.5);
            tint: Theme.s.on-surface-variant;
        }
        toggle-ta := TouchArea { clicked => { root.toggle(); } }
    }
    Flickable {
        y: root.item-h + 16px;
        width: parent.width;
        height: parent.height - self.y - 4px;
        viewport-height: root.items.length * root.stride;
        for d[i] in root.items: Rectangle {
            x: 4px;
            y: i * root.stride + 2px;
            width: parent.width - 8px;
            height: root.item-h;
            border-radius: 10px;
            clip: true;
            background: i == root.selected ? Theme.s.on-surface.with-alpha(0.08) : row-ta.pressed ? Theme.s.on-surface.with-alpha(0.06) : transparent;
            Icon { x: 8px; glyph: d.glyph; tint: Theme.s.on-surface-variant; }
            Text {
                x: 44px;
                width: 156px;
                text: d.label;
                font-size: 15px * Type.scale;
                color: Theme.s.on-surface;
                opacity: root.label-opacity;
                vertical-alignment: center;
                overflow: elide;
            }
            row-ta := TouchArea { clicked => { root.select(d.tab); } }
        }
        if root.selected >= 0 && root.selected < root.items.length: Rectangle {
            x: 4px;
            y: min(root.lead, root.trail);
            width: 3px;
            height: max(root.lead, root.trail) - min(root.lead, root.trail) + 16px;
            border-radius: 1.5px;
            background: Theme.s.primary;
        }
    }
}

