component Icon inherits Path {
    in property <string> glyph;
    in property <color> tint: Theme.s.on-surface;
    in property <length> size: 24px;
    width: size;
    height: size;
    commands: glyph;
    fill: transparent;
    stroke: tint;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    stroke-line-join: round;
    viewbox-width: 24;
    viewbox-height: 24;
}

component FilledIcon inherits Path {
    in property <string> glyph;
    in property <color> tint: Theme.s.on-surface;
    in property <length> size: 24px;
    width: size;
    height: size;
    commands: glyph;
    fill: tint;
    stroke: tint;
    stroke-width: 1px;
    stroke-line-join: round;
    viewbox-width: 24;
    viewbox-height: 24;
}

// ---------------------------------------------------------------- Building blocks

component Card inherits Rectangle {
    in property <bool> selected;
    background: selected ? Theme.s.primary-container : Theme.s.card;
    border-radius: 12px;
}

// A card with FlClash's header row: a small icon, then the title.
component InfoCard inherits Card {
    in property <string> title;
    in property <string> glyph;
    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            height: 22px;
            Icon { glyph: root.glyph; size: 20px; tint: root.selected ? Theme.s.on-primary-container : Theme.s.primary; y: 1px; }
            Text {
                text: root.title;
                font-size: 15px;
                color: root.selected ? Theme.s.on-primary-container : Theme.s.on-surface;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        @children
    }
}

component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> filled;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked();
    height: 36px;
    min-width: 64px;
    border-radius: 18px;
    background: filled ? (ta.pressed ? Theme.s.primary.darker(0.15) : Theme.s.primary) : (ta.pressed ? Theme.s.inset : transparent);
    opacity: enabled ? 1 : 0.45;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            font-size: 14px;
            color: root.filled ? Theme.s.on-primary : (root.danger ? Theme.s.error : Theme.s.primary);
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <color> tint: Theme.s.on-surface-variant;
    in property <bool> enabled: true;
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: ta.pressed ? Theme.s.inset : transparent;
    opacity: enabled ? 1 : 0.4;
    Icon { glyph: root.glyph; tint: root.tint; }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// FlClash's floating action button: a rounded square in the primary container color,
// bottom right of the page. With a label it widens into the extended form.
component Fab inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> filled-glyph;
    in property <bool> enabled: true;
    callback clicked();
    width: label == "" ? 56px : max(56px, row.preferred-width);
    height: 56px;
    border-radius: 16px;
    background: ta.pressed ? Theme.s.primary-container.darker(0.08) : Theme.s.primary-container;
    opacity: enabled ? 1 : 0.6;
    row := HorizontalLayout {
        padding-left: root.label == "" ? 16px : 18px;
        padding-right: root.label == "" ? 16px : 20px;
        spacing: 10px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            if root.filled-glyph: FilledIcon { glyph: root.glyph; tint: Theme.s.on-primary-container; }
            if !root.filled-glyph: Icon { glyph: root.glyph; tint: Theme.s.on-primary-container; }
        }
        if root.label != "": Text {
            text: root.label;
            font-size: 15px;
            color: Theme.s.on-primary-container;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// The top app bar: the page title on the left, actions on the right.
component AppBar inherits HorizontalLayout {
    in property <string> title;
    in property <bool> can-back;
    callback back();
    height: 56px;
    padding-left: can-back ? 4px : 16px;
    padding-right: 8px;
    spacing: 4px;
    if root.can-back: VerticalLayout {
        alignment: center;
        IconButton { glyph: Icons.back; tint: Theme.s.on-surface; clicked => { root.back(); } }
    }
    Text {
        horizontal-stretch: 1;
        text: root.title;
        font-size: 22px;
        color: Theme.s.on-surface;
        vertical-alignment: center;
        overflow: elide;
    }
    @children
}

component Empty inherits Rectangle {
    in property <string> text;
    Text {
        text: root.text;
        color: Theme.s.on-surface-variant;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
        width: parent.width - 48px;
    }
}

component RadioRow inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    callback clicked();
    height: 34px;
    border-radius: 8px;
    background: ta.pressed ? Theme.s.block : transparent;
    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: 2px;
                border-color: root.checked ? Theme.s.primary : Theme.s.on-surface-variant;
                Rectangle {
                    visible: root.checked;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.s.primary;
                }
            }
        }
        Text {
            text: root.text;
            font-size: 14px;
            color: Theme.s.on-surface;
            vertical-alignment: center;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// ---------------------------------------------------------------- Dashboard

component Switch inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 52px;
    height: 32px;
    border-radius: 16px;
    background: checked ? Theme.s.primary : Theme.s.inset;
    border-width: checked ? 0 : 2px;
    border-color: Theme.s.on-surface-variant;
    Rectangle {
        x: root.checked ? parent.width - self.width - 6px : 8px;
        width: root.checked ? 22px : 16px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.checked ? Theme.s.on-primary : Theme.s.on-surface-variant;
        animate x { duration: 120ms; }
    }
    TouchArea { clicked => { root.checked = !root.checked; root.toggled(root.checked); } }
}

// A small rounded label (`DashboardChip`).
component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.s.on-surface-variant;
    in property <bool> dot;
    height: 22px;
    width: row.preferred-width;
    border-radius: 11px;
    background: tone.with-alpha(0.14);
    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        if root.dot: VerticalLayout {
            alignment: center;
            Rectangle { width: 6px; height: 6px; border-radius: 3px; background: root.tone; }
        }
        Text { text: root.text; font-size: 12px; font-weight: 600; color: root.tone; vertical-alignment: center; }
    }
}

// `DashboardCard` with its header row: icon, title, chips, then actions on the right.
component DashCard inherits Rectangle {
    in property <string> glyph;
    in property <string> title;
    in property <bool> chevron;
    callback tapped();
    background: Theme.s.card;
    border-radius: 20px;
    TouchArea { clicked => { root.tapped(); } }
    @children
}

component DashHeader inherits HorizontalLayout {
    in property <string> glyph;
    in property <string> title;
    in property <bool> chevron;
    height: 28px;
    spacing: 8px;
    VerticalLayout { alignment: center; Icon { glyph: root.glyph; size: 18px; tint: Theme.s.on-surface-variant; } }
    Text { text: root.title; font-size: 15px; font-weight: 600; color: Theme.s.on-surface; vertical-alignment: center; }
    @children
    Rectangle { horizontal-stretch: 1; }
    if root.chevron: VerticalLayout { alignment: center; Icon { glyph: Icons.chevron; size: 18px; tint: Theme.s.on-surface-variant; } }
}

// `CurrentOutboundCard`: where traffic leaves, the kind of address, run time and the
// organization, with the start button.
component StatusCard inherits DashCard {
    in property <DashStatus> status;
    in property <string> run-state;
    in property <string> run-time;
    in property <bool> compact;
    callback toggle();
    callback refresh();
    property <bool> on: run-state == "STARTED";
    property <bool> busy: run-state == "STARTING" || run-state == "STOPPING" || run-state == "OFFLINE";
    glyph: Icons.status;
    title: "状态";
    tapped => { root.refresh(); }
    HorizontalLayout {
        padding: 16px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 12px;
            DashHeader {
                glyph: Icons.status;
                title: "状态";
                Chip {
                    text: root.run-state == "STARTED" ? "运行中" : root.run-state == "STARTING" ? "启动中" : root.run-state == "STOPPING" ? "停止中" : "未运行";
                    tone: root.on ? Theme.success : Theme.s.on-surface-variant;
                    dot: true;
                }
            }
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: Theme.s.block;
                        Text { text: root.status.country == "" ? "—" : root.status.country; font-size: 13px; font-weight: 700; color: Theme.s.on-surface; }
                    }
                }
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: root.status.ip == "" ? (root.status.probing ? "检测中…" : "—") : root.status.ip;
                        font-size: root.compact ? 18px : 22px;
                        font-weight: 700;
                        color: Theme.s.on-surface;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        if root.status.kind != "": Chip { text: root.status.kind; }
                        if root.status.quality > 0: Chip {
                            text: root.status.quality == 1 ? "质量 优" : root.status.quality == 2 ? "质量 普通" : "质量 风险";
                            tone: root.status.quality == 1 ? Theme.success : root.status.quality == 2 ? Theme.s.on-surface-variant : Theme.s.error;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 20px;
                VerticalLayout {
                    spacing: 2px;
                    Text { text: "运行时长"; font-size: 12px; color: Theme.s.on-surface-variant; }
                    Text { text: root.run-time; font-size: 15px; font-weight: 600; color: Theme.s.on-surface; }
                }
                VerticalLayout {
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text { text: "组织"; font-size: 12px; color: Theme.s.on-surface-variant; }
                    Text { text: root.status.org == "" ? "—" : root.status.org; font-size: 15px; font-weight: 600; color: Theme.s.on-surface; overflow: elide; }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: root.compact ? 64px : 76px;
                height: self.width;
                border-radius: self.width / 2;
                background: root.on ? Theme.s.primary : Theme.s.primary-container;
                opacity: root.busy ? 0.6 : 1;
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        FilledIcon { glyph: root.on ? Icons.pause : Icons.play; tint: root.on ? Theme.s.on-primary : Theme.s.on-primary-container; }
                    }
                }
                TouchArea { enabled: !root.busy; clicked => { root.toggle(); } }
            }
        }
    }
}

// `SpeedCard`: one direction's speed, its total and its chart.
component SpeedTile inherits Rectangle {
    in property <bool> upload;
    in property <DashTraffic> traffic;
    in property <bool> peak;
    in property <bool> header;
    background: header ? Theme.s.card : Theme.s.block;
    border-radius: header ? 20px : 14px;
    clip: true;
    property <color> tint: root.upload ? Theme.s.primary : Theme.success;
    Path {
        y: parent.height - self.height;
        width: parent.width;
        height: parent.width * 0.2;
        viewbox-width: 100;
        viewbox-height: 20;
        commands: root.upload ? root.traffic.up-fill : root.traffic.down-fill;
        fill: root.tint.with-alpha(0.14);
        stroke-width: 0;
    }
    Path {
        y: parent.height - self.height;
        width: parent.width;
        height: parent.width * 0.2;
        viewbox-width: 100;
        viewbox-height: 20;
        commands: root.upload ? root.traffic.up-line : root.traffic.down-line;
        fill: transparent;
        stroke: root.tint;
        stroke-width: 2px;
    }
    VerticalLayout {
        padding: root.header ? 16px : 12px;
        spacing: 4px;
        alignment: start;
        HorizontalLayout {
            spacing: 6px;
            VerticalLayout { alignment: center; Icon { glyph: root.upload ? Icons.up : Icons.down; size: 16px; tint: root.tint; } }
            Text { text: root.upload ? "上传" : "下载"; font-size: root.header ? 15px : 13px; font-weight: 600; color: Theme.s.on-surface; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            if root.peak: Text { text: root.upload ? root.traffic.up-peak : root.traffic.down-peak; font-size: 11px; color: Theme.s.on-surface-variant; vertical-alignment: center; }
        }
        HorizontalLayout {
            spacing: 4px;
            // Device fonts can draw bold digits wider than they measure, so
            // the value gets slack and the unit takes the rest of the row.
            Text { text: root.upload ? root.traffic.up-value : root.traffic.down-value; font-size: 28px; font-weight: 700; color: Theme.s.on-surface; min-width: self.preferred-width + 12px; }
            VerticalLayout {
                alignment: end;
                padding-bottom: 5px;
                horizontal-stretch: 1;
                Text { text: root.upload ? root.traffic.up-unit : root.traffic.down-unit; font-size: 12px; font-weight: 600; color: Theme.s.on-surface-variant; min-width: self.preferred-width + 6px; }
            }
        }
        Text { text: root.upload ? root.traffic.up-total : root.traffic.down-total; font-size: 12px; color: Theme.s.on-surface-variant; }
    }
}

// `NetworkSpeedCard` on a phone: both directions side by side.
component SpeedCard inherits DashCard {
    in property <DashTraffic> traffic;
    height: 216px;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        DashHeader { glyph: Icons.speed; title: "网络速度"; }
        HorizontalLayout {
            spacing: 10px;
            SpeedTile { upload: true; traffic: root.traffic; }
            SpeedTile { upload: false; traffic: root.traffic; }
        }
    }
}

// One choice of the outbound mode.
component ModeTile inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> active;
    in property <bool> inline;
    callback clicked();
    border-radius: inline ? 18px : 14px;
    background: active ? Theme.s.primary : Theme.s.block;
    if !root.inline: VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout { alignment: center; Icon { glyph: root.glyph; size: 18px; tint: root.active ? Theme.s.on-primary : Theme.s.on-surface-variant; } }
        Text { text: root.label; font-size: 14px; font-weight: 600; horizontal-alignment: center; color: root.active ? Theme.s.on-primary : Theme.s.on-surface; }
    }
    if root.inline: HorizontalLayout {
        alignment: center;
        spacing: 6px;
        VerticalLayout { alignment: center; Icon { glyph: root.glyph; size: 16px; tint: root.active ? Theme.s.on-primary : Theme.s.on-surface-variant; } }
        Text { text: root.label; font-size: 14px; font-weight: 600; vertical-alignment: center; color: root.active ? Theme.s.on-primary : Theme.s.on-surface; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

// `OutboundModeCard` on a phone: three tiles under the header.
component ModeCard inherits DashCard {
    in property <int> mode;
    callback set-mode(int);
    height: 136px;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        DashHeader { glyph: Icons.route; title: "出站模式"; }
        HorizontalLayout {
            spacing: 8px;
            ModeTile { glyph: Icons.rule; label: "规则"; active: root.mode == 0; clicked => { root.set-mode(0); } }
            ModeTile { glyph: Icons.proxies; label: "全局"; active: root.mode == 1; clicked => { root.set-mode(1); } }
            ModeTile { glyph: Icons.target; label: "直连"; active: root.mode == 2; clicked => { root.set-mode(2); } }
        }
    }
}

// `OutboundModeBar` on a wide dashboard: the label, then the choices in a row.
component ModeBar inherits DashCard {
    in property <int> mode;
    callback set-mode(int);
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout { alignment: center; Icon { glyph: Icons.route; size: 18px; tint: Theme.s.on-surface-variant; } }
            Text { text: "出站模式"; font-size: 14px; font-weight: 600; color: Theme.s.on-surface; vertical-alignment: center; }
        }
        Rectangle { horizontal-stretch: 0.2; }
        ModeTile { inline: true; glyph: Icons.rule; label: "规则"; active: root.mode == 0; clicked => { root.set-mode(0); } }
        ModeTile { inline: true; glyph: Icons.proxies; label: "全局"; active: root.mode == 1; clicked => { root.set-mode(1); } }
        ModeTile { inline: true; glyph: Icons.target; label: "直连"; active: root.mode == 2; clicked => { root.set-mode(2); } }
    }
}

// `VpnCard` / `VpnTile`: the switch that starts and stops the VPN.
component VpnCard inherits DashCard {
    in property <string> run-state;
    in property <bool> slim;
    callback toggle();
    property <bool> on: run-state == "STARTED" || run-state == "STARTING";
    height: slim ? 60px : 84px;
    tapped => { if (root.run-state != "OFFLINE") { root.toggle(); } }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        if !root.slim: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: root.on ? Theme.s.primary : Theme.s.block;
                Icon { glyph: Icons.shield; size: 22px; tint: root.on ? Theme.s.on-primary : Theme.s.on-surface-variant; }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: "VPN"; font-size: root.slim ? 14px : 16px; font-weight: 600; color: Theme.s.on-surface; }
            if !root.slim: Text { text: root.on ? "已启用" : "已停用"; font-size: 12px; color: Theme.s.on-surface-variant; }
        }
        VerticalLayout {
            alignment: center;
            Switch { checked: root.on; toggled => { root.toggle(); } }
        }
    }
}

// `ProfilesCard`: the current profile, when it runs out and how much it has used.
component ProfileDashCard inherits DashCard {
    in property <DashProfile> profile;
    in property <bool> wide;
    callback sync();
    glyph: Icons.profiles;
    title: "配置";
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        alignment: start;
        DashHeader {
            glyph: Icons.profiles;
            title: "配置";
            chevron: true;
            Rectangle { horizontal-stretch: 100; }
            if root.profile.syncable: VerticalLayout {
                alignment: center;
                IconButton {
                    width: 30px;
                    height: 30px;
                    glyph: root.profile.busy ? Icons.clock : Icons.sync;
                    enabled: !root.profile.busy;
                    clicked => { root.sync(); }
                }
            }
        }
        Text {
            text: root.profile.name == "" ? "添加配置" : root.profile.name;
            font-size: 17px;
            font-weight: 600;
            color: Theme.s.on-surface;
            overflow: elide;
        }
        if root.profile.name != "": HorizontalLayout {
            spacing: 12px;
            Text { text: root.profile.updated; font-size: 12px; color: Theme.s.on-surface-variant; horizontal-stretch: 1; overflow: elide; }
            Text { text: root.profile.end; font-size: 12px; color: root.profile.warn ? Theme.warning : Theme.s.on-surface-variant; }
        }
        if root.profile.usage: VerticalLayout {
            spacing: 6px;
            padding-top: 4px;
            HorizontalLayout {
                spacing: 4px;
                Text { text: root.profile.percent; font-size: 20px; font-weight: 700; color: Theme.s.on-surface; }
                VerticalLayout { alignment: end; padding-bottom: 3px; Text { text: "已用"; font-size: 12px; color: Theme.s.on-surface-variant; } }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: end; padding-bottom: 3px; Text { text: root.profile.used; font-size: 12px; color: Theme.s.on-surface-variant; } }
            }
            Rectangle {
                height: 6px;
                border-radius: 3px;
                background: Theme.s.block;
                Rectangle {
                    x: 0;
                    width: parent.width * root.profile.ratio;
                    border-radius: 3px;
                    background: root.profile.ratio >= 0.9 ? Theme.warning : Theme.s.primary;
                }
            }
        }
    }
}

// `ProxyGroupsCard`: the groups with the proxy each one picks; a tap opens it.
component GroupsDashCard inherits DashCard {
    in property <[ProxyGroup]> groups;
    in property <bool> running;
    in property <int> limit: 6;
    callback open(string);
    property <int> cols: self.width > 360px ? 2 : 1;
    property <length> tile-h: 52px;
    property <int> shown: min(groups.length, limit);
    property <length> cell-w: (self.width - 32px - (cols - 1) * 8px) / cols;
    height: 16px + 28px + 12px + (shown == 0 ? 40px : ceil(shown / cols) * (tile-h + 8px) - 8px) + 16px;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        alignment: start;
        DashHeader {
            glyph: Icons.group;
            title: "策略组";
            chevron: root.groups.length > 0;
            if root.groups.length > 0: Chip { text: root.groups.length; }
        }
        if root.groups.length == 0: Text {
            height: 40px;
            text: root.running ? "暂无策略组" : "启动后在这里显示策略组";
            font-size: 13px;
            color: Theme.s.on-surface-variant;
            vertical-alignment: center;
        }
        if root.groups.length > 0: Rectangle {
            height: ceil(root.shown / root.cols) * (root.tile-h + 8px) - 8px;
            for g[i] in root.groups: Rectangle {
                visible: i < root.limit;
                x: mod(i, root.cols) * (root.cell-w + 8px);
                y: floor(i / root.cols) * (root.tile-h + 8px);
                width: root.cell-w;
                height: root.tile-h;
                border-radius: 14px;
                background: ta.pressed ? Theme.s.inset : Theme.s.block;
                ta := TouchArea { clicked => { root.open(g.name); } }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 10px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 10px;
                            background: Theme.s.card;
                            Text { text: g.monogram; font-size: 14px; font-weight: 700; color: Theme.s.on-surface-variant; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text { text: g.name; font-size: 14px; font-weight: 600; color: Theme.s.on-surface; overflow: elide; }
                        Text { text: g.now; font-size: 12px; color: Theme.s.on-surface-variant; overflow: elide; }
                    }
                }
            }
        }
    }
}

// `IntranetIpCard`: this device's address on its network.
component IpDashCard inherits DashCard {
    in property <string> ip;
    callback copy();
    height: 120px;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        alignment: start;
        DashHeader {
            glyph: Icons.devices;
            title: "局域网 IP";
            VerticalLayout { alignment: center; IconButton { width: 30px; height: 30px; glyph: Icons.copy; clicked => { root.copy(); } } }
        }
        Text { text: root.ip; font-size: 22px; font-weight: 700; color: Theme.s.on-surface; overflow: elide; }
    }
}

// `MemoryInfo`: what the app and its Core hold in memory.
component MemoryDashCard inherits DashCard {
    in property <string> memory;
    height: 120px;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        alignment: start;
        DashHeader { glyph: Icons.memory; title: "内存信息"; }
        Text { text: root.memory == "" ? "—" : root.memory; font-size: 22px; font-weight: 700; color: Theme.s.on-surface; }
        Text { text: "常驻内存（含内核）"; font-size: 12px; color: Theme.s.on-surface-variant; }
    }
}

// The editor's frame around a card: move it, or take it off the dashboard.
component EditFrame inherits Rectangle {
    in property <bool> first;
    in property <bool> last;
    callback up();
    callback down();
    callback remove();
    height: 40px;
    HorizontalLayout {
        spacing: 4px;
        alignment: end;
        IconButton { glyph: Icons.up; enabled: !root.first; clicked => { root.up(); } }
        IconButton { glyph: Icons.down; enabled: !root.last; clicked => { root.down(); } }
        IconButton { glyph: Icons.delete; tint: Theme.s.error; clicked => { root.remove(); } }
    }
}

component Dashboard inherits Rectangle {
    in property <string> run-state;
    in property <string> run-time;
    in property <DashStatus> status;
    in property <DashTraffic> traffic;
    in property <DashProfile> profile;
    in property <[ProxyGroup]> groups;
    in property <[string]> widgets;
    in property <[string]> hidden;
    in property <string> local-ip;
    in property <string> memory;
    in property <int> mode;
    in-out property <bool> editing;
    callback toggle-vpn();
    callback set-mode(int);
    callback open-profiles();
    callback sync-profile(string);
    callback open-group(string);
    callback refresh-ip();
    callback copy-ip();
    callback edit(string, string);
    // `DashboardDensity`: a phone column under 640, else the fixed grid of 2 or 4 columns.
    property <bool> wide: self.width >= 640px;
    property <int> columns: self.width < 860px ? 2 : 4;
    property <length> gap: self.width < 600px ? 8px : self.width < 840px ? 12px : 16px;
    property <length> side: max(16px, (self.width - 560px) / 2);
    in property <bool> has-start: true;
    property <length> cw: min((self.width - 40px - gap * (columns - 1)) / columns, 440px);
    property <length> inset: (self.width - 40px - gap * (columns - 1) - cw * columns) / 2;

    function span(n: int) -> length { return root.cw * n + root.gap * (n - 1); }

    VerticalLayout {
        AppBar {
            title: root.editing ? "编辑仪表盘" : "仪表盘";
            if !root.wide: VerticalLayout {
                alignment: center;
                IconButton {
                    glyph: root.editing ? Icons.check : Icons.edit;
                    tint: Theme.s.on-surface;
                    clicked => { root.editing = !root.editing; }
                }
            }
        }
        if !root.wide: Flickable {
            content-height: mobile.preferred-height;
            mobile := VerticalLayout {
                padding-left: root.side;
                padding-right: root.side;
                padding-top: 4px;
                padding-bottom: 24px;
                spacing: root.gap;
                for w[i] in root.widgets: VerticalLayout {
                    if root.editing: EditFrame {
                        first: i == 0;
                        last: i == root.widgets.length - 1;
                        up => { root.edit("up", w); }
                        down => { root.edit("down", w); }
                        remove => { root.edit("remove", w); }
                    }
                    if w == "status": StatusCard {
                        height: 200px;
                        status: root.status;
                        run-state: root.run-state;
                        run-time: root.run-time;
                        toggle => { root.toggle-vpn(); }
                        refresh => { root.refresh-ip(); }
                    }
                    if w == "speed": SpeedCard { traffic: root.traffic; }
                    if w == "mode": ModeCard { mode: root.mode; set-mode(m) => { root.set-mode(m); } }
                    if w == "vpn": VpnCard { run-state: root.run-state; toggle => { root.toggle-vpn(); } }
                    if w == "profile": ProfileDashCard {
                        height: self.preferred-height;
                        profile: root.profile;
                        tapped => { root.open-profiles(); }
                        sync => { root.sync-profile(root.profile.id); }
                    }
                    if w == "groups": GroupsDashCard {
                        groups: root.groups;
                        running: root.run-state == "STARTED";
                        tapped => { root.open-group(""); }
                        open(g) => { root.open-group(g); }
                    }
                    if w == "ip": IpDashCard { ip: root.local-ip; copy => { root.copy-ip(); } }
                    if w == "memory": MemoryDashCard { memory: root.memory; }
                }
                if root.editing && root.hidden.length > 0: VerticalLayout {
                    spacing: 8px;
                    padding-top: 8px;
                    Text { text: "添加卡片"; font-size: 13px; color: Theme.s.on-surface-variant; }
                    for h in root.hidden: Rectangle {
                        height: 48px;
                        border-radius: 14px;
                        background: Theme.s.card;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 4px;
                            Text {
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                font-size: 15px;
                                color: Theme.s.on-surface;
                                text: h == "status" ? "状态" : h == "speed" ? "网络速度" : h == "mode" ? "出站模式" : h == "vpn" ? "VPN" : h == "profile" ? "配置" : h == "groups" ? "策略组" : h == "ip" ? "局域网 IP" : "内存信息";
                            }
                            IconButton { glyph: Icons.plus; tint: Theme.s.primary; clicked => { root.edit("add", h); } }
                        }
                    }
                }
                if root.editing: HorizontalLayout {
                    alignment: center;
                    TextButton { text: "恢复默认"; clicked => { root.edit("reset", ""); } }
                }
            }
        }
        // The wide dashboard (`_DesktopDashboard`): rows of fixed height across 2 or 4
        // columns.
        if root.wide: Flickable {
            content-height: grid.preferred-height;
            grid := VerticalLayout {
                padding-left: 16px + root.inset;
                padding-right: 24px + root.inset;
                padding-top: 4px;
                padding-bottom: 24px;
                spacing: root.gap;
                if root.columns == 2: StatusCard {
                    height: 200px;
                    status: root.status;
                    run-state: root.run-state;
                    run-time: root.run-time;
                    toggle => { root.toggle-vpn(); }
                    refresh => { root.refresh-ip(); }
                }
                HorizontalLayout {
                    height: 200px;
                    spacing: root.gap;
                    if root.columns == 4: StatusCard {
                        width: root.span(2);
                        status: root.status;
                        run-state: root.run-state;
                        run-time: root.run-time;
                        compact: true;
                        toggle => { root.toggle-vpn(); }
                        refresh => { root.refresh-ip(); }
                    }
                    SpeedTile { width: root.cw; header: true; peak: true; upload: true; traffic: root.traffic; }
                    SpeedTile { width: root.cw; header: true; peak: true; upload: false; traffic: root.traffic; }
                }
                if root.columns == 2: ModeBar { height: 60px; mode: root.mode; set-mode(m) => { root.set-mode(m); } }
                if root.columns == 2: VpnCard { slim: true; run-state: root.run-state; toggle => { root.toggle-vpn(); } }
                if root.columns == 4: HorizontalLayout {
                    height: 60px;
                    spacing: root.gap;
                    ModeBar { width: root.span(2); mode: root.mode; set-mode(m) => { root.set-mode(m); } }
                    VpnCard { width: root.span(2); slim: true; run-state: root.run-state; toggle => { root.toggle-vpn(); } }
                }
                HorizontalLayout {
                    height: 170px;
                    spacing: root.gap;
                    IpDashCard { width: root.cw; height: 170px; ip: root.local-ip; copy => { root.copy-ip(); } }
                    ProfileDashCard {
                        width: root.columns == 4 ? root.span(2) : root.cw;
                        wide: true;
                        profile: root.profile;
                        tapped => { root.open-profiles(); }
                        sync => { root.sync-profile(root.profile.id); }
                    }
                    if root.columns == 4: MemoryDashCard { width: root.cw; height: 170px; memory: root.memory; }
                }
                if root.columns == 2: HorizontalLayout {
                    height: 120px;
                    spacing: root.gap;
                    MemoryDashCard { width: root.cw; memory: root.memory; }
                    Rectangle { width: root.cw; }
                }
                GroupsDashCard {
                    groups: root.groups;
                    limit: root.columns == 4 ? 8 : 6;
                    running: root.run-state == "STARTED";
                    tapped => { root.open-group(""); }
                    open(g) => { root.open-group(g); }
                }
            }
        }
    }

    // Neither the status card nor the VPN switch on a phone dashboard: the start button
    // stays reachable.
    if !root.wide && !root.has-start: Fab {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        glyph: root.run-state == "STARTED" ? Icons.pause : Icons.play;
        filled-glyph: true;
        enabled: root.run-state == "STARTED" || root.run-state == "STOPPED";
        clicked => { root.toggle-vpn(); }
    }
}

// ---------------------------------------------------------------- Proxies

// The delay on a card (`_DelayText`): a bolt to test while untested, a clock while queued,
// dots while running, then the value; a tap tests the card again.
component DelayBadge inherits Rectangle {
    in property <int> delay;
    in property <color> idle: Theme.s.on-surface-variant;
    callback test();
    property <bool> busy: delay == -3 || delay == -4;
    width: delay > 0 || delay == -1 || delay == -2 ? label.preferred-width + 4px : 18px;
    height: 18px;
    if root.delay == 0: Icon { glyph: Icons.bolt; size: 15px; tint: root.idle; }
    if root.delay == -4: Icon { glyph: Icons.clock; size: 15px; tint: root.idle.with-alpha(0.5); }
    if root.delay == -3: Text { text: "···"; font-size: 13px; font-weight: 700; color: Theme.s.primary; horizontal-alignment: center; vertical-alignment: center; }
    label := Text {
        visible: root.delay > 0 || root.delay == -1 || root.delay == -2;
        text: root.delay == -1 ? "超时" : root.delay == -2 ? "失败" : root.delay + " ms";
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: right;
        vertical-alignment: center;
        color: root.delay > 0 && root.delay < 800 ? Theme.success : root.delay > 0 && root.delay < 1500 ? Theme.warning : Theme.s.error;
    }
    TouchArea {
        enabled: !root.busy;
        clicked => { root.test(); }
    }
}

// FlClash's ProxyCard: the name (two lines, or one when compact), the type and the delay
// below, and a badge for the proxy in use or the pin.
component NodeCard inherits Card {
    in property <NodeItem> item;
    // 0 compact, 1 standard, 2 loose.
    in property <int> size: 1;
    callback clicked();
    callback test();
    selected: item.selected;
    background: item.selected ? Theme.s.primary-container : (ta.pressed ? Theme.s.block : Theme.s.card);
    property <color> fg: item.selected ? Theme.s.on-primary-container : Theme.s.on-surface;
    property <color> fg2: item.selected ? Theme.s.on-primary-container : Theme.s.on-surface-variant;
    ta := TouchArea { clicked => { root.clicked(); } }
    VerticalLayout {
        padding-left: 12px;
        padding-right: 10px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: root.size == 2 ? 4px : 6px;
        HorizontalLayout {
            spacing: 4px;
            vertical-stretch: 1;
            Text {
                text: root.item.name;
                font-size: 14px;
                color: root.fg;
                wrap: root.size == 0 ? no-wrap : word-wrap;
                overflow: elide;
                vertical-alignment: top;
                horizontal-stretch: 1;
            }
            if root.item.pinned || root.item.selected: Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: root.item.selected ? Theme.s.primary : Theme.s.primary.with-alpha(0.15);
                Icon {
                    glyph: root.item.pinned ? Icons.pin : Icons.check;
                    size: 13px;
                    tint: root.item.selected ? Theme.s.on-primary : Theme.s.primary;
                }
            }
        }
        if root.size == 2: Text { text: root.item.kind; font-size: 12px; color: root.fg2; overflow: elide; }
        if root.size == 2: HorizontalLayout {
            DelayBadge { delay: root.item.delay; idle: root.fg2; test => { root.test(); } }
            Rectangle { }
        }
        if root.size != 2: HorizontalLayout {
            spacing: 6px;
            height: 18px;
            Text {
                horizontal-stretch: 1;
                text: root.item.kind;
                font-size: 12px;
                color: root.fg2;
                overflow: elide;
                vertical-alignment: center;
            }
            DelayBadge { delay: root.item.delay; idle: root.fg2; test => { root.test(); } }
        }
    }
}

// A group's cards in rows of `columns`.
component NodeGrid inherits Rectangle {
    in property <[NodeItem]> nodes;
    in property <int> columns: 2;
    in property <length> card-height;
    in property <int> size;
    callback select(string);
    callback test(string);
    property <length> gap: 8px;
    property <length> cell-w: (self.width - (columns - 1) * gap) / columns;
    height: max(0px, ceil(nodes.length / columns) * (card-height + gap) - gap);
    for n[i] in root.nodes: NodeCard {
        x: mod(i, root.columns) * (root.cell-w + root.gap);
        y: floor(i / root.columns) * (root.card-height + root.gap);
        width: root.cell-w;
        height: root.card-height;
        item: n;
        size: root.size;
        clicked => { root.select(n.name); }
        test => { root.test(n.name); }
    }
}

// The list style's group header (`ListHeader`): icon, name and its pick, then the
// locate and test buttons while unfolded or the type while folded, and the fold toggle.
component GroupHeader inherits Card {
    in property <ProxyGroup> group;
    // 0 filled, 1 plain, 2 hidden.
    in property <int> icon;
    callback toggle();
    callback test();
    callback locate();
    height: 64px;
    border-radius: 16px;
    ta := TouchArea { clicked => { root.toggle(); } }
    HorizontalLayout {
        padding-left: root.icon == 2 ? 14px : 10px;
        padding-right: 6px;
        spacing: 10px;
        if root.icon == 0: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 42px;
                height: 42px;
                border-radius: 10px;
                background: Theme.s.block;
                Text { text: root.group.monogram; font-size: 18px; font-weight: 600; color: Theme.s.on-surface-variant; }
            }
        }
        if root.icon == 1: VerticalLayout {
            alignment: center;
            Text { text: root.group.monogram; width: 28px; font-size: 22px; font-weight: 700; color: Theme.s.primary; horizontal-alignment: center; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.group.name; font-size: 16px; font-weight: 600; color: Theme.s.on-surface; overflow: elide; }
            if root.group.now != "": Text { text: root.group.now; font-size: 12px; color: Theme.s.on-surface-variant; overflow: elide; }
        }
        if root.group.expanded: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 84px;
                height: 36px;
                border-radius: 18px;
                background: Theme.s.block;
                HorizontalLayout {
                    IconButton { width: 42px; height: 36px; glyph: Icons.locate; clicked => { root.locate(); } }
                    IconButton {
                        width: 42px;
                        height: 36px;
                        glyph: root.group.testing ? Icons.clock : Icons.bolt;
                        enabled: !root.group.testing;
                        clicked => { root.test(); }
                    }
                }
            }
        }
        if !root.group.expanded: Text { text: root.group.kind; font-size: 12px; color: Theme.s.on-surface-variant; vertical-alignment: center; }
        VerticalLayout {
            alignment: center;
            IconButton { glyph: root.group.expanded ? Icons.fold : Icons.unfold; clicked => { root.toggle(); } }
        }
    }
}

component Proxies inherits Rectangle {
    in property <[ProxyGroup]> groups;
    in property <ProxyStyle> style;
    in-out property <string> current-group;
    in property <bool> testing;
    in property <string> hint;
    in-out property <bool> searching;
    in-out property <string> query;
    // `getProxiesColumns` and the card heights of `getItemHeight`.
    out property <int> columns: max(ceil((self.width - 32px) / 250px), 2) + (style.layout == 0 ? 1 : style.layout == 2 ? -1 : 0);
    out property <length> card-height: style.card == 0 ? 58px : style.card == 2 ? 94px : 76px;
    callback open-group(string);
    callback select-node(string, string);
    callback test-group(string);
    callback test-node(string, string);
    callback toggle-group(string);
    callback search(string);
    callback open-options();
    callback locate(string) -> length;

    changed query => { root.search(root.query); }

    function go-to(group: string) {
        flick.content-y = -min(max(0px, root.locate(group) - 8px), max(0px, flick.content-height - flick.height));
    }

    VerticalLayout {
        if !root.searching: AppBar {
            title: "代理";
            VerticalLayout { alignment: center; IconButton { glyph: Icons.search; tint: Theme.s.on-surface; clicked => { root.searching = true; } } }
            if root.style.kind == 0 && root.groups.length > 0: VerticalLayout {
                alignment: center;
                IconButton { glyph: Icons.locate; tint: Theme.s.on-surface; clicked => { root.go-to(root.current-group); } }
            }
            VerticalLayout { alignment: center; IconButton { glyph: Icons.more; tint: Theme.s.on-surface; clicked => { root.open-options(); } } }
        }
        if root.searching: HorizontalLayout {
            height: 56px;
            padding-left: 4px;
            padding-right: 12px;
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                IconButton { glyph: Icons.back; tint: Theme.s.on-surface; clicked => { root.query = ""; root.searching = false; } }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Rectangle {
                    height: 44px;
                    border-radius: 22px;
                    background: Theme.s.block;
                    Text {
                        x: 16px;
                        visible: search-input.text == "";
                        text: "搜索";
                        color: Theme.s.on-surface-variant;
                        font-size: 15px;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    search-input := TextInput {
                        x: 16px;
                        width: parent.width - 32px;
                        height: parent.height;
                        vertical-alignment: center;
                        single-line: true;
                        font-size: 15px;
                        color: Theme.s.on-surface;
                        text <=> root.query;
                        init => { self.focus(); }
                    }
                }
            }
            if root.style.kind == 0 && root.groups.length > 0: VerticalLayout {
                alignment: center;
                IconButton { glyph: root.testing ? Icons.clock : Icons.bolt; enabled: !root.testing; tint: Theme.s.on-surface; clicked => { root.test-group(root.current-group); } }
            }
        }

        // Group tabs, FlClash's scrollable tab bar.
        if root.style.kind == 0 && root.groups.length > 0: Rectangle {
            height: 44px;
            Flickable {
                content-width: max(tabs.preferred-width, self.width);
                tabs := HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    for g in root.groups: Rectangle {
                        property <bool> active: g.name == root.current-group;
                        width: label.preferred-width + 24px;
                        label := Text {
                            text: g.name;
                            font-size: 14px;
                            font-weight: parent.active ? 600 : 400;
                            color: parent.active ? Theme.s.primary : Theme.s.on-surface-variant;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            y: parent.height - 3px;
                            width: label.preferred-width;
                            height: 3px;
                            border-radius: 1.5px;
                            background: parent.active ? Theme.s.primary : transparent;
                        }
                        TouchArea {
                            clicked => {
                                root.current-group = g.name;
                                flick.content-y = 0;
                                root.open-group(g.name);
                            }
                        }
                    }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.s.outline-variant; }
        }

        Rectangle {
            flick := Flickable {
                content-height: max(content.preferred-height, self.height);
                content := VerticalLayout {
                    alignment: start;
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 8px;
                    padding-bottom: root.style.kind == 0 ? 96px : 24px;
                    spacing: 10px;
                    if root.style.kind == 1: VerticalLayout {
                        spacing: 10px;
                        for g in root.groups: VerticalLayout {
                            spacing: 8px;
                            GroupHeader {
                                group: g;
                                icon: root.style.icon;
                                toggle => { root.toggle-group(g.name); }
                                test => { root.test-group(g.name); }
                                locate => { root.go-to(g.name); }
                            }
                            if g.expanded: NodeGrid {
                                nodes: g.nodes;
                                columns: root.columns;
                                card-height: root.card-height;
                                size: root.style.card;
                                select(n) => { root.select-node(g.name, n); }
                                test(n) => { root.test-node(g.name, n); }
                            }
                        }
                    }
                    if root.style.kind == 0: VerticalLayout {
                        for g in root.groups: VerticalLayout {
                            if g.name == root.current-group: NodeGrid {
                                nodes: g.nodes;
                                columns: root.columns;
                                card-height: root.card-height;
                                size: root.style.card;
                                select(n) => { root.select-node(g.name, n); }
                                test(n) => { root.test-node(g.name, n); }
                            }
                        }
                    }
                }
            }
            if root.groups.length == 0: Empty { text: root.searching && root.query != "" ? "没有匹配的代理" : root.hint; }
        }
    }

    if root.style.kind == 0 && root.groups.length > 0 && !root.searching: Fab {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        glyph: Icons.bolt;
        enabled: !root.testing;
        label: root.testing ? "测试中…" : "";
        clicked => { root.test-group(root.current-group); }
    }
}

// One option of the proxies menu: its name, then its choices as chips.
component OptionRow inherits VerticalLayout {
    in property <string> label;
    in property <[string]> options;
    in property <int> value;
    callback picked(int);
    padding-left: 20px;
    padding-right: 20px;
    spacing: 8px;
    Text { text: root.label; font-size: 13px; color: Theme.s.on-surface-variant; }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        for o[i] in root.options: Rectangle {
            height: 34px;
            width: chip.preferred-width + 28px;
            border-radius: 17px;
            background: i == root.value ? Theme.s.primary-container : Theme.s.block;
            chip := Text {
                text: o;
                font-size: 14px;
                color: i == root.value ? Theme.s.on-primary-container : Theme.s.on-surface;
            }
            TouchArea { clicked => { root.picked(i); } }
        }
    }
}

// ---------------------------------------------------------------- Profiles

// FlClash's ProfileItem: title with the expiry chip, the usage or the type below, the last
// update and the selection badge on the right; the more
// button opens its menu.
component ProfileCard inherits Card {
    in property <ProfileItem> item;
    callback select();
    callback menu();
    selected: item.active;
    height: 72px;
    property <color> fg: item.active ? Theme.s.on-primary-container : Theme.s.on-surface;
    property <color> fg2: item.active ? Theme.s.on-primary-container : Theme.s.on-surface-variant;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 4px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.item.name;
                    font-size: 17px;
                    color: root.fg;
                    overflow: elide;
                    horizontal-stretch: 1;
                    max-width: self.preferred-width;
                }
                if root.item.expire != "": Rectangle {
                    width: chip.preferred-width + 16px;
                    height: 20px;
                    border-radius: 10px;
                    background: (root.item.expired ? Theme.s.error : Theme.s.primary).with-alpha(0.15);
                    chip := Text {
                        text: root.item.expire;
                        font-size: 11px;
                        font-weight: 600;
                        color: root.item.expired ? Theme.s.error : Theme.s.primary;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
                Rectangle { horizontal-stretch: 0.001; }
            }
            Text { text: root.item.subtitle; font-size: 13px; color: root.fg2; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.item.busy ? "更新中…" : root.item.trailing;
                font-size: 12px;
                color: root.fg2;
            }
        }
        if root.item.active: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: Theme.s.primary;
                Icon { glyph: Icons.check; size: 16px; tint: Theme.s.on-primary; }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                glyph: Icons.more;
                enabled: !root.item.busy;
                tint: root.fg2;
                clicked => { root.menu(); }
            }
        }
    }
    TouchArea {
        width: parent.width - 48px;
        x: 0;
        clicked => { root.select(); }
    }
}

component Profiles inherits Rectangle {
    in property <[ProfileItem]> profiles;
    in property <bool> adding;
    callback add();
    callback update-all();
    callback open-sort();
    callback select-profile(string);
    callback menu(ProfileItem);

    VerticalLayout {
        AppBar {
            title: "配置";
            if root.profiles.length > 0: VerticalLayout {
                alignment: center;
                IconButton { glyph: Icons.sync; tint: Theme.s.on-surface; clicked => { root.update-all(); } }
            }
            if root.profiles.length > 0: VerticalLayout {
                alignment: center;
                IconButton { glyph: Icons.sort; tint: Theme.s.on-surface; clicked => { root.open-sort(); } }
            }
        }
        if root.profiles.length == 0: Rectangle {
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text { text: "暂无配置"; font-size: 18px; color: Theme.s.on-surface; horizontal-alignment: center; }
                Text { text: "添加一个配置文件后即可开始使用"; font-size: 14px; color: Theme.s.on-surface-variant; horizontal-alignment: center; }
                HorizontalLayout {
                    alignment: center;
                    padding-top: 8px;
                    TextButton { text: "添加配置"; filled: true; clicked => { root.add(); } }
                }
            }
        }
        if root.profiles.length > 0: Flickable {
            content-height: list.preferred-height;
            list := VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 88px;
                spacing: 10px;
                for p in root.profiles: ProfileCard {
                    item: p;
                    select => { root.select-profile(p.id); }
                    menu => { root.menu(p); }
                }
            }
        }
    }

    if root.profiles.length > 0: Fab {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        glyph: Icons.plus;
        enabled: !root.adding;
        label: root.adding ? "加载中…" : "";
        clicked => { root.add(); }
    }
}

// An outlined text field with its label above, as FlClash's forms.
component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> multi;
    in property <bool> enabled: true;
    in property <InputType> input-type: InputType.text;
    in-out property <string> text <=> input.text;
    callback accepted();
    public function focus-input() { input.focus(); }
    spacing: 6px;
    if root.label != "": Text { text: root.label; font-size: 13px; color: Theme.s.on-surface-variant; }
    Rectangle {
        height: root.multi ? 160px : 50px;
        border-radius: 8px;
        border-width: input.has-focus ? 2px : 1px;
        border-color: input.has-focus ? Theme.s.primary : Theme.s.outline-variant;
        clip: true;
        Text {
            x: 14px;
            y: root.multi ? 12px : (parent.height - self.height) / 2;
            visible: input.text == "";
            text: root.placeholder;
            color: Theme.s.on-surface-variant;
            font-size: 15px;
        }
        input := TextInput {
            x: 14px;
            y: root.multi ? 12px : 0px;
            width: parent.width - 28px;
            height: root.multi ? parent.height - 24px : parent.height;
            vertical-alignment: root.multi ? top : center;
            single-line: !root.multi;
            wrap: root.multi ? word-wrap : no-wrap;
            input-type: root.input-type;
            font-size: 15px;
            color: Theme.s.on-surface;
            selection-background-color: Theme.s.primary-container;
            enabled: root.enabled;
            accepted => { root.accepted(); }
        }
    }
}


// EditProfileView: name, url, age key, auto update and its interval, and the profile file
// (edit or upload).
component EditProfilePage inherits Rectangle {
    in property <bool> is-url;
    in-out property <string> name;
    in-out property <string> url;
    in-out property <string> age;
    in-out property <bool> auto;
    in-out property <string> interval;
    in property <string> file-info;
    in property <bool> busy;
    callback save();
    callback back();
    callback edit-file();
    callback upload-file();
    background: Theme.s.page;
    VerticalLayout {
        AppBar {
            title: "编辑";
            can-back: true;
            back => { root.back(); }
            VerticalLayout {
                alignment: center;
                TextButton { text: root.busy ? "保存中…" : "保存"; enabled: !root.busy; clicked => { root.save(); } }
            }
        }
        Flickable {
            content-height: form.preferred-height;
            form := VerticalLayout {
                padding: 16px;
                spacing: 14px;
                Field { label: "名称"; placeholder: "必填"; text <=> root.name; }
                if root.is-url: Field { label: "URL"; placeholder: "必填"; text <=> root.url; }
                Field { label: "age 私钥"; placeholder: "可选"; text <=> root.age; }
                if root.is-url: HorizontalLayout {
                    height: 48px;
                    Text { text: "自动更新"; font-size: 16px; color: Theme.s.on-surface; vertical-alignment: center; horizontal-stretch: 1; }
                    VerticalLayout { alignment: center; Switch { checked <=> root.auto; } }
                }
                if root.is-url && root.auto: HorizontalLayout {
                    spacing: 8px;
                    Field { label: "自动更新间隔"; placeholder: "必填"; input-type: InputType.number; text <=> root.interval; }
                    VerticalLayout {
                        alignment: end;
                        Text { text: "分钟"; height: 50px; vertical-alignment: center; color: Theme.s.on-surface-variant; }
                    }
                }
                Card {
                    height: 64px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 4px;
                        spacing: 4px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text { text: "配置"; font-size: 16px; color: Theme.s.on-surface; }
                            Text { text: root.file-info; font-size: 13px; color: Theme.s.on-surface-variant; }
                        }
                        VerticalLayout { alignment: center; IconButton { glyph: Icons.edit; clicked => { root.edit-file(); } } }
                        VerticalLayout { alignment: center; IconButton { glyph: Icons.upload; clicked => { root.upload-file(); } } }
                    }
                }
            }
        }
    }
}

// EditorPage: the profile file to edit, or the runtime config to read.
component EditorPage inherits Rectangle {
    in property <string> title;
    in-out property <string> text;
    in property <bool> readonly;
    callback save(string);
    callback back();
    background: Theme.s.page;
    VerticalLayout {
        AppBar {
            title: root.title;
            can-back: true;
            back => { root.back(); }
            if !root.readonly: VerticalLayout {
                alignment: center;
                TextButton { text: "保存"; clicked => { root.save(editor.text); } }
            }
        }
        Rectangle {
            background: Theme.s.card;
            flick := Flickable {
                content-height: max(editor.preferred-height + 24px, self.height);
                content-width: self.width;
                editor := TextInput {
                    x: 12px;
                    y: 12px;
                    width: parent.width - 24px;
                    text <=> root.text;
                    read-only: root.readonly;
                    single-line: false;
                    wrap: word-wrap;
                    font-family: "monospace";
                    font-size: 13px;
                    color: Theme.s.on-surface;
                    selection-background-color: Theme.s.primary-container;
                }
            }
        }
    }
}

// ReorderableProfilesSheet: move each profile up or down, then save.
component SortPage inherits Rectangle {
    in property <[ProfileItem]> items;
    callback move(int, int);
    callback save();
    callback back();
    background: Theme.s.page;
    VerticalLayout {
        AppBar {
            title: "配置排序";
            can-back: true;
            back => { root.back(); }
            VerticalLayout {
                alignment: center;
                TextButton { text: "保存"; clicked => { root.save(); } }
            }
        }
        Flickable {
            content-height: col.preferred-height;
            col := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                for p[i] in root.items: Card {
                    height: 64px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 4px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text { text: p.name; font-size: 16px; color: Theme.s.on-surface; overflow: elide; }
                            Text { text: p.subtitle; font-size: 13px; color: Theme.s.on-surface-variant; overflow: elide; }
                        }
                        VerticalLayout { alignment: center; IconButton { glyph: Icons.up; enabled: i > 0; clicked => { root.move(i, -1); } } }
                        VerticalLayout { alignment: center; IconButton { glyph: Icons.down; enabled: i < root.items.length - 1; clicked => { root.move(i, 1); } } }
                    }
                }
            }
        }
    }
}

// A row of a popup menu (FlClash's PopupMenuItem).
component MenuRow inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> danger;
    in property <bool> sub;
    callback clicked();
    height: 48px;
    background: ta.pressed ? Theme.s.inset : transparent;
    HorizontalLayout {
        padding-left: root.sub ? 40px : 16px;
        padding-right: 16px;
        spacing: 14px;
        VerticalLayout { alignment: center; Icon { glyph: root.glyph; size: 20px; tint: root.danger ? Theme.s.error : Theme.s.on-surface-variant; } }
        Text { text: root.label; font-size: 15px; color: root.danger ? Theme.s.error : Theme.s.on-surface; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// A centered dialog card over a scrim.
component Dialog inherits Rectangle {
    in property <string> title;
    in property <length> keyboard;
    in property <length> top;
    in property <bool> dismissable: true;
    callback dismiss();
    background: #00000066;
    TouchArea { clicked => { if (root.dismissable) { root.dismiss(); } } }
    Rectangle {
        x: 24px;
        width: parent.width - 48px;
        height: body.preferred-height;
        y: max(root.top + 24px, (parent.height - root.keyboard - self.height) / 2);
        background: Theme.s.card;
        border-radius: 24px;
        TouchArea { }
        body := VerticalLayout {
            padding: 24px;
            padding-bottom: 16px;
            spacing: 16px;
            if root.title != "": Text { text: root.title; font-size: 22px; color: Theme.s.on-surface; wrap: word-wrap; }
            @children
        }
    }
}

// ---------------------------------------------------------------- Tools

component ListRow inherits Rectangle {
    in property <string> glyph;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> chevron: true;
    callback clicked();
    height: subtitle == "" ? 56px : 68px;
    background: ta.pressed ? Theme.s.block : transparent;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            Icon { glyph: root.glyph; tint: Theme.s.on-surface-variant; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: root.title; font-size: 16px; color: Theme.s.on-surface; }
            if root.subtitle != "": Text { text: root.subtitle; font-size: 13px; color: Theme.s.on-surface-variant; overflow: elide; }
        }
        if root.chevron: VerticalLayout {
            alignment: center;
            Icon { glyph: Icons.chevron; size: 20px; tint: Theme.s.on-surface-variant; }
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component SectionHeader inherits Text {
    color: Theme.s.primary;
    font-size: 13px;
    height: 36px;
    vertical-alignment: bottom;
}

component Tools inherits Rectangle {
    in property <string> version;
    callback open(string);
    VerticalLayout {
        AppBar { title: "工具"; }
        Flickable {
            content-height: col.preferred-height;
            col := VerticalLayout {
                padding-bottom: 16px;
                ListRow { glyph: Icons.logs; title: "日志"; clicked => { root.open("logs"); } }
                HorizontalLayout {
                    padding-left: 16px;
                    SectionHeader { text: "设置"; }
                }
                ListRow { glyph: Icons.palette; title: "主题"; clicked => { root.open("theme"); } }
                HorizontalLayout {
                    padding-left: 16px;
                    SectionHeader { text: "其他"; }
                }
                ListRow { glyph: Icons.info; title: "关于"; subtitle: root.version; chevron: false; }
            }
        }
    }
}

component Logs inherits Rectangle {
    in property <[LogItem]> logs;
    callback clear-logs();
    callback back();
    VerticalLayout {
        AppBar {
            title: "日志";
            can-back: true;
            back => { root.back(); }
            VerticalLayout {
                alignment: center;
                TextButton { text: "清空"; clicked => { root.clear-logs(); } }
            }
        }
        if root.logs.length == 0: Empty { text: "暂无数据"; }
        if root.logs.length > 0: Flickable {
            content-height: list.preferred-height;
            list := VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 16px;
                spacing: 8px;
                for l in root.logs: Card {
                    height: col.preferred-height;
                    col := VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: l.level;
                                font-size: 11px;
                                color: l.level == "error" ? Theme.s.error : l.level == "warning" ? Theme.warning : l.level == "info" ? Theme.s.primary : Theme.s.on-surface-variant;
                            }
                            Text { text: l.time; font-size: 11px; color: Theme.s.on-surface-variant; }
                            Rectangle { }
                        }
                        Text { text: l.text; font-size: 13px; color: Theme.s.on-surface; wrap: word-wrap; }
                    }
                }
            }
        }
    }
}

component ThemePage inherits Rectangle {
    in property <[color]> accents;
    in property <int> accent;
    in property <int> theme-mode;
    callback set-accent(int);
    callback set-theme-mode(int);
    callback back();
    VerticalLayout {
        AppBar { title: "主题"; can-back: true; back => { root.back(); } }
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 12px;
            alignment: start;
            InfoCard {
                title: "主题模式";
                glyph: Icons.palette;
                VerticalLayout {
                    spacing: 2px;
                    RadioRow { text: "跟随系统"; checked: root.theme-mode == 0; clicked => { root.set-theme-mode(0); } }
                    RadioRow { text: "浅色"; checked: root.theme-mode == 1; clicked => { root.set-theme-mode(1); } }
                    RadioRow { text: "深色"; checked: root.theme-mode == 2; clicked => { root.set-theme-mode(2); } }
                }
            }
            InfoCard {
                title: "主题色彩";
                glyph: Icons.palette;
                HorizontalLayout {
                    height: 40px;
                    alignment: space-between;
                    for c[i] in root.accents: Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: c;
                        Rectangle {
                            visible: i == root.accent;
                            width: 14px;
                            height: 14px;
                            border-radius: 7px;
                            background: white;
                        }
                        TouchArea { clicked => { root.set-accent(i); } }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------- Shell

// Material 3 navigation bar destination: a pill behind the active icon, label below.
component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <string> glyph;
    callback clicked();
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 60px;
                height: 32px;
                border-radius: 16px;
                background: root.active ? Theme.s.primary-container : transparent;
                Icon {
                    glyph: root.glyph;
                    tint: root.active ? Theme.s.on-primary-container : Theme.s.on-surface-variant;
                }
            }
        }
        Text {
            text: root.label;
            font-size: 12px;
            horizontal-alignment: center;
            color: root.active ? Theme.s.on-surface : Theme.s.on-surface-variant;
        }
    }
    TouchArea { clicked => { root.clicked(); } }
}

// A destination on the side: a rail item (icon over label) or a side bar row.
component SideItem inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> active;
    in property <bool> rail;
    callback clicked();
    height: rail ? 60px : 44px;
    border-radius: rail ? 0 : 12px;
    background: !rail && active ? Theme.s.primary-container : transparent;
    if root.rail: VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 56px;
                height: 32px;
                border-radius: 16px;
                background: root.active ? Theme.s.primary-container : transparent;
                Icon { glyph: root.glyph; tint: root.active ? Theme.s.on-primary-container : Theme.s.on-surface-variant; }
            }
        }
        Text { text: root.label; font-size: 12px; horizontal-alignment: center; color: root.active ? Theme.s.on-surface : Theme.s.on-surface-variant; }
    }
    if !root.rail: HorizontalLayout {
        padding-left: 12px;
        spacing: 12px;
        VerticalLayout { alignment: center; Icon { glyph: root.glyph; size: 22px; tint: root.active ? Theme.s.on-primary-container : Theme.s.on-surface-variant; } }
        Text { text: root.label; font-size: 15px; vertical-alignment: center; color: root.active ? Theme.s.on-primary-container : Theme.s.on-surface; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

export component AppWindow inherits Window {
    title: "SeasonCat";
    background: Theme.s.page;
    default-font-size: 14px;

    // 0 dashboard, 1 proxies, 2 profiles, 3 tools (FlClash's mobile bar)
    in-out property <int> tab: 0;
    // Page opened from tools: "", "logs" or "theme".
    in-out property <string> tools-page;
    // Dashboard
    in property <string> run-state: "OFFLINE";
    in property <string> profile-name;
    in property <string> up-speed: "0 B/s";
    in property <string> down-speed: "0 B/s";
    in property <string> up-total;
    in property <string> down-total;
    in property <int> mode: 0;
    in property <DashStatus> dash-status;
    in property <DashTraffic> dash-traffic;
    in property <DashProfile> dash-profile;
    in property <[ProxyGroup]> dash-groups;
    in property <[string]> dash-widgets;
    in property <[string]> dash-hidden;
    in property <bool> dash-has-start: true;
    in property <string> dash-local-ip;
    in property <string> dash-memory;
    in property <string> dash-run-time: "00:00:00";
    in property <int> profile-count;
    in-out property <bool> dash-editing;
    callback edit-dashboard(string, string);
    callback refresh-ip();
    callback copy-text(string);
    callback toggle-vpn();
    callback set-mode(int);
    // Profiles
    in property <[ProfileItem]> profiles;
    in property <bool> adding;
    // Page over the profiles list: "", "edit", "editor", "preview" or "sort".
    in-out property <string> profiles-page;
    in-out property <bool> add-menu-open;
    in-out property <bool> link-open;
    in-out property <bool> link-batch;
    in-out property <ProfileItem> menu-item;
    in-out property <bool> menu-open;
    in-out property <bool> menu-more;
    callback import-links(string, string, string, bool);
    callback add-file();
    callback update-profile(string);
    callback update-all();
    callback select-profile(string);
    callback delete-profile(string);
    callback edit-profile(string);
    callback preview-profile(string);
    callback copy-link(string);
    callback show-qr(string);
    callback export-profile(string);
    callback open-sort();
    // Edit page
    in-out property <string> edit-id;
    in-out property <bool> edit-is-url;
    in-out property <string> edit-name;
    in-out property <string> edit-url;
    in-out property <string> edit-age;
    in-out property <bool> edit-auto;
    in-out property <string> edit-interval;
    in-out property <string> edit-file-info;
    in-out property <bool> edit-file-changed;
    callback edit-save();
    callback edit-file();
    callback upload-file();
    // Editor / runtime config
    in-out property <string> editor-title;
    in-out property <string> editor-text;
    in-out property <bool> editor-readonly;
    callback editor-save(string);
    // Sort
    in property <[ProfileItem]> sort-items;
    callback sort-move(int, int);
    callback sort-save();
    // age key prompt (dialogs.showAgeSecretKeyInput)
    in-out property <bool> age-open;
    callback age-submit(string);
    // QR code of a profile's link
    in-out property <bool> qr-open;
    in-out property <string> qr-title;
    in-out property <image> qr-image;
    // Alert and confirm dialogs
    in-out property <bool> alert-open;
    in-out property <string> alert-title;
    in-out property <string> alert-text;
    in-out property <bool> confirm-open;
    in-out property <string> confirm-title;
    in-out property <string> confirm-text;
    in-out property <string> confirm-action;
    in-out property <string> confirm-arg;
    callback confirm-answer(string, string, bool);
    // Proxies
    in property <[ProxyGroup]> proxy-groups;
    in property <ProxyStyle> proxy-style: { kind: 1, sort: 0, layout: 1, card: 1, icon: 0, hide-timeout: false };
    out property <int> proxy-columns: proxies-page.columns;
    out property <length> proxy-card-height: proxies-page.card-height;
    in-out property <bool> proxy-options-open;
    in-out property <bool> proxy-searching;
    callback test-node(string, string);
    callback toggle-group(string);
    callback proxy-style-changed(string, int);
    callback search-proxies(string);
    callback locate(string) -> length;
    in-out property <string> current-group;
    in property <bool> testing;
    in property <string> proxies-hint: "暂无数据";
    callback open-group(string);
    callback select-node(string, string);
    callback test-group(string);
    callback tab-changed(int);
    // Logs
    in property <[LogItem]> logs;
    callback clear-logs();
    // Settings
    in property <[color]> accents;
    in property <int> accent;
    in property <int> theme-mode;
    in property <string> version;
    callback set-accent(int);
    callback set-theme-mode(int);
    // Feedback
    in property <string> toast;

    public function links-done() {
        root.link-open = false;
        link-name.text = "";
        link-url.text = "";
        link-age.text = "";
        root.link-batch = false;
    }

    function go(t: int) {
        root.tab = t;
        root.tools-page = "";
        root.profiles-page = "";
        root.tab-changed(t);
    }

    property <bool> wide: root.width > 600px;
    property <bool> desktop: root.width > 840px;
    property <length> top-inset: max(root.safe-area-insets.top, 0px);
    property <length> bottom-inset: max(root.safe-area-insets.bottom, 0px);
    property <length> keyboard: root.virtual-keyboard-size.height > 0 ? root.virtual-keyboard-size.height : 0px;

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Back) {
                if (root.alert-open) { root.alert-open = false; return accept; }
                if (root.proxy-options-open) { root.proxy-options-open = false; return accept; }
                if (root.tab == 1 && root.proxy-searching) { root.proxy-searching = false; root.search-proxies(""); return accept; }
                if (root.confirm-open) {
                    root.confirm-open = false;
                    root.confirm-answer(root.confirm-action, root.confirm-arg, false);
                    return accept;
                }
                if (root.qr-open) { root.qr-open = false; return accept; }
                if (root.age-open) { root.age-open = false; root.age-submit(""); return accept; }
                if (root.menu-open) { root.menu-open = false; return accept; }
                if (root.add-menu-open) { root.add-menu-open = false; return accept; }
                if (root.link-open) { root.link-open = false; return accept; }
                if (root.tab == 2 && root.profiles-page == "editor") { root.profiles-page = "edit"; return accept; }
                if (root.tab == 2 && root.profiles-page != "") { root.profiles-page = ""; return accept; }
                if (root.tab == 3 && root.tools-page != "") {
                    root.tools-page = "";
                    return accept;
                }
                if (root.tab == 0 && root.dash-editing) { root.dash-editing = false; return accept; }
                if (root.tab != 0) {
                    root.go(0);
                    return accept;
                }
            }
            reject
        }

        HorizontalLayout {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            padding-top: root.top-inset;
            // `ViewMode`: past 600 the bar moves to the side, a rail up to 840 and a
            // labelled side bar beyond.
            if root.wide: Rectangle {
                width: root.desktop ? 200px : 88px;
                background: Theme.s.card;
                VerticalLayout {
                    padding-top: 16px;
                    padding-left: root.desktop ? 12px : 4px;
                    padding-right: root.desktop ? 12px : 4px;
                    spacing: root.desktop ? 4px : 12px;
                    alignment: start;
                    SideItem { label: "仪表盘"; glyph: Icons.dashboard; rail: !root.desktop; active: root.tab == 0; clicked => { root.go(0); } }
                    SideItem { label: "代理"; glyph: Icons.proxies; rail: !root.desktop; active: root.tab == 1; clicked => { root.go(1); } }
                    SideItem { label: "配置"; glyph: Icons.profiles; rail: !root.desktop; active: root.tab == 2; clicked => { root.go(2); } }
                    SideItem { label: "工具"; glyph: Icons.tools; rail: !root.desktop; active: root.tab == 3; clicked => { root.go(3); } }
                }
            }
        VerticalLayout {
            Rectangle {
                vertical-stretch: 1;
                if root.tab == 0: Dashboard {
                    width: parent.width;
                    height: parent.height;
                    run-state: root.run-state;
                    run-time: root.dash-run-time;
                    status: root.dash-status;
                    traffic: root.dash-traffic;
                    profile: root.dash-profile;
                    groups: root.dash-groups;
                    widgets: root.dash-widgets;
                    hidden: root.dash-hidden;
                    has-start: root.dash-has-start;
                    local-ip: root.dash-local-ip;
                    memory: root.dash-memory;
                    mode: root.mode;
                    editing <=> root.dash-editing;
                    toggle-vpn => { root.toggle-vpn(); }
                    set-mode(m) => { root.set-mode(m); }
                    open-profiles => { root.go(2); }
                    sync-profile(id) => { root.update-profile(id); }
                    open-group(g) => {
                        if (g != "") { root.current-group = g; }
                        root.go(1);
                        root.open-group(root.current-group);
                    }
                    refresh-ip => { root.refresh-ip(); }
                    copy-ip => { root.copy-text(root.dash-local-ip); }
                    edit(a, w) => { root.edit-dashboard(a, w); }
                }
                // Kept in the tree so its measures stay readable and its scroll stays put.
                proxies-page := Proxies {
                    visible: root.tab == 1;
                    width: parent.width;
                    height: parent.height;
                    groups: root.proxy-groups;
                    style: root.proxy-style;
                    current-group <=> root.current-group;
                    searching <=> root.proxy-searching;
                    testing: root.testing;
                    hint: root.proxies-hint;
                    open-group(g) => { root.open-group(g); }
                    select-node(g, n) => { root.select-node(g, n); }
                    test-group(g) => { root.test-group(g); }
                    test-node(g, n) => { root.test-node(g, n); }
                    toggle-group(g) => { root.toggle-group(g); }
                    search(q) => { root.search-proxies(q); }
                    open-options => { root.proxy-options-open = true; }
                    locate(g) => { return root.locate(g); }
                }
                if root.tab == 2 && root.profiles-page == "": Profiles {
                    width: parent.width;
                    height: parent.height;
                    profiles: root.profiles;
                    adding: root.adding;
                    add => { root.add-menu-open = true; }
                    update-all => { root.update-all(); }
                    open-sort => { root.open-sort(); }
                    select-profile(id) => { root.select-profile(id); }
                    menu(p) => { root.menu-item = p; root.menu-more = false; root.menu-open = true; }
                }
                if root.tab == 2 && root.profiles-page == "edit": EditProfilePage {
                    width: parent.width;
                    height: parent.height;
                    is-url: root.edit-is-url;
                    name <=> root.edit-name;
                    url <=> root.edit-url;
                    age <=> root.edit-age;
                    auto <=> root.edit-auto;
                    interval <=> root.edit-interval;
                    file-info: root.edit-file-info;
                    busy: root.adding;
                    save => { root.edit-save(); }
                    back => { root.profiles-page = ""; }
                    edit-file => { root.edit-file(); }
                    upload-file => { root.upload-file(); }
                }
                if root.tab == 2 && (root.profiles-page == "editor" || root.profiles-page == "preview"): EditorPage {
                    width: parent.width;
                    height: parent.height;
                    title: root.editor-title;
                    text <=> root.editor-text;
                    readonly: root.editor-readonly;
                    save(t) => { root.editor-save(t); }
                    back => { root.profiles-page = root.profiles-page == "editor" ? "edit" : ""; }
                }
                if root.tab == 2 && root.profiles-page == "sort": SortPage {
                    width: parent.width;
                    height: parent.height;
                    items: root.sort-items;
                    move(i, d) => { root.sort-move(i, d); }
                    save => { root.sort-save(); }
                    back => { root.profiles-page = ""; }
                }
                if root.tab == 3 && root.tools-page == "": Tools {
                    width: parent.width;
                    height: parent.height;
                    version: root.version;
                    open(p) => { root.tools-page = p; }
                }
                if root.tab == 3 && root.tools-page == "logs": Logs {
                    width: parent.width;
                    height: parent.height;
                    logs: root.logs;
                    clear-logs => { root.clear-logs(); }
                    back => { root.tools-page = ""; }
                }
                if root.tab == 3 && root.tools-page == "theme": ThemePage {
                    width: parent.width;
                    height: parent.height;
                    accents: root.accents;
                    accent: root.accent;
                    theme-mode: root.theme-mode;
                    set-accent(i) => { root.set-accent(i); }
                    set-theme-mode(m) => { root.set-theme-mode(m); }
                    back => { root.tools-page = ""; }
                }

                if root.toast != "": Rectangle {
                    y: parent.height - self.height - 88px - root.keyboard;
                    x: (parent.width - self.width) / 2;
                    width: min(parent.width - 40px, toast-text.preferred-width + 32px);
                    height: toast-text.preferred-height + 20px;
                    border-radius: 8px;
                    background: Theme.s.on-surface;
                    toast-text := Text {
                        x: 16px;
                        width: parent.width - 32px;
                        text: root.toast;
                        color: Theme.s.page;
                        font-size: 14px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            if !root.wide && root.keyboard == 0: Rectangle {
                height: 72px + root.bottom-inset;
                background: Theme.s.card;
                HorizontalLayout {
                    y: 0;
                    height: 72px;
                    NavItem { label: "仪表盘"; glyph: Icons.dashboard; active: root.tab == 0; clicked => { root.go(0); } }
                    NavItem { label: "代理"; glyph: Icons.proxies; active: root.tab == 1; clicked => { root.go(1); } }
                    NavItem { label: "配置"; glyph: Icons.profiles; active: root.tab == 2; clicked => { root.go(2); } }
                    NavItem { label: "工具"; glyph: Icons.tools; active: root.tab == 3; clicked => { root.go(3); } }
                }
            }
        }
        }

        // The proxies page's menu (`_buildMenuItems`), as a sheet from the bottom.
        if root.proxy-options-open: Rectangle {
            background: #00000066;
            TouchArea { clicked => { root.proxy-options-open = false; } }
            Rectangle {
                y: parent.height - self.height;
                height: opts.preferred-height + root.bottom-inset;
                background: Theme.s.card;
                border-top-left-radius: 24px;
                border-top-right-radius: 24px;
                TouchArea { }
                opts := VerticalLayout {
                    padding-top: 20px;
                    padding-bottom: 12px;
                    spacing: 16px;
                    OptionRow { label: "风格"; options: ["标签页", "列表"]; value: root.proxy-style.kind; picked(i) => { root.proxy-style-changed("kind", i); } }
                    OptionRow { label: "排序"; options: ["默认", "延迟", "名称"]; value: root.proxy-style.sort; picked(i) => { root.proxy-style-changed("sort", i); } }
                    OptionRow { label: "布局"; options: ["紧凑", "标准", "宽松"]; value: root.proxy-style.layout; picked(i) => { root.proxy-style-changed("layout", i); } }
                    OptionRow { label: "尺寸"; options: ["紧凑", "标准", "宽松"]; value: root.proxy-style.card; picked(i) => { root.proxy-style-changed("card", i); } }
                    if root.proxy-style.kind == 1: OptionRow { label: "图标样式"; options: ["色块", "纯图标", "隐藏"]; value: root.proxy-style.icon; picked(i) => { root.proxy-style-changed("icon", i); } }
                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        height: 48px;
                        Text { text: "隐藏超时代理"; font-size: 16px; color: Theme.s.on-surface; vertical-alignment: center; horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            Switch { checked: root.proxy-style.hide-timeout; toggled(on) => { root.proxy-style-changed("hide", on ? 1 : 0); } }
                        }
                    }
                }
            }
        }

        // AddProfileMenu: 文件 and 链接 (the scan and custom entries follow with the custom
        // profile editor).
        if root.add-menu-open: Rectangle {
            background: #00000033;
            TouchArea { clicked => { root.add-menu-open = false; } }
            Rectangle {
                x: parent.width - self.width - 16px;
                y: parent.height - self.height - (root.wide ? 0px : 72px) - root.bottom-inset - 88px;
                width: 200px;
                height: add-menu.preferred-height;
                background: Theme.s.card;
                border-radius: 12px;
                add-menu := VerticalLayout {
                    padding-top: 8px;
                    padding-bottom: 8px;
                    MenuRow { glyph: Icons.import-file; label: "文件"; clicked => { root.add-menu-open = false; root.add-file(); } }
                    MenuRow { glyph: Icons.cloud; label: "链接"; clicked => { root.add-menu-open = false; root.link-open = true; link-url.focus-input(); } }
                }
            }
        }

        // The profile's menu (ProfileItem._menuItems), as a sheet from the bottom.
        if root.menu-open: Rectangle {
            background: #00000066;
            TouchArea { clicked => { root.menu-open = false; } }
            Rectangle {
                y: parent.height - self.height;
                height: sheet.preferred-height + root.bottom-inset;
                background: Theme.s.card;
                border-top-left-radius: 24px;
                border-top-right-radius: 24px;
                TouchArea { }
                sheet := VerticalLayout {
                    padding-top: 12px;
                    padding-bottom: 8px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Text { text: root.menu-item.name; font-size: 16px; color: Theme.s.on-surface-variant; height: 40px; vertical-alignment: center; overflow: elide; }
                    }
                    MenuRow { glyph: Icons.edit; label: "编辑"; clicked => { root.menu-open = false; root.edit-profile(root.menu-item.id); } }
                    if root.menu-item.is-url: MenuRow { glyph: Icons.sync; label: "同步"; clicked => { root.menu-open = false; root.update-profile(root.menu-item.id); } }
                    MenuRow { glyph: Icons.more-circle; label: "更多"; clicked => { root.menu-more = !root.menu-more; } }
                    if root.menu-more: MenuRow { sub: true; glyph: Icons.eye; label: "运行时配置"; clicked => { root.menu-open = false; root.preview-profile(root.menu-item.id); } }
                    if root.menu-more && root.menu-item.is-url: MenuRow { sub: true; glyph: Icons.copy; label: "复制链接"; clicked => { root.menu-open = false; root.copy-link(root.menu-item.id); } }
                    if root.menu-more && root.menu-item.is-url: MenuRow { sub: true; glyph: Icons.qr; label: "二维码"; clicked => { root.menu-open = false; root.show-qr(root.menu-item.id); } }
                    if root.menu-more: MenuRow { sub: true; glyph: Icons.export; label: "导出文件"; clicked => { root.menu-open = false; root.export-profile(root.menu-item.id); } }
                    MenuRow { glyph: Icons.delete; label: "删除"; danger: true; clicked => { root.menu-open = false; root.delete-profile(root.menu-item.id); } }
                }
            }
        }

        // 从链接导入 (showNamedUrlsForm): a name, the link and an age key, or a batch of links.
        // Kept in the tree so the inputs keep their text and focus.
        Dialog {
            visible: root.link-open;
            title: "从链接导入";
            keyboard: root.keyboard;
            top: root.top-inset;
            dismiss => { root.link-open = false; }
            link-name := Field { label: "名称"; placeholder: "可选"; visible: !root.link-batch; height: root.link-batch ? 0 : self.preferred-height; }
            link-url := Field {
                label: "链接";
                placeholder: root.link-batch ? "每行一个链接" : "订阅链接或代理分享链接";
                multi: root.link-batch;
               
            }
            link-age := Field { label: "age 私钥"; placeholder: "可选"; visible: !root.link-batch; height: root.link-batch ? 0 : self.preferred-height; }
            HorizontalLayout {
                spacing: 8px;
                TextButton { text: root.link-batch ? "单个导入" : "批量导入"; clicked => { root.link-batch = !root.link-batch; } }
                Rectangle { horizontal-stretch: 1; }
                TextButton { text: "取消"; clicked => { root.link-open = false; } }
                TextButton {
                    text: "导入";
                    enabled: !root.adding && link-url.text != "";
                    clicked => { root.import-links(link-name.text, link-url.text, link-age.text, root.link-batch); }
                }
            }
        }

        if root.age-open: Dialog {
            title: "age 私钥";
            keyboard: root.keyboard;
            top: root.top-inset;
            dismissable: false;
            Text { text: "该配置已用 age 加密，需要 age 私钥才能解密"; wrap: word-wrap; color: Theme.s.on-surface-variant; }
            age-key := Field { placeholder: "AGE-SECRET-KEY-…"; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                TextButton { text: "取消"; clicked => { root.age-open = false; root.age-submit(""); } }
                TextButton { text: "确定"; enabled: age-key.text != ""; clicked => { root.age-open = false; root.age-submit(age-key.text); } }
            }
        }

        if root.qr-open: Dialog {
            title: root.qr-title;
            top: root.top-inset;
            dismiss => { root.qr-open = false; }
            HorizontalLayout {
                alignment: center;
                Image { source: root.qr-image; width: 240px; height: 240px; image-rendering: pixelated; }
            }
            Text { text: "在另一台设备上用 FlClash 扫码即可导入此配置。"; wrap: word-wrap; color: Theme.s.on-surface-variant; horizontal-alignment: center; }
            HorizontalLayout {
                alignment: end;
                TextButton { text: "确定"; clicked => { root.qr-open = false; } }
            }
        }

        if root.confirm-open: Dialog {
            title: root.confirm-title;
            top: root.top-inset;
            dismissable: false;
            Text { text: root.confirm-text; wrap: word-wrap; color: Theme.s.on-surface-variant; font-size: 15px; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                TextButton { text: "取消"; clicked => { root.confirm-open = false; root.confirm-answer(root.confirm-action, root.confirm-arg, false); } }
                TextButton {
                    text: root.confirm-action == "delete" ? "删除" : "确定";
                    danger: root.confirm-action == "delete";
                    clicked => { root.confirm-open = false; root.confirm-answer(root.confirm-action, root.confirm-arg, true); }
                }
            }
        }

        if root.alert-open: Dialog {
            title: root.alert-title;
            top: root.top-inset;
            dismiss => { root.alert-open = false; }
            Text { text: root.alert-text; wrap: word-wrap; color: Theme.s.on-surface-variant; font-size: 15px; }
            HorizontalLayout {
                alignment: end;
                TextButton { text: "确定"; clicked => { root.alert-open = false; } }
            }
        }
    }
}
